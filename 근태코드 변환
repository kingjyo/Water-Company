/**
 *  처리 순서:
 *  1. B1 셀 파싱 → 연도/월/마지막일 확정
 *  2. 근무계획에서 해당 월 이름 + 근태 데이터 로드
 *  3. 목적지 A열 사번 → 행 번호 맵 구성
 *  4. 근무계획 이름 → NAME_TO_ID → 사번 → 목적지 행 매칭
 *  5. 매칭된 행에 코드 변환 후 입력, 미매칭 항목은 알림에 표시
 *  6. 가운데 정렬 + 열 숨김
 */
function importAndConvert() {
  const ui    = SpreadsheetApp.getUi();
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();

  try {
    // ── STEP 1. 헤더에서 연/월/마지막일 파싱 ──────────────────────────
    const { year, month } = parseHeaderMonth(sheet);
    const lastDay = getLastDayOfMonth(year, month);

    // ── STEP 2. 근무계획 로드 ──────────────────────────────────────────
    const { names: srcNames, dateMap: srcDateMap, dataGrid: srcDataGrid }
      = loadWorkPlanData(month);

    if (srcNames.length === 0) {
      throw new Error(`근무계획 "${month}월" 시트에서 작업자 데이터를 찾을 수 없습니다.`);
    }

    // ── STEP 3. 목적지: 사번 → 행 번호 맵 ────────────────────────────
    const lastRow = sheet.getLastRow();
    if (lastRow < 3) throw new Error('3행부터 데이터가 존재해야 합니다.');

    const aColValues = sheet.getRange(3, 1, lastRow - 2, 1).getValues();
    const idToRow    = {};   // 사번 → 시트 행 번호
    const destRows   = [];   // 사번이 있는 모든 행
    for (let i = 0; i < aColValues.length; i++) {
      const id = normalizeId(aColValues[i][0]);
      if (id === '') continue;
      const row = 3 + i;
      destRows.push(row);
      if (!(id in idToRow)) idToRow[id] = row;   // 중복 사번이면 첫 행 사용
    }
    if (destRows.length === 0) {
      throw new Error('A열에서 사번을 찾을 수 없습니다.\n3행부터 A열에 사번이 입력되어 있는지 확인하세요.');
    }

    // ── STEP 4. 데이터 영역 초기화 ────────────────────────────────────
    const lastWorkerRow = destRows[destRows.length - 1];
    sheet.getRange(3, 2, lastWorkerRow - 2, lastDay).clearContent();

    // ── STEP 5. 이름 → 사번 → 행 매칭 후 코드 변환 입력 ──────────────
    const matched        = [];   // { name, id, row }
    const unknownNames   = [];   // NAME_TO_ID 에 없는 이름
    const missingInSheet = [];   // 사번은 알지만 A열에 없는 경우
    const filledRows     = new Set();

    for (let srcIdx = 0; srcIdx < srcNames.length; srcIdx++) {
      const name = srcNames[srcIdx];
      if (name === '') continue;   // 빈 이름 행은 건너뜀

      const id = NAME_TO_ID[name];
      if (!id) { unknownNames.push(name); continue; }

      const destRow = idToRow[normalizeId(id)];
      if (!destRow) { missingInSheet.push(`${name}(${id})`); continue; }

      // 1일~lastDay일 코드 배열 구성
      const rowData = [];
      for (let day = 1; day <= lastDay; day++) {
        let converted = DEFAULT_VALUE;
        if (day in srcDateMap) {
          const raw = String(srcDataGrid[srcIdx][srcDateMap[day]] ?? '').trim();
          if (raw !== '') {
            converted = REPLACEMENT_MAP.hasOwnProperty(raw) ? REPLACEMENT_MAP[raw] : DEFAULT_VALUE;
          }
        }
        rowData.push(converted);
      }

      sheet.getRange(destRow, 2, 1, lastDay).setValues([rowData]);
      filledRows.add(destRow);
      matched.push({ name, id, row: destRow });
    }

    // 근무계획에 없는 사번 행 (목적지에만 존재)
    const unmatchedIds = destRows
      .filter(r => !filledRows.has(r))
      .map(r => `${normalizeId(aColValues[r - 3][0])} (${r}행)`);

    // ── STEP 6. 가운데 정렬 + 열 숨김 ───────────────────────────────
    sheet.getRange(3, 2, lastWorkerRow - 2, lastDay).setHorizontalAlignment('center');
    applyColumnVisibility(sheet, lastDay);
    SpreadsheetApp.flush();

    // ── STEP 7. 완료 알림 ─────────────────────────────────────────────
    const lastDayCol = colIndexToLetter(1 + lastDay);
    const hiddenNote = lastDay < 31
      ? `\n• 표시 열 숨김: ${lastDay + 1}일~31일 열 숨김 완료`
      : `\n• 31일까지 모두 표시`;

    let warn = '';
    if (unknownNames.length)   warn += `\n\n⚠️ NAME_TO_ID 에 없는 이름 (건너뜀):\n  ${unknownNames.join(', ')}`;
    if (missingInSheet.length) warn += `\n\n⚠️ 사번이 A열에 없음 (건너뜀):\n  ${missingInSheet.join(', ')}`;
    if (unmatchedIds.length)   warn += `\n\n⚠️ 근무계획에 없는 사번 행 (비워둠):\n  ${unmatchedIds.join(', ')}`;

    ui.alert(
      `📥 ${year}년 ${month}월 근무계획 가져오기 + 코드 변환 완료!\n\n` +
      `• 처리 기간: ${month}월 1일 ~ ${lastDay}일 (${lastDay}일간)\n` +
      `• 처리 범위: B3:${lastDayCol}${lastWorkerRow}\n` +
      `• 근무계획 인원: ${srcNames.filter(n => n).length}명 / 매칭 입력: ${matched.length}명` +
      hiddenNote +
      warn
    );

  } catch (e) {
    ui.alert('❌ 오류 발생\n\n' + e.message);
    console.error(e);
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// 코드 변환만 실행 (기존 기능 — 월 기반 열 범위 적용)
// ─────────────────────────────────────────────────────────────────────────────

function replaceShiftCodes() {
  const ui    = SpreadsheetApp.getUi();
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();

  try {
    const { year, month } = parseHeaderMonth(sheet);
    const lastDay = getLastDayOfMonth(year, month);

    const lastRow = sheet.getLastRow();
    const numRows = lastRow - 2;
    if (numRows <= 0) {
      ui.alert('3행부터 데이터가 존재해야 합니다.');
      return;
    }

    const idValues  = sheet.getRange(3, 1, numRows, 1).getValues();
    const dataRange = sheet.getRange(3, 2, numRows, lastDay);
    const dataValues = dataRange.getValues();

    const newValues = dataValues.map((row, i) => {
      const empId = normalizeId(idValues[i][0]);
      if (!empId) return row;
      return row.map(cell => {
        const key = String(cell ?? '').trim();
        if (key === '') return DEFAULT_VALUE;
        return REPLACEMENT_MAP.hasOwnProperty(key) ? REPLACEMENT_MAP[key] : DEFAULT_VALUE;
      });
    });

    dataRange.setValues(newValues);
    dataRange.setHorizontalAlignment('center');
    applyColumnVisibility(sheet, lastDay);
    SpreadsheetApp.flush();

    const lastDayCol = colIndexToLetter(1 + lastDay);
    const hiddenNote = lastDay < 31
      ? `\n• 표시 열 숨김: ${lastDay + 1}일~31일 열 숨김 완료`
      : `\n• 31일까지 모두 표시`;

    ui.alert(
      `근태 코드 변환이 완료되었습니다!\n\n` +
      `• ${year}년 ${month}월 기준 (${lastDay}일까지)\n` +
      `• 처리 범위: B3:${lastDayCol}${lastRow}\n` +
      `• 변환 규칙 적용 + 가운데 정렬 완료` +
      hiddenNote
    );

  } catch (e) {
    ui.alert('❌ 오류 발생\n\n' + e.message);
    console.error(e);
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// 헬퍼: 달의 일수에 맞게 열 표시/숨김 조정
// ─────────────────────────────────────────────────────────────────────────────

function applyColumnVisibility(sheet, lastDay) {
  const DAY_COL_START = 2;  // B열 = 1일
  const MAX_DAY = 31;

  sheet.showColumns(DAY_COL_START, lastDay);

  const hideDays = MAX_DAY - lastDay;
  if (hideDays > 0) {
    sheet.hideColumns(DAY_COL_START + lastDay, hideDays);
  }
}
