/** 👤 인원정보 시트 열기 (없으면 만들기) */
function openStaffInfoSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const existed = !!ss.getSheetByName(STAFF_INFO_SHEET);
  const sh = getStaffInfoSheet_(ss, true);
  ss.setActiveSheet(sh);
  ss.toast(
    existed ? '근무 시작/종료일, 월차 기준일을 확인·수정하세요.'
            : '새로 만들었습니다. 제목 셀에 마우스를 올리면 설명이 보입니다.',
    '👤 인원정보', 6);
}

/** 🗓️ 월차 대상자 점검 (X월 근무현황표 Z3/X3 기준 월) */
function checkMonthlyLeave() {
  const ui = SpreadsheetApp.getUi();
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const { year, month } = getCurrentYearMonth(ss);
    const logs = checkMonthlyLeave_(ss, year, month, true);
    ui.alert(`🗓️ ${year}년 ${month}월 1년 미만 월차 점검\n\n` + logs.join('\n'));
  } catch (e) {
    ui.alert('❌ 오류 발생\n\n' + e.message);
    console.error(e);
  }
}

/** ⛔ 근무기간 외 "-" 다시 표시 (현재 시트) */
function reapplyEmploymentMask() {
  const ui = SpreadsheetApp.getUi();
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getActiveSheet();
    const { year, month } = resolveYearMonthForActiveSheet(ss, sheet);
    const logs = applyEmploymentMask_(sheet, year, month);
    ui.alert(`⛔ [${sheet.getName()}] ${year}년 ${month}월 근무기간 외 표시\n\n` +
      (logs.length ? logs.join('\n') : '해당 인원 없음'));
  } catch (e) {
    ui.alert('❌ 오류 발생\n\n' + e.message);
    console.error(e);
  }
}
