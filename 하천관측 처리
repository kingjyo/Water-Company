function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('🌧️ 기상관측 처리')
    .addItem('① 정시 행만 남기기 (A열)', 'filterHourlyRows')
    .addItem('② 강우 구간만 남기기 (C열)', 'filterRainfallRange')
    .addItem('① + ② 순서대로 실행', 'runAll')
    .addSeparator()
    .addItem('③ 오류 데이터 보정 (수위/유속)', 'fixZeroWaterLevelVelocity')
    .addItem('④ 10분 단위 데이터 정리', 'filterTenMinuteData')
    .addToUi();
}

// ① A열: 정시(xx:00:xx) 또는 59분(xx:59:xx)인 행만 남기고, 측정일시를 "23시" 형식으로 변경
function filterHourlyRows() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();

  if (lastRow < 2) {
    SpreadsheetApp.getUi().alert('데이터가 없습니다.');
    return;
  }

  const allData = sheet.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();

  const filteredData = [];
  for (let i = 0; i < allData.length; i++) {
    const cellValue = allData[i][0].trim();
    const timeMatch = cellValue.match(/(\d{1,2}):(\d{2}):\d{2}$/);
    if (timeMatch && (timeMatch[2] === '00' || timeMatch[2] === '59')) {
      const row = allData[i].slice();
      let hour = parseInt(timeMatch[1], 10);
      if (timeMatch[2] === '59') {
        hour = (hour + 1) % 24; // 59분이면 다음 시각으로 표시 (23:59 → 0시)
      }
      row[0] = `${hour}시`;
      filteredData.push(row);
    }
  }

  if (filteredData.length === 0) {
    SpreadsheetApp.getUi().alert('정시 행이 없습니다.');
    return;
  }

  sheet.getRange(2, 1, lastRow - 1, lastCol).clearContent();
  sheet.getRange(2, 1, filteredData.length, lastCol).setValues(filteredData);

  const emptyRowStart = filteredData.length + 2;
  if (emptyRowStart <= lastRow) {
    sheet.deleteRows(emptyRowStart, lastRow - emptyRowStart + 1);
  }

  SpreadsheetApp.getUi().alert(`✅ 정시 행 필터링 완료! (${filteredData.length}행 유지)`);
}

// ② C열: 수위 1 초과 값이 있으면, 처음 0 초과 ~ 다시 0이 되는 지점까지만 남김
function filterRainfallRange() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();

  if (lastRow < 2) {
    SpreadsheetApp.getUi().alert('데이터가 없습니다.');
    return;
  }

  const allData = sheet.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();

  const cNums = allData.map(row => {
    const v = parseFloat(row[2]);
    return isNaN(v) ? 0 : v;
  });

  // 구간 탐지: 값이 0 초과인 연속 구간 (경계는 기존과 동일하게 0 기준)
  const segments = [];
  let inSegment = false;
  let segStart = -1;

  for (let i = 0; i < cNums.length; i++) {
    if (!inSegment && cNums[i] > 0) {
      inSegment = true;
      segStart = i;
    } else if (inSegment && cNums[i] <= 0) {
      segments.push({ start: segStart, end: i - 1 });
      inSegment = false;
    }
  }
  if (inSegment) {
    segments.push({ start: segStart, end: cNums.length - 1 });
  }

  // 유효 구간 판정 기준
  const MIN_PEAK = 0.05; // 하천유출 시작 판단 기준 (기존 1 → 0.05)

  const validSegments = segments.filter(seg => {
    const segValues = cNums.slice(seg.start, seg.end + 1);
    const peak = Math.max(...segValues);

    // 조건1: 최고 수위가 0.05 이상
    if (peak < MIN_PEAK) return false;

    // 조건2: 상승 구간과 하강 구간이 모두 존재해야 함 (단순 노이즈/스파이크 제외)
    let hasRise = false;
    let hasFall = false;
    for (let i = 1; i < segValues.length; i++) {
      if (segValues[i] > segValues[i - 1]) hasRise = true;
      if (segValues[i] < segValues[i - 1]) hasFall = true;
    }

    return hasRise && hasFall;
  });

  if (validSegments.length === 0) {
    SpreadsheetApp.getUi().alert('ℹ️ 상승-하강 패턴(하천유출)을 보이는 구간이 없습니다.');
    return;
  }

  const keepSet = new Set();
  validSegments.forEach(seg => {
    for (let i = seg.start; i <= seg.end; i++) {
      keepSet.add(i);
    }
  });

  const filteredData = allData.filter((_, i) => keepSet.has(i));

  sheet.getRange(2, 1, lastRow - 1, lastCol).clearContent();
  sheet.getRange(2, 1, filteredData.length, lastCol).setValues(filteredData);

  const emptyRowStart = filteredData.length + 2;
  if (emptyRowStart <= lastRow) {
    sheet.deleteRows(emptyRowStart, lastRow - emptyRowStart + 1);
  }

  SpreadsheetApp.getUi().alert(`✅ 강우 구간(상승-하강 패턴) 필터링 완료!\n유효 구간 ${validSegments.length}개, ${filteredData.length}행 유지`);
}

// ① + ② 순서대로 실행
function runAll() {
  filterHourlyRows();
  filterRainfallRange();
  SpreadsheetApp.getUi().alert('✅ 전체 처리 완료!');
}

// ③ 오류 데이터 보정: 수위/유속 이상값 보정
function fixZeroWaterLevelVelocity() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const lastRow = sheet.getLastRow();

  if (lastRow < 2) return;

  const dataRange = sheet.getRange(2, 3, lastRow - 1, 2); // C2:D마지막행
  const values = dataRange.getValues();

  let correctedCount = 0;

  for (let i = 0; i < values.length; i++) {
    const waterLevel = values[i][0]; // C열: 수위
    const velocity = values[i][1]; // D열: 유속

    const isAbnormal =
      (waterLevel <= 0 && velocity > 0) || // 조건1: 수위 0 이하, 유속 0 초과
      (waterLevel > 0 && waterLevel <= 0.010 && velocity >= 2); // 조건2: 수위 0.001~0.010, 유속 2 이상

    if (isAbnormal) {
      const velocityCell = sheet.getRange(i + 2, 4); // D열
      velocityCell.setValue(0);
      velocityCell.setFontColor('#0000FF'); // 파란색
      correctedCount++;
    }
  }

  if (correctedCount > 0) {
    SpreadsheetApp.getUi().alert(`✅ 수정 완료: ${correctedCount}개의 유속 값이 0으로 보정되었습니다.`);
  } else {
    SpreadsheetApp.getUi().alert('보정이 필요한 데이터가 없습니다.');
  }
}

// ④ 10분 단위 데이터 정리
function filterTenMinuteData() {
  const ui = SpreadsheetApp.getUi();
  const response = ui.alert(
    '10분 단위 데이터 정리',
    '분(MM)이 00, 10, 20, 30, 40, 50이 아닌 행을 모두 삭제합니다.\n계속 하시겠습니까?',
    ui.ButtonSet.OK_CANCEL
  );

  if (response !== ui.Button.OK) return;

  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();

  if (lastRow < 2) return;

  const allData = sheet.getRange(2, 1, lastRow - 1, lastCol).getValues();
  const allFormats = sheet.getRange(2, 1, lastRow - 1, lastCol).getFontColors();

  const keepData = [];
  const keepFormats = [];

  for (let i = 0; i < allData.length; i++) {
    const cellValue = allData[i][1]; // B열 (index 1)
    let minute = null;

    if (cellValue instanceof Date) {
      minute = cellValue.getMinutes();
    } else if (typeof cellValue === 'string' && cellValue.trim() !== '') {
      const match = cellValue.trim().match(/^\d{4}-\d{2}-\d{2} \d{2}:(\d{2}):\d{2}$/);
      if (match) minute = parseInt(match[1], 10);
    }

    if (minute !== null && minute % 10 === 0) {
      keepData.push(allData[i]);
      keepFormats.push(allFormats[i]);
    }
  }

  const deletedCount = allData.length - keepData.length;

  sheet.getRange(2, 1, lastRow - 1, lastCol).clearContent();
  sheet.getRange(2, 1, lastRow - 1, lastCol).setFontColor('#000000');

  if (keepData.length > 0) {
    sheet.getRange(2, 1, keepData.length, lastCol).setValues(keepData);
    sheet.getRange(2, 1, keepFormats.length, lastCol).setFontColors(keepFormats);
  }

  ui.alert(`✅ 정리 완료: ${deletedCount}개 행이 삭제되었습니다.`);
}