/*******************************
 * 설정
 *******************************/
const REPORT_CONFIG = {
  weatherSheet: '기상정보',
  riverSheet: '하천관측 정보',
  reportSheet: '보고용 표',
  rainCol: 13, // M열: 강수량
  levelCol: 3, // C열: 수위
  velCol: 4, // D열: 유속
  eventMinTotal: 30, // 강우 이벤트 최소 누적 강수량(mm)

  levelThreshold: 0.001, // 유출 인정 최소 수위
  velThreshold: 0.1, // 유출 인정 최소 유속

  riseWindow: 6, // 상승 전환 확인 창 (10분 단위 → 1시간)
  minLevelRise: 0.005, // 창 안에서 필요한 수위 상승폭
  minVelRise: 0.05, // 창 안에서 필요한 유속 상승폭

  recessionCount: 6, // 기준 미달 연속 N회면 유출 종료
  reportStartRow: 3,
  reportEndRow: 14
};

// ③ 오류 데이터 보정 기준
const FIX_CONFIG = {
  levelCol: 3,
  velCol: 4,
  velJump: 2, // 직전 행 대비 유속 급등 기준
  levelJump: 1.5, // 직전 행 대비 수위 급등 기준
  lowLevel: 0.010,
  lowLevelVelLimit: 2,
  minDuration: 3,
  minPeakLevel: 0.01,
  minLevelRise: 0.005,
  jumpFromZero: 0.5,
  warnColor: '#FFC7CE',
  fixColor: '#0000FF'
};

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('🌧️ 기상관측 처리')
    .addItem('① 정시 행만 남기기 (A열)', 'filterHourlyRows')
    .addItem('② 강우 구간만 남기기 (C열)', 'filterRainfallRange')
    .addItem('① + ② 순서대로 실행', 'runAll')
    .addSeparator()
    .addItem('③ 오류 데이터 보정 (수위/유속)', 'fixZeroWaterLevelVelocity')
    .addItem('④ 10분 단위 데이터 정리', 'filterTenMinuteData')
    .addSeparator()
    .addItem('⑤ 보고용 표 자동 작성', 'buildRainfallReport')
    .addToUi();
}

/*******************************
 * ⑤ 보고용 표 자동 작성
 * 기록 조건: 강우 이벤트 발생 AND 하천유출 발생
 * 빈 행(3~14)은 숨김 처리
 *******************************/
function buildRainfallReport() {
  const ui = SpreadsheetApp.getUi();
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const reportSheet = ss.getSheetByName(REPORT_CONFIG.reportSheet);
  if (!reportSheet) { ui.alert(`'${REPORT_CONFIG.reportSheet}' 시트가 없습니다.`); return; }

  let weather, river;
  try {
    weather = loadWeatherData_(ss);
    river = loadRiverData_(ss);
  } catch (e) {
    ui.alert(e.message);
    return;
  }
  if (weather.length === 0) { ui.alert('기상정보 시트에서 유효한 데이터를 찾지 못했습니다.'); return; }

  const rowCount = REPORT_CONFIG.reportEndRow - REPORT_CONFIG.reportStartRow + 1;

  const rainEvents = detectRainEvents_(weather);
  if (rainEvents.length === 0) {
    ui.alert(`누적 ${REPORT_CONFIG.eventMinTotal}mm 이상인 강우 이벤트가 없습니다.`);
    return;
  }

  rainEvents.forEach((ev, idx) => {
    const nextStart = (idx + 1 < rainEvents.length) ? rainEvents[idx + 1].startTime : null;
    ev.runoff = analyzeRunoff_(river, ev.startTime, nextStart);
  });

  const events = rainEvents.filter(ev => ev.runoff.start !== null);
  const droppedCount = rainEvents.length - events.length;

  if (events.length === 0) {
    ui.alert(`강우 이벤트는 ${rainEvents.length}건 있으나,\n하천유출이 확인된 건이 없어 기록하지 않았습니다.`);
    return;
  }

  const out = [];
  for (let i = 0; i < rowCount; i++) {
    if (i >= events.length) { out.push(['', '', '', '', '', '', '']); continue; }
    const ev = events[i];
    const r = ev.runoff;

    out.push([
      formatDateK_(ev.mainDate),
      `${Math.round(ev.total)} mm`,
      `${formatDateK_(ev.startTime)} ${formatTime_(ev.startTime, true)} ~\n` +
      `${formatDateK_(ev.endTime)} ${formatTime_(ev.endTime, true)}`,
      `${formatDateK_(r.start)} ${formatTime_(r.start, false)}`,
      formatDuration_(r.start - ev.startTime),
      `${r.maxLevel.toFixed(2)}m`,
      `${r.maxVel.toFixed(2)}m/s`
    ]);
  }

  reportSheet.getRange(REPORT_CONFIG.reportStartRow, 2, rowCount, 7).clearContent();
  reportSheet.getRange(REPORT_CONFIG.reportStartRow, 2, rowCount, 7).setValues(out);
  reportSheet.getRange(REPORT_CONFIG.reportStartRow, 4, rowCount, 1).setWrap(true);

  // 빈 행 숨기기
  const usedRows = Math.min(events.length, rowCount);
  reportSheet.showRows(REPORT_CONFIG.reportStartRow, rowCount);
  if (usedRows < rowCount) {
    const hideStart = REPORT_CONFIG.reportStartRow + usedRows;
    reportSheet.hideRows(hideStart, rowCount - usedRows);
  }

  let msg = `✅ 강우+유출 이벤트 ${usedRows}건을 작성했습니다.`;
  if (usedRows < rowCount) msg += `\nℹ️ 빈 행 ${rowCount - usedRows}개는 숨겼습니다.`;
  if (droppedCount > 0) msg += `\nℹ️ 강우 이벤트 ${droppedCount}건은 하천유출이 없어 제외했습니다.`;
  if (events.length > rowCount) msg += `\n⚠️ 표 칸(${rowCount}개)보다 많아 앞의 ${rowCount}건만 기록했습니다.`;
  ui.alert(msg);
}

/*******************************
 * 하천유출 분석
 * 시작: 강우 이벤트 시작 이후 '상승 전환점'
 * 인정: 구간 최고 수위 >= levelThreshold AND 최고 유속 >= velThreshold
 *******************************/
function analyzeRunoff_(river, eventStart, nextEventStart) {
  const result = { start: null, maxLevel: null, maxVel: null };
  if (river.length === 0) return result;

  const limitTime = nextEventStart ? nextEventStart.getTime()
                                   : eventStart.getTime() + 1000 * 60 * 60 * 72;

  const idx = [];
  for (let i = 0; i < river.length; i++) {
    const t = river[i].time.getTime();
    if (t < eventStart.getTime()) continue;
    if (t > limitTime) break;
    idx.push(i);
  }
  if (idx.length < 2) return result;

  // 1) 상승 전환점 탐색
  let turnPos = -1;
  for (let p = 0; p < idx.length - 1; p++) {
    const base = river[idx[p]];
    let maxLvlAhead = -Infinity;
    let maxVelAhead = -Infinity;

    for (let q = p + 1; q <= p + REPORT_CONFIG.riseWindow && q < idx.length; q++) {
      const d = river[idx[q]];
      if (d.level > maxLvlAhead) maxLvlAhead = d.level;
      if (d.vel > maxVelAhead) maxVelAhead = d.vel;
    }
    if (maxLvlAhead === -Infinity) break;

    const rising = (maxLvlAhead - base.level >= REPORT_CONFIG.minLevelRise) &&
                   (maxVelAhead - base.vel >= REPORT_CONFIG.minVelRise);
    if (rising) { turnPos = p; break; }
  }
  if (turnPos === -1) return result;

  // 2) 저점 이후 실제 상승 시작 행
  const baseLvl = river[idx[turnPos]].level;
  const baseVel = river[idx[turnPos]].vel;
  let startPos = -1;
  for (let q = turnPos + 1; q <= turnPos + REPORT_CONFIG.riseWindow && q < idx.length; q++) {
    const d = river[idx[q]];
    if (d.level > baseLvl && d.vel > baseVel) { startPos = q; break; }
  }
  if (startPos === -1) startPos = turnPos + 1;
  if (startPos >= idx.length) return result;

  const startIdx = idx[startPos];

  // 3) 유출 종료까지 최대값 추적
  let maxLevel = river[startIdx].level;
  let maxVel = river[startIdx].vel;
  let below = 0;

  for (let i = startIdx; i < river.length; i++) {
    const d = river[i];
    if (nextEventStart && d.time >= nextEventStart) break;
    if (d.time.getTime() > limitTime) break;

    const active = (d.level >= REPORT_CONFIG.levelThreshold && d.vel >= REPORT_CONFIG.velThreshold);
    if (active) {
      below = 0;
      if (d.level > maxLevel) maxLevel = d.level;
      if (d.vel > maxVel) maxVel = d.vel;
    } else {
      below++;
      if (below >= REPORT_CONFIG.recessionCount) break;
    }
  }

  if (maxLevel < REPORT_CONFIG.levelThreshold || maxVel < REPORT_CONFIG.velThreshold) {
    return result;
  }

  result.start = river[startIdx].time;
  result.maxLevel = maxLevel;
  result.maxVel = maxVel;
  return result;
}

/*******************************
 * ③ 오류 데이터 보정
 * 0단계: 급등 스파이크 → 이웃 평균 보정 (이웃이 0이면 경고)
 * 1단계: 행 단위 명백한 오류
 * 2단계: 유속 구간 단위 추세 판정
 *******************************/
function fixZeroWaterLevelVelocity() {
  const ui = SpreadsheetApp.getUi();
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) { ui.alert('데이터가 없습니다.'); return; }

  const n = lastRow - 1;
  const maxCol = Math.max(FIX_CONFIG.levelCol, FIX_CONFIG.velCol);
  const data = sheet.getRange(2, 1, n, maxCol).getValues();

  const levels = data.map(r => toNum_(r[FIX_CONFIG.levelCol - 1]));
  const vels = data.map(r => toNum_(r[FIX_CONFIG.velCol - 1]));

  const levelFixed = new Array(n).fill(false);
  const velFixed = new Array(n).fill(false);
  const warns = [];

  const stats = {
    velSpike: 0, levelSpike: 0,
    zeroLevel: 0, lowLevelHighVel: 0,
    tooShort: 0, noLevelResponse: 0, noRiseFall: 0, suddenJump: 0
  };

  // ── 0단계: 급등 스파이크 보정 ────────────────────────
  const smoothSpikes = (arr, jumpLimit, fixedFlags, colIdx, label) => {
    for (let i = 1; i < n; i++) {
      if (arr[i] - arr[i - 1] < jumpLimit) continue;

      const prev = arr[i - 1];
      const next = (i + 1 < n) ? arr[i + 1] : null;

      if (next === null) {
        warns.push({
          row: i + 2, col: colIdx, kind: label,
          msg: `${label} 급등(${prev} → ${arr[i]})이나 다음 행이 없어 보정 불가`
        });
        continue;
      }
      if (prev === 0 || next === 0) {
        warns.push({
          row: i + 2, col: colIdx, kind: label,
          msg: `${label} 급등(${prev} → ${arr[i]}), 이웃 값에 0이 있어 자동 보정 불가 (위: ${prev}, 아래: ${next})`
        });
        continue;
      }

      arr[i] = Math.round(((prev + next) / 2) * 1000) / 1000;
      fixedFlags[i] = true;
      if (label === '유속') stats.velSpike++; else stats.levelSpike++;
    }
  };

  smoothSpikes(vels, FIX_CONFIG.velJump, velFixed, FIX_CONFIG.velCol, '유속');
  smoothSpikes(levels, FIX_CONFIG.levelJump, levelFixed, FIX_CONFIG.levelCol, '수위');

  // ── 1단계: 행 단위 명백한 오류 ──────────────────────
  const bad = new Array(n).fill(false);

  for (let i = 0; i < n; i++) {
    if (vels[i] <= 0) continue;
    if (levels[i] <= 0) {
      bad[i] = true; stats.zeroLevel++;
    } else if (levels[i] <= FIX_CONFIG.lowLevel && vels[i] >= FIX_CONFIG.lowLevelVelLimit) {
      bad[i] = true; stats.lowLevelHighVel++;
    }
  }

  // ── 2단계: 유속 구간 단위 추세 판정 ─────────────────
  let i = 0;
  while (i < n) {
    if (vels[i] <= 0) { i++; continue; }

    let j = i;
    while (j + 1 < n && vels[j + 1] > 0) j++;

    const segVel = vels.slice(i, j + 1);
    const segLvl = levels.slice(i, j + 1);
    const len = segVel.length;

    const peakLvl = Math.max.apply(null, segLvl);
    const lvlRange = peakLvl - Math.min.apply(null, segLvl);
    const peakVel = Math.max.apply(null, segVel);

    let reason = null;

    if (len < FIX_CONFIG.minDuration) {
      reason = 'tooShort';
    } else if (peakLvl < FIX_CONFIG.minPeakLevel || lvlRange < FIX_CONFIG.minLevelRise) {
      reason = 'noLevelResponse';
    } else {
      let hasRise = false, hasFall = false;
      for (let k = 1; k < len; k++) {
        if (segVel[k] > segVel[k - 1]) hasRise = true;
        if (segVel[k] < segVel[k - 1]) hasFall = true;
      }
      if (!(hasRise && hasFall)) {
        reason = 'noRiseFall';
      } else if (segVel[0] >= FIX_CONFIG.jumpFromZero && segVel[0] >= peakVel) {
        reason = 'suddenJump';
      }
    }

    if (reason) {
      for (let k = i; k <= j; k++) { bad[k] = true; vels[k] = 0; velFixed[k] = true; }
      stats[reason]++;
    }

    i = j + 1;
  }

  // ── 시트 반영 ──────────────────────────────────────
  const lvlRangeAll = sheet.getRange(2, FIX_CONFIG.levelCol, n, 1);
  const velRangeAll = sheet.getRange(2, FIX_CONFIG.velCol, n, 1);

  const lvlValues = lvlRangeAll.getValues();
  const velValues = velRangeAll.getValues();
  const lvlColors = lvlRangeAll.getFontColors();
  const velColors = velRangeAll.getFontColors();

  let changed = 0;
  for (let k = 0; k < n; k++) {
    if (levelFixed[k]) {
      lvlValues[k][0] = levels[k];
      lvlColors[k][0] = FIX_CONFIG.fixColor;
      changed++;
    }
    if (velFixed[k] || (bad[k] && toNum_(velValues[k][0]) !== 0)) {
      velValues[k][0] = vels[k];
      velColors[k][0] = FIX_CONFIG.fixColor;
      changed++;
    }
  }

  lvlRangeAll.setValues(lvlValues);
  lvlRangeAll.setFontColors(lvlColors);
  velRangeAll.setValues(velValues);
  velRangeAll.setFontColors(velColors);

  lvlRangeAll.setBackground(null);
  velRangeAll.setBackground(null);
  lvlRangeAll.clearNote();
  velRangeAll.clearNote();

  warns.forEach(w => {
    const cell = sheet.getRange(w.row, w.col);
    cell.setBackground(FIX_CONFIG.warnColor);
    cell.setNote('⚠️ ' + w.msg);
  });

  if (changed === 0 && warns.length === 0) { ui.alert('보정이 필요한 데이터가 없습니다.'); return; }

  const lines = [`✅ ${changed}개 값을 보정했습니다.`, ''];
  if (stats.velSpike) lines.push(`· 유속 급등 → 이웃 평균: ${stats.velSpike}개`);
  if (stats.levelSpike) lines.push(`· 수위 급등 → 이웃 평균: ${stats.levelSpike}개`);
  if (stats.zeroLevel) lines.push(`· 수위 0 이하인데 유속 있음: ${stats.zeroLevel}행`);
  if (stats.lowLevelHighVel) lines.push(`· 수위 낮은데 유속 과다: ${stats.lowLevelHighVel}행`);
  if (stats.tooShort) lines.push(`· 지속시간 부족(스파이크): ${stats.tooShort}구간`);
  if (stats.noLevelResponse) lines.push(`· 수위 반응 없음: ${stats.noLevelResponse}구간`);
  if (stats.noRiseFall) lines.push(`· 상승-하강 추세 없음: ${stats.noRiseFall}구간`);
  if (stats.suddenJump) lines.push(`· 0에서 급등: ${stats.suddenJump}구간`);

  if (warns.length > 0) {
    lines.push('', `⚠️ 수동 확인 필요 ${warns.length}건 (분홍색 셀, 메모 참고)`);
    warns.slice(0, 15).forEach(w => lines.push(`· ${w.row}행 ${w.kind}: ${w.msg}`));
    if (warns.length > 15) lines.push(`· … 외 ${warns.length - 15}건`);
  }

  ui.alert(lines.join('\n'));
}

/*******************************
 * 데이터 로드
 *******************************/
function loadWeatherData_(ss) {
  const sh = ss.getSheetByName(REPORT_CONFIG.weatherSheet);
  if (!sh) throw new Error(`'${REPORT_CONFIG.weatherSheet}' 시트가 없습니다.`);
  const lastRow = sh.getLastRow();
  if (lastRow < 2) return [];

  const vals = sh.getRange(1, 1, lastRow, REPORT_CONFIG.rainCol).getValues();
  const out = [];
  vals.forEach(r => {
    const t = parseDateCell_(r[0]);
    if (!t) return;
    out.push({ time: t, rain: toNum_(r[REPORT_CONFIG.rainCol - 1]) });
  });
  out.sort((a, b) => a.time - b.time);
  return out;
}

function loadRiverData_(ss) {
  const sh = ss.getSheetByName(REPORT_CONFIG.riverSheet);
  if (!sh) throw new Error(`'${REPORT_CONFIG.riverSheet}' 시트가 없습니다.`);
  const lastRow = sh.getLastRow();
  if (lastRow < 2) return [];

  const maxCol = Math.max(REPORT_CONFIG.levelCol, REPORT_CONFIG.velCol);
  const vals = sh.getRange(1, 1, lastRow, maxCol).getValues();
  const out = [];
  vals.forEach(r => {
    const t = parseDateCell_(r[0]);
    if (!t) return;
    out.push({
      time: roundTo10_(t),
      level: toNum_(r[REPORT_CONFIG.levelCol - 1]),
      vel: toNum_(r[REPORT_CONFIG.velCol - 1])
    });
  });
  out.sort((a, b) => a.time - b.time);
  return out;
}

/*******************************
 * 강우 이벤트 탐지
 *******************************/
function detectRainEvents_(weather) {
  const events = [];
  let run = [];

  const closeRun = () => {
    if (run.length === 0) return;
    const total = run.reduce((s, r) => s + r.rain, 0);
    if (total >= REPORT_CONFIG.eventMinTotal) {
      const startTime = new Date(run[0].time.getTime() - 3600000);
      const endTime = new Date(run[run.length - 1].time.getTime());
      events.push({
        rows: run.slice(),
        total: total,
        startTime: startTime,
        endTime: endTime,
        mainDate: pickMainDate_(run)
      });
    }
    run = [];
  };

  weather.forEach(w => {
    if (w.rain > 0) run.push(w);
    else closeRun();
  });
  closeRun();

  return events;
}

function pickMainDate_(run) {
  const counts = {};
  run.forEach(r => {
    const s = new Date(r.time.getTime() - 3600000);
    const key = `${s.getFullYear()}-${s.getMonth()}-${s.getDate()}`;
    if (!counts[key]) counts[key] = { date: s, n: 0 };
    counts[key].n++;
  });
  let best = null;
  Object.keys(counts).forEach(k => {
    if (!best || counts[k].n > best.n) best = counts[k];
  });
  return best.date;
}

/*******************************
 * 공통 유틸
 *******************************/
function parseDateCell_(v) {
  if (v instanceof Date && !isNaN(v)) return new Date(v.getTime());
  if (typeof v === 'string' && v.trim() !== '') {
    const s = v.trim().replace(/-/g, '/');
    const d = new Date(s);
    if (!isNaN(d)) return d;
  }
  return null;
}

function toNum_(v) {
  if (v === '' || v === null || v === undefined) return 0;
  const n = parseFloat(v);
  return isNaN(n) ? 0 : n;
}

function roundTo10_(d) {
  const base = new Date(d.getFullYear(), d.getMonth(), d.getDate(), d.getHours(), 0, 0, 0);
  const mins = d.getMinutes() + d.getSeconds() / 60;
  return new Date(base.getTime() + Math.round(mins / 10) * 10 * 60000);
}

function formatDateK_(d) {
  return `${d.getMonth() + 1}월 ${d.getDate()}일`;
}

function formatTime_(d, padHour) {
  const h = d.getHours();
  const m = ('0' + d.getMinutes()).slice(-2);
  return `${padHour ? ('0' + h).slice(-2) : h}:${m}`;
}

function formatDuration_(ms) {
  const total = Math.round(ms / 60000);
  const h = Math.floor(total / 60);
  const m = total % 60;
  if (h === 0) return `${m}분`;
  if (m === 0) return `${h}시간`;
  return `${h}시간 ${m}분`;
}

/*******************************
 * ① A열: 정시 행만 남기기
 *******************************/
function filterHourlyRows() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();

  if (lastRow < 2) { SpreadsheetApp.getUi().alert('데이터가 없습니다.'); return; }

  const allData = sheet.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();
  const filteredData = [];

  for (let i = 0; i < allData.length; i++) {
    const cellValue = allData[i][0].trim();
    const timeMatch = cellValue.match(/(\d{1,2}):(\d{2}):\d{2}$/);
    if (timeMatch && (timeMatch[2] === '00' || timeMatch[2] === '59')) {
      const row = allData[i].slice();
      let hour = parseInt(timeMatch[1], 10);
      if (timeMatch[2] === '59') hour = (hour + 1) % 24;
      row[0] = `${hour}시`;
      filteredData.push(row);
    }
  }

  if (filteredData.length === 0) { SpreadsheetApp.getUi().alert('정시 행이 없습니다.'); return; }

  sheet.getRange(2, 1, lastRow - 1, lastCol).clearContent();
  sheet.getRange(2, 1, filteredData.length, lastCol).setValues(filteredData);

  const emptyRowStart = filteredData.length + 2;
  if (emptyRowStart <= lastRow) sheet.deleteRows(emptyRowStart, lastRow - emptyRowStart + 1);

  SpreadsheetApp.getUi().alert(`✅ 정시 행 필터링 완료! (${filteredData.length}행 유지)`);
}

/*******************************
 * ② C열: 강우(상승-하강) 구간만 남기기
 *******************************/
function filterRainfallRange() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();

  if (lastRow < 2) { SpreadsheetApp.getUi().alert('데이터가 없습니다.'); return; }

  const allData = sheet.getRange(2, 1, lastRow - 1, lastCol).getDisplayValues();
  const cNums = allData.map(row => {
    const v = parseFloat(row[2]);
    return isNaN(v) ? 0 : v;
  });

  const segments = [];
  let inSegment = false;
  let segStart = -1;

  for (let i = 0; i < cNums.length; i++) {
    if (!inSegment && cNums[i] > 0) { inSegment = true; segStart = i; }
    else if (inSegment && cNums[i] <= 0) { segments.push({ start: segStart, end: i - 1 }); inSegment = false; }
  }
  if (inSegment) segments.push({ start: segStart, end: cNums.length - 1 });

  const MIN_PEAK = 0.05;

  const validSegments = segments.filter(seg => {
    const segValues = cNums.slice(seg.start, seg.end + 1);
    const peak = Math.max.apply(null, segValues);
    if (peak < MIN_PEAK) return false;

    let hasRise = false, hasFall = false;
    for (let i = 1; i < segValues.length; i++) {
      if (segValues[i] > segValues[i - 1]) hasRise = true;
      if (segValues[i] < segValues[i - 1]) hasFall = true;
    }
    return hasRise && hasFall;
  });

  if (validSegments.length === 0) {
    SpreadsheetApp.getUi().alert('ℹ️ 상승-하강 패턴(하천유출)을 보이는 구간이 없습니다.');
    return;
  }

  const keepSet = new Set();
  validSegments.forEach(seg => {
    for (let i = seg.start; i <= seg.end; i++) keepSet.add(i);
  });

  const filteredData = allData.filter((_, i) => keepSet.has(i));

  sheet.getRange(2, 1, lastRow - 1, lastCol).clearContent();
  sheet.getRange(2, 1, filteredData.length, lastCol).setValues(filteredData);

  const emptyRowStart = filteredData.length + 2;
  if (emptyRowStart <= lastRow) sheet.deleteRows(emptyRowStart, lastRow - emptyRowStart + 1);

  SpreadsheetApp.getUi().alert(`✅ 강우 구간(상승-하강 패턴) 필터링 완료!\n유효 구간 ${validSegments.length}개, ${filteredData.length}행 유지`);
}

function runAll() {
  filterHourlyRows();
  filterRainfallRange();
  SpreadsheetApp.getUi().alert('✅ 전체 처리 완료!');
}

/*******************************
 * ④ 10분 단위 데이터 정리
 *******************************/
function filterTenMinuteData() {
  const ui = SpreadsheetApp.getUi();
  const response = ui.alert(
    '10분 단위 데이터 정리',
    '분(MM)이 00, 10, 20, 30, 40, 50이 아닌 행을 모두 삭제합니다.\n계속 하시겠습니까?',
    ui.ButtonSet.OK_CANCEL
  );
  if (response !== ui.Button.OK) return;

  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();
  if (lastRow < 2) return;

  const allData = sheet.getRange(2, 1, lastRow - 1, lastCol).getValues();
  const allFormats = sheet.getRange(2, 1, lastRow - 1, lastCol).getFontColors();

  const keepData = [];
  const keepFormats = [];

  for (let i = 0; i < allData.length; i++) {
    const cellValue = allData[i][1];
    let minute = null;

    if (cellValue instanceof Date) {
      minute = cellValue.getMinutes();
    } else if (typeof cellValue === 'string' && cellValue.trim() !== '') {
      const match = cellValue.trim().match(/^\d{4}-\d{2}-\d{2} \d{2}:(\d{2}):\d{2}$/);
      if (match) minute = parseInt(match[1], 10);
    }

    if (minute !== null && minute % 10 === 0) {
      keepData.push(allData[i]);
      keepFormats.push(allFormats[i]);
    }
  }

  const deletedCount = allData.length - keepData.length;

  sheet.getRange(2, 1, lastRow - 1, lastCol).clearContent();
  sheet.getRange(2, 1, lastRow - 1, lastCol).setFontColor('#000000');

  if (keepData.length > 0) {
    sheet.getRange(2, 1, keepData.length, lastCol).setValues(keepData);
    sheet.getRange(2, 1, keepFormats.length, lastCol).setFontColors(keepFormats);
  }

  ui.alert(`✅ 정리 완료: ${deletedCount}개 행이 삭제되었습니다.`);
}