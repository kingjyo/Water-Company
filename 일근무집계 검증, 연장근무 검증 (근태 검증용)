// [2] 연장근무 검증
// ═════════════════════════════════════════════════════════════════════════
function verifyOvertimeReport() {
  const res = _collectOvertimeVerification();

  const lines = res.rows.map(r =>
    `${r.result}  ${r.label}\n   연장근무 시트 ${_fmt(r.base)}건 / 대상 ${_fmt(r.compare)}건` +
    (r.note ? `\n   ${r.note}` : "")
  );

  const okCount = res.rows.filter(r => r.result === R_OK).length;

  SpreadsheetApp.getUi().alert(
    `📊 연장근무 검증\n기준 월: ${res.month ? res.month + "월" : "확인 불가"}\n` +
    `연장근무 일수(D열 기준): ${res.baseCount}건\n` +
    `${okCount} / ${res.rows.length} 항목 일치\n\n` +
    lines.join("\n\n")
  );
}


function _collectOvertimeVerification() {
  const rows = [];

  // ── 기준값: 연장근무통합결과보고 계산용 D열 근무일 수 ──────────────────
  let baseCount = null, baseErr = "";
  try {
    baseCount = _countOvertimeDays();
  } catch (e) {
    baseErr = e.message;
  }

  // ── 기준 월 ────────────────────────────────────────────────────────────
  let month = null, monthErr = "";
  try {
    month = _getWorkStatusSheet().month;
  } catch (e) {
    monthErr = e.message;
  }

  // ── (1) 근태 정산내역 — 연장야근정산 "연" 개수 (이름 행 전체, 인원 자동) ──
  let settleNote = `연장야근정산 이름 행 × ${OTS_DAY_COL_START}:${OTS_DAY_COL_END} 中 "${OT_SETTLE_TOKENS.join(", ")}"`;
  rows.push(_compareCount(
    "근태 정산내역 검증",
    baseCount, baseErr,
    () => {
      const att = SpreadsheetApp.openById(SS_ID_ATTENDANCE);
      const sh  = att.getSheetByName(OT_SETTLE_SHEET);
      if (!sh) throw new Error(`"${OT_SETTLE_SHEET}" 시트 없음`);

      const t = _readOtSettleTable(sh);
      if (t.count === 0) throw new Error(`"${OT_SETTLE_SHEET}" ${OTS_NAME_COL}${OTS_NAME_START_ROW}부터 이름 없음`);

      let n = 0;
      t.marks.forEach(r => r.forEach(v => {
        if (OT_SETTLE_TOKENS.indexOf(String(v).trim()) !== -1) n++;
      }));
      settleNote = `연장야근정산 ${OTS_DAY_COL_START}${t.startRow}:${OTS_DAY_COL_END}${t.startRow + t.count - 1} ` +
                   `(${t.names.length}명) 中 "${OT_SETTLE_TOKENS.join(", ")}"`;
      return n;
    },
    null
  ));
  rows[rows.length - 1].note = rows[rows.length - 1].note || settleNote;

  // ── (2) 근무계획 — 근무기호 개수 (행 수는 "계" 직전까지 자동) ──────────
  let planNote = "G5:AK?? 中 P / B / L (교육 병기 포함)";
  rows.push(_compareCount(
    "근무계획 검증",
    baseCount, baseErr,
    () => {
      if (!month) throw new Error(monthErr || "기준 월 확인 불가");

      const plan = SpreadsheetApp.openById(SS_ID_WORK_PLAN);
      const sh = _findSheetByPatterns(plan, [`${month}월`],
        new RegExp(`(^|[^0-9])${month}\\s*월`));
      if (!sh) throw new Error(`"${month}월" 시트 없음`);

      const nameRows = _readPlanNameRows(sh);
      if (nameRows.count === 0) throw new Error(`"${sh.getName()}" 시트에서 이름 행을 찾지 못했습니다`);

      const numCols = PLAN_MARK_COL_END - PLAN_MARK_COL_START + 1;
      const vals = _readBlock(sh, nameRows.startRow, PLAN_MARK_COL_START, nameRows.count, numCols);
      let n = 0;
      vals.forEach(r => r.forEach(v => {
        const s = String(v).toUpperCase().replace(/\s+/g, "");
        if (s && PLAN_MARK_REGEX.test(s)) n++;
      }));
      planNote = `G${nameRows.startRow}:AK${nameRows.startRow + nameRows.count - 1} ` +
                 `(${nameRows.count}명) 中 P / B / L (교육 병기 포함)`;
      return n;
    },
    null
  ));
  rows[rows.length - 1].note = rows[rows.length - 1].note || planNote;

  // ── (3) 교통비 지급 정산서 — 제품생산 시트 (행 범위 자동) ───────────────
  let transportNote = `제품생산 ${TRANSPORT_COL_WORK}${TRANSPORT_DATA_START_ROW}~ (셀 단위 1회 카운트)`;
  rows.push(_compareCount(
    "교통비 지급 정산서 검증",
    baseCount, baseErr,
    () => {
      const tr = SpreadsheetApp.openById(SS_ID_TRANSPORT);
      const sh = tr.getSheetByName(SHEET_TRANSPORT_PRODUCT);
      if (!sh) throw new Error(`"${SHEET_TRANSPORT_PRODUCT}" 시트 없음`);

      const nameCol = columnLetterToIndex(TRANSPORT_COL_NAME);
      const workCol = columnLetterToIndex(TRANSPORT_COL_WORK);
      const lastRow = Math.min(sh.getLastRow(), TRANSPORT_DATA_START_ROW + TRANSPORT_SCAN_MAX);
      if (lastRow < TRANSPORT_DATA_START_ROW) return 0;

      const vals = _readBlock(sh, TRANSPORT_DATA_START_ROW, 1,
                              lastRow - TRANSPORT_DATA_START_ROW + 1, Math.max(nameCol, workCol));
      let n = 0, endRow = TRANSPORT_DATA_START_ROW - 1;
      for (let i = 0; i < vals.length; i++) {
        if (_lvIsTotalLabel(vals[i][nameCol - 1])) break;   // A열 "합계" → 표 끝
        endRow = TRANSPORT_DATA_START_ROW + i;
        const s = String(vals[i][workCol - 1] == null ? "" : vals[i][workCol - 1]).replace(/\s+/g, " ").trim();
        if (!s) continue;
        // 키워드가 여러 개 걸려도 셀 단위로 1회만 카운트
        if (TRANSPORT_KEYWORDS.some(k => s.indexOf(k.replace(/\s+/g, " ")) !== -1)) n++;
      }
      transportNote = `제품생산 ${TRANSPORT_COL_WORK}${TRANSPORT_DATA_START_ROW}:${TRANSPORT_COL_WORK}${endRow} (셀 단위 1회 카운트)`;
      return n;
    },
    null
  ));
  rows[rows.length - 1].note = rows[rows.length - 1].note || transportNote;

  return { rows: rows, month: month, baseCount: baseCount };
}


// ─── 연장근무 D열 근무일 수 (첫 공란에서 중단) ───────────────────────────
function _countOvertimeDays() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_OVERTIME);
  if (!sheet) throw new Error(`"${SHEET_OVERTIME}" 시트 없음`);

  const lastRow = sheet.getLastRow();
  if (lastRow < DATA_START_ROW) return 0;

  const vals = sheet.getRange(DATA_START_ROW, COL_WORK_DATE,
                              lastRow - DATA_START_ROW + 1, 1).getValues();
  let count = 0;
  for (let i = 0; i < vals.length; i++) {
    const v = vals[i][0];
    if (v === "" || v === null || v === undefined || String(v).trim() === "") break;
    count++;
  }
  Logger.log(`연장근무 D열 근무일 수: ${count}건`);
  return count;
}


// ─── 카운트 비교 한 줄 생성 ──────────────────────────────────────────────
function _compareCount(label, baseCount, baseErr, counterFn, note) {
  if (baseCount === null) {
    return _row(label, "", "", R_NA, baseErr);
  }
  try {
    const n = counterFn();
    return _row(label, baseCount, n, baseCount === n ? R_OK : R_FAIL, note);
  } catch (e) {
    return _row(label, baseCount, "", R_NA, e.message);
  }
}


