/**
 * 검증 모듈 (검증.gs)
 * - 식수 검증 : 일근무집계 ↔ X월 근무현황표를 "이름"으로 매칭해 조·중·석·야식 대조
 *               (인원이 늘거나 줄어도 자동 대응, 석식은 현황표의 석식+연장식과 비교)
 *               → "식수 검증" 시트 (비고란은 재실행해도 유지)
 * - 연장근무 검증 : 3개 소스 대조 → "검증 결과" 시트
 * - 전체 검증 : 식수 + 휴가(휴가검증.gs) + CIP(CIP검증.gs) + 연장근무를 한 번에 → "검증 결과" 요약 시트
 *
 * ※ Code.gs의 상수·헬퍼(SS_ID_*, SHEET_*, _getWorkStatusSheet, _findSheetByPatterns,
 *    _readBlock, columnLetterToIndex)와 일근무관리검증.gs의 _readPlanNameRows를 재사용합니다.
 * ※ _getWorkStatusSheet()는 Code.gs에만 있어야 합니다 (이 파일에서는 제거됨).
 */

// ─── 교통비 지급 정산서 ──────────────────────────────────────────────────
const SS_ID_TRANSPORT = "16z8tsSrWuu7rd1ViJUIAU9odqCQJrUSiImCBENLfek8";
const SHEET_TRANSPORT_PRODUCT = "제품생산";

// ─── 결과 시트명 ─────────────────────────────────────────────────────────
const SHEET_VERIFY_RESULT = "검증 결과";
const SHEET_MEAL_VERIFY   = "식수 검증";


// ═════════════════════════════════════════════════════════════════════════
// 식수 검증 설정
// ═════════════════════════════════════════════════════════════════════════
// 일근무집계 (정리 완료 후 기준) — C2부터 이름, C열 첫 공란 직전까지가 인원
const DW_DATA_START_ROW = 2;
const DW_COL_NAME       = "C";

// X월 근무현황표 (근태 정산내역) — B8부터 이름, A열에 "합  계"가 나오면 그 전 행까지
// ※ 이름이 "김 재 방"처럼 글자 사이에 공백이 있으므로 공백 제거 후 비교
const WS_NAME_START_ROW = 8;
const WS_COL_NAME       = "B";
const WS_COL_STOP       = "A";
const WS_STOP_LABEL     = "합계";   // 공백 제거 후 포함 여부로 판정
const WS_SCAN_MAX       = 300;      // 안전 상한 (행)

// 식사별 열 매핑 — wsCols가 여러 개면 합산 (석식 = 석식 + 연장식)
const MEAL_ITEMS = [
  { label: "조식", dwCol: "D", wsCols: ["BB"] },
  { label: "중식", dwCol: "E", wsCols: ["BC"] },
  { label: "석식", dwCol: "F", wsCols: ["BD", "BG"], wsLabel: "석식+연장식" },
  { label: "야식", dwCol: "G", wsCols: ["BE"] }
];

// 결과 시트 열 구성: 이름 | (집계·현황표·차이) × 식사 수 | 결과 | 비고
const MEAL_RESULT_COL = 2 + 3 * MEAL_ITEMS.length;   // 14
const MEAL_NOTE_COL   = MEAL_RESULT_COL + 1;         // 15
const MEAL_NCOL       = MEAL_NOTE_COL;


// ═════════════════════════════════════════════════════════════════════════
// 연장근무 검증 설정
// ═════════════════════════════════════════════════════════════════════════
// 연장야근정산 (근태 정산내역) — 행 범위는 고정하지 않고 B8부터 A열 "합계" 직전까지의
// 이름 행 전체 (CIP검증.gs의 _readOtSettleTable 재사용 → 인원 변동 자동 대응)
const OT_SETTLE_SHEET  = "연장야근정산";
const OT_SETTLE_TOKENS = ["연"];   // 정확 일치로 카운트

// 근무계획 근무기호 범위 — 행 수는 고정하지 않고 C5부터 A열 "계" 직전까지
// (일근무관리검증.gs의 _readPlanNameRows 재사용 → 인원 변동 자동 대응)
const PLAN_MARK_COL_START = 7;    // G
const PLAN_MARK_COL_END   = 37;   // AK
// 공백 제거·대문자 변환 후 정확 일치할 때만 카운트
const PLAN_MARK_REGEX = /^(?:(?:P|B|L)(?:\/교)?|교\/(?:P|B|L))$/;

// 교통비 제품생산 — 5행부터 A열 "합계" 직전(또는 마지막 행)까지, E열(E:F 병합) 업무내용
const TRANSPORT_DATA_START_ROW = 5;
const TRANSPORT_COL_NAME = "A";
const TRANSPORT_COL_WORK = "E";
const TRANSPORT_SCAN_MAX = 500;
// 셀 단위 카운트 — 아래 중 하나라도 포함하면 1회
const TRANSPORT_KEYWORDS = ["제품 생산", "생산", "BTL 생산", "정비", "정비 연장"];

// 연장근무 시트 근무일 열
const COL_WORK_DATE = 4;   // D열

// ─── 결과 라벨 ───────────────────────────────────────────────────────────
const R_OK   = "✅ 일치";
const R_FAIL = "❌ 불일치";
const R_NA   = "⚠️ 확인불가";


// ═════════════════════════════════════════════════════════════════════════
// [1] 식수 검증 — 일근무집계 ↔ X월 근무현황표
// ═════════════════════════════════════════════════════════════════════════
function verifyDailyWorkSheet() {
  const ui  = SpreadsheetApp.getUi();
  const res = _collectMealVerification();
  const sheet = _buildMealReport(res);
  SpreadsheetApp.getActiveSpreadsheet().setActiveSheet(sheet);

  if (res.error) {
    ui.alert(`⚠️ 식수 검증 실패\n\n${res.error}`);
    return;
  }

  const s = _mealStats(res);
  let msg =
    `📊 식수 검증 완료\n\n` +
    `기준 월: ${res.month}월 / 근무현황표 "${res.statusSheet}"\n` +
    `일근무집계 ${res.people.length}명 ↔ 현황표 ${res.statusCount}명\n\n` +
    `${R_OK} ${s.ok}명\n${R_FAIL} ${s.bad}명\n⚠️ 현황표에 이름 없음 ${s.unmatched}명`;
  if (res.onlyInStatus.length > 0) {
    msg += `\n⚠️ 현황표에만 있는 이름 ${res.onlyInStatus.length}명 (${res.onlyInStatus.map(p => p.name).join(", ")})`;
  }
  msg += `\n\n자세한 내용은 "${SHEET_MEAL_VERIFY}" 시트를 확인하세요.`;
  ui.alert(msg);
}


function _mealStats(res) {
  const ok        = res.people.filter(p => p.matched && p.mismatch === 0).length;
  const bad       = res.people.filter(p => p.matched && p.mismatch > 0).length;
  const unmatched = res.people.filter(p => !p.matched).length;
  return { ok: ok, bad: bad, unmatched: unmatched };
}


// ─── 데이터 수집 ─────────────────────────────────────────────────────────
function _collectMealVerification() {
  const ss  = SpreadsheetApp.getActiveSpreadsheet();
  const res = { month: null, statusSheet: null, statusCount: 0, error: null,
                people: [], onlyInStatus: [], totals: [] };

  const daily = ss.getSheetByName(SHEET_DAILY);
  if (!daily) { res.error = `"${SHEET_DAILY}" 시트 없음`; return res; }

  let status;
  try {
    const f = _getWorkStatusSheet();
    status = f.sheet;
    res.month = f.month;
    res.statusSheet = status.getName();
  } catch (e) {
    res.error = e.message;
    return res;
  }

  const dwRows = _readDailyMealRows(daily);
  if (dwRows.length === 0) {
    res.error = `"${SHEET_DAILY}" 시트 ${DW_COL_NAME}${DW_DATA_START_ROW}부터 이름이 없습니다 (정리를 먼저 실행했는지 확인)`;
    return res;
  }

  const wsRows = _readStatusMealRows(status);
  res.statusCount = wsRows.length;
  if (wsRows.length === 0) {
    res.error = `"${res.statusSheet}" 시트 ${WS_COL_NAME}${WS_NAME_START_ROW}부터 이름이 없습니다`;
    return res;
  }

  // 이름(공백 제거) → 현황표 행  (중복 이름이면 첫 행 사용)
  const wsMap = {};
  wsRows.forEach(w => { if (!(w.key in wsMap)) wsMap[w.key] = w; });
  const used = {};

  dwRows.forEach(d => {
    const w = wsMap[d.key] || null;
    if (w) used[d.key] = true;

    const p = { name: d.name, key: d.key, dwRow: d.row,
                wsRow: w ? w.row : null, matched: !!w, mismatch: 0, meals: [] };

    MEAL_ITEMS.forEach((m, i) => {
      const base = d.meals[i];
      const cmp  = w ? w.meals[i] : null;
      const diff = w ? base - cmp : null;
      if (w && diff !== 0) p.mismatch++;
      p.meals.push({ label: m.label, base: base, compare: cmp, diff: diff });
    });
    res.people.push(p);
  });

  res.onlyInStatus = wsRows.filter(w => !used[w.key]);

  // 합계: 집계 전체 ↔ 현황표 전체 (매칭 여부와 무관하게 시트 전체 합)
  res.totals = MEAL_ITEMS.map((m, i) => {
    let b = 0, c = 0;
    dwRows.forEach(d => { b += d.meals[i]; });
    wsRows.forEach(w => { c += w.meals[i]; });
    return { label: m.label, base: b, compare: c, diff: b - c,
             note: `집계 ${m.dwCol}열 합 ↔ 현황표 ${m.wsCols.join("+")}열 합` };
  });

  Logger.log(`식수 검증: 집계 ${dwRows.length}명 / 현황표 ${wsRows.length}명 / ` +
             `현황표에만 ${res.onlyInStatus.length}명`);
  return res;
}


// ─── 일근무집계: C2부터 첫 공란 직전까지 ─────────────────────────────────
function _readDailyMealRows(sheet) {
  const lastRow = sheet.getLastRow();
  if (lastRow < DW_DATA_START_ROW) return [];

  const nameCol  = columnLetterToIndex(DW_COL_NAME);
  const mealCols = MEAL_ITEMS.map(m => columnLetterToIndex(m.dwCol));
  const maxCol   = Math.max(nameCol, Math.max.apply(null, mealCols));

  const vals = _readBlock(sheet, DW_DATA_START_ROW, 1, lastRow - DW_DATA_START_ROW + 1, maxCol);
  const rows = [];
  for (let i = 0; i < vals.length; i++) {
    const raw = vals[i][nameCol - 1];
    const key = _normName(raw);
    if (!key) break;   // 첫 공란 = 합계 행 → 종료
    rows.push({
      row: DW_DATA_START_ROW + i,
      name: String(raw).trim(),
      key: key,
      meals: mealCols.map(c => _num(vals[i][c - 1]))
    });
  }
  return rows;
}


// ─── 근무현황표: B8부터 A열 "합  계" 직전까지 ────────────────────────────
function _readStatusMealRows(sheet) {
  const lastRow = Math.min(sheet.getLastRow(), WS_NAME_START_ROW + WS_SCAN_MAX);
  if (lastRow < WS_NAME_START_ROW) return [];

  const nameCol = columnLetterToIndex(WS_COL_NAME);
  const stopCol = columnLetterToIndex(WS_COL_STOP);
  const mealColSets = MEAL_ITEMS.map(m => m.wsCols.map(columnLetterToIndex));
  const allCols = mealColSets.reduce((acc, set) => acc.concat(set), [nameCol, stopCol]);
  const maxCol  = Math.max.apply(null, allCols);

  const vals = _readBlock(sheet, WS_NAME_START_ROW, 1, lastRow - WS_NAME_START_ROW + 1, maxCol);
  const rows = [];
  for (let i = 0; i < vals.length; i++) {
    const stop = _normName(vals[i][stopCol - 1]);
    if (stop.indexOf(WS_STOP_LABEL) !== -1) break;   // "합  계" 행 → 종료

    const raw = vals[i][nameCol - 1];
    const key = _normName(raw);
    if (!key) continue;   // 이름 없는 행은 건너뜀

    rows.push({
      row: WS_NAME_START_ROW + i,
      name: String(raw).replace(/\s+/g, " ").trim(),
      key: key,
      meals: mealColSets.map(set => set.reduce((s, c) => s + _num(vals[i][c - 1]), 0))
    });
  }
  return rows;
}


// 이름 비교용 정규화: 모든 공백(전각 공백 포함) 제거
function _normName(v) {
  return String(v == null ? "" : v).replace(/[\s\u3000]+/g, "");
}


// ─── 기존 비고 읽기 (재실행 시 보존) ─────────────────────────────────────
function _readExistingNotes(sheet) {
  const notes = {};
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();
  if (lastRow < 1 || lastCol < MEAL_NOTE_COL) return notes;

  const vals = sheet.getRange(1, 1, lastRow, MEAL_NOTE_COL).getValues();
  vals.forEach(r => {
    const key  = _normName(r[0]);
    const note = String(r[MEAL_NOTE_COL - 1] == null ? "" : r[MEAL_NOTE_COL - 1]).trim();
    if (key && note && key !== "이름") notes[key] = note;
  });
  return notes;
}


// ─── 결과 시트 작성 ──────────────────────────────────────────────────────
function _buildMealReport(res) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(SHEET_MEAL_VERIFY);

  const notes = sheet ? _readExistingNotes(sheet) : {};

  if (!sheet) {
    sheet = ss.insertSheet(SHEET_MEAL_VERIFY);
  } else {
    sheet.getRange(1, 1, sheet.getMaxRows(), sheet.getMaxColumns()).breakApart();
    sheet.clear();
    sheet.setFrozenRows(0);
    sheet.setFrozenColumns(0);
  }

  const stamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd HH:mm");
  const data = [];
  const meta = [];
  const push  = (row, type) => { data.push(row); meta.push(type); };
  const blankRow = () => new Array(MEAL_NCOL).fill("");
  const line = (text, type) => { const r = blankRow(); r[0] = text; push(r, type); };

  line("식수 검증 결과 (일근무집계 ↔ X월 근무현황표)", "title");

  if (res.error) {
    line(`실행 ${stamp}`, "sub");
    line(`⚠️ ${res.error}`, "summary");
    sheet.getRange(1, 1, data.length, MEAL_NCOL).setValues(data);
    _styleMealReport(sheet, data, meta, 0);
    return sheet;
  }

  const s = _mealStats(res);
  line(`기준 ${res.month}월 · 근무현황표 "${res.statusSheet}" · ` +
       `일근무집계 ${res.people.length}명 ↔ 현황표 ${res.statusCount}명 · 실행 ${stamp}`, "sub");

  let summary = `${R_OK} ${s.ok}명 · ${R_FAIL} ${s.bad}명 · ⚠️ 현황표에 이름 없음 ${s.unmatched}명`;
  if (res.onlyInStatus.length > 0) summary += ` · ⚠️ 현황표에만 있는 이름 ${res.onlyInStatus.length}명`;
  line(summary, (s.bad + s.unmatched + res.onlyInStatus.length) === 0 ? "ok" : "summary");
  line("석식은 현황표의 석식 + 연장식 합계와 비교합니다. 차이 사유는 맨 오른쪽 '비고'에 적어 두면 재실행해도 유지됩니다.", "note");
  push(blankRow(), "blank");

  // ── 그룹 헤더 + 소헤더 ───────────────────────────────────────────────
  const g = blankRow(); g[0] = "이름";
  const h = blankRow(); h[0] = "이름";
  MEAL_ITEMS.forEach((m, i) => {
    const c = 2 + 3 * i;
    g[c - 1] = m.wsLabel ? `${m.label} (현황표 = ${m.wsLabel})` : m.label;
    h[c - 1] = "집계";
    h[c]     = "현황표";
    h[c + 1] = "차이";
  });
  g[MEAL_RESULT_COL - 1] = "결과"; g[MEAL_NOTE_COL - 1] = "비고";
  h[MEAL_RESULT_COL - 1] = "결과"; h[MEAL_NOTE_COL - 1] = "비고";
  push(g, "ghead");
  push(h, "head");
  const headRow = data.length;

  // ── 인원별 행 ────────────────────────────────────────────────────────
  res.people.forEach(p => {
    const r = blankRow();
    r[0] = p.name;
    p.meals.forEach((m, i) => {
      const c = 2 + 3 * i;
      r[c - 1] = m.base;
      r[c]     = p.matched ? m.compare : "";
      r[c + 1] = p.matched ? m.diff : "";
    });
    let type, label;
    if (!p.matched)            { type = "na";   label = "⚠️ 현황표에 이름 없음"; }
    else if (p.mismatch === 0) { type = "ok";   label = R_OK; }
    else                       { type = "fail"; label = `${R_FAIL} ${p.mismatch}건`; }
    r[MEAL_RESULT_COL - 1] = label;
    r[MEAL_NOTE_COL - 1]   = notes[p.key] || "";
    push(r, "data:" + type);
  });

  // ── 합계 행 ──────────────────────────────────────────────────────────
  const t = blankRow();
  t[0] = "합계";
  let totalBad = 0;
  res.totals.forEach((m, i) => {
    const c = 2 + 3 * i;
    t[c - 1] = m.base; t[c] = m.compare; t[c + 1] = m.diff;
    if (m.diff !== 0) totalBad++;
  });
  t[MEAL_RESULT_COL - 1] = totalBad === 0 ? R_OK : `${R_FAIL} ${totalBad}건`;
  t[MEAL_NOTE_COL - 1]   = notes["합계"] || "";
  push(t, "total:" + (totalBad === 0 ? "ok" : "fail"));

  // ── 현황표에만 있는 이름 ─────────────────────────────────────────────
  if (res.onlyInStatus.length > 0) {
    push(blankRow(), "blank");
    line(`근무현황표에만 있는 이름 (일근무집계에 없음) — ${res.onlyInStatus.length}명`, "section");
    res.onlyInStatus.forEach(w => {
      const r = blankRow();
      r[0] = w.name;
      w.meals.forEach((v, i) => { r[2 + 3 * i] = v; });   // 현황표 칸에만 표시
      r[MEAL_RESULT_COL - 1] = "⚠️ 집계에 이름 없음";
      r[MEAL_NOTE_COL - 1]   = notes[w.key] || "";
      push(r, "data:na");
    });
  }

  sheet.getRange(1, 1, data.length, MEAL_NCOL).setValues(data);
  _styleMealReport(sheet, data, meta, headRow);
  return sheet;
}


// ─── 식수 검증 시트 서식 ─────────────────────────────────────────────────
function _styleMealReport(sheet, data, meta, headRow) {
  const N = MEAL_NCOL;

  sheet.setColumnWidth(1, 90);
  for (let i = 0; i < MEAL_ITEMS.length; i++) {
    const c = 2 + 3 * i;
    sheet.setColumnWidth(c, 62);
    sheet.setColumnWidth(c + 1, 70);
    sheet.setColumnWidth(c + 2, 62);
  }
  sheet.setColumnWidth(MEAL_RESULT_COL, 170);
  sheet.setColumnWidth(MEAL_NOTE_COL, 320);

  sheet.getRange(1, 1, data.length, N)
    .setFontFamily("Noto Sans KR")
    .setVerticalAlignment("middle");

  const BG = { ok: "#eaf5ea", fail: "#fdeaea", na: "#fff6e5" };
  const FC = { ok: "#1e6b34", fail: "#a61b1b", na: "#8a6100" };

  meta.forEach((type, i) => {
    const r = i + 1;
    const full = sheet.getRange(r, 1, 1, N);

    if (type === "title") {
      full.merge().setValue(data[i][0])
        .setFontSize(16).setFontWeight("bold")
        .setFontColor("#ffffff").setBackground("#1f3864")
        .setHorizontalAlignment("center");
      sheet.setRowHeight(r, 40);

    } else if (type === "sub") {
      full.merge().setValue(data[i][0])
        .setFontSize(10).setFontColor("#ffffff").setBackground("#2e5496")
        .setHorizontalAlignment("center");
      sheet.setRowHeight(r, 26);

    } else if (type === "summary" || type === "ok") {
      full.merge().setValue(data[i][0])
        .setFontSize(11).setFontWeight("bold")
        .setBackground(type === "ok" ? BG.ok : BG.fail)
        .setFontColor(type === "ok" ? FC.ok : FC.fail)
        .setHorizontalAlignment("center");
      sheet.setRowHeight(r, 30);

    } else if (type === "note") {
      full.merge().setValue(data[i][0])
        .setFontSize(9).setFontColor("#666666").setFontStyle("italic")
        .setBackground("#f7f9fc").setHorizontalAlignment("center");
      sheet.setRowHeight(r, 22);

    } else if (type === "section") {
      full.merge().setValue(data[i][0])
        .setFontSize(11).setFontWeight("bold")
        .setFontColor("#ffffff").setBackground("#4472c4")
        .setHorizontalAlignment("left");
      sheet.setRowHeight(r, 28);

    } else if (type === "ghead") {
      full.setFontWeight("bold").setBackground("#c5d3ea")
        .setHorizontalAlignment("center")
        .setBorder(true, true, true, true, true, true, "#8ea9db", SpreadsheetApp.BorderStyle.SOLID);
      // 식사별 3칸 병합
      for (let k = 0; k < MEAL_ITEMS.length; k++) {
        sheet.getRange(r, 2 + 3 * k, 1, 3).merge();
      }
      sheet.setRowHeight(r, 26);

    } else if (type === "head") {
      full.setFontWeight("bold").setBackground("#d9e1f2")
        .setHorizontalAlignment("center")
        .setBorder(true, true, true, true, true, true, "#8ea9db", SpreadsheetApp.BorderStyle.SOLID);
      sheet.setRowHeight(r, 26);

    } else if (type.indexOf("data:") === 0 || type.indexOf("total:") === 0) {
      const isTotal = type.indexOf("total:") === 0;
      const kind = type.split(":")[1];
      full.setBackground(BG[kind])
        .setBorder(true, true, true, true, true, true, "#c9d4e8", SpreadsheetApp.BorderStyle.SOLID);
      sheet.getRange(r, 1, 1, N - 1).setHorizontalAlignment("center");
      sheet.getRange(r, MEAL_RESULT_COL).setFontWeight("bold").setFontColor(FC[kind]);

      // 차이가 0이 아닌 칸 강조
      for (let k = 0; k < MEAL_ITEMS.length; k++) {
        const diffCol = 4 + 3 * k;
        const v = data[i][diffCol - 1];
        if (typeof v === "number" && v !== 0) {
          sheet.getRange(r, diffCol).setFontWeight("bold").setFontColor("#a61b1b").setBackground("#f9d0d0");
        }
      }

      // 비고란: 입력 가능 표시 (연노랑 · 왼쪽 정렬 · 줄바꿈)
      sheet.getRange(r, MEAL_NOTE_COL)
        .setBackground("#fffbe6").setHorizontalAlignment("left")
        .setFontColor("#333333").setFontWeight("normal").setWrap(true);

      if (isTotal) {
        sheet.getRange(r, 1, 1, N).setFontWeight("bold");
        sheet.getRange(r, MEAL_NOTE_COL).setFontWeight("normal");
        sheet.setRowHeight(r, 28);
      } else {
        sheet.setRowHeight(r, 24);
      }

    } else {
      sheet.setRowHeight(r, 10);
    }
  });

  // ※ 열 고정은 하지 않음 — 제목 행이 전체 열에 걸쳐 병합돼 있어 열 고정 시 예외 발생
  if (headRow > 0) sheet.setFrozenRows(headRow);
  sheet.setHiddenGridlines(true);
}


// 전체 검증 결과 시트용 요약 행
function _mealSummaryRows(res) {
  if (res.error) return [_row("식수 검증", "", "", R_NA, res.error)];

  const rows = res.totals.map(t =>
    _row(`${t.label} 합계`, t.base, t.compare, t.diff === 0 ? R_OK : R_FAIL, t.note)
  );

  const s = _mealStats(res);
  const matched = res.people.length - s.unmatched;
  const nameOk  = s.unmatched === 0 && res.onlyInStatus.length === 0;
  rows.push(_row("이름 매칭", matched, res.people.length, nameOk ? R_OK : R_FAIL,
    nameOk ? "집계·현황표 이름 모두 일치"
           : `현황표에 없음 ${s.unmatched}명 / 현황표에만 있음 ${res.onlyInStatus.length}명`));
  rows.push(_row("개인별 불일치 인원", s.bad, 0, s.bad === 0 ? R_OK : R_FAIL,
    `개인별 상세는 "${SHEET_MEAL_VERIFY}" 시트`));
  return rows;
}


