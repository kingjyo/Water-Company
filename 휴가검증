// [D] 미리보기 — 휴가관리 열 매핑 확인 (실제 변경 없음)
// ═════════════════════════════════════════════════════════════════════════
function previewLeaveColumns() {
  const ui = SpreadsheetApp.getUi();
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_LEAVE);
  if (!sheet) { ui.alert(`"${SHEET_LEAVE}" 시트를 찾을 수 없습니다.`); return; }

  const cols = _leaveSystemColumns(sheet);
  const headers = _leaveHeaders(sheet);
  Logger.log("─── 휴가관리 헤더 ───");
  headers.forEach(h => Logger.log(h));

  const fmt = c => c ? `${_lvColLetter(c)}열` : "❌ 못 찾음";
  let msg =
    `🔍 휴가관리 열 매핑\n\n` +
    `• 휴가구분: ${fmt(cols.type)}\n` +
    `• 이름: ${fmt(cols.name)}\n` +
    `• 잔여: ${fmt(cols.remain)}\n\n` +
    `헤더: ${headers.join(" | ")}`;

  if (cols.type && cols.name && cols.remain) {
    try {
      const sys = _readLeaveSystem(sheet);
      const sample = sys.list.slice(0, 5).map(p => {
        const e = sys.map[p.key];
        const parts = LV_GROUPS.map(g => e.rows[g.key] ? `${g.label} ${e.rows[g.key].sum}` : null).filter(Boolean);
        return `${p.name}: ${parts.join(", ") || "-"}`;
      });
      msg += `\n\n읽은 인원 ${sys.list.length}명 (앞 5명)\n${sample.join("\n")}`;
      if (sys.skipped.length > 0) msg += `\n\n제외 ${sys.skipped.length}건: ${sys.skipped.slice(0, 5).join(", ")}`;
      Logger.log(`읽은 인원: ${sys.list.map(p => p.name).join(", ")}`);
    } catch (e) {
      msg += `\n\n⚠️ ${e.message}`;
    }
  }
  ui.alert(msg);
}


