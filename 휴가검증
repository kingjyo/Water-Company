function _lvNum(v) {
  if (typeof v === "number") return v;
  const s = String(v == null ? "" : v).replace(/,/g, "").trim();
  if (!s) return 0;
  const n = parseFloat(s);
  return isNaN(n) ? 0 : n;
}


function _lvFmtVal(v) {
  if (v === undefined || v === null) return "-";
  return v;
}


function _lvIsTotalLabel(v) {
  const s = _normName(v);
  return s === "계" || s === "총계" || s.indexOf("합계") !== -1;
}


function _lvColLetter(index) {
  let letter = "", n = index;
  while (n > 0) {
    const rem = (n - 1) % 26;
    letter = String.fromCharCode(65 + rem) + letter;
    n = Math.floor((n - 1) / 26);
  }
  return letter;
}
