/**
 * ════════════════════════════════════════════════════════════════════
 *  자동생성.gs — 인원파악표 매일 자동 생성 + 공유용 '📌 오늘 인원파악' 시트
 * ────────────────────────────────────────────────────────────────────
 *  [붙여넣는 곳]  '식수인원파악' 스프레드시트 → 확장 프로그램 → Apps Script
 *                 → 파일 옆 [+] → 스크립트 → 이름 '자동생성'
 *  [기존 코드에서 할 일]
 *                 기존 onOpen() 함수(39~49행, function onOpen() { ... } 전체)를 지우기
 *                 → 이 파일에 새 onOpen 이 들어 있음 (onOpen 이 두 개면 안 됨)
 *                 ※ runDailyReport, runTestByDate, _runReport 등 나머지는 그대로 둠
 * ════════════════════════════════════════════════════════════════════
 */

const AUTO_OWNER_EMAIL = "youngjoonkim@kas.co.kr"; // 메뉴가 보일 사람 (기존 onOpen 의 me 와 동일)
const AUTO_HANDLER = "autoDailyReport";             // 트리거가 부를 함수
const AUTO_TZ = "Asia/Seoul";
const AUTO_DEFAULT_HOUR = 6;                         // 비워 두고 켜면 6시대(6:00~6:59)에 실행
const AUTO_PROP_HOUR = "AUTO_REPORT_HOUR";
const PIN_SHEET_NAME = "📌 오늘 인원파악";           // 공유용 고정 시트 (주소가 매일 같음)


// ============================================================
// 메뉴 (기존 onOpen 대체)
// ============================================================
function onOpen() {
  const user = Session.getActiveUser().getEmail();
  if (user !== AUTO_OWNER_EMAIL) return; // 다른 사람에게는 메뉴 안 보임

  const ui = SpreadsheetApp.getUi();
  ui.createMenu("🏭 인원파악")
    .addItem("📋 오늘 파악표 생성", "createTodayReport")
    .addItem("🔄 오늘 파악표 다시 만들기 (근무계획 바뀌었을 때)", "recreateTodayReport")
    .addItem("🔍 날짜 지정 테스트", "runTestByDate")
    .addSeparator()
    .addSubMenu(ui.createMenu("⏰ 매일 자동 생성")
      .addItem("▶ 켜기 / 시각 바꾸기", "autoTriggerOn")
      .addItem("⏹ 끄기", "autoTriggerOff")
      .addItem("ℹ️ 상태 보기", "autoTriggerStatus"))
    .addItem("🔗 공유용 링크 보기", "showShareLink")
    .addToUi();
}


// ============================================================
// 트리거가 매일 부르는 함수
// ============================================================
function autoDailyReport() {
  const res = _generateToday_();
  if (!res.ok) _notifyOwner_("⚠️ 인원파악표 자동 생성 실패", res.msg);
}


// ============================================================
// 메뉴: 오늘 파악표 생성 / 다시 만들기
// ============================================================
function createTodayReport() {
  const ui = SpreadsheetApp.getUi();
  const res = _generateToday_();
  if (!res.ok) { ui.alert("⚠️ " + res.msg); return; }
  ui.alert(res.existed
    ? "ℹ️ 오늘 파악표는 이미 있어서 '" + PIN_SHEET_NAME + "' 시트만 다시 맞췄습니다.\n" +
      "(근무계획이 바뀌었으면 '오늘 파악표 다시 만들기'를 쓰세요)"
    : "✅ 오늘 파악표 생성 완료!\n공유용 '" + PIN_SHEET_NAME + "' 시트도 갱신했습니다.");
}

function recreateTodayReport() {
  const ui = SpreadsheetApp.getUi();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const name = _reportSheetName_(_kstToday_());
  const old = ss.getSheetByName(name);

  let keep = null;
  if (old) {
    const ans = ui.alert("🔄 다시 만들기",
      "'" + name + "' 시트를 지우고 근무계획·생산계획을 다시 읽어 새로 만듭니다.\n" +
      "※ 안전포인트(말한 사람·내용)는 옮겨 드리지만, 그 밖에 직접 고친 내용은 사라집니다.\n\n진행할까요?",
      ui.ButtonSet.YES_NO);
    if (ans !== ui.Button.YES) return;
    keep = [old.getRange("B15").getValue(), old.getRange("C15").getValue()];
    ss.deleteSheet(old);
  }

  const res = _generateToday_();
  if (!res.ok) { ui.alert("⚠️ " + res.msg); return; }

  if (keep && (keep[0] !== "" || keep[1] !== "")) {
    const sh = ss.getSheetByName(name);
    sh.getRange("B15").setValue(keep[0]);
    sh.getRange("C15").setValue(keep[1]);
  }
  ui.alert("✅ 다시 만들었습니다.\n공유용 '" + PIN_SHEET_NAME + "' 시트도 갱신했습니다.");
}


// ============================================================
// 메뉴: 자동 생성 켜기 / 끄기 / 상태
// ============================================================
function autoTriggerOn() {
  const ui = SpreadsheetApp.getUi();
  const res = ui.prompt("⏰ 매일 자동 생성 켜기",
    "몇 시에 실행할까요? (0~23, 비워 두면 " + AUTO_DEFAULT_HOUR + ")\n\n" +
    "※ 구글 트리거는 '정각'이 아니라 그 시간대 안 아무 때나 실행됩니다.\n" +
    "   예) 6 입력 → 6:00~6:59 사이 실행 → 7시 전에는 완성\n" +
    "   7시 전에 꼭 있어야 하면 6, 6시 전에 보려면 5를 넣으세요.",
    ui.ButtonSet.OK_CANCEL);
  if (res.getSelectedButton() !== ui.Button.OK) return;

  const txt = res.getResponseText().replace(/[^0-9]/g, "");
  const hour = txt === "" ? AUTO_DEFAULT_HOUR : Number(txt);
  if (!Number.isInteger(hour) || hour < 0 || hour > 23) {
    ui.alert("0~23 사이 숫자로 입력하세요.");
    return;
  }

  _deleteAutoTriggers_(); // 중복 방지: 기존 것 지우고 새로
  ScriptApp.newTrigger(AUTO_HANDLER)
    .timeBased().everyDays(1).atHour(hour).inTimezone(AUTO_TZ)
    .create();
  PropertiesService.getScriptProperties().setProperty(AUTO_PROP_HOUR, String(hour));

  ui.alert("✅ 자동 생성 켜짐",
    "매일 " + hour + ":00 ~ " + hour + ":59 사이에 오늘 파악표가 만들어집니다.\n" +
    "공유용 '" + PIN_SHEET_NAME + "' 시트도 같이 바뀝니다.\n\n" +
    "실패하면 " + Session.getEffectiveUser().getEmail() + " 로 메일이 갑니다.",
    ui.ButtonSet.OK);
}

function autoTriggerOff() {
  const ui = SpreadsheetApp.getUi();
  const n = _deleteAutoTriggers_();
  PropertiesService.getScriptProperties().deleteProperty(AUTO_PROP_HOUR);
  ui.alert(n > 0 ? "⏹ 자동 생성을 껐습니다. (트리거 " + n + "개 삭제)" : "ℹ️ 켜져 있는 자동 생성이 없습니다.");
}

function autoTriggerStatus() {
  const ui = SpreadsheetApp.getUi();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ts = _autoTriggers_();
  const hour = PropertiesService.getScriptProperties().getProperty(AUTO_PROP_HOUR);
  const todayName = _reportSheetName_(_kstToday_());
  const scriptTz = Session.getScriptTimeZone();

  const lines = [];
  if (ts.length === 0) {
    lines.push("⏹ 자동 생성: 꺼짐");
  } else {
    lines.push("▶ 자동 생성: 켜짐" + (hour !== null ? " — 매일 " + hour + ":00~" + hour + ":59" : ""));
    if (ts.length > 1) lines.push("⚠️ 트리거가 " + ts.length + "개입니다 (중복). '켜기'를 한 번 더 누르면 1개로 정리됩니다.");
  }
  lines.push("");
  lines.push((ss.getSheetByName(todayName) ? "✅ " : "⬜ ") + "오늘 시트: " + todayName);
  lines.push((ss.getSheetByName(PIN_SHEET_NAME) ? "✅ " : "⬜ ") + "공유용 시트: " + PIN_SHEET_NAME);
  lines.push("");
  lines.push("스크립트 시간대: " + scriptTz + (scriptTz === AUTO_TZ ? " ✅" :
    "\n⚠️ Asia/Seoul 이 아닙니다. 편집기 왼쪽 ⚙️ 프로젝트 설정 → 시간대를 '(GMT+09:00) 서울'로 바꾸세요."));

  ui.alert("ℹ️ 자동 생성 상태", lines.join("\n"), ui.ButtonSet.OK);
}


// ============================================================
// 메뉴: 공유용 링크
// ============================================================
function showShareLink() {
  const ui = SpreadsheetApp.getUi();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const pin = ss.getSheetByName(PIN_SHEET_NAME);
  if (!pin) { ui.alert("먼저 '📋 오늘 파악표 생성'을 한 번 실행하세요. 그때 공유용 시트가 만들어집니다."); return; }

  const url = ss.getUrl().replace(/\/edit.*$/, "/edit") + "#gid=" + pin.getSheetId();
  const html = HtmlService.createHtmlOutput(
    '<div style="font-family:맑은 고딕,sans-serif;font-size:13px;line-height:1.6">' +
    '<p>이 주소는 <b>매일 같습니다.</b> 열면 항상 그날 파악표가 보입니다.<br>' +
    '단톡방에 한 번 올리거나 휴대폰 홈 화면에 추가해 두게 하세요.</p>' +
    '<input id="u" value="' + url + '" readonly style="width:100%;padding:6px;font-size:12px" onclick="this.select()">' +
    '<p style="margin-top:10px"><button onclick="cp()" style="padding:6px 14px">📋 복사</button> ' +
    '<span id="m" style="color:#2e7d32"></span></p>' +
    '<p style="color:#888;font-size:11px">※ 받는 사람은 이 스프레드시트에 <b>뷰어</b>로 공유돼 있어야 열립니다.</p>' +
    '<script>function cp(){var i=document.getElementById("u");i.select();' +
    'try{document.execCommand("copy");document.getElementById("m").textContent="복사됨";}' +
    'catch(e){document.getElementById("m").textContent="Ctrl+C 로 복사하세요";}}</script>' +
    '</div>'
  ).setWidth(480).setHeight(230);
  ui.showModalDialog(html, "🔗 공유용 링크");
}


// ============================================================
// 내부 함수
// ============================================================

/** 오늘(한국 날짜) 정오 — 스크립트 시간대가 달라도 날짜가 밀리지 않게 */
function _kstToday_() {
  const p = Utilities.formatDate(new Date(), AUTO_TZ, "yyyy-MM-dd").split("-").map(Number);
  return new Date(p[0], p[1] - 1, p[2], 12, 0, 0);
}

/** _runReport 와 똑같은 규칙의 시트 이름 */
function _reportSheetName_(d) {
  return Utilities.formatDate(d, AUTO_TZ, "yyyy년 M월 dd일") + " 인원 파악";
}

/** 오늘 파악표 생성(없을 때만) + 공유용 시트 갱신 */
function _generateToday_() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(60 * 1000)) return { ok: false, msg: "다른 실행이 진행 중입니다. 잠시 후 다시 시도하세요." };

  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const today = _kstToday_();
    const name = _reportSheetName_(today);
    let sh = ss.getSheetByName(name);
    const existed = !!sh;

    if (!sh) {
      try {
        _runReport(today);
      } catch (e) {
        const half = ss.getSheetByName(name); // 만들다 만 시트는 지워서 다음 실행이 막히지 않게
        if (half) ss.deleteSheet(half);
        return { ok: false, msg: name + " 생성 중 오류:\n" + e.message };
      }
      sh = ss.getSheetByName(name);
      if (!sh) {
        return { ok: false, msg: name + " 이(가) 만들어지지 않았습니다.\n" + _logText_() };
      }
    }

    _updatePinnedSheet_(ss, sh);
    return { ok: true, existed: existed, name: name };
  } finally {
    lock.releaseLock();
  }
}

/** 오늘 시트를 '📌 오늘 인원파악' 시트에 그대로 복사 (맨 앞 탭) */
function _updatePinnedSheet_(ss, src) {
  let pin = ss.getSheetByName(PIN_SHEET_NAME);
  if (!pin) pin = ss.insertSheet(PIN_SHEET_NAME);

  pin.getRange(1, 1, pin.getMaxRows(), pin.getMaxColumns()).breakApart();
  pin.clear();

  const nr = Math.max(src.getLastRow(), 15);
  const nc = Math.max(src.getLastColumn(), 19);
  if (pin.getMaxColumns() < nc) pin.insertColumnsAfter(pin.getMaxColumns(), nc - pin.getMaxColumns());

  const range = src.getRange(1, 1, nr, nc);
  range.copyTo(pin.getRange(1, 1), SpreadsheetApp.CopyPasteType.PASTE_NORMAL, false);
  range.copyTo(pin.getRange(1, 1), SpreadsheetApp.CopyPasteType.PASTE_COLUMN_WIDTHS, false);
  for (let r = 1; r <= nr; r++) pin.setRowHeight(r, src.getRowHeight(r));
  pin.setHiddenGridlines(true);

  // 안전포인트는 날짜 시트에 적으면 여기에도 자동으로 보이게
  const ref = "'" + src.getName().replace(/'/g, "''") + "'!";
  pin.getRange("B15").setFormula('=IF(ISBLANK(' + ref + 'B15),"",' + ref + 'B15)');
  pin.getRange("C15").setFormula('=IF(ISBLANK(' + ref + 'C15),"",' + ref + 'C15)');

  pin.getRange(nr + 2, 1)
    .setValue("※ 매일 자동으로 바뀌는 공유용 시트입니다. 안전포인트는 '" + src.getName() + "' 시트에 적어 주세요. " +
              "(갱신: " + Utilities.formatDate(new Date(), AUTO_TZ, "M월 d일 HH:mm") + ")")
    .setFontColor("#888888").setFontSize(9).setFontFamily("맑은 고딕");

  // 편집자가 실수로 고칠 때 경고만 띄움 (막지는 않음)
  if (pin.getProtections(SpreadsheetApp.ProtectionType.SHEET).length === 0) {
    pin.protect().setDescription("공유용 자동 시트").setWarningOnly(true);
  }

  ss.setActiveSheet(pin);
  ss.moveActiveSheet(1); // 맨 왼쪽 탭
}

function _autoTriggers_() {
  return ScriptApp.getProjectTriggers().filter(t =>
    [AUTO_HANDLER, "runDailyReport"].indexOf(t.getHandlerFunction()) !== -1 &&
    t.getEventType() === ScriptApp.EventType.CLOCK);
}

function _deleteAutoTriggers_() {
  const ts = _autoTriggers_();
  ts.forEach(t => ScriptApp.deleteTrigger(t));
  return ts.length;
}

function _notifyOwner_(subject, body) {
  Logger.log(subject + "\n" + body);
  try {
    const to = Session.getEffectiveUser().getEmail() || AUTO_OWNER_EMAIL;
    MailApp.sendEmail(to, subject,
      body + "\n\n해결 후 스프레드시트 메뉴 '🏭 인원파악 → 📋 오늘 파악표 생성'을 누르면 됩니다.\n" +
      SpreadsheetApp.getActiveSpreadsheet().getUrl());
  } catch (e) {
    Logger.log("메일 발송 실패: " + e.message);
  }
}

/** 트리거 실행 중 showAlert 가 남긴 로그(근무계획 시트 없음 등)를 메일에 담기 위함 */
function _logText_() {
  try { return String(Logger.getLog() || "").trim().slice(-800); } catch (e) { return ""; }
}
