    if (Number(i15b)  > 0 && hasP) { A_days.push(day); Logger.log(`A해당: ${day}일 (1.5BTL=${i15b}, P=${p})`); }
    if (Number(j05b)  > 0 && hasP) { B_days.push(day); Logger.log(`B해당: ${day}일 (0.5BTL=${j05b}, P=${p})`); }
    if (Number(k033b) > 0 && hasP) { C_days.push(day); Logger.log(`C해당: ${day}일 (0.33BTL=${k033b}, P=${p})`); }
  }

  Logger.log('=== 연장일 목록 ===');
  Logger.log(`Q(1.5L 제품): [${Q_days.join(', ')}] → ${Q_days.length}일`);
  Logger.log(`W(0.5L 제품): [${W_days.join(', ')}] → ${W_days.length}일`);
  Logger.log(`E(0.33L 제품): [${E_days.join(', ')}] → ${E_days.length}일`);
  Logger.log(`A(1.5L BTL): [${A_days.join(', ')}] → ${A_days.length}일`);
  Logger.log(`B(0.5L BTL): [${B_days.join(', ')}] → ${B_days.length}일`);
  Logger.log(`C(0.33L BTL): [${C_days.join(', ')}] → ${C_days.length}일`);

  const workSS = SpreadsheetApp.openById('12yP7AxfC_27B6LhSEJ4lFH5ZYnymyQIlcbPXXhpDUBY');
  let workSheet = null;
  for (let s of workSS.getSheets()) {
    if (s.getName().includes(month + '월')) { workSheet = s; break; }
  }
  Logger.log('근무계획 시트: ' + (workSheet ? workSheet.getName() : '못 찾음'));

  const workData  = workSheet.getRange('G3:AK20').getValues();
  const dateRow   = workData[0];
  const staffRows = workData.slice(2);

  function hasNight(day) {
    const colIdx = dateRow.findIndex(v => Number(v) === Number(day));
