function onOpen() {
  const ui = SpreadsheetApp.getUi();
  ui.createMenu('🔧 연장근로 자동입력')
    .addItem('연장근로 계획 산정 근거 입력', 'fillOvertimePlan')
    .addSeparator()
    .addSubMenu(
      ui.createMenu('🧪 테스트 (월 직접 지정)')
        .addItem('1월 기준으로 테스트', 'testMonth1')
        .addItem('2월 기준으로 테스트', 'testMonth2')
        .addItem('3월 기준으로 테스트', 'testMonth3')
        .addItem('월 직접 입력해서 테스트', 'testMonthCustom')
    )
    .addToUi();
}

// ── 테스트 진입점들 ──────────────────────────────────────────────
function testMonth1()      { fillOvertimePlanWithMonth(1); }
function testMonth2()      { fillOvertimePlanWithMonth(2); }
function testMonth3()      { fillOvertimePlanWithMonth(3); }

function testMonthCustom() {
  const ui = SpreadsheetApp.getUi();
  const response = ui.prompt(
    '🧪 테스트 월 직접 입력',
    '테스트할 월을 숫자로 입력하세요 (예: 4)',
    ui.ButtonSet.OK_CANCEL
  );
  if (response.getSelectedButton() !== ui.Button.OK) return;

  const month = Number(response.getResponseText().trim());
  if (isNaN(month) || month < 1 || month > 12) {
    ui.alert('❌ 올바른 월(1~12)을 입력해주세요.');
    return;
  }
  fillOvertimePlanWithMonth(month);
}

