  for (let { label, days } of allDaysSets) {
    let total = 0;
    for (let d of days) {
      const night = hasNight(d);
      const people = night ? 1 : 2;
      total += people;
      Logger.log(`  ${label} ${d}일 → 야간=${night} → ${people}명`);
    }
    Logger.log(`  ${label} 합계: ${days.length}일, ${total}명`);
  }
}

// ── 핵심 계산 로직 (월을 인자로 받음) ───────────────────────────
function fillOvertimePlanWithMonth(month) {
  try {
    const isTest = true; // 테스트 모드 플래그 (알림 문구 구분용)

    // ── 제품생산 계획 읽기 ─────────────────────────────────────────
    const prodSS = SpreadsheetApp.openById('1ibZaOX0NKni6vRTVE0i2Wb5AXNHn9D72F5CFWSxH3qQ');
    let prodSheet = null;
    for (let s of prodSS.getSheets()) {
      const name = s.getName();
      if (name.includes(month + '월') && name.includes('제품생산 계획')) {
        prodSheet = s; break;
      }
    }
    if (!prodSheet) throw new Error(
      `${month}월 제품생산 계획 시트를 찾을 수 없습니다.\n` +
      `시트 목록: ${prodSS.getSheets().map(s => s.getName()).join(', ')}`
    );

    const prodData = prodSheet.getRange('A3:P33').getValues();

    const Q_days = [], W_days = [], E_days = [];
    const A_days = [], B_days = [], C_days = [];

    for (let row of prodData) {
      const day   = row[0];
      const c189  = row[2];
      const d15   = row[3];
      const e05   = row[4];
      const f033  = row[5];
      const i15b  = row[8];
      const j05b  = row[9];
      const k033b = row[10];
      const p     = row[15];

      if (day === '' || day === null) continue;

      const has189 = (c189 !== '' && c189 !== null && c189 !== 0);

      if (has189) {
        if (Number(d15)  >= 6000) Q_days.push(day);
        if (Number(e05)  >= 2700) W_days.push(day);
        if (Number(f033) >= 4000) E_days.push(day);
      } else {
        if (Number(d15)  >= 8500) Q_days.push(day);
        if (Number(e05)  >= 4000) W_days.push(day);
        if (Number(f033) >= 5000) E_days.push(day);
      }

      const hasP = (p !== '' && p !== null && p !== 0);
      if (Number(i15b)  > 0 && hasP) A_days.push(day);
      if (Number(j05b)  > 0 && hasP) B_days.push(day);
      if (Number(k033b) > 0 && hasP) C_days.push(day);
    }

    // ── 근무계획 시트 읽기 ─────────────────────────────────────────
    const workSS = SpreadsheetApp.openById('12yP7AxfC_27B6LhSEJ4lFH5ZYnymyQIlcbPXXhpDUBY');
    let workSheet = null;
    for (let s of workSS.getSheets()) {
      if (s.getName().includes(month + '월')) { workSheet = s; break; }
    }
    if (!workSheet) throw new Error(
      `${month}월 근무계획 시트를 찾을 수 없습니다.\n` +
      `시트 목록: ${workSS.getSheets().map(s => s.getName()).join(', ')}`
    );

    const workData  = workSheet.getRange('G3:AK20').getValues();
    const dateRow   = workData[0];
    const staffRows = workData.slice(2);

    function hasNight(day) {
      const colIdx = dateRow.findIndex(v => Number(v) === Number(day));
      if (colIdx === -1) return false;
      for (let sr of staffRows) {
        if (sr[colIdx] === '야') return true;
      }
      return false;
    }

    function calcPeople(days) {
      let total = 0;
      for (let d of days) {
        total += hasNight(d) ? 1 : 2;
      }
      return total;
    }

    function splitByNight(days) {
      const withNight = [], noNight = [];
      for (let d of days) {
        hasNight(d) ? withNight.push(d) : noNight.push(d);
      }
      return { withNight, noNight };
    }

    const toDateStr = (days) => days.map(d => Number(d)).sort((a,b) => a-b).join(', ');

    const Q = Q_days.length, W = W_days.length, Ev = E_days.length;
    const Av = A_days.length, Bv = B_days.length, Cv = C_days.length;
    const X = calcPeople(Q_days), Y = calcPeople(W_days), Z = calcPeople(E_days);
    const D = calcPeople(A_days), Ep = calcPeople(B_days), F = calcPeople(C_days);

    const totalProdDays   = Q + W + Ev;
    const totalProdPeople = X + Y + Z;
    const totalBTLDays    = Av + Bv + Cv;
    const totalBTLPeople  = D + Ep + F;

    const Q_split  = splitByNight(Q_days);
    const W_split  = splitByNight(W_days);
    const E_split  = splitByNight(E_days);
    const A_split  = splitByNight(A_days);
    const B_split  = splitByNight(B_days);
    const C_split  = splitByNight(C_days);

    // ── 출력 대상 시트 ─────────────────────────────────────────────
    const outSS = SpreadsheetApp.openById('1uqWQ3XnPwoOXR5SlqJy7ZO-bxyyC-1XL6v362S4QmGs');
    let outTarget = null;
    for (let s of outSS.getSheets()) {
      if (s.getSheetId() === 209613212) { outTarget = s; break; }
    }
    if (!outTarget) throw new Error('출력 대상 시트를 찾을 수 없습니다.');

    // ── A9: 연장근로 계획 산정 근거 텍스트 ───────────────────────
    const text =
`● 연장근로 계획 산정 근거
 
      - 제품 생산 : ${totalProdDays}일, ${totalProdPeople}명
      ᆞ1.5L (${Q}일, ${X}명), 0.5L (${W}일, ${Y}명), 0.33L (${Ev}일, ${Z}명)
      - 병 생산 : ${totalBTLDays}일, ${totalBTLPeople}명
      ᆞ1.5L (${Av}일, ${D}명), 0.5L (${Bv}일, ${Ep}명), 0.33L (${Cv}일, ${F}명)`;

    outTarget.getRange('A9').setValue(text);

    // ── 연장 일자 전체 목록 ────────────────────────────────────────
    outTarget.getRange('R4').setValue(toDateStr(Q_days));
    outTarget.getRange('R5').setValue(toDateStr(W_days));
    outTarget.getRange('R6').setValue(toDateStr(E_days));
    outTarget.getRange('X4').setValue(toDateStr(A_days));
    outTarget.getRange('X5').setValue(toDateStr(B_days));
    outTarget.getRange('X6').setValue(toDateStr(C_days));

    // ── 야간 있는 날 ──────────────────────────────────────────────
    outTarget.getRange('R11').setValue(toDateStr(Q_split.withNight));
    outTarget.getRange('R12').setValue(toDateStr(W_split.withNight));
    outTarget.getRange('R13').setValue(toDateStr(E_split.withNight));
    outTarget.getRange('W11').setValue(toDateStr(A_split.withNight));
    outTarget.getRange('W12').setValue(toDateStr(B_split.withNight));
    outTarget.getRange('W13').setValue(toDateStr(C_split.withNight));

    // ── 야간 없는 날 ──────────────────────────────────────────────
    outTarget.getRange('S11').setValue(toDateStr(Q_split.noNight));
    outTarget.getRange('S12').setValue(toDateStr(W_split.noNight));
    outTarget.getRange('S13').setValue(toDateStr(E_split.noNight));
    outTarget.getRange('X11').setValue(toDateStr(A_split.noNight));
    outTarget.getRange('X12').setValue(toDateStr(B_split.noNight));
    outTarget.getRange('X13').setValue(toDateStr(C_split.noNight));

    // ── D7: 생수공장 근태 정산내역 > 연장근무 발생 보고 D17+D18+D19 ──
    const keunTaeSS2 = SpreadsheetApp.openById('1UjHzUCH3w4eUQuxIZrzOtgeCi4itVUOTXDq7sm8PcvE');
    let reportSheet = null;
    for (let s of keunTaeSS2.getSheets()) {
      if (s.getName().includes('연장근무 발생 보고')) { reportSheet = s; break; }
    }
    if (!reportSheet) throw new Error('연장근무 발생 보고 시트를 찾을 수 없습니다.');

    const d17 = Number(reportSheet.getRange('D17').getValue()) || 0;
    const d18 = Number(reportSheet.getRange('D18').getValue()) || 0;
    const d19 = Number(reportSheet.getRange('D19').getValue()) || 0;
    outTarget.getRange('D7').setValue(d17 + d18 + d19);

    // ── E7, F7 ────────────────────────────────────────────────────
    const j35 = prodSheet.getRange('J35').getValue();
    outTarget.getRange('E7').setValue(j35);

    const totalPeople = X + Y + Z + D + Ep + F;
    outTarget.getRange('F7').setValue(totalPeople * 2.5);

    const modeLabel = isTest ? `🧪 [테스트 - ${month}월 기준]\n\n` : '';
    SpreadsheetApp.getUi().alert(`✅ 완료!\n\n${modeLabel}연장근로 계획 산정 근거가 입력되었습니다.`);

  } catch (e) {
    SpreadsheetApp.getUi().alert('❌ 오류 발생:\n' + e.message);
  }
}

// ── 메인 함수 (Z3 기준, 기존 동작 유지) ─────────────────────────
function fillOvertimePlan() {
  try {
    const keunTaeSS = SpreadsheetApp.openById('1UjHzUCH3w4eUQuxIZrzOtgeCi4itVUOTXDq7sm8PcvE');
    let targetSheet = null;
    for (let s of keunTaeSS.getSheets()) {
      if (s.getName().includes('근무현황표')) { targetSheet = s; break; }
    }
    if (!targetSheet) throw new Error('근무현황표 시트를 찾을 수 없습니다.');

    const M = Number(targetSheet.getRange('Z3').getValue());
    if (!M || isNaN(M)) throw new Error('Z3 셀에서 월 값을 읽을 수 없습니다.');
    const month = M + 1;

    fillOvertimePlanWithMonth(month);

  } catch (e) {
    SpreadsheetApp.getUi().alert('❌ 오류 발생:\n' + e.message);
  }
}