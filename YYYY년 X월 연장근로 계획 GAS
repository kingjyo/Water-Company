    const has189 = (c189 !== '' && c189 !== null && c189 !== 0);

    if (has189) {
      if (Number(d15)  >= 6000) { Q_days.push(day); Logger.log(`Q해당: ${day}일 (18.9L동반, 1.5L=${d15})`); }
