/* ═════════════ ④ 원부재료 분배 실행 ═════════════ */
function distributeRun() {
  const ui = SpreadsheetApp.getUi();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let plan, dates, done;

  ss.toast('원부재료 스프레드시트를 확인하는 중입니다. (30초~1분)', '분배 실행', -1);
  try {
    dates = loadSavedDates();
    done = loadDoneDates();
    plan = buildDistributionPlan(getSummarySheet().getRange(CONFIG.GRID).getValues(), dates, done);
  } catch (e) {
    ss.toast('중단됨', '분배 실행', 2);
    ui.alert('분배 실행 실패', e.message, ui.ButtonSet.OK);
    return;
  }
  ss.toast('확인 완료', '분배 실행', 2);

  const toWrite = plan.tasks.filter(t => t.write);
  const overwrite = toWrite.filter(t => t.status === '덮어쓰기').length;
  const dateText = CONFIG.SOURCES.map(s => {
    const d = dates[s.key];
    const mark = d && done[s.key] === d ? ' (이미 배분됨 → 건너뜀)' : '';
    return `${s.name}: ${d ? mmddLabel(d) : '없음'}${mark}`;
  }).join('\n');

  let msg = '[기준 날짜]\n' + dateText + `\n\n입력 예정: ${toWrite.length}칸 (그중 덮어쓰기 ${overwrite}칸)`;
  if (plan.warnings.length) msg += '\n\n⚠ 경고\n' + plan.warnings.map(w => '• ' + w).join('\n');
  if (plan.errors.length)   msg += '\n\n❌ 오류 (해당 항목은 제외)\n' + plan.errors.map(e => '• ' + e).join('\n');

  if (!toWrite.length) {
    ui.alert('원부재료 분배', msg + '\n\n새로 입력할 내용이 없습니다.', ui.ButtonSet.OK);
    return;
  }

  msg += '\n\n진행할까요? (칸별 상세 내용은 ② 테스트에서 확인)';
  if (ui.alert('원부재료 분배 실행', msg, ui.ButtonSet.YES_NO) !== ui.Button.YES) return;

  const failed = [], badGroup = {};
  toWrite.forEach(t => {
    try {
      t.sheet.getRange(t.a1).setValue(t.newVal);
    } catch (e) {
      failed.push(`• ${t.name} ${t.sheetName}!${t.a1}: ${e.message}`);
      badGroup[t.group] = true;
    }
  });
  plan.tasks.forEach(t => { if (t.status === '오류') badGroup[t.group] = true; });

  // 배분 기록 저장 (오류·실패 없는 원본만)
  const marked = [];
  CONFIG.SOURCES.forEach(s => {
    const mmdd = dates[s.key];
    if (!mmdd || badGroup[s.short]) return;
    done[s.key] = mmdd;
    marked.push(`• ${s.name}: ${mmddLabel(mmdd)}`);
  });
  saveDoneDates(done);

  let doneMsg = `${toWrite.length - failed.length}칸 입력했습니다.`;
  if (failed.length) doneMsg += '\n\n❌ 입력 실패\n' + failed.join('\n');
  if (marked.length) doneMsg += '\n\n[배분 기록 저장]\n' + marked.join('\n') + '\n\n※ 같은 날짜 자료는 다시 배분하지 않습니다.';
  ui.alert('완료', doneMsg, ui.ButtonSet.OK);
}

