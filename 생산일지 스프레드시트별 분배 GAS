/* ═════════════ ③ 분배 테스트 (날짜 지정) ═════════════ */
function distributeTestByDate() {
  const ymd = promptYmd('분배 테스트 (날짜 지정)',
    '테스트할 날짜를 YYYY-MM-DD 형식으로 입력하세요.\n예) 2026-09-10\n\n※ 생산일지 모음 시트는 변경되지 않습니다.');
  if (!ymd) return;

  runTest(() => {
    const res = readSources(ss => findSheetByName(ss, ymd.mmdd));
    // 날짜 지정 테스트는 조회 성격이므로 '이미 배분됨' 건너뛰기를 적용하지 않음 (경고로만 표시)
    const plan = buildDistributionPlan(res.grid, res.dates, {});

    const done = loadDoneDates();
    const extra = yearWarning(ymd).concat(res.warnings);
    CONFIG.SOURCES.forEach(s => {
      if (res.dates[s.key] && done[s.key] === res.dates[s.key]) {
        extra.push(`${s.name} ${mmddLabel(res.dates[s.key])} 자료는 이미 배분 기록이 있습니다. (④ 실행 시에는 건너뜁니다)`);
      }
    });

    plan.errors = res.errors.concat(plan.errors);
    plan.warnings = extra.concat(plan.warnings);

    return {
      plan,
      meta: { mode: `날짜 지정 · ${ymd.text} (${ymd.dow})`, done, sources: res.info },
    };
  });
}

