/* ═════════════ ① 생산일지 모음 불러오기 (최신 날짜) ═════════════ */
function importProductionLogs() {
  const ui = SpreadsheetApp.getUi();
  const target = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.TARGET_SHEET);
  if (!target) {
    ui.alert(`'${CONFIG.TARGET_SHEET}' 시트를 찾을 수 없습니다.`);
    return;
  }

  const res = readSources(ss => findLatestDateSheet(ss));
  const errors = res.errors.concat(res.missing.map(s => `${s.name}: 날짜(MMDD) 형식의 시트를 찾지 못했습니다.`));
  if (errors.length) {
    ui.alert('불러오기 실패',
      '아래 오류로 인해 아무것도 입력하지 않았습니다.\n\n' + errors.map(e => '• ' + e).join('\n'),
      ui.ButtonSet.OK);
    return;
  }

  const warnings = res.warnings.slice();
  const uniq = [...new Set(Object.values(res.dates))];
  if (uniq.length > 1) {
    warnings.unshift(`원본별 날짜가 서로 다릅니다 (${uniq.join(', ')}) → 날짜가 뒤처진 원본은 그날 생산이 없었을 수 있습니다.`);
  }

  const done = loadDoneDates();
  CONFIG.SOURCES.forEach(s => {
    if (res.dates[s.key] && done[s.key] === res.dates[s.key]) {
      warnings.push(`${s.name} ${mmddLabel(res.dates[s.key])} 자료는 이미 배분했습니다. (④ 실행 시 건너뜀)`);
    }
  });

  let msg = '다음 시트의 데이터를 불러옵니다.\n\n' + res.info.map(i => `• ${i.name} → [${i.mmdd}] 시트`).join('\n');
  if (warnings.length) msg += '\n\n⚠ 확인 필요\n' + warnings.map(w => '• ' + w).join('\n');
  msg += '\n\n진행할까요?';
  if (ui.alert('생산일지 모음 불러오기', msg, ui.ButtonSet.YES_NO) !== ui.Button.YES) return;

  applyImport(target, res);
  ui.alert('완료', `'${CONFIG.TARGET_SHEET}' 시트에 입력했습니다.\n(분배 기준 날짜도 함께 저장됨)`, ui.ButtonSet.OK);
}

/* ═════════════ ①-2 날짜 지정 불러오기 (결과 시트 + 실제 입력) ═════════════ */
function importByDate() {
  const ui = SpreadsheetApp.getUi();
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const ymd = promptYmd('날짜 지정 불러오기',
    '불러올 날짜를 YYYY-MM-DD 형식으로 입력하세요.\n예) 2026-09-10\n\n' +
    `※ 먼저 '${CONFIG.IMPORT_RESULT_SHEET}' 시트에 미리보기를 만든 뒤,\n` +
    '   확인 창에서 [예]를 눌러야 실제로 입력됩니다.\n' +
    '※ 해당 날짜 시트가 없는 원본은 "미생산"으로 처리됩니다.');
  if (!ymd) return;

  let target;
  try {
    target = getSummarySheet();
  } catch (e) {
    ui.alert('오류', e.message, ui.ButtonSet.OK);
    return;
  }

  ss.toast('각 생산일지를 확인하는 중입니다.', '날짜 지정 불러오기', -1);
  let res, out;
  try {
    res = readSources(s => findSheetByName(s, ymd.mmdd));
    res.warnings = yearWarning(ymd).concat(res.warnings);
    out = writeImportTestResult(res, ymd, false);
    ss.toast(`'${CONFIG.IMPORT_RESULT_SHEET}' 시트를 만들었습니다.`, '미리보기 완료', 3);
  } catch (e) {
    ss.toast('중단됨', '날짜 지정 불러오기', 2);
    ui.alert('불러오기 실패', e.message, ui.ButtonSet.OK);
    return;
  }

  // 원본 읽기 오류가 있으면 입력하지 않음
  if (res.errors.length) {
    ui.alert('입력 불가',
      `'${CONFIG.IMPORT_RESULT_SHEET}' 시트는 만들었지만, 아래 오류로 인해 아무것도 입력하지 않았습니다.\n\n` +
      res.errors.map(e => '• ' + e).join('\n'),
      ui.ButtonSet.OK);
    return;
  }

  const found = res.info.filter(s => s.mmdd);
  if (!found.length) {
    ui.alert('대상 없음',
      `${ymd.text} 날짜의 시트를 어느 생산일지에서도 찾지 못했습니다.\n` +
      '(해당 날짜에 생산이 없었거나, 시트 이름을 확인해 주세요)\n\n' +
      `자세한 내용은 '${CONFIG.IMPORT_RESULT_SHEET}' 시트를 확인하세요.`,
      ui.ButtonSet.OK);
    return;
  }

  const lines = res.info.map(s => s.mmdd
    ? `• ${s.name} → [${s.mmdd}] 시트`
    : `• ${s.name} → 시트 없음 (미생산${CONFIG.CLEAR_MISSING ? ' → 모음 영역 비움' : ' → 기존 값 유지'})`);

  const warnings = res.warnings.slice();
  const done = loadDoneDates();
  CONFIG.SOURCES.forEach(s => {
    if (res.dates[s.key] && done[s.key] === res.dates[s.key]) {
      warnings.push(`${s.name} ${mmddLabel(res.dates[s.key])} 자료는 이미 배분했습니다. (④ 실행 시 건너뜀)`);
    }
  });

  let msg = `[대상] ${ymd.text} (${ymd.dow})\n\n` + lines.join('\n') +
    `\n\n'${CONFIG.TARGET_SHEET}' 변경 예정\n` +
    `입력 ${out.cnt['입력']}칸 · 변경 ${out.cnt['변경']}칸 · 비움 ${out.cnt['비움']}칸 · 동일 ${out.cnt['동일']}칸\n\n` +
    '※ 분배 기준 날짜도 함께 저장되어 ② ④ 에서 사용됩니다.';
  if (warnings.length) msg += '\n\n⚠ 확인 필요\n' + warnings.map(w => '• ' + w).join('\n');
  msg += `\n\n'${CONFIG.TARGET_SHEET}' 시트에 실제로 입력할까요?\n(아니오를 누르면 미리보기 시트만 남습니다)`;

  if (ui.alert('날짜 지정 불러오기', msg, ui.ButtonSet.YES_NO) !== ui.Button.YES) {
    setResultSubtitle(out.sh, out.W,
      `대상 날짜: ${ymd.text} (${ymd.dow})     ·     상태: 미리보기 — 입력하지 않았습니다.`,
      '#d9e2f3', '#44546a');
    return;
  }

  applyImport(target, res);
  setResultSubtitle(out.sh, out.W,
    `대상 날짜: ${ymd.text} (${ymd.dow})     ·     상태: 입력 완료 — '${CONFIG.TARGET_SHEET}' 시트에 반영되었고 분배 기준 날짜도 저장되었습니다.`,
    '#e8f5e9', '#1b5e20');

  ui.alert('완료',
    `'${CONFIG.TARGET_SHEET}' 시트에 입력했습니다.\n(분배 기준 날짜도 함께 저장됨)\n\n` +
    '다음 단계: ② 분배 테스트 → ④ 원부재료 분배 실행',
    ui.ButtonSet.OK);
}

/* 모음 시트에 실제 입력 + 기준 날짜 저장 (①·①-2 공통) */
function applyImport(target, res) {
  res.jobs.forEach(j =>
    target.getRange(j.row, j.col, j.values.length, j.values[0].length).setValues(j.values));

  if (CONFIG.CLEAR_MISSING) {
    res.missing.forEach(src => src.maps.forEach(m => {
      const d = parseA1Range(m.dst);
      target.getRange(d.row, d.col, d.numRows, d.numCols).clearContent();
    }));
  }

  PropertiesService.getDocumentProperties().setProperty(DIST.DATE_KEY, JSON.stringify(res.dates));
}

/* 각 생산일지 읽기 (pickSheet: 스프레드시트 → 사용할 시트) */
function readSources(pickSheet) {
  const g = parseA1Range(CONFIG.GRID);
  const grid = Array.from({ length: g.numRows }, () => Array(g.numCols).fill(''));
  const res = { grid, dates: {}, info: [], jobs: [], warnings: [], errors: [], missing: [] };

  CONFIG.SOURCES.forEach(src => {
    const info = { key: src.key, short: src.short, name: src.name, mmdd: '', note: '' };
    res.info.push(info);

    try {
      const sheet = pickSheet(SpreadsheetApp.openById(src.id));
      if (!sheet) {
        res.missing.push(src);
        info.note = CONFIG.CLEAR_MISSING
          ? '해당 날짜 시트 없음 (미생산?) → 모음 영역을 비움'
          : '해당 날짜 시트 없음 (미생산?) → 기존 값 유지';
        return;
      }

      src.maps.forEach(m => {
        const values = sheet.getRange(m.src).getValues();
        const s = parseA1Range(m.src);
        const d = parseA1Range(m.dst);
        const rows = Math.min(values.length, d.numRows);
        const cols = Math.min(values[0].length, d.numCols);

        if (values.length !== d.numRows || values[0].length !== d.numCols) {
          res.warnings.push(`${src.name} ${m.src}(${values.length}×${values[0].length}) ↔ ${m.dst}(${d.numRows}×${d.numCols}) 크기 불일치 → 겹치는 부분만 사용`);
        }

        const data = values.slice(0, rows).map(r => r.slice(0, cols));
        data.forEach((r, i) => r.forEach((v, j) => {
          const gr = grid[d.row - 1 + i];
          if (gr && d.col - 1 + j < g.numCols) gr[d.col - 1 + j] = v;
        }));
        res.jobs.push({
          row: d.row, col: d.col, values: data,
          key: src.key, short: src.short, srcName: src.name,
          srcRow: s.row, srcCol: s.col, cleared: false,
        });
      });

      info.mmdd = sheet.getName().trim();
      res.dates[src.key] = info.mmdd;
    } catch (e) {
      info.note = '오류: ' + e.message;
      res.errors.push(`${src.name}: ${e.message}`);
    }
  });
  return res;
}

/* 최신 날짜(MMDD) 시트 찾기 */
function findLatestDateSheet(ss) {
  const today = Number(Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'MMdd'));
  const re = /^(0[1-9]|1[0-2])(0[1-9]|[12]\d|3[01])$/;

  let best = null, bestN = -1;   // 오늘(또는 어제) 이전 중 가장 최신
  let maxAll = null, maxN = -1;  // 연초 대비용: 전체 중 가장 큰 날짜

  ss.getSheets().forEach(sh => {
    const name = sh.getName().trim();
    if (!re.test(name)) return;
    const n = Number(name);

    if (n > maxN) { maxN = n; maxAll = sh; }

    const inRange = CONFIG.INCLUDE_TODAY ? n <= today : n < today;
    if (inRange && n > bestN) { bestN = n; best = sh; }
  });

  // 1월 초처럼 오늘 이전 시트가 없으면 전체 중 최신(작년 12월)을 사용
  return best || maxAll;
}

