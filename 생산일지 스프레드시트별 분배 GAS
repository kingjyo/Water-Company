/* ═════════════ 분배 계획 만들기 (②③④ 공통 · 읽기만 함) ═════════════ */
function buildDistributionPlan(grid, dates, done) {
  done = done || {};

  const getSum = a1 => {
    const p = parseA1Range(a1);
    const row = grid[p.row - 1];
    return row && row[p.col - 1] !== undefined ? row[p.col - 1] : '';
  };
  const srcOf = key => CONFIG.SOURCES.find(s => s.key === key) || { key, short: key, name: key };

  const tasks = [], warnings = [], errors = [], skipped = {}, already = {};

  const items = DIST.ITEMS.map(it => Object.assign({}, it, {
    cells: Object.keys(it.cols).map(c => ({ from: c + it.row, to: it.cols[c], label: SUM_LABELS[c] })),
  }));
  items.push(Object.assign({}, DIST.GLUE, { cells: buildGlueCells(getSum, warnings) }));

  items.forEach(it => {
    const src = srcOf(it.src);
    const base = {
      group: src.short, name: it.name, id: it.id, gid: '', sheet: null, sheetName: '',
      a1: '', from: '', label: '', oldVal: '', newVal: '', status: '', note: '', write: false,
    };

    const mmdd = dates[it.src];
    if (!mmdd) {
      (skipped[src.name] = skipped[src.name] || []).push(it.name);
      tasks.push(Object.assign(base, { status: '건너뜀(원본 없음)', note: `${src.name} 데이터 없음` }));
      return;
    }

    if (DIST.SKIP_DISTRIBUTED && done[it.src] === mmdd) {
      (already[src.name] = already[src.name] || { mmdd, names: [] }).names.push(it.name);
      tasks.push(Object.assign(base, {
        sheetName: `${Number(mmdd.slice(0, 2))}월`,
        status: '건너뜀(이미 배분됨)',
        note: `${src.name} ${mmddLabel(mmdd)} 자료는 이미 배분함`,
      }));
      return;
    }

    const day = Number(mmdd.slice(2));
    base.sheetName = `${Number(mmdd.slice(0, 2))}월`;

    try {
      const sheet = SpreadsheetApp.openById(it.id).getSheetByName(base.sheetName);
      if (!sheet) throw new Error(`'${base.sheetName}' 시트가 없습니다.`);

      const range = sheet.getRange(DIST.FORMS[it.form]);
      const vals = range.getValues();
      const formulas = range.getFormulas();
      const idx = vals.findIndex(r => dayOf(r[0]) === day);
      if (idx < 0) throw new Error(`'${base.sheetName}' A열에서 ${day}일 행을 찾지 못했습니다.`);

      const row = range.getRow() + idx;
      const gid = sheet.getSheetId();

      it.cells.forEach(c => {
        const ci = colToNum(c.to) - range.getColumn();
        const newVal = getSum(c.from);
        const oldVal = vals[idx][ci];

        let status, note = c.note || '';
        if (isBlank(newVal) && !DIST.WRITE_BLANK) status = '건너뜀(빈칸)';
        else if (DIST.SKIP_ZERO && isZero(newVal)) {
          status = '건너뜀(0)';
          note = note || '모음 값이 0이라 입력하지 않음';
        }
        else if (isErrorValue(newVal))            status = '건너뜀(오류값)';
        else if (formulas[idx][ci])               status = '건너뜀(수식 셀)';
        else if (sameValue(oldVal, newVal))       status = '동일';
        else                                      status = isBlank(oldVal) ? '입력' : '덮어쓰기';

        tasks.push(Object.assign({}, base, {
          sheet, gid, a1: c.to + row, from: c.from, label: c.label,
          oldVal, newVal, status, note,
          write: status === '입력' || status === '덮어쓰기',
        }));
      });
    } catch (e) {
      errors.push(`${it.name}: ${e.message}`);
      tasks.push(Object.assign(base, { status: '오류', note: e.message }));
    }
  });

  Object.keys(skipped).forEach(name => warnings.push(`${name} 데이터가 없어 건너뜀 → ${skipped[name].join(', ')}`));
  Object.keys(already).forEach(name => {
    const a = already[name];
    warnings.push(`${name} ${mmddLabel(a.mmdd)} 자료는 이미 배분해서 건너뜀 → ${a.names.join(', ')}`);
  });
  return { tasks, warnings, errors };
}

/* GLUE: 생산 제품을 판별해서 F15의 입력 열 결정 */
function buildGlueCells(getSum, warnings) {
  const g = DIST.GLUE;
  const cells = [{ from: g.inCell, to: 'B', label: '입고량' }];

  const made = g.products.filter(p => p.checks.some(a1 => hasValue(getSum(a1))));
  if (made.length === 1) {
    cells.push({
      from: g.petCell, to: made[0].col, label: `사용량 (${made[0].label})`,
      note: `${made[0].label} 생산 감지 → ${made[0].col}열`,
    });
  } else if (hasValue(getSum(g.petCell))) {
    warnings.push(made.length === 0
      ? `GLUE: ${g.petCell}에 사용량이 있지만 생산 제품(1.5L/0.5L/0.33L)을 찾지 못해 건너뜀`
      : `GLUE: 생산 제품이 여러 개(${made.map(p => p.label).join(', ')})로 감지되어 ${g.petCell} 건너뜀`);
  }

  cells.push({ from: g.cupCell, to: g.cupCol, label: '사용량 (0.12L)' });
  return cells;
}

/* ═════════════ '테스트 결과' 시트 작성 (분배) ═════════════ */
function writeTestResult(plan, meta) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const BS = SpreadsheetApp.BorderStyle;
  const W = 11; // A~K
  const done = meta.done || {};

  const now = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm:ss');
  const sh = makeResultSheet(
    DIST.RESULT_SHEET, '원부재료 분배 테스트 결과',
    `모드: ${meta.mode}     ·     생성: ${now}     ·     ※ 테스트 결과이며, 실제 원부재료 스프레드시트에는 아무것도 입력되지 않았습니다.`,
    [45, 60, 160, 60, 80, 110, 75, 95, 95, 120, 320]);

  let r = 4;

  // ── 기준 날짜
  resultSection(sh, r, '■ 기준 날짜', W); r++;
  const srcRows = [['구분', '생산일지', '사용 시트', '분배 날짜', '배분 기록', '비고']]
    .concat(meta.sources.map(s => [
      s.short, s.name, s.mmdd || '-', s.mmdd ? mmddLabel(s.mmdd) : '-',
      doneLabel(done[s.key], s.mmdd), s.note || '',
    ]));
  srcRows.forEach((row, i) => {
    sh.getRange(r + i, 2, 1, 5).setValues([row.slice(0, 5)]);
    sh.getRange(r + i, 7, 1, 5).merge().setValue(row[5]);
  });
  sh.getRange(r, 2, srcRows.length, 10)
    .setBorder(true, true, true, true, true, true, '#d0d0d0', BS.SOLID).setVerticalAlignment('middle');
  sh.getRange(r, 2, srcRows.length, 5).setHorizontalAlignment('center');
  resultHeaderStyle(sh.getRange(r, 2, 1, 10));
  meta.sources.forEach((s, i) => {
    if (!s.mmdd) sh.getRange(r + 1 + i, 2, 1, 10).setFontColor('#c62828');
    else if (done[s.key] === s.mmdd) sh.getRange(r + 1 + i, 6).setFontColor('#e65100').setFontWeight('bold');
  });
  r += srcRows.length + 1;

  // ── 요약 카드
  resultSection(sh, r, '■ 요약', W); r++;
  const cnt = countStatus(plan.tasks);
  const compared = cnt['동일'] + cnt['덮어쓰기'];
  const compareText = compared
    ? `${cnt['동일']} / ${compared}칸 일치 (${Math.round(cnt['동일'] / compared * 100)}%)`
    : '비교할 기존 값 없음';
  resultCards(sh, r, [
    [2, 2, '입력',           `${cnt['입력']}칸`,     '#e8f5e9', '#2e7d32'],
    [4, 2, '덮어쓰기',       `${cnt['덮어쓰기']}칸`, '#fff3e0', '#e65100'],
    [6, 2, '동일',           `${cnt['동일']}칸`,     '#e3f2fd', '#1565c0'],
    [8, 2, '건너뜀',         `${cnt['건너뜀']}칸`,   '#f5f5f5', '#757575'],
    [10, 1, '오류',          `${cnt['오류']}건`,     '#ffebee', '#c62828'],
    [11, 1, '기존 값과 비교', compareText,            '#ede7f6', '#4527a0', 12],
  ]);
  r += 3;

  // ── 확인 필요 (오류/경고)
  r = writeMessages(sh, r, W, plan.errors, plan.warnings);

  // ── 상세 내역
  resultSection(sh, r, '■ 상세 내역     (입력 셀 클릭 → 해당 스프레드시트로 이동 · 헤더 필터로 상태별 보기 가능)', W); r++;
  const head = ['No', '구분', '원부재료', '시트', '입력 셀', '항목', '모음 셀', '기존 값', '입력 값', '상태', '비고'];
  const hr = r;
  sh.getRange(hr, 1, 1, W).setValues([head]);
  resultHeaderStyle(sh.getRange(hr, 1, 1, W));
  sh.setRowHeight(hr, 30);

  const n = plan.tasks.length;
  if (n) {
    const body = sh.getRange(hr + 1, 1, n, W);
    body.setValues(plan.tasks.map((t, i) =>
      [i + 1, t.group, t.name, t.sheetName, '', t.label, t.from, t.oldVal, t.newVal, t.status, t.note]));

    const STYLE = { // [배경, 글자, 상태 글자]
      '입력':     ['#e8f5e9', '#000000', '#2e7d32'],
      '덮어쓰기': ['#fff3e0', '#000000', '#e65100'],
      '동일':     ['#ffffff', '#000000', '#1565c0'],
      '건너뜀':   ['#ffffff', '#9e9e9e', '#9e9e9e'],
      '오류':     ['#ffebee', '#000000', '#c62828'],
    };
    const bgs = [], fgs = [];
    plan.tasks.forEach(t => {
      const s = STYLE[t.status.split('(')[0]] || STYLE['동일'];
      bgs.push(Array(W).fill(s[0]));
      const row = Array(W).fill(s[1]);
      row[9] = s[2];
      fgs.push(row);
    });
    body.setBackgrounds(bgs).setFontColors(fgs).setVerticalAlignment('middle')
      .setBorder(true, true, true, true, true, true, '#d9d9d9', BS.SOLID);

    const colA1 = c => sh.getRange(hr + 1, c, n, 1).getA1Notation();
    sh.getRangeList([1, 2, 4, 5, 6, 7, 10].map(colA1)).setHorizontalAlignment('center');
    sh.getRangeList([8, 9].map(colA1)).setHorizontalAlignment('right');
    sh.getRangeList([3, 10].map(colA1)).setFontWeight('bold');

    // 입력 셀 → 원부재료 스프레드시트 바로가기 링크
    sh.getRange(hr + 1, 5, n, 1).setRichTextValues(plan.tasks.map(t => {
      const b = SpreadsheetApp.newRichTextValue().setText(t.a1 || '-');
      if (t.a1) b.setLinkUrl(`https://docs.google.com/spreadsheets/d/${t.id}/edit#gid=${t.gid}&range=${t.a1}`);
      return [b.build()];
    }));

    // 원부재료가 바뀌는 지점에 굵은 구분선
    plan.tasks.forEach((t, i) => {
      if (i > 0 && t.name !== plan.tasks[i - 1].name) {
        sh.getRange(hr + 1 + i, 1, 1, W).setBorder(true, null, null, null, null, null, '#7f7f7f', BS.SOLID_MEDIUM);
      }
    });

    sh.getRange(hr, 1, n + 1, W).createFilter();
  }

  ss.setActiveSheet(sh);
  sh.setActiveSelection('A1');
}

/* ═════════════ '불러오기 테스트 결과' 시트 작성 ═════════════ */
function writeImportTestResult(res, ymd, applied) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const BS = SpreadsheetApp.BorderStyle;
  const W = 10; // A~J

  const cur = getSummarySheet().getRange(CONFIG.GRID).getValues();
  const g = parseA1Range(CONFIG.GRID);

  // 시트를 못 찾은 원본 → 비울 영역도 목록에 포함
  const jobs = res.jobs.slice();
  if (CONFIG.CLEAR_MISSING) {
    res.missing.forEach(src => src.maps.forEach(m => {
      const d = parseA1Range(m.dst), s = parseA1Range(m.src);
      jobs.push({
        row: d.row, col: d.col,
        values: Array.from({ length: d.numRows }, () => Array(d.numCols).fill('')),
        key: src.key, short: src.short, srcName: src.name,
        srcRow: s.row, srcCol: s.col, cleared: true,
      });
    }));
  }

  // ── 셀 단위 비교
  const rows = [];
  const cnt = { '입력': 0, '변경': 0, '비움': 0, '동일': 0, '빈칸': 0 };
  jobs.forEach(j => {
    j.values.forEach((vals, i) => vals.forEach((v, k) => {
      const gr = j.row - 1 + i, gc = j.col - 1 + k;
      if (gr >= g.numRows || gc >= g.numCols) return;

      const oldVal = cur[gr][gc];
      if (isBlank(v) && isBlank(oldVal)) { cnt['빈칸']++; return; }

      let status, note = '';
      if (sameValue(oldVal, v))   status = '동일';
      else if (isBlank(v))      { status = '비움'; note = j.cleared ? '해당 날짜 시트 없음(미생산) → 모음 값 지움' : '원본이 비어 있어 모음의 기존 값이 지워짐'; }
      else if (isBlank(oldVal))   status = '입력';
      else                      { status = '변경'; note = '모음의 기존 값을 덮어씀'; }
      if (!note && DIST.SKIP_ZERO && isZero(v)) note = '값이 0 → ④ 배분 때는 입력하지 않음';
      cnt[status]++;

      rows.push([
        j.short, j.srcName, res.dates[j.key] || '-',
        j.cleared ? '-' : colName(j.srcCol + k) + (j.srcRow + i),
        colName(gc + 1) + (gr + 1),
        oldVal, v, status, note,
      ]);
    }));
  });

  const now = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm:ss');
  const sh = makeResultSheet(
    CONFIG.IMPORT_RESULT_SHEET, '생산일지 모음 불러오기 결과',
    `대상 날짜: ${ymd.text} (${ymd.dow})     ·     생성: ${now}     ·     상태: ${applied ? '입력 완료' : '미리보기 — 아직 입력하지 않았습니다.'}`,
    [45, 60, 150, 80, 80, 80, 110, 110, 90, 300]);

  let r = 4;

  // ── 대상 시트
  resultSection(sh, r, '■ 대상 시트', W); r++;
  const srcRows = [['구분', '생산일지', '요청 날짜', '찾은 시트', '상태', '비고']]
    .concat(res.info.map(s => [
      s.short, s.name, ymd.mmdd, s.mmdd || '-',
      s.mmdd ? '찾음' : (s.note.indexOf('오류') === 0 ? '오류' : '시트 없음'),
      s.note || '',
    ]));
  srcRows.forEach((row, i) => {
    sh.getRange(r + i, 2, 1, 5).setValues([row.slice(0, 5)]);
    sh.getRange(r + i, 7, 1, 4).merge().setValue(row[5]);
  });
  sh.getRange(r, 2, srcRows.length, 9)
    .setBorder(true, true, true, true, true, true, '#d0d0d0', BS.SOLID).setVerticalAlignment('middle');
  sh.getRange(r, 2, srcRows.length, 5).setHorizontalAlignment('center');
  resultHeaderStyle(sh.getRange(r, 2, 1, 9));
  res.info.forEach((s, i) => {
    if (!s.mmdd) sh.getRange(r + 1 + i, 2, 1, 9).setFontColor('#c62828').setBackground('#ffebee');
  });
  r += srcRows.length + 1;

  const notFound = res.info.filter(s => !s.mmdd).length;

  // ── 요약 카드
  resultSection(sh, r, '■ 요약', W); r++;
  resultCards(sh, r, [
    [2, 2, '입력',         `${cnt['입력']}칸`,   '#e8f5e9', '#2e7d32'],
    [4, 2, '변경',         `${cnt['변경']}칸`,   '#fff3e0', '#e65100'],
    [6, 1, '비움',         `${cnt['비움']}칸`,   '#ffebee', '#c62828'],
    [7, 1, '동일',         `${cnt['동일']}칸`,   '#e3f2fd', '#1565c0'],
    [8, 1, '빈칸→빈칸',    `${cnt['빈칸']}칸`,   '#f5f5f5', '#757575'],
    [9, 2, '시트 못 찾음', `${notFound}개 원본`, '#ede7f6', '#4527a0', 13],
  ]);
  r += 3;

  // ── 확인 필요
  const extra = res.info.filter(s => !s.mmdd)
    .map(s => `${s.name}: ${ymd.mmdd} 시트가 없습니다. 해당 날짜에 생산이 없었을 가능성이 높습니다.`);
  r = writeMessages(sh, r, W, res.errors, extra.concat(res.warnings));

  // ── 상세 내역
  resultSection(sh, r, '■ 상세 내역     (빈칸 → 빈칸인 셀은 생략 · 헤더 필터로 상태별 보기 가능)', W); r++;
  const head = ['No', '구분', '생산일지', '원본 시트', '원본 셀', '모음 셀', '기존 값', '불러올 값', '상태', '비고'];
  const hr = r;
  sh.getRange(hr, 1, 1, W).setValues([head]);
  resultHeaderStyle(sh.getRange(hr, 1, 1, W));
  sh.setRowHeight(hr, 30);

  const n = rows.length;
  if (n) {
    const body = sh.getRange(hr + 1, 1, n, W);
    body.setValues(rows.map((row, i) => [i + 1].concat(row)));

    const STYLE = {
      '입력': ['#e8f5e9', '#000000', '#2e7d32'],
      '변경': ['#fff3e0', '#000000', '#e65100'],
      '비움': ['#ffebee', '#000000', '#c62828'],
      '동일': ['#ffffff', '#000000', '#1565c0'],
    };
    const bgs = [], fgs = [];
    rows.forEach(row => {
      const s = STYLE[row[7]] || STYLE['동일'];
      bgs.push(Array(W).fill(s[0]));
      const f = Array(W).fill(s[1]);
      f[8] = s[2];
      fgs.push(f);
    });
    body.setBackgrounds(bgs).setFontColors(fgs).setVerticalAlignment('middle')
      .setBorder(true, true, true, true, true, true, '#d9d9d9', BS.SOLID);

    const colA1 = c => sh.getRange(hr + 1, c, n, 1).getA1Notation();
    sh.getRangeList([1, 2, 4, 5, 6, 9].map(colA1)).setHorizontalAlignment('center');
    sh.getRangeList([7, 8].map(colA1)).setHorizontalAlignment('right');
    sh.getRangeList([9].map(colA1)).setFontWeight('bold');

    rows.forEach((row, i) => {
      if (i > 0 && row[0] !== rows[i - 1][0]) {
        sh.getRange(hr + 1 + i, 1, 1, W).setBorder(true, null, null, null, null, null, '#7f7f7f', BS.SOLID_MEDIUM);
      }
    });

    sh.getRange(hr, 1, n + 1, W).createFilter();
  } else {
    sh.getRange(hr + 1, 1).setValue('변경할 내용이 없습니다. (모든 대상 셀이 이미 같거나 비어 있습니다)');
    sh.getRange(hr + 1, 1, 1, W).merge().setFontColor('#9e9e9e').setHorizontalAlignment('center');
  }

  ss.setActiveSheet(sh);
  sh.setActiveSelection('A1');
  return { sh, W, cnt, notFound, total: n };
}

/* ═════════════ 결과 시트 공통 서식 ═════════════ */
function makeResultSheet(name, title, subtitle, widths) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const W = widths.length;

  const old = ss.getSheetByName(name);
  if (old) ss.deleteSheet(old);
  const sh = ss.insertSheet(name, ss.getNumSheets());
  sh.setHiddenGridlines(true);
  widths.forEach((w, i) => sh.setColumnWidth(i + 1, w));

  sh.getRange(1, 1).setValue('  ' + title);
  sh.getRange(1, 1, 1, W).merge().setFontSize(16).setFontWeight('bold')
    .setFontColor('#ffffff').setBackground('#1f3864').setVerticalAlignment('middle');
  sh.setRowHeight(1, 42);

  sh.getRange(2, 1).setValue('  ' + subtitle);
  sh.getRange(2, 1, 1, W).merge().setFontColor('#44546a').setBackground('#d9e2f3').setVerticalAlignment('middle');
  sh.setRowHeight(2, 26);

  return sh;
}

function setResultSubtitle(sh, W, text, bg, color) {
  sh.getRange(2, 1).setValue('  ' + text);
  sh.getRange(2, 1, 1, W).setBackground(bg).setFontColor(color).setFontWeight('bold');
}

function resultSection(sh, row, text, W) {
  const BS = SpreadsheetApp.BorderStyle;
  sh.getRange(row, 1).setValue(text);
  sh.getRange(row, 1, 1, W).merge()
    .setFontWeight('bold').setFontSize(11).setFontColor('#1f3864').setVerticalAlignment('bottom')
    .setBorder(null, null, true, null, null, null, '#1f3864', BS.SOLID_MEDIUM);
  sh.setRowHeight(row, 28);
}

function resultHeaderStyle(range) {
  return range.setBackground('#1f3864').setFontColor('#ffffff').setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
}

function resultCards(sh, row, cards) {
  const BS = SpreadsheetApp.BorderStyle;
  cards.forEach(c => {
    const [col, span, label, value, bg, fg, size] = c;
    sh.getRange(row, col).setValue(label);
    sh.getRange(row + 1, col).setValue(value);
    if (span > 1) {
      sh.getRange(row, col, 1, span).merge();
      sh.getRange(row + 1, col, 1, span).merge();
    }
    sh.getRange(row, col, 2, span)
      .setBackground(bg).setFontColor(fg).setFontWeight('bold')
      .setHorizontalAlignment('center').setVerticalAlignment('middle')
      .setBorder(true, true, true, true, null, null, '#ffffff', BS.SOLID_THICK);
    sh.getRange(row + 1, col, 1, span).setFontSize(size || 15);
  });
  sh.setRowHeight(row, 24);
  sh.setRowHeight(row + 1, 40);
}

function writeMessages(sh, r, W, errors, warnings) {
  const msgs = (errors || []).map(m => ['❌ ' + m, '#c62828'])
    .concat((warnings || []).map(m => ['⚠ ' + m, '#e65100']));
  if (!msgs.length) return r;

  resultSection(sh, r, '■ 확인 필요', W); r++;
  msgs.forEach(([text, color]) => {
    sh.getRange(r, 2).setValue(text);
    sh.getRange(r, 2, 1, W - 1).merge().setFontColor(color);
    r++;
  });
  return r + 1;
}

/* ═════════════ 공통 도우미 ═════════════ */
