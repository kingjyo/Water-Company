}

function saveDoneDates(done) {
  PropertiesService.getDocumentProperties().setProperty(DIST.DONE_KEY, JSON.stringify(done));
}

function doneLabel(doneMmdd, curMmdd) {
  if (!doneMmdd) return '없음';
  return doneMmdd === curMmdd ? `${mmddLabel(doneMmdd)} · 이미 배분됨` : `${mmddLabel(doneMmdd)}까지`;
}

function findSheetByName(ss, name) {
  return ss.getSheets().find(sh => sh.getName().trim() === name) || null;
}

function promptYmd(title, text) {
  const ui = SpreadsheetApp.getUi();
  const resp = ui.prompt(title, text, ui.ButtonSet.OK_CANCEL);
  if (resp.getSelectedButton() !== ui.Button.OK) return null;

  const input = resp.getResponseText().trim();
  const ymd = parseYmd(input);
  if (!ymd) {
    ui.alert('날짜 형식 오류',
      `'${input}'은(는) 올바른 날짜가 아닙니다.\nYYYY-MM-DD 형식으로 입력하세요. (예: 2026-09-10)`,
      ui.ButtonSet.OK);
    return null;
  }
  return ymd;
}

function yearWarning(ymd) {
  const thisYear = Number(Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy'));
  if (ymd.y === thisYear) return [];
  return [`입력 연도(${ymd.y})가 올해(${thisYear})와 다릅니다. 시트 이름에 연도가 없어 현재 설정된 파일의 '${ymd.mmdd}' 시트를 사용했습니다.`];
}

function parseYmd(text) {
  const m = String(text).match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
  if (!m) return null;
  const y = Number(m[1]), mo = Number(m[2]), d = Number(m[3]);
  const dt = new Date(y, mo - 1, d);
  if (dt.getFullYear() !== y || dt.getMonth() !== mo - 1 || dt.getDate() !== d) return null;
  const pad = v => String(v).padStart(2, '0');
  return { y, m: mo, d, mmdd: pad(mo) + pad(d), text: `${y}-${pad(mo)}-${pad(d)}`, dow: '일월화수목금토'[dt.getDay()] };
}

function parseA1Range(a1) {
  const m = String(a1).match(/^([A-Z]+)(\d+)(?::([A-Z]+)(\d+))?$/);
  if (!m) throw new Error(`잘못된 셀 주소: ${a1}`);
  const row = Number(m[2]), col = colToNum(m[1]);
  const row2 = m[4] ? Number(m[4]) : row;
  const col2 = m[3] ? colToNum(m[3]) : col;
  return { row, col, numRows: row2 - row + 1, numCols: col2 - col + 1 };
}

function colToNum(col) {
  return col.split('').reduce((n, ch) => n * 26 + ch.charCodeAt(0) - 64, 0);
}

function colName(num) {
  let s = '';
  while (num > 0) {
    const r = (num - 1) % 26;
    s = String.fromCharCode(65 + r) + s;
    num = Math.floor((num - 1) / 26);
  }
  return s;
}

function mmddLabel(mmdd) {
  return `${Number(mmdd.slice(0, 2))}월 ${Number(mmdd.slice(2))}일`;
}

function countStatus(tasks) {
  const c = { '입력': 0, '덮어쓰기': 0, '동일': 0, '건너뜀': 0, '오류': 0 };
  tasks.forEach(t => {
    const k = t.status.split('(')[0];
    if (k in c) c[k]++;
  });
  return c;
}

function dayOf(v) {
  return v instanceof Date ? v.getDate() : parseInt(v, 10);
}

function isBlank(v) {
  return v === '' || v === null;
}

function isZero(v) {
  if (isBlank(v) || typeof v === 'boolean' || v instanceof Date) return false;
  const n = Number(v);
  return !isNaN(n) && n === 0;
}

function hasValue(v) {
  return !isBlank(v) && Number(v) !== 0;
}

function isErrorValue(v) {
  return typeof v === 'string' && /^#(N\/A|REF!|DIV\/0!|VALUE!|NAME\?|NUM!|NULL!|ERROR!)/.test(v);
}

function sameValue(a, b) {
  if (isBlank(a) || isBlank(b)) return isBlank(a) && isBlank(b);
  const na = Number(a), nb = Number(b);
  if (!isNaN(na) && !isNaN(nb)) return Math.abs(na - nb) < 1e-6;
  return String(a).trim() === String(b).trim();
}