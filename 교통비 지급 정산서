// 사유 생성 함수들 (BTL, 제품생산, CIP)
// ───────────────────────────────────────────
function getBTLReason(dayPlan) {
  if (!dayPlan) return 'BTL/CAP 생산';
  const btlPart = [];
  if (hasValue(dayPlan.I)) btlPart.push('1.5L BTL');
  if (hasValue(dayPlan.J)) btlPart.push('0.5L BTL');
  if (hasValue(dayPlan.K)) btlPart.push('0.33L BTL');
  const parts = [];
  if (btlPart.length > 0) parts.push(btlPart.join('/'));
  if (hasValue(dayPlan.L)) parts.push('CAP');
  return parts.length > 0 ? parts.join('/') + ' 생산' : 'BTL/CAP 생산';
}

function getSejeumReason(type, dayPlan) {
  if (type === 'L') return '정비 연장';
  if (!dayPlan) return type === 'B' ? 'BTL 생산' : '제품 생산';

  if (type === 'B') {
    const parts = [];
    if (hasValue(dayPlan.I)) parts.push('1.5L BTL');
    if (hasValue(dayPlan.J)) parts.push('0.5L BTL');
    if (hasValue(dayPlan.K)) parts.push('0.33L BTL');
    return parts.length > 0 ? parts.join('/') + ' 생산' : 'BTL 생산';
  }

  if (type === 'P') {
    if (hasValue(dayPlan.D)) return '1.5L 제품 생산';
    if (hasValue(dayPlan.E)) return '0.5L 제품 생산';
    if (hasValue(dayPlan.F)) return '0.33L 제품 생산';
    if (hasValue(dayPlan.G)) return '0.12L 제품 생산';
    return '제품 생산';
  }
  return '연장 근무';
}

function getCIPReasons(dayPlan, group) {
  if (!group || group.length === 0) return [];
  if (!dayPlan) return Array(group.length).fill('CIP');

  const morning = group.filter(r => r.type === '조');
  const evening = group.filter(r => r.type === '연');
  const reasons = [];

  if (morning.length > 0) {
    if (hasValue(dayPlan.H)) {
      reasons.push('0.19L 생산라인 CIP');
    } else {
      reasons.push(getNextCIP(dayPlan, 'morning'));
    }
    for (let i = 1; i < morning.length; i++) reasons.push(getNextCIP(dayPlan, 'morning'));
  }
  for (let i = 0; i < evening.length; i++) reasons.push(getNextCIP(dayPlan, 'evening'));
  return reasons;
}

function getNextCIP(dayPlan, shiftType) {
  const priorities = shiftType === 'morning'
    ? ['C', 'D', 'E', 'F', 'G']
    : ['D', 'E', 'F', 'C', 'G'];
  for (const col of priorities) {
    if (hasValue(dayPlan[col])) return getCIPReasonName(col);
  }
  return 'CIP';
}

function getCIPReasonName(col) {
  const map = {
    'C': '18.9L 생산라인 CIP',
    'D': '1.5L 생산라인 CIP',
    'E': '0.5L 생산라인 CIP',
    'F': '0.33L 생산라인 CIP',
    'G': '0.12L 생산라인 CIP',
    'H': '0.19L 생산라인 CIP'
  };
  return map[col] || 'CIP';
}

// ───────────────────────────────────────────
// 구간·주행거리 결정 (특이사항 km > 사람별 > 시트 기본)
// ───────────────────────────────────────────
function resolveTrip_(key, row) {
  let route = ROUTE_TEXT;
  let distance = SHEET_CFG[key].distance;

  const p = PERSON_ROUTE[normName_(row.name)];
  if (p) {
    if (p.route) route = p.route;
    const d = (p.distance !== null && typeof p.distance === 'object') ? p.distance[key] : p.distance;
    if (typeof d === 'number' && d > 0) distance = d;
  }
  if (typeof row.km === 'number' && row.km > 0) distance = row.km;   // 특이사항에 적은 주행거리
  return { route, distance };
}

// ───────────────────────────────────────────
// 공통 시트 쓰기
// 반환: { count, sumRow, addedRows }
// ───────────────────────────────────────────
function writeToSheet(targetSheet, rows, monthName) {
  let sumRow = findSumRow(targetSheet);
  if (sumRow <= DATA_START_ROW) {
    throw new Error(`"${targetSheet.getName()}" 시트의 합계 행 위치(${sumRow}행)가 올바르지 않습니다.`);
  }

  // 1) 숨겨진 데이터 행 모두 펼치기
  targetSheet.showRows(DATA_START_ROW, sumRow - DATA_START_ROW);

  // 2) 행이 모자라면 자동 확장 (데이터가 잘리지 않게)
  let addedRows = 0;
  if (rows.length > sumRow - DATA_START_ROW) {
    addedRows = rows.length - (sumRow - DATA_START_ROW);
    sumRow = insertDataRows_(targetSheet, sumRow, addedRows);
  }
  const capacity = sumRow - DATA_START_ROW;

  // 3) 5행 ~ 합계 바로 윗행까지 A~F 전부 비우기
  targetSheet.getRange(DATA_START_ROW, 1, capacity, 6).clearContent();
  targetSheet.getRange(DATA_START_ROW, 2, capacity, 1).setNumberFormat(DATE_FORMAT);

  const n = rows.length;
  const sumCell = targetSheet.getRange(sumRow, SUM_COL);

  if (n === 0) {
    sumCell.setValue(0);
    targetSheet.hideRows(DATA_START_ROW, capacity);
    return { count: 0, sumRow: sumRow, addedRows: addedRows };
  }

  // 4) 열 단위 일괄 쓰기 (C:D, E:F 병합 셀 고려해 열별로 기록)
  targetSheet.getRange(DATA_START_ROW, 1, n, 1).setValues(rows.map(r => [r.name]));
  targetSheet.getRange(DATA_START_ROW, 2, n, 1).setValues(rows.map(r => [`${monthName} ${r.day}일`])); // ★ 띄어쓰기
  targetSheet.getRange(DATA_START_ROW, 3, n, 1).setValues(rows.map(r => [r.route || ROUTE_TEXT]));
  targetSheet.getRange(DATA_START_ROW, 5, n, 1).setValues(rows.map(r => [r.reason]));
  targetSheet.getRange(DATA_START_ROW, DIST_COL, n, 1).setValues(rows.map(r => [r.distance]));  // 주행거리

  // 5) 합계 수식 (빈 행의 #N/A를 피하려고 마지막 데이터 행까지만 합산)
  const lastDataRow = DATA_START_ROW + n - 1;
  sumCell.setFormula(`=SUM($K$${DATA_START_ROW}:$K$${lastDataRow})`);

  // 6) 데이터 없는 행 숨기기
  if (capacity > n) targetSheet.hideRows(DATA_START_ROW + n, capacity - n);

  return { count: n, sumRow: sumRow, addedRows: addedRows };
}

// ───────────────────────────────────────────
// 공통 데이터 로딩
// ───────────────────────────────────────────
function loadData() {
  const month = getMonthNumber();
  const parsed = parseMonthlyWorkData(month);
  const plan = parsePlanData(month);
  return { month, records: parsed.records, rankMap: parsed.rankMap, plan, endMarkFound: parsed.endMarkFound, endRow: parsed.endRow };
}

function rankOf_(rankMap, name) {
  return (name in rankMap) ? rankMap[name] : 999;
}

// ───────────────────────────────────────────
// 자동 입력 행 생성 (근무계획 기반)
// kind: CIP는 조=0, 연=1 / 나머지는 0 (특이사항은 2)
// ───────────────────────────────────────────
function buildAutoRows_(key, data) {
  const records = data.records, plan = data.plan, rankMap = data.rankMap;
  const byDayRank = (a, b) => {
    if (a.day !== b.day) return a.day - b.day;
    return rankOf_(rankMap, a.name) - rankOf_(rankMap, b.name);
  };

  if (key === 'BTL') {
    return records.filter(r => r.type === '야').sort(byDayRank)
      .map(r => ({ name: r.name, day: r.day, reason: getBTLReason(plan[r.day]), kind: 0, special: false }));
  }

  if (key === 'SEJEUM') {
    return records.filter(r => ['B', 'P', 'L'].includes(r.type)).sort(byDayRank)
      .map(r => ({ name: r.name, day: r.day, reason: getSejeumReason(r.type, plan[r.day]), kind: 0, special: false }));
  }

  // CIP
  const filtered = records
    .filter(r => r.type === '조' || r.type === '연')
    .sort((a, b) => {
      if (a.day !== b.day) return a.day - b.day;
      if (a.type !== b.type) return a.type === '조' ? -1 : 1;
      return rankOf_(rankMap, a.name) - rankOf_(rankMap, b.name);
    });

  const dayGroups = {};
  for (const r of filtered) {
    if (!dayGroups[r.day]) dayGroups[r.day] = [];
    dayGroups[r.day].push(r);
  }

  const rows = [];
  for (const day of Object.keys(dayGroups).map(Number).sort((a, b) => a - b)) {
    const group = dayGroups[day];
    const reasons = getCIPReasons(plan[day], group);
    group.forEach((r, i) => {
      rows.push({ name: r.name, day: r.day, reason: reasons[i], kind: r.type === '조' ? 0 : 1, special: false });
    });
  }
  return rows;
}

// ───────────────────────────────────────────
// 자동 입력 + 특이사항 병합 정렬
// • BTL/제품생산: 날짜 → 직급 → (자동 먼저)
// • 품질 CIP : 날짜 → 조 → 연 → 특이사항 → 직급
// ───────────────────────────────────────────
function mergeAndSort_(key, autoRows, specials, rankMap) {
  const all = autoRows.concat(specials.map(s => ({
    name: s.name, day: s.day, reason: s.reason, km: s.km, kind: 2, special: true
  })));
  const kindFirst = (key === 'CIP');
  all.sort((a, b) => {
    if (a.day !== b.day) return a.day - b.day;
    if (kindFirst && a.kind !== b.kind) return a.kind - b.kind;
    const ra = rankOf_(rankMap, a.name), rb = rankOf_(rankMap, b.name);
    if (ra !== rb) return ra - rb;
    return a.kind - b.kind;
  });
  return all;
}

// ───────────────────────────────────────────
// 정산 실행 본체 — mode: 'ALL' | 'BTL' | 'SEJEUM' | 'CIP'
// 반환: 결과 요약 문자열
// ───────────────────────────────────────────
function runFill_(mode, expectedMonth) {
  const data = loadData();
  if (expectedMonth && data.month !== expectedMonth) {
    throw new Error(`기준 월이 ${expectedMonth}월 → ${data.month}월로 바뀌었습니다. 창을 닫고 다시 실행해주세요.`);
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const monthName = `${data.month}월`;
  const keys = mode === 'ALL' ? RUN_SHEET_ORDER : [mode];
  const specialsAll = readSpecials_(data.month);

  const lines = [];
  const warns = [];
  const checks = [];
  const tripNotes = [];
  const written = []; // { key, sheet, sumRow, rows }

  if (!data.endMarkFound) {
    checks.push(` - 근무계획 "${monthName}" 시트 A열에서 "계" 행을 못 찾아 시트 끝(${data.endRow}행)까지 읽음 → 메뉴 [근무계획 이름 확인]으로 확인`);
  }

  for (const key of keys) {
    const cfg = SHEET_CFG[key];
    const sheet = ss.getSheetByName(cfg.sheetName);
    if (!sheet) {
      if (mode === 'ALL') { lines.push(`• ${cfg.sheetName}: 시트 없음 (건너뜀)`); continue; }
      throw new Error(`"${cfg.sheetName}" 시트를 찾을 수 없습니다.`);
    }

    const autoRows = buildAutoRows_(key, data);
    const specials = specialsAll.filter(s => s.sheetKey === key);
    const rows = mergeAndSort_(key, autoRows, specials, data.rankMap);

    // 구간·주행거리
    rows.forEach(r => {
      const t = resolveTrip_(key, r);
      r.route = t.route;
      r.distance = t.distance;
      if (r.special && typeof r.km === 'number' && r.km > 0) {
        tripNotes.push(` - ${cfg.sheetName} / ${r.name} / ${monthName} ${r.day}일 (${r.reason}) → ${r.km}km`);
      }
    });

    const res = writeToSheet(sheet, rows, monthName);
    written.push({ key, sheet, sumRow: res.sumRow, rows });

    let line = `• ${cfg.sheetName}: 총 ${res.count}건 (자동 ${autoRows.length} + 특이사항 ${specials.length}) / 합계 ${res.sumRow}행`;
    if (res.addedRows > 0) line += ` ← 행 부족으로 ${res.addedRows}행 자동 추가`;
    const routeCnt = rows.filter(r => r.route !== ROUTE_TEXT).length;
    if (routeCnt > 0) line += ` / 다른 구간 ${routeCnt}건`;
    lines.push(line);

    specials.forEach(s => {
      if (autoRows.some(a => a.name === s.name && a.day === s.day)) {
        warns.push(` - ${cfg.sheetName} / ${s.name} / ${monthName} ${s.day}일 (${s.reason})`);
      }
    });
  }

  SpreadsheetApp.flush();

  // 실행 후 점검: 개인별 현황 = 합계 ?
  written.forEach(w => checkPersonTables_(w.sheet, w.sumRow, w.rows).forEach(m => checks.push(m)));

  let msg = `${monthName} 교통비 정산 완료\n\n` + lines.join('\n');
  msg += '\n\n' + fuelStatusLine_(data.month);
  if (tripNotes.length > 0) {
    msg += '\n\nℹ 특이사항 주행거리 적용\n' + tripNotes.join('\n');
  }
  if (warns.length > 0) {
    msg += '\n\n⚠ 같은 사람·같은 날에 자동 입력 건과 겹치는 특이사항 (두 행 모두 입력됨, 확인 필요)\n' + warns.join('\n');
  }
  msg += checks.length > 0
    ? '\n\n⚠ 자동 점검에서 확인할 것\n' + checks.join('\n')
    : '\n\n✅ 자동 점검: 개인별 현황 금액·건수가 합계와 일치';
  return msg;
}

// ═══════════════════════════════════════════
// 실행 후 점검 — 합계행 아래 "개인별 현황" 표
//  ① 금액표(첫 번째 '성명' 표) 합 = K 합계
//  ② 건수표(두 번째 '성명' 표) 합 = 입력 건수
//  ③ 입력된 이름이 개인별 현황 표에 있는지
// ═══════════════════════════════════════════
function readPersonTables_(sheet, sumRow) {
  const nRows = Math.min(20, Math.max(0, sheet.getLastRow() - sumRow));
  if (nRows < 1) return [];
  const vals = sheet.getRange(sumRow + 1, 1, nRows, 10).getValues();
  const tables = [];
  let cur = null;
  for (let i = 0; i < nRows; i++) {
    const row = vals[i];
    if (normName_(row[0]) === '성명') { cur = { headerRow: sumRow + 1 + i, items: [] }; tables.push(cur); continue; }
    if (!cur) continue;
    let any = false;
    for (let c = 0; c < 10; c += 2) {
      const nm = normName_(row[c]);
      if (!nm) continue;
      any = true;
      cur.items.push({ name: nm, value: Number(row[c + 1]) || 0 });
    }
    if (!any) cur = null;
  }
  return tables;
}

function checkPersonTables_(sheet, sumRow, rows) {
  const out = [];
  const name = sheet.getName();
  const tables = readPersonTables_(sheet, sumRow);
  if (tables.length === 0) return out;

  const total = Number(sheet.getRange(sumRow, SUM_COL).getValue()) || 0;
  const amountSum = tables[0].items.reduce((a, b) => a + b.value, 0);
  if (Math.round(amountSum) !== Math.round(total)) {
    out.push(` - ${name}: 개인별 현황 금액 합 ${fmt_(amountSum)} ≠ 합계 K${sumRow} ${fmt_(total)} → 개인별 현황 표의 이름·수식 확인`);
  }
  if (tables[1]) {
    const cntSum = tables[1].items.reduce((a, b) => a + b.value, 0);
    if (cntSum !== rows.length) {
      out.push(` - ${name}: 개인별 현황 건수 합 ${cntSum} ≠ 입력 ${rows.length}건 → 교통비 발생 내역 "근무인원"이 틀어짐`);
    }
  }
  const listed = new Set(tables[0].items.map(x => x.name));
  const missing = [];
  rows.forEach(r => { const k = normName_(r.name); if (!listed.has(k) && missing.indexOf(k) < 0) missing.push(k); });
  if (missing.length > 0) {
    out.push(` - ${name}: 개인별 현황 표에 없는 이름 ${missing.join(', ')} → 금액·인원 집계에서 빠짐 (표에 칸 추가 필요)`);
  }
  return out;
}

function fmt_(n) {
  return Math.round(Number(n) || 0).toLocaleString('ko-KR');
}

// ═══════════════════════════════════════════
// ⛽ 유류단가 확인
// ═══════════════════════════════════════════

/** 메일 본문에서 휘발유·경유·LPG 단가 추출 (못 읽으면 null) */
function parseFuelPrices_(body) {
  const t = String(body || '').replace(/ /g, ' ');
  const grab = re => { const m = t.match(re); return m ? Number(m[1].replace(/,/g, '')) : null; };
  const g = grab(/휘\s*발\s*유\s*[:：]\s*([\d,]+)/);
  const d = grab(/경\s*유\s*[:：]\s*([\d,]+)/);
  const l = grab(/L\s*\.?\s*P\s*\.?\s*G\s*[:：]\s*([\d,]+)/i);
  if (!g || !d || !l) return null;
  return { '휘발유': g, '경유': d, 'LPG': l };
}

/** "{month}월 마감 ... 유류단가" 메일 찾기 */
function findFuelMail_(month) {
  if (!FUEL_USE_GMAIL) return { status: 'off' };
  try {
    const threads = GmailApp.search(`subject:${FUEL_MAIL_KEYWORD} newer_than:${FUEL_MAIL_LOOKBACK_DAYS}d`, 0, 30);
    const subjRe = new RegExp(`(^|[^0-9])${month}\\s*월\\s*마감`);
    for (const th of threads) {
      if (!subjRe.test(th.getFirstMessageSubject())) continue;
      const msgs = th.getMessages();
      for (let i = msgs.length - 1; i >= 0; i--) {
        const p = parseFuelPrices_(msgs[i].getPlainBody());
        if (p) return { status: 'found', prices: p, date: msgs[i].getDate(), subject: msgs[i].getSubject() };
      }
    }
    return { status: 'notfound' };
  } catch (e) {
    return { status: 'error', error: e.message };
  }
}

function readSheetFuel_() {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(FUEL_SHEET_NAME);
  if (!sh) throw new Error(`"${FUEL_SHEET_NAME}" 시트를 찾을 수 없습니다.`);
  const cur = {};
  Object.keys(FUEL_CELLS).forEach(k => { cur[k] = Number(sh.getRange(FUEL_CELLS[k]).getValue()) || 0; });
  return { sh, cur };
}

function sameFuel_(a, b) {
  return !!a && !!b && Object.keys(FUEL_CELLS).every(k => Number(a[k]) === Number(b[k]));
}

function fuelText_(p) {
  return Object.keys(FUEL_CELLS).map(k => `${k} ${fmt_(p[k])}`).join(' / ');
}

function getFuelStamp_() {
  try { return JSON.parse(PropertiesService.getDocumentProperties().getProperty(FUEL_STAMP_KEY) || 'null'); }
  catch (e) { return null; }
}

function saveFuelStamp_(month, prices, how) {
  PropertiesService.getDocumentProperties().setProperty(FUEL_STAMP_KEY, JSON.stringify({
    month: month, prices: prices, how: how, at: new Date().toISOString()
  }));
}

/**
 * 정산 전 유류단가 확인 (메뉴 실행 흐름에서만 호출 — 대화상자 UI 사용)
 * @param standalone 메뉴 [⛽ 유류단가 확인]에서 직접 부른 경우 true (결과를 항상 보여줌)
 * @return 계속 진행해도 되면 true
 */
function confirmFuelPrices_(month, standalone) {
  const ui = SpreadsheetApp.getUi();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const { sh, cur } = readSheetFuel_();
  const stamp = getFuelStamp_();
  const mail = findFuelMail_(month);

  // ① 메일을 찾은 경우 — 값 대조
  if (mail.status === 'found') {
    const when = Utilities.formatDate(mail.date, Session.getScriptTimeZone(), 'M/d HH:mm');
    if (sameFuel_(cur, mail.prices)) {
      saveFuelStamp_(month, cur, 'mail');
      if (standalone) ui.alert('⛽ 유류단가 확인', `✅ ${month}월 메일(${when})과 시트 값이 같습니다.\n\n${fuelText_(cur)}`, ui.ButtonSet.OK);
      else ss.toast(`${month}월 메일 단가와 일치: ${fuelText_(cur)}`, '⛽ 유류단가 확인', 5);
      return true;
    }
    const diff = Object.keys(FUEL_CELLS).map(k =>
      `• ${k}: 시트 ${fmt_(cur[k])}  →  메일 ${fmt_(mail.prices[k])}${Number(cur[k]) === Number(mail.prices[k]) ? '' : '  ◀ 다름'}`).join('\n');
    const ans = ui.alert('⛽ 유류단가가 메일과 다릅니다',
      `메일: "${mail.subject}" (${when})\n\n${diff}\n\n` +
      `[예] 메일 값으로 바꾸고 진행\n[아니요] 시트 값 그대로 진행\n[취소] 중단`,
      ui.ButtonSet.YES_NO_CANCEL);
    if (ans === ui.Button.YES) {
      Object.keys(FUEL_CELLS).forEach(k => sh.getRange(FUEL_CELLS[k]).setValue(mail.prices[k]));
      SpreadsheetApp.flush();
      saveFuelStamp_(month, mail.prices, 'mail-updated');
      ss.toast(`유류단가 갱신: ${fuelText_(mail.prices)}`, '⛽ 유류단가', 5);
      return true;
    }
    if (ans === ui.Button.NO) { saveFuelStamp_(month, cur, 'manual-override'); return true; }
    ss.setActiveSheet(sh);
    return false;
  }

  // ② 메일을 못 찾은 경우 — 이번 달 이미 확인했고 값도 그대로면 통과
  if (!standalone && stamp && stamp.month === month && sameFuel_(cur, stamp.prices)) return true;

  const reason = {
    off: '메일 대조 꺼짐 (FUEL_USE_GMAIL = false)',
    notfound: `최근 ${FUEL_MAIL_LOOKBACK_DAYS}일 메일에서 "${month}월 마감 … 유류단가" 메일을 못 찾았습니다.`,
    error: `메일을 읽지 못했습니다 (${mail.error || ''})`,
  }[mail.status];
  const sameAsLast = stamp && stamp.month !== month && sameFuel_(cur, stamp.prices);
  const ans = ui.alert('⛽ 유류단가 확인',
    `${reason}\n\n현재 유류단가 시트: ${fuelText_(cur)}\n` +
    (sameAsLast ? `\n⚠️ 지난번(${stamp.month}월) 정산 때와 값이 똑같습니다.\n   ${month}월 메일 단가로 바꿨는지 확인하세요.\n` : '') +
    `\n이 값이 ${month}월 메일에 안내된 단가가 맞습니까?\n[예] 맞음, 진행   [아니요] 유류단가 시트로 이동`,
    ui.ButtonSet.YES_NO);
  if (ans === ui.Button.YES) { saveFuelStamp_(month, cur, 'manual'); return true; }
  ss.setActiveSheet(sh);
  return false;
}

/** 실행 결과에 넣을 한 줄 */
function fuelStatusLine_(month) {
  let cur = null;
  try { cur = readSheetFuel_().cur; } catch (e) { return '⚠ 유류단가 시트를 읽지 못함'; }
  const stamp = getFuelStamp_();
  if (stamp && stamp.month === month && sameFuel_(cur, stamp.prices)) {
    const how = { mail: '메일과 일치', 'mail-updated': '메일 값으로 갱신', manual: '직접 확인', 'manual-override': '메일과 다르지만 시트 값 사용' }[stamp.how] || '확인';
    return `⛽ 유류단가: ${fuelText_(cur)} (${month}월 ${how})`;
  }
  return `⚠ 유류단가: ${fuelText_(cur)} — ${month}월분으로 확인된 기록 없음`;
}

/** 메뉴: ⛽ 유류단가 확인 */
