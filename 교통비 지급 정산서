// ───────────────────────────────────────────
// 근무 유형 표기 정규화
// "P/교" → "P", "야/교" → "야" ... / "교", "교육" 단독 → "" (제외)
// ───────────────────────────────────────────
function normalizeType(raw) {
  let s = String(raw === null || raw === undefined ? '' : raw).trim();
  if (!s) return '';
  s = s.replace(/[／\\,、·ㆍ|]/g, '/');
  s = s.replace(/\s+/g, '');
  const parts = s.split('/').filter(function (p) {
    return p !== '' && !/^교(육)?$/.test(p);
  });
  if (parts.length === 0) return '';
  let base = parts[0];
  if (/^[a-zA-Z]+$/.test(base)) base = base.toUpperCase();
  return base;
}

// ───────────────────────────────────────────
// 월 숫자 가져오기 (근무현황표 Z3) — 실패 시 오류 발생
// ───────────────────────────────────────────
function getMonthNumber() {
  const ss = SpreadsheetApp.openById(ATTENDANCE_SS_ID);
  for (const s of ss.getSheets()) {
    if (!s.getName().includes('근무현황표')) continue;
    const val = s.getRange('Z3').getValue();
    let month = null;
    if (val instanceof Date) {
      month = val.getMonth() + 1;
    } else {
      const matched = String(val).match(/(\d+)/);
      if (matched) month = parseInt(matched[1], 10);
    }
    if (month >= 1 && month <= 12) return month;
  }
  throw new Error('근무현황표 스프레드시트의 "근무현황표" 시트 Z3에서 월을 읽지 못했습니다. Z3 셀을 확인해주세요.');
}

/** A열 값이 "계"(합계/소계 포함)인지 */
function isEndMark_(v) {
  return /^(합|소)?계$/.test(String(v === null || v === undefined ? '' : v).replace(/\s+/g, ''));
}

/**
 * 근무계획 → 해당 월 시트 파싱 + 직급 순위 매핑
 * 범위: C5부터 A열에 "계"가 나오는 행 전까지 (못 찾으면 시트 마지막 행까지)
 * 반환: { records: [...], rankMap: { "김일수": 0, ... }, endRow, endMarkFound }
 */
function parseMonthlyWorkData(month) {
  const ss = SpreadsheetApp.openById(WORK_PLAN_SS_ID);
  const monthName = `${month}월`;
  const monthSheet = ss.getSheetByName(monthName);
  if (!monthSheet) {
    throw new Error(`근무계획 스프레드시트에서 "${monthName}" 시트를 찾을 수 없습니다.`);
  }

  const lastRow = monthSheet.getLastRow();
  if (lastRow < WP_NAME_START_ROW) {
    throw new Error(`"${monthName}" 시트 ${WP_NAME_START_ROW}행 이후에 데이터가 없습니다.`);
  }

  // A열에서 "계" 행 찾기 → 그 위까지가 사람
  const markCol = monthSheet.getRange(WP_NAME_START_ROW, WP_END_MARK_COL, lastRow - WP_NAME_START_ROW + 1, 1).getValues();
  let numRows = markCol.length;
  let endMarkFound = false;
  for (let i = 0; i < markCol.length; i++) {
    if (isEndMark_(markCol[i][0])) { numRows = i; endMarkFound = true; break; }
  }
  if (numRows === 0) {
    throw new Error(`"${monthName}" 시트 ${WP_NAME_START_ROW}행 A열이 이미 "계"라 읽을 이름이 없습니다.`);
  }

  const dayRow = monthSheet.getRange(WP_HEADER_ROW, WP_DAY_START_COL, 1, WP_DAY_COUNT).getValues()[0];
  const nameCol = monthSheet.getRange(WP_NAME_START_ROW, WP_NAME_COL, numRows, 1).getValues();
  const workGrid = monthSheet.getRange(WP_NAME_START_ROW, WP_DAY_START_COL, numRows, WP_DAY_COUNT).getValues();

  const records = [];
  const rankMap = {};

  for (let r = 0; r < nameCol.length; r++) {
    const name = String(nameCol[r][0]).trim();
    if (!name) continue;
    if (!(name in rankMap)) rankMap[name] = r;

    for (let c = 0; c < dayRow.length; c++) {
      const dayVal = dayRow[c];
      if (!dayVal && dayVal !== 0) continue;
      const day = parseInt(dayVal, 10);
      if (isNaN(day)) continue;

      const rawType = String(workGrid[r][c]).trim();
      if (!rawType) continue;
      const type = normalizeType(rawType);
      if (!type) continue;

      records.push({ name, day, type, rawType, monthName });
    }
  }
  return { records, rankMap, endRow: WP_NAME_START_ROW + numRows - 1, endMarkFound };
}

/**
 * 제품생산 계획 → 해당 월 시트 파싱
 * 반환: { [day]: { C, D, E, F, G, H, I, J, K, L } }
 */
function parsePlanData(month) {
  const ss = SpreadsheetApp.openById(PROD_PLAN_SS_ID);
  const prefix = `${month}월`;

  let planSheet = null;
  for (const s of ss.getSheets()) {
    if (s.getName().startsWith(prefix) && s.getName().includes('제품생산 계획')) {
      planSheet = s;
      break;
    }
  }
  if (!planSheet) {
    throw new Error(`제품생산 계획 스프레드시트에서 "${prefix} 제품생산 계획..." 시트를 찾을 수 없습니다.`);
  }

  const dayCol = planSheet.getRange('A3:A33').getValues();
  const dataGrid = planSheet.getRange('C3:L33').getValues();

  const plan = {};
  for (let r = 0; r < dayCol.length; r++) {
    const day = parseInt(dayCol[r][0], 10);
    if (isNaN(day)) continue;
    plan[day] = {
      C: dataGrid[r][0], D: dataGrid[r][1], E: dataGrid[r][2], F: dataGrid[r][3],
      G: dataGrid[r][4], H: dataGrid[r][5], I: dataGrid[r][6], J: dataGrid[r][7],
      K: dataGrid[r][8], L: dataGrid[r][9]
    };
  }
  return plan;
}

/** 숫자 수치가 입력된 경우만 true */
function hasValue(v) {
  if (v === null || v === undefined) return false;
  const s = String(v).trim();
  if (s === '' || s === '-') return false;
  const num = Number(s.replace(/,/g, ''));
  return !isNaN(num) && num !== 0;
}

// ───────────────────────────────────────────
// "합 계" 행 찾기 ★ 시트 끝까지 검색, 못 찾으면 오류 (추측 금지)
// ───────────────────────────────────────────
function findSumRow(targetSheet) {
  const last = targetSheet.getLastRow();
  if (last >= DATA_START_ROW) {
    const vals = targetSheet.getRange(DATA_START_ROW, 1, last - DATA_START_ROW + 1, SUM_COL).getValues();
    for (let i = 0; i < vals.length; i++) {
      for (let c = 0; c < vals[i].length; c++) {
        if (String(vals[i][c]).replace(/\s+/g, '') === '합계') return DATA_START_ROW + i;
      }
    }
  }
  throw new Error(`"${targetSheet.getName()}" 시트에서 "합 계" 행을 찾지 못했습니다. 합계 행의 A열에 "합 계" 글자가 있는지 확인해주세요.`);
}

/**
 * 합계 행 바로 위에 count개 행 추가 (TEMPLATE_ROW의 서식·병합·수식 복사)
 * 반환: 새 합계 행 번호
 */
function insertDataRows_(sheet, sumRow, count) {
  if (sumRow <= TEMPLATE_ROW) {
    throw new Error(`"${sheet.getName()}" 시트의 합계 행(${sumRow}행)이 너무 위에 있어 행을 추가할 수 없습니다.`);
  }
  sheet.insertRowsAfter(sumRow - 1, count);
  const lastCol = sheet.getMaxColumns();
  sheet.getRange(TEMPLATE_ROW, 1, 1, lastCol).copyTo(sheet.getRange(sumRow, 1, count, lastCol));
  sheet.getRange(sumRow, 1, count, 6).clearContent(); // 복사된 A~F 데이터는 지움
  sheet.setRowHeights(sumRow, count, sheet.getRowHeight(TEMPLATE_ROW));
  sheet.showRows(sumRow, count);
  return sumRow + count;
}

// ───────────────────────────────────────────
// 사유 생성 함수들 (BTL, 제품생산, CIP)
// ───────────────────────────────────────────
function getBTLReason(dayPlan) {
  if (!dayPlan) return 'BTL/CAP 생산';
  const btlPart = [];
  if (hasValue(dayPlan.I)) btlPart.push('1.5L BTL');
  if (hasValue(dayPlan.J)) btlPart.push('0.5L BTL');
  if (hasValue(dayPlan.K)) btlPart.push('0.33L BTL');
  const parts = [];
  if (btlPart.length > 0) parts.push(btlPart.join('/'));
  if (hasValue(dayPlan.L)) parts.push('CAP');
  return parts.length > 0 ? parts.join('/') + ' 생산' : 'BTL/CAP 생산';
}

function getSejeumReason(type, dayPlan) {
  if (type === 'L') return '정비 연장';
  if (!dayPlan) return type === 'B' ? 'BTL 생산' : '제품 생산';

  if (type === 'B') {
    const parts = [];
    if (hasValue(dayPlan.I)) parts.push('1.5L BTL');
    if (hasValue(dayPlan.J)) parts.push('0.5L BTL');
    if (hasValue(dayPlan.K)) parts.push('0.33L BTL');
    return parts.length > 0 ? parts.join('/') + ' 생산' : 'BTL 생산';
  }

  if (type === 'P') {
    if (hasValue(dayPlan.D)) return '1.5L 제품 생산';
    if (hasValue(dayPlan.E)) return '0.5L 제품 생산';
    if (hasValue(dayPlan.F)) return '0.33L 제품 생산';
    if (hasValue(dayPlan.G)) return '0.12L 제품 생산';
    return '제품 생산';
  }
  return '연장 근무';
}

function getCIPReasons(dayPlan, group) {
  if (!group || group.length === 0) return [];
  if (!dayPlan) return Array(group.length).fill('CIP');

  const morning = group.filter(r => r.type === '조');
  const evening = group.filter(r => r.type === '연');
  const reasons = [];

  if (morning.length > 0) {
    if (hasValue(dayPlan.H)) {
      reasons.push('0.19L 생산라인 CIP');
    } else {
      reasons.push(getNextCIP(dayPlan, 'morning'));
    }
    for (let i = 1; i < morning.length; i++) reasons.push(getNextCIP(dayPlan, 'morning'));
  }
  for (let i = 0; i < evening.length; i++) reasons.push(getNextCIP(dayPlan, 'evening'));
  return reasons;
}

function getNextCIP(dayPlan, shiftType) {
  const priorities = shiftType === 'morning'
    ? ['C', 'D', 'E', 'F', 'G']
    : ['D', 'E', 'F', 'C', 'G'];
  for (const col of priorities) {
    if (hasValue(dayPlan[col])) return getCIPReasonName(col);
  }
  return 'CIP';
}

function getCIPReasonName(col) {
  const map = {
    'C': '18.9L 생산라인 CIP',
    'D': '1.5L 생산라인 CIP',
    'E': '0.5L 생산라인 CIP',
    'F': '0.33L 생산라인 CIP',
    'G': '0.12L 생산라인 CIP',
    'H': '0.19L 생산라인 CIP'
  };
  return map[col] || 'CIP';
}

// ───────────────────────────────────────────
// 공통 시트 쓰기
// 반환: { count, sumRow, addedRows }
// ───────────────────────────────────────────
function writeToSheet(targetSheet, rows, monthName) {
  let sumRow = findSumRow(targetSheet);
  if (sumRow <= DATA_START_ROW) {
    throw new Error(`"${targetSheet.getName()}" 시트의 합계 행 위치(${sumRow}행)가 올바르지 않습니다.`);
  }

  // 1) 숨겨진 데이터 행 모두 펼치기
  targetSheet.showRows(DATA_START_ROW, sumRow - DATA_START_ROW);

  // 2) 행이 모자라면 자동 확장 (데이터가 잘리지 않게)
  let addedRows = 0;
  if (rows.length > sumRow - DATA_START_ROW) {
    addedRows = rows.length - (sumRow - DATA_START_ROW);
    sumRow = insertDataRows_(targetSheet, sumRow, addedRows);
  }
  const capacity = sumRow - DATA_START_ROW;

  // 3) 5행 ~ 합계 바로 윗행까지 A~F 전부 비우기
  targetSheet.getRange(DATA_START_ROW, 1, capacity, 6).clearContent();
  targetSheet.getRange(DATA_START_ROW, 2, capacity, 1).setNumberFormat(DATE_FORMAT);

  const n = rows.length;
  const sumCell = targetSheet.getRange(sumRow, SUM_COL);

  if (n === 0) {
    sumCell.setValue(0);
    targetSheet.hideRows(DATA_START_ROW, capacity);
    return { count: 0, sumRow: sumRow, addedRows: addedRows };
  }

  // 4) 열 단위 일괄 쓰기 (C:D, E:F 병합 셀 고려해 열별로 기록)
  targetSheet.getRange(DATA_START_ROW, 1, n, 1).setValues(rows.map(r => [r.name]));
  targetSheet.getRange(DATA_START_ROW, 2, n, 1).setValues(rows.map(r => [`${monthName} ${r.day}일`])); // ★ 띄어쓰기
  targetSheet.getRange(DATA_START_ROW, 3, n, 1).setValues(rows.map(() => [ROUTE_TEXT]));
  targetSheet.getRange(DATA_START_ROW, 5, n, 1).setValues(rows.map(r => [r.reason]));

  // 5) 합계 수식 (빈 행의 #N/A를 피하려고 마지막 데이터 행까지만 합산)
  const lastDataRow = DATA_START_ROW + n - 1;
  sumCell.setFormula(`=SUM($K$${DATA_START_ROW}:$K$${lastDataRow})`);

  // 6) 데이터 없는 행 숨기기
  if (capacity > n) targetSheet.hideRows(DATA_START_ROW + n, capacity - n);

  return { count: n, sumRow: sumRow, addedRows: addedRows };
}

// ───────────────────────────────────────────
// 공통 데이터 로딩
// ───────────────────────────────────────────
function loadData() {
  const month = getMonthNumber();
  const parsed = parseMonthlyWorkData(month);
  const plan = parsePlanData(month);
  return { month, records: parsed.records, rankMap: parsed.rankMap, plan };
}

function rankOf_(rankMap, name) {
  return (name in rankMap) ? rankMap[name] : 999;
}

// ───────────────────────────────────────────
// 자동 입력 행 생성 (근무계획 기반)
// kind: CIP는 조=0, 연=1 / 나머지는 0 (특이사항은 2)
// ───────────────────────────────────────────
function buildAutoRows_(key, data) {
  const records = data.records, plan = data.plan, rankMap = data.rankMap;
  const byDayRank = (a, b) => {
    if (a.day !== b.day) return a.day - b.day;
    return rankOf_(rankMap, a.name) - rankOf_(rankMap, b.name);
  };

  if (key === 'BTL') {
    return records.filter(r => r.type === '야').sort(byDayRank)
      .map(r => ({ name: r.name, day: r.day, reason: getBTLReason(plan[r.day]), kind: 0, special: false }));
  }

  if (key === 'SEJEUM') {
    return records.filter(r => ['B', 'P', 'L'].includes(r.type)).sort(byDayRank)
      .map(r => ({ name: r.name, day: r.day, reason: getSejeumReason(r.type, plan[r.day]), kind: 0, special: false }));
  }

  // CIP
  const filtered = records
    .filter(r => r.type === '조' || r.type === '연')
    .sort((a, b) => {
      if (a.day !== b.day) return a.day - b.day;
      if (a.type !== b.type) return a.type === '조' ? -1 : 1;
      return rankOf_(rankMap, a.name) - rankOf_(rankMap, b.name);
    });

  const dayGroups = {};
  for (const r of filtered) {
    if (!dayGroups[r.day]) dayGroups[r.day] = [];
    dayGroups[r.day].push(r);
  }

  const rows = [];
  for (const day of Object.keys(dayGroups).map(Number).sort((a, b) => a - b)) {
    const group = dayGroups[day];
    const reasons = getCIPReasons(plan[day], group);
    group.forEach((r, i) => {
      rows.push({ name: r.name, day: r.day, reason: reasons[i], kind: r.type === '조' ? 0 : 1, special: false });
    });
  }
  return rows;
}

// ───────────────────────────────────────────
// 자동 입력 + 특이사항 병합 정렬
// • BTL/제품생산: 날짜 → 직급 → (자동 먼저)
// • 품질 CIP : 날짜 → 조 → 연 → 특이사항 → 직급
// ───────────────────────────────────────────
function mergeAndSort_(key, autoRows, specials, rankMap) {
  const all = autoRows.concat(specials.map(s => ({
    name: s.name, day: s.day, reason: s.reason, kind: 2, special: true
  })));
  const kindFirst = (key === 'CIP');
  all.sort((a, b) => {
    if (a.day !== b.day) return a.day - b.day;
    if (kindFirst && a.kind !== b.kind) return a.kind - b.kind;
    const ra = rankOf_(rankMap, a.name), rb = rankOf_(rankMap, b.name);
    if (ra !== rb) return ra - rb;
    return a.kind - b.kind;
  });
  return all;
}

// ───────────────────────────────────────────
// 정산 실행 본체 — mode: 'ALL' | 'BTL' | 'SEJEUM' | 'CIP'
// 반환: 결과 요약 문자열
// ───────────────────────────────────────────
function runFill_(mode, expectedMonth) {
  const data = loadData();
  if (expectedMonth && data.month !== expectedMonth) {
    throw new Error(`기준 월이 ${expectedMonth}월 → ${data.month}월로 바뀌었습니다. 창을 닫고 다시 실행해주세요.`);
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const monthName = `${data.month}월`;
  const keys = mode === 'ALL' ? RUN_SHEET_ORDER : [mode];
  const specialsAll = readSpecials_(data.month);

  const lines = [];
  const warns = [];

  for (const key of keys) {
    const cfg = SHEET_CFG[key];
    const sheet = ss.getSheetByName(cfg.sheetName);
    if (!sheet) {
      if (mode === 'ALL') { lines.push(`• ${cfg.sheetName}: 시트 없음 (건너뜀)`); continue; }
      throw new Error(`"${cfg.sheetName}" 시트를 찾을 수 없습니다.`);
    }

    const autoRows = buildAutoRows_(key, data);
    const specials = specialsAll.filter(s => s.sheetKey === key);
    const rows = mergeAndSort_(key, autoRows, specials, data.rankMap);
    const res = writeToSheet(sheet, rows, monthName);

    let line = `• ${cfg.sheetName}: 총 ${res.count}건 (자동 ${autoRows.length} + 특이사항 ${specials.length}) / 합계 ${res.sumRow}행`;
    if (res.addedRows > 0) line += ` ← 행 부족으로 ${res.addedRows}행 자동 추가`;
    lines.push(line);

    specials.forEach(s => {
      if (autoRows.some(a => a.name === s.name && a.day === s.day)) {
        warns.push(` - ${cfg.sheetName} / ${s.name} / ${monthName} ${s.day}일 (${s.reason})`);
      }
    });
  }

  SpreadsheetApp.flush();

  let msg = `${monthName} 교통비 정산 완료\n\n` + lines.join('\n');
  if (warns.length > 0) {
    msg += '\n\n⚠ 같은 사람·같은 날에 자동 입력 건과 겹치는 특이사항 (두 행 모두 입력됨, 확인 필요)\n' + warns.join('\n');
  }
  return msg;
}

// ═══════════════════════════════════════════
// 근무계획 이름 확인 (입사·표 변경 후 점검용)
// ═══════════════════════════════════════════
function checkWorkPlanNames() {
  const month = getMonthNumber();
  const parsed = parseMonthlyWorkData(month);
  const rankMap = parsed.rankMap, records = parsed.records;
  const names = Object.keys(rankMap).sort((a, b) => rankMap[a] - rankMap[b]);

  const lines = names.map(n => {
    const cnt = {};
    records.filter(r => r.name === n).forEach(r => { cnt[r.type] = (cnt[r.type] || 0) + 1; });
    const summary = Object.keys(cnt).map(t => `${t}${cnt[t]}`).join(' ');
    return `${rankMap[n] + WP_NAME_START_ROW}행 ${n} ${summary ? '(' + summary + ')' : '(표기 없음)'}`;
  });

  const cfgNames = [];
  Object.keys(SHEET_CFG).forEach(k => SHEET_CFG[k].names.forEach(n => { if (cfgNames.indexOf(n) < 0) cfgNames.push(n); }));
  const missing = cfgNames.filter(n => !(n in rankMap));

  let msg = `${month}월 근무계획에서 읽은 인원 ${names.length}명 ` +
            `(${WP_NAME_START_ROW}행 ~ ${parsed.endRow}행)\n`;
  msg += parsed.endMarkFound
    ? `A열 "계" 행: ${parsed.endRow + 1}행\n\n`
    : `⚠ A열에서 "계" 행을 찾지 못해 시트 끝까지 읽었습니다.\n\n`;
  msg += lines.join('\n');
  if (missing.length > 0) {
    msg += `\n\n⚠ 코드 이름 목록에는 있지만 근무계획에 없는 이름: ${missing.join(', ')}`;
  }
  SpreadsheetApp.getUi().alert(msg);
}

// ═══════════════════════════════════════════
// 특이사항 입력창 ↔ 서버 통신 함수
// ═══════════════════════════════════════════

/** 입력창 초기 데이터 */
function getDialogInit() {
  const month = getMonthNumber();
  const rankMap = parseMonthlyWorkData(month).rankMap;

  const unknownNames = [];
  const sheets = UI_SHEET_ORDER.map(key => {
    const cfg = SHEET_CFG[key];
    cfg.names.forEach(n => {
      if (!(n in rankMap) && unknownNames.indexOf(n) < 0) unknownNames.push(n);
    });
    return { key: key, sheetName: cfg.sheetName, names: cfg.names, reasons: cfg.reasons };
  });

  return {
    month: month,
    daysInMonth: daysInMonth_(month),
    sheets: sheets,
    unknownNames: unknownNames,
    entries: readSpecials_(month)
  };
}

/** 저장만 */
function saveSpecials(month, entries) {
  const clean = sanitizeEntries_(entries);
  writeSpecials_(parseInt(month, 10), clean);
  return clean.length;
}

/** 저장 후 정산 실행 */
function saveSpecialsAndRun(month, entries, mode) {
  const m = parseInt(month, 10);
  if (mode !== 'ALL' && !SHEET_CFG[mode]) throw new Error('알 수 없는 실행 모드: ' + mode);
  writeSpecials_(m, sanitizeEntries_(entries));
  return runFill_(mode, m);
}

function daysInMonth_(month) {
  const now = new Date();
  let year = now.getFullYear();
  if (month - (now.getMonth() + 1) > 6) year -= 1; // 1월에 작년 12월분 정산하는 경우
  return new Date(year, month, 0).getDate();
}

function sanitizeEntries_(entries) {
  const out = [];
  const seen = {};
  (entries || []).forEach(e => {
    if (!e) return;
    const sheetKey = String(e.sheetKey || '');
    if (!SHEET_CFG[sheetKey]) return;
    const name = String(e.name || '').trim();
    const reason = String(e.reason || '').trim();
    const day = parseInt(e.day, 10);
    if (!name || !reason || isNaN(day) || day < 1 || day > 31) return;
    const k = [sheetKey, name, day, reason].join('|');
    if (seen[k]) return;
    seen[k] = true;
    out.push({ sheetKey: sheetKey, name: name, day: day, reason: reason });
  });
  return out;
}

// ───────────────────────────────────────────
// 특이사항 저장 시트 (숨김) — A:월 B:시트 C:일 D:이름 E:사유 F:등록일시
// ───────────────────────────────────────────
function getOrCreateSpecialSheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(SPECIAL_SHEET_NAME);
  if (sh) return sh;

  const active = ss.getActiveSheet();
  sh = ss.insertSheet(SPECIAL_SHEET_NAME, ss.getNumSheets());
  sh.getRange('A:E').setNumberFormat('@');
  sh.getRange('F:F').setNumberFormat('yyyy-mm-dd hh:mm');
  sh.getRange(1, 1, 1, 6).setValues([['월', '시트', '일', '이름', '사유', '등록일시']]).setFontWeight('bold');
  sh.setFrozenRows(1);
  sh.hideSheet();
  if (active) ss.setActiveSheet(active);
  return sh;
}

function readSpecials_(month) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SPECIAL_SHEET_NAME);
  if (!sh || sh.getLastRow() < 2) return [];

  const nameToKey = {};
  Object.keys(SHEET_CFG).forEach(k => { nameToKey[SHEET_CFG[k].sheetName] = k; });

  const limit = new Date().getTime() - SPECIAL_EXPIRE_DAYS * 24 * 60 * 60 * 1000;
  const vals = sh.getRange(2, 1, sh.getLastRow() - 1, 6).getValues();
  const out = [];

  vals.forEach(r => {
    if (parseInt(r[0], 10) !== month) return;
    const sheetKey = nameToKey[String(r[1]).trim()];
    const day = parseInt(r[2], 10);
    const name = String(r[3]).trim();
    const reason = String(r[4]).trim();
    if (!sheetKey || isNaN(day) || !name || !reason) return;
    if (r[5] instanceof Date && r[5].getTime() < limit) return; // 오래된 건(작년 같은 달) 무시
    out.push({ sheetKey: sheetKey, name: name, day: day, reason: reason });
  });
  return out;
}

/** 해당 월의 특이사항을 entries로 통째 교체 (다른 달 기록은 유지) */
function writeSpecials_(month, entries) {
  const sh = getOrCreateSpecialSheet_();
  const last = sh.getLastRow();

  let keep = [];
  if (last >= 2) {
    keep = sh.getRange(2, 1, last - 1, 6).getValues()
      .filter(r => String(r[0]).trim() !== '' && parseInt(r[0], 10) !== month);
    sh.getRange(2, 1, last - 1, 6).clearContent();
  }

  const now = new Date();
  const rows = keep.concat(entries.map(e =>
    [String(month), SHEET_CFG[e.sheetKey].sheetName, String(e.day), e.name, e.reason, now]
  ));

  if (rows.length > 0) {
    sh.getRange(2, 1, rows.length, 5).setNumberFormat('@');
    sh.getRange(2, 1, rows.length, 6).setValues(rows);
  }
}

