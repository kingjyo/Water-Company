// ⚙ 합계 행을 100행으로 맞추기 (최초 1회)
// ═══════════════════════════════════════════
function setupSumRow100() {
  const ui = SpreadsheetApp.getUi();
  const answer = ui.alert(
    '합계 행을 100행으로 맞추기',
    '"BTL 생산", "제품생산", "품질 CIP" 시트에 대해 다음 작업을 합니다.\n\n' +
    `1. 합계 행을 ${TARGET_SUM_ROW}행으로 이동 (부족한 행은 ${TEMPLATE_ROW}행 서식·수식을 복사해 추가)\n` +
    `2. ${TEMPLATE_ROW + 1}행 ~ ${TARGET_SUM_ROW - 1}행의 G~K열 수식을 ${TEMPLATE_ROW}행 기준으로 다시 채움 (K61에 남은 SUM 수식 등 복구)\n` +
    `3. ${DATA_START_ROW}행 ~ ${TARGET_SUM_ROW - 1}행의 A~F열 내용을 비움 (수기 입력분 포함)\n\n` +
    `※ 실행 전 각 시트 ${TEMPLATE_ROW}행의 G~K열 수식이 정상인지 확인하세요.\n` +
    '※ 스프레드시트 사본을 먼저 만들어 두는 것을 권장합니다.\n\n계속할까요?',
    ui.ButtonSet.OK_CANCEL
  );
  if (answer !== ui.Button.OK) return;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const msgs = [];

  RUN_SHEET_ORDER.forEach(key => {
    const sheetName = SHEET_CFG[key].sheetName;
    const sheet = ss.getSheetByName(sheetName);
    if (!sheet) { msgs.push(`• ${sheetName}: 시트 없음 (건너뜀)`); return; }

    try {
      let sumRow = findSumRow(sheet);
      const before = sumRow;
      sheet.showRows(DATA_START_ROW, sumRow - DATA_START_ROW);

      if (sumRow < TARGET_SUM_ROW) {
        sumRow = insertDataRows_(sheet, sumRow, TARGET_SUM_ROW - sumRow);
      } else if (sumRow > TARGET_SUM_ROW) {
        sheet.deleteRows(TARGET_SUM_ROW, sumRow - TARGET_SUM_ROW);
        sumRow = TARGET_SUM_ROW;
      }

      // G~K 수식 복구 (TEMPLATE_ROW 기준)
      const fixCount = sumRow - 1 - TEMPLATE_ROW;
      if (fixCount > 0) {
        sheet.getRange(TEMPLATE_ROW, 7, 1, 5).copyTo(
          sheet.getRange(TEMPLATE_ROW + 1, 7, fixCount, 5),
          SpreadsheetApp.CopyPasteType.PASTE_FORMULA, false
        );
      }

      sheet.getRange(DATA_START_ROW, 1, sumRow - DATA_START_ROW, 6).clearContent();
      sheet.getRange(sumRow, SUM_COL).setValue(0);
      msgs.push(`• ${sheetName}: 합계 ${before}행 → ${sumRow}행`);
    } catch (e) {
      msgs.push(`• ${sheetName}: 실패 — ${e.message}`);
    }
  });

  SpreadsheetApp.flush();
  ui.alert('완료\n\n' + msgs.join('\n') + '\n\n이제 메뉴에서 "전체 시트 자동 채우기"를 실행하세요.');
}

