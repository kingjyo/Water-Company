// ───────────────────────────────────────────
// 근무 유형 표기 정규화
// "P/교" → "P", "야/교" → "야" ... / "교", "교육" 단독 → "" (제외)
// ───────────────────────────────────────────
function normalizeType(raw) {
  let s = String(raw === null || raw === undefined ? '' : raw).trim();
  if (!s) return '';
  s = s.replace(/[／\\,、·ㆍ|]/g, '/');
  s = s.replace(/\s+/g, '');
  const parts = s.split('/').filter(function (p) {
    return p !== '' && !/^교(육)?$/.test(p);
  });
  if (parts.length === 0) return '';
  let base = parts[0];
  if (/^[a-zA-Z]+$/.test(base)) base = base.toUpperCase();
  return base;
}

function normName_(s) {
  return String(s === null || s === undefined ? '' : s).replace(/\s+/g, '');
}

// ───────────────────────────────────────────
// 월 숫자 가져오기 (근무현황표 Z3) — 실패 시 오류 발생
// ───────────────────────────────────────────
function getMonthNumber() {
  const ss = SpreadsheetApp.openById(ATTENDANCE_SS_ID);
  for (const s of ss.getSheets()) {
    if (!s.getName().includes('근무현황표')) continue;
    const val = s.getRange('Z3').getValue();
    let month = null;
    if (val instanceof Date) {
      month = val.getMonth() + 1;
    } else {
      const matched = String(val).match(/(\d+)/);
      if (matched) month = parseInt(matched[1], 10);
    }
    if (month >= 1 && month <= 12) return month;
  }
  throw new Error('근무현황표 스프레드시트의 "근무현황표" 시트 Z3에서 월을 읽지 못했습니다. Z3 셀을 확인해주세요.');
}

/** A열 값이 "계"(합계/소계 포함)인지 */
function isEndMark_(v) {
  return /^(합|소)?계$/.test(String(v === null || v === undefined ? '' : v).replace(/\s+/g, ''));
}

/**
 * 근무계획 → 해당 월 시트 파싱 + 직급 순위 매핑
 * 범위: C5부터 A열에 "계"가 나오는 행 전까지 (못 찾으면 시트 마지막 행까지 + 경고)
 * 반환: { records: [...], rankMap: { "김일수": 0, ... }, endRow, endMarkFound }
 */
function parseMonthlyWorkData(month) {
  const ss = SpreadsheetApp.openById(WORK_PLAN_SS_ID);
  const monthName = `${month}월`;
  const monthSheet = ss.getSheetByName(monthName);
  if (!monthSheet) {
    throw new Error(`근무계획 스프레드시트에서 "${monthName}" 시트를 찾을 수 없습니다.`);
  }

  const lastRow = monthSheet.getLastRow();
  if (lastRow < WP_NAME_START_ROW) {
    throw new Error(`"${monthName}" 시트 ${WP_NAME_START_ROW}행 이후에 데이터가 없습니다.`);
  }

  // A열에서 "계" 행 찾기 → 그 위까지가 사람
  const markCol = monthSheet.getRange(WP_NAME_START_ROW, WP_END_MARK_COL, lastRow - WP_NAME_START_ROW + 1, 1).getValues();
  let numRows = markCol.length;
  let endMarkFound = false;
  for (let i = 0; i < markCol.length; i++) {
    if (isEndMark_(markCol[i][0])) { numRows = i; endMarkFound = true; break; }
  }
  if (numRows === 0) {
    throw new Error(`"${monthName}" 시트 ${WP_NAME_START_ROW}행 A열이 이미 "계"라 읽을 이름이 없습니다.`);
  }

  const dayRow = monthSheet.getRange(WP_HEADER_ROW, WP_DAY_START_COL, 1, WP_DAY_COUNT).getValues()[0];
  const nameCol = monthSheet.getRange(WP_NAME_START_ROW, WP_NAME_COL, numRows, 1).getValues();
  const workGrid = monthSheet.getRange(WP_NAME_START_ROW, WP_DAY_START_COL, numRows, WP_DAY_COUNT).getValues();

  const records = [];
  const rankMap = {};

  for (let r = 0; r < nameCol.length; r++) {
    const name = String(nameCol[r][0]).trim();
    if (!name) continue;
    if (!(name in rankMap)) rankMap[name] = r;

    for (let c = 0; c < dayRow.length; c++) {
      const dayVal = dayRow[c];
      if (!dayVal && dayVal !== 0) continue;
      const day = parseInt(dayVal, 10);
      if (isNaN(day)) continue;

      const rawType = String(workGrid[r][c]).trim();
      if (!rawType) continue;
      const type = normalizeType(rawType);
      if (!type) continue;

      records.push({ name, day, type, rawType, monthName });
    }
  }
  return { records, rankMap, endRow: WP_NAME_START_ROW + numRows - 1, endMarkFound };
}

/**
 * 제품생산 계획 → 해당 월 시트 파싱
 * 반환: { [day]: { C, D, E, F, G, H, I, J, K, L } }
 */
function parsePlanData(month) {
  const ss = SpreadsheetApp.openById(PROD_PLAN_SS_ID);
  const prefix = `${month}월`;

  let planSheet = null;
  for (const s of ss.getSheets()) {
    if (s.getName().startsWith(prefix) && s.getName().includes('제품생산 계획')) {
      planSheet = s;
      break;
    }
  }
  if (!planSheet) {
    throw new Error(`제품생산 계획 스프레드시트에서 "${prefix} 제품생산 계획..." 시트를 찾을 수 없습니다.`);
  }

  const dayCol = planSheet.getRange('A3:A33').getValues();
  const dataGrid = planSheet.getRange('C3:L33').getValues();

  const plan = {};
  for (let r = 0; r < dayCol.length; r++) {
    const day = parseInt(dayCol[r][0], 10);
    if (isNaN(day)) continue;
    plan[day] = {
      C: dataGrid[r][0], D: dataGrid[r][1], E: dataGrid[r][2], F: dataGrid[r][3],
      G: dataGrid[r][4], H: dataGrid[r][5], I: dataGrid[r][6], J: dataGrid[r][7],
      K: dataGrid[r][8], L: dataGrid[r][9]
    };
  }
  return plan;
}

/** 숫자 수치가 입력된 경우만 true */
function hasValue(v) {
  if (v === null || v === undefined) return false;
  const s = String(v).trim();
  if (s === '' || s === '-') return false;
  const num = Number(s.replace(/,/g, ''));
  return !isNaN(num) && num !== 0;
}

// ───────────────────────────────────────────
// "합 계" 행 찾기 ★ 시트 끝까지 검색, 못 찾으면 오류 (추측 금지)
// ───────────────────────────────────────────
function findSumRow(targetSheet) {
  const last = targetSheet.getLastRow();
  if (last >= DATA_START_ROW) {
    const vals = targetSheet.getRange(DATA_START_ROW, 1, last - DATA_START_ROW + 1, SUM_COL).getValues();
    for (let i = 0; i < vals.length; i++) {
      for (let c = 0; c < vals[i].length; c++) {
        if (String(vals[i][c]).replace(/\s+/g, '') === '합계') return DATA_START_ROW + i;
      }
    }
  }
  throw new Error(`"${targetSheet.getName()}" 시트에서 "합 계" 행을 찾지 못했습니다. 합계 행의 A열에 "합 계" 글자가 있는지 확인해주세요.`);
}

/**
 * 합계 행 바로 위에 count개 행 추가 (TEMPLATE_ROW의 서식·병합·수식 복사)
 * 반환: 새 합계 행 번호
 */
function insertDataRows_(sheet, sumRow, count) {
  if (sumRow <= TEMPLATE_ROW) {
    throw new Error(`"${sheet.getName()}" 시트의 합계 행(${sumRow}행)이 너무 위에 있어 행을 추가할 수 없습니다.`);
  }
  sheet.insertRowsAfter(sumRow - 1, count);
  const lastCol = sheet.getMaxColumns();
  sheet.getRange(TEMPLATE_ROW, 1, 1, lastCol).copyTo(sheet.getRange(sumRow, 1, count, lastCol));
  sheet.getRange(sumRow, 1, count, 6).clearContent(); // 복사된 A~F 데이터는 지움
  sheet.setRowHeights(sumRow, count, sheet.getRowHeight(TEMPLATE_ROW));
  sheet.showRows(sumRow, count);
  return sumRow + count;
}

