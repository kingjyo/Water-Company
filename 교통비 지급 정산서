  try {
    confirmFuelPrices_(getMonthNumber(), true);
  } catch (e) {
    SpreadsheetApp.getUi().alert('❌ 오류 발생\n\n' + e.message);
  }
}

// ═══════════════════════════════════════════
// 근무계획 이름 확인 (입사·표 변경 후 점검용)
// ═══════════════════════════════════════════
function checkWorkPlanNames() {
  const month = getMonthNumber();
  const parsed = parseMonthlyWorkData(month);
  const rankMap = parsed.rankMap, records = parsed.records;
  const names = Object.keys(rankMap).sort((a, b) => rankMap[a] - rankMap[b]);

  const lines = names.map(n => {
    const cnt = {};
    records.filter(r => r.name === n).forEach(r => { cnt[r.type] = (cnt[r.type] || 0) + 1; });
    const summary = Object.keys(cnt).map(t => `${t}${cnt[t]}`).join(' ');
    const p = PERSON_ROUTE[normName_(n)];
    return `${rankMap[n] + WP_NAME_START_ROW}행 ${n}${summary ? '(' + summary + ')' : '(표기 없음)'}` +
      (p ? ` — 구간: ${p.route}` : '');
  });

  const cfgNames = [];
  Object.keys(SHEET_CFG).forEach(k => SHEET_CFG[k].names.forEach(n => { if (cfgNames.indexOf(n) < 0) cfgNames.push(n); }));
  const missing = cfgNames.filter(n => !(n in rankMap));
  const notInCfg = names.filter(n => cfgNames.indexOf(n) < 0);

  // 개인별DATA(차종·연비)에 없는 이름 → 교통비가 #N/A
  const personData = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('개인별DATA');
  let noCar = [];
  if (personData && personData.getLastRow() >= 1) {
    const listed = new Set(personData.getRange(1, 2, personData.getLastRow(), 1).getValues().map(r => normName_(r[0])));
    noCar = names.filter(n => !listed.has(normName_(n)));
  }

  let msg = `${month}월 근무계획에서 읽은 인원 ${names.length}명 ` +
    `(${WP_NAME_START_ROW}행 ~ ${parsed.endRow}행)\n`;
  msg += parsed.endMarkFound
    ? `A열 "계" 행: ${parsed.endRow + 1}행\n\n`
    : `⚠ A열에서 "계" 행을 찾지 못해 시트 끝까지 읽었습니다.\n\n`;
  msg += lines.join('\n');
  if (missing.length > 0) msg += `\n\n⚠ 코드 이름 목록에는 있지만 근무계획에 없는 이름: ${missing.join(', ')}`;
  if (notInCfg.length > 0) msg += `\n\nℹ 근무계획에는 있지만 특이사항 버튼 목록(PRODUCTION/QUALITY_NAMES)에 없는 이름: ${notInCfg.join(', ')}`;
  if (noCar.length > 0) msg += `\n\n⚠ '개인별DATA'(차종·연비)에 없는 이름: ${noCar.join(', ')} → 이 사람 행은 교통비가 #N/A`;
  SpreadsheetApp.getUi().alert(msg);
}

// ═══════════════════════════════════════════
// 🛠 개인별DATA 참조 범위 통일 (1회)
//  • 5행~합계 직전 G(차종)·H(전용유류)·J(등록연비) VLOOKUP을 '개인별DATA'!$B:$E 전체 열로
//    → 시트마다 $B$1:$E$18 / $B$6:$E$84 등 달랐던 범위를 통일, 개인별DATA에 행이 늘어도 안 깨짐
//  • K열(교통비, 전기 76원/km 고정)과 개인별 현황 표는 건드리지 않음
// ═══════════════════════════════════════════
function unifyPersonDataRange() {
  const ui = SpreadsheetApp.getUi();
  const ans = ui.alert('🛠 개인별DATA 참조 범위 통일',
    '"BTL 생산", "제품생산", "품질 CIP" 시트의\n' +
    `${DATA_START_ROW}행~합계 직전 G·H·J열 VLOOKUP 범위를 '개인별DATA'!$B:$E 로 바꿉니다.\n\n` +
    '• K열(교통비 계산식)과 개인별 현황 표는 그대로 둡니다.\n' +
    '• 계산 결과는 그대로여야 정상입니다 (실행 후 합계 전후를 보여줌).\n\n계속할까요?',
    ui.ButtonSet.OK_CANCEL);
  if (ans !== ui.Button.OK) return;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const msgs = [];
  RUN_SHEET_ORDER.forEach(key => {
    const name = SHEET_CFG[key].sheetName;
    const sheet = ss.getSheetByName(name);
    if (!sheet) { msgs.push(`• ${name}: 시트 없음`); return; }
    try {
      const sumRow = findSumRow(sheet);
      const before = Number(sheet.getRange(sumRow, SUM_COL).getValue()) || 0;
      const n = sumRow - DATA_START_ROW;
      [[7, 2], [8, 3], [10, 4]].forEach(([col, idx]) => {
        const f = [];
        for (let r = DATA_START_ROW; r < sumRow; r++) f.push([`=VLOOKUP(A${r},'개인별DATA'!$B:$E,${idx},FALSE)`]);
        sheet.getRange(DATA_START_ROW, col, n, 1).setFormulas(f);
      });
      SpreadsheetApp.flush();
      const after = Number(sheet.getRange(sumRow, SUM_COL).getValue()) || 0;
      msgs.push(`• ${name}: G·H·J ${n}행 통일 / 합계 ${fmt_(before)} → ${fmt_(after)}` +
        (Math.round(before) !== Math.round(after) ? '  ◀ 합계가 바뀜, 확인 필요' : ''));
    } catch (e) {
      msgs.push(`• ${name}: 실패 — ${e.message}`);
    }
  });
  ui.alert('🛠 완료\n\n' + msgs.join('\n'));
}

// ═══════════════════════════════════════════
// 특이사항 입력창 ↔ 서버 통신 함수
// ═══════════════════════════════════════════

/** 입력창 초기 데이터 */
function getDialogInit() {
  const month = getMonthNumber();
  const rankMap = parseMonthlyWorkData(month).rankMap;

  const unknownNames = [];
  const sheets = UI_SHEET_ORDER.map(key => {
    const cfg = SHEET_CFG[key];
    cfg.names.forEach(n => {
      if (!(n in rankMap) && unknownNames.indexOf(n) < 0) unknownNames.push(n);
    });
    return { key: key, sheetName: cfg.sheetName, names: cfg.names, reasons: cfg.reasons, distance: cfg.distance };
  });

  return {
    month: month,
    daysInMonth: daysInMonth_(month),
    sheets: sheets,
    unknownNames: unknownNames,
    entries: readSpecials_(month)
  };
}

/** 저장만 */
function saveSpecials(month, entries) {
  const clean = sanitizeEntries_(entries);
  writeSpecials_(parseInt(month, 10), clean);
  return clean.length;
}

/** 저장 후 정산 실행 */
function saveSpecialsAndRun(month, entries, mode) {
  const m = parseInt(month, 10);
  if (mode !== 'ALL' && !SHEET_CFG[mode]) throw new Error('알 수 없는 실행 모드: ' + mode);
  writeSpecials_(m, sanitizeEntries_(entries));
  return runFill_(mode, m);
}

function daysInMonth_(month) {
  const now = new Date();
  let year = now.getFullYear();
  if (month - (now.getMonth() + 1) > 6) year -= 1; // 1월에 작년 12월분 정산하는 경우
  return new Date(year, month, 0).getDate();
}

function sanitizeEntries_(entries) {
  const out = [];
  const seen = {};
  (entries || []).forEach(e => {
    if (!e) return;
    const sheetKey = String(e.sheetKey || '');
    if (!SHEET_CFG[sheetKey]) return;
    const name = String(e.name || '').trim();
    const reason = String(e.reason || '').trim();
    const day = parseInt(e.day, 10);
    if (!name || !reason || isNaN(day) || day < 1 || day > 31) return;
    const k = [sheetKey, name, day, reason].join('|');
    if (seen[k]) return;
    seen[k] = true;
    out.push({ sheetKey: sheetKey, name: name, day: day, reason: reason, km: parseKm_(e.km) });
  });
  return out;
}

/** 주행거리 입력값 → 양수면 숫자, 아니면 '' (= 시트 기본 거리) */
function parseKm_(v) {
  const n = Number(String(v === null || v === undefined ? '' : v).replace(/[^\d.]/g, ''));
  return (n > 0) ? n : '';
}

// ───────────────────────────────────────────
// 특이사항 저장 시트 (숨김) — A:월 B:시트 C:일 D:이름 E:사유 F:등록일시 G:주행거리(km, 비우면 기본)
// ───────────────────────────────────────────
const SPECIAL_HEADERS = ['월', '시트', '일', '이름', '사유', '등록일시', '주행거리(km)'];

function getOrCreateSpecialSheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(SPECIAL_SHEET_NAME);
  if (sh) {
    if (String(sh.getRange(1, 7).getValue()).trim() === '') sh.getRange(1, 7).setValue(SPECIAL_HEADERS[6]).setFontWeight('bold');
    return sh;
  }

  const active = ss.getActiveSheet();
  sh = ss.insertSheet(SPECIAL_SHEET_NAME, ss.getNumSheets());
  sh.getRange('A:E').setNumberFormat('@');
  sh.getRange('F:F').setNumberFormat('yyyy-mm-dd hh:mm');
  sh.getRange(1, 1, 1, SPECIAL_HEADERS.length).setValues([SPECIAL_HEADERS]).setFontWeight('bold');
  sh.setFrozenRows(1);
  sh.hideSheet();
  if (active) ss.setActiveSheet(active);
  return sh;
}

function readSpecials_(month) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(SPECIAL_SHEET_NAME);
  if (!sh || sh.getLastRow() < 2) return [];

  const nameToKey = {};
  Object.keys(SHEET_CFG).forEach(k => { nameToKey[SHEET_CFG[k].sheetName] = k; });

  const limit = new Date().getTime() - SPECIAL_EXPIRE_DAYS * 24 * 60 * 60 * 1000;
  const vals = sh.getRange(2, 1, sh.getLastRow() - 1, 7).getValues();
  const out = [];

  vals.forEach(r => {
    if (parseInt(r[0], 10) !== month) return;
    const sheetKey = nameToKey[String(r[1]).trim()];
    const day = parseInt(r[2], 10);
    const name = String(r[3]).trim();
    const reason = String(r[4]).trim();
    if (!sheetKey || isNaN(day) || !name || !reason) return;
    if (r[5] instanceof Date && r[5].getTime() < limit) return; // 오래된 건(작년 같은 달) 무시
    out.push({ sheetKey: sheetKey, name: name, day: day, reason: reason, km: parseKm_(r[6]) });
  });
  return out;
}

/** 해당 월의 특이사항을 entries로 통째 교체 (다른 달 기록은 유지) */
function writeSpecials_(month, entries) {
  const sh = getOrCreateSpecialSheet_();
  const last = sh.getLastRow();

  let keep = [];
  if (last >= 2) {
    keep = sh.getRange(2, 1, last - 1, 7).getValues()
      .filter(r => String(r[0]).trim() !== '' && parseInt(r[0], 10) !== month);
    sh.getRange(2, 1, last - 1, 7).clearContent();
  }

  const now = new Date();
  const rows = keep.concat(entries.map(e =>
    [String(month), SHEET_CFG[e.sheetKey].sheetName, String(e.day), e.name, e.reason, now, e.km === '' ? '' : e.km]
  ));

  if (rows.length > 0) {
    sh.getRange(2, 1, rows.length, 5).setNumberFormat('@');
    sh.getRange(2, 1, rows.length, 7).setValues(rows);
  }
}

