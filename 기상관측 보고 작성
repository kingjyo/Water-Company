// ── 날짜 파싱: Date / 시리얼 / "2026. 10. 12 00:00" / "9/1/26 0:00" ──
function parseDateTime(v) {
  if (v instanceof Date) return isNaN(v.getTime()) ? null : v;
  if (typeof v === "number") {
    const d = new Date(1899, 11, 30);
    d.setTime(d.getTime() + Math.round(v * 86400000));
    return d;
  }
  const s = String(v).trim();
  if (!s) return null;

  let m = s.match(/^(\d{4})[.\-\/]\s*(\d{1,2})[.\-\/]\s*(\d{1,2})\.?\s*(?:(\d{1,2}):(\d{2}))?/);
  if (m) return new Date(+m[1], +m[2] - 1, +m[3], +(m[4] || 0), +(m[5] || 0));

  m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})\s*(?:(\d{1,2}):(\d{2}))?/);
  if (m) {
    let y = +m[3];
    if (y < 100) y += 2000;
    return new Date(y, +m[1] - 1, +m[2], +(m[4] || 0), +(m[5] || 0));
  }

  const d = new Date(s);
  return isNaN(d.getTime()) ? null : d;
}

function hourKey(d) {
  return Utilities.formatDate(d, Session.getScriptTimeZone(), "yyyy-MM-dd HH");
}

function toNumOrNull(v) {
  if (v === "" || v === null || v === undefined) return null;
  if (typeof v === "number") return isNaN(v) ? null : v;
  const n = parseFloat(String(v).replace(/[^0-9.\-]/g, ""));
  return isNaN(n) ? null : n;
}

// ── 가시리 시트 → { "yyyy-MM-dd HH": {val, minute} } 맵 ──
function loadGasiriRainMap() {
  const sheet = SpreadsheetApp.openById(GASIRI_SS_ID).getSheetByName(GASIRI_SHEET_NAME);
  if (!sheet) throw new Error(`가시리 스프레드시트에 '${GASIRI_SHEET_NAME}' 시트가 없습니다.`);

  const lastRow = sheet.getLastRow();
  if (lastRow < 1) throw new Error("가시리 기상데이터 시트가 비어 있습니다.");

  const maxCol = Math.max(GASIRI_DATE_COL, GASIRI_RAIN_COL);
  const values = sheet.getRange(1, 1, lastRow, maxCol).getValues();

  const map = {};
  for (let i = 0; i < values.length; i++) {
    const d = parseDateTime(values[i][GASIRI_DATE_COL - 1]);
    if (!d) continue;
    const key = hourKey(d);
    const minute = d.getMinutes();
    const val = values[i][GASIRI_RAIN_COL - 1];
    // 같은 시각이 여러 행이면 정시(00분) 행을 우선
    if (!map[key] || (minute === 0 && map[key].minute !== 0)) {
      map[key] = { val, minute };
    }
  }
  return map;
}

// ── 메인: 강수량 보정 ──
function correctRainfallFromGasiri() {
  const ui = SpreadsheetApp.getUi();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dataSheet = ss.getSheetByName(DATA_SHEET_NAME);
  if (!dataSheet) { ui.alert(`'${DATA_SHEET_NAME}' 시트를 찾을 수 없습니다.`); return; }

  const lastRow = dataSheet.getLastRow();
  if (lastRow < DATA_START_ROW) { ui.alert("기상관측 데이터가 없습니다."); return; }
  const n = lastRow - DATA_START_ROW + 1;

  const dateVals = dataSheet.getRange(DATA_START_ROW, DATA_DATE_COL, n, 1).getValues();
  const rainVals = dataSheet.getRange(DATA_START_ROW, DATA_RAIN_COL, n, 1).getValues();

  let gasiri;
  try {
    gasiri = loadGasiriRainMap();
  } catch (e) {
    ui.alert("가시리 데이터를 읽지 못했습니다.\n" + e.message);
    return;
  }

  const tz = Session.getScriptTimeZone();
  const newRain = [];
  const logRows = [];
  let cntChanged = 0, cntSame = 0, cntMissing = 0, cntNoDate = 0, cntNoVal = 0;
  let sumBefore = 0, sumAfter = 0;

  for (let i = 0; i < n; i++) {
    const rowNo = DATA_START_ROW + i;
    const oldRaw = rainVals[i][0];
    const oldNum = toNumOrNull(oldRaw);
    const d = parseDateTime(dateVals[i][0]);

    let newRaw = oldRaw;
    let status = "";

    if (!d) {
      status = "날짜없음";
      cntNoDate++;
    } else {
      const hit = gasiri[hourKey(d)];
      if (!hit) {
        status = "가시리 없음";
        cntMissing++;
      } else {
        let g = toNumOrNull(hit.val);
        if (g === null && TREAT_BLANK_AS_ZERO) g = 0;
        if (g === null) {
          status = "값없음";
          cntNoVal++;
        } else {
          newRaw = g;
          if (oldNum === null || Math.abs(oldNum - g) > 1e-9) { status = "변경"; cntChanged++; }
          else { status = "동일"; cntSame++; }
        }
      }
    }

    newRain.push([newRaw]);
    const newNum = toNumOrNull(newRaw);
    sumBefore += oldNum === null ? 0 : oldNum;
    sumAfter += newNum === null ? 0 : newNum;

    const diff = (newNum !== null && oldNum !== null) ? Math.round((newNum - oldNum) * 10) / 10 : "";

    logRows.push([
      rowNo,
      d ? Utilities.formatDate(d, tz, "yyyy-MM-dd HH:mm") : String(dateVals[i][0]),
      oldRaw,
      newRaw,
      diff,
      status
    ]);
  }

  const summary =
    `대상 행: ${n}행 (${DATA_SHEET_NAME} ${DATA_START_ROW}행~${lastRow}행)\n` +
    `변경: ${cntChanged} / 동일: ${cntSame} / 가시리 없음: ${cntMissing} / 값없음: ${cntNoVal} / 날짜없음: ${cntNoDate}\n` +
    `강수량 합계: ${sumBefore.toFixed(1)} mm → ${sumAfter.toFixed(1)} mm`;

  const res = ui.alert(
    "강수량 보정 확인",
    summary + "\n\nM열을 가시리 데이터로 덮어쓸까요?\n(원래 값은 '" + RAIN_LOG_SHEET_NAME + "' 시트에 보관됩니다)",
    ui.ButtonSet.YES_NO
  );
  if (res !== ui.Button.YES) return;

  // M열 쓰기
  dataSheet.getRange(DATA_START_ROW, DATA_RAIN_COL, n, 1).setValues(newRain);

  // 로그 시트 기록
  const meta = {
    when: Utilities.formatDate(new Date(), tz, "yyyy-MM-dd HH:mm:ss"),
    range: `${DATA_SHEET_NAME} M${DATA_START_ROW}:M${lastRow}`,
    cntChanged, cntSame, cntMissing, cntNoVal, cntNoDate, sumBefore, sumAfter, total: n
  };
  writeRainLogSheet(ss, meta, logRows);

  // 팝업 화면
  showRainCorrectionDialog(meta, logRows);
}

// ── 로그 시트 작성 (최근 실행 1회분만 보관) ──
function writeRainLogSheet(ss, meta, logRows) {
  let sheet = ss.getSheetByName(RAIN_LOG_SHEET_NAME);
  if (!sheet) sheet = ss.insertSheet(RAIN_LOG_SHEET_NAME);
  sheet.clear();
  sheet.clearFormats();

  const head = [
    ["강수량 보정 로그", "", "", "", "", ""],
    ["보정 일시", meta.when, "", "", "", ""],
    ["기준 데이터", "제주가시리 기상정보 데이터 / 기상데이터 시트 G열(1시간강수량)", "", "", "", ""],
    ["보정 범위", meta.range, "", "", "", ""],
    ["결과", `변경 ${meta.cntChanged} / 동일 ${meta.cntSame} / 가시리 없음 ${meta.cntMissing} / 값없음 ${meta.cntNoVal} / 날짜없음 ${meta.cntNoDate}`, "", "", "", ""],
    ["합계(mm)", `${meta.sumBefore.toFixed(1)} → ${meta.sumAfter.toFixed(1)}`, "", "", "", ""],
    ["", "", "", "", "", ""],
    ["행", "일시", "보정 전(mm)", "보정 후(mm)", "차이(mm)", "상태"]
  ];
  sheet.getRange(1, 1, head.length, 6).setValues(head);
  sheet.getRange(1, 1).setFontWeight("bold").setFontSize(13);
  sheet.getRange(8, 1, 1, 6).setFontWeight("bold").setBackground("#d9d9d9");

  if (logRows.length) {
    const start = head.length + 1;
    sheet.getRange(start, 1, logRows.length, 6).setValues(logRows);

    const bg = logRows.map(r => {
      const s = r[5];
      const c = s === "변경" ? "#fff2cc"
        : (s === "가시리 없음" || s === "날짜없음" || s === "값없음") ? "#f4cccc"
        : null;
      return [c, c, c, c, c, c];
    });
    sheet.getRange(start, 1, logRows.length, 6).setBackgrounds(bg);
  }
  sheet.setFrozenRows(8);
  sheet.autoResizeColumns(1, 6);
}

// ── 팝업 화면 ──
function showRainCorrectionDialog(meta, logRows) {
  const esc = s => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const changed = logRows.filter(r => r[5] === "변경");
  const problems = logRows.filter(r => r[5] === "가시리 없음" || r[5] === "날짜없음" || r[5] === "값없음");
  const LIMIT = 400;

  const cells = r => `<td>${r[0]}</td><td>${esc(r[1])}</td><td>${esc(r[2])}</td><td><b>${esc(r[3])}</b></td><td>${esc(r[4])}</td><td>${esc(r[5])}</td>`;
  const tableHead = `<tr><th>행</th><th>일시</th><th>보정 전</th><th>보정 후</th><th>차이</th><th>상태</th></tr>`;

  let html = `
<style>
  body{font-family:'Malgun Gothic',sans-serif;font-size:12px;margin:12px}
  h2{font-size:15px;margin:0 0 8px}
  .sum{background:#f3f3f3;padding:8px;border-radius:6px;margin-bottom:10px;line-height:1.6}
  table{border-collapse:collapse;width:100%}
  th,td{border:1px solid #ccc;padding:3px 6px;text-align:center}
  th{background:#e6e6e6;position:sticky;top:0}
  .chg td{background:#fff2cc}
  .bad td{background:#f4cccc}
  .box{max-height:300px;overflow:auto;border:1px solid #ddd;margin-bottom:10px}
</style>
<h2>강수량 보정 결과 (가시리 기준)</h2>
<div class="sum">
  보정 일시: <b>${esc(meta.when)}</b><br>
  보정 범위: ${esc(meta.range)} (총 ${meta.total}행)<br>
  변경 <b>${meta.cntChanged}</b> / 동일 ${meta.cntSame} / 가시리 없음 ${meta.cntMissing} / 값없음 ${meta.cntNoVal} / 날짜없음 ${meta.cntNoDate}<br>
  강수량 합계: ${Number(meta.sumBefore).toFixed(1)} mm → <b>${Number(meta.sumAfter).toFixed(1)} mm</b><br>
  <span style="color:#666">상세 내역은 '${RAIN_LOG_SHEET_NAME}' 시트에 저장됨</span>
</div>`;

  html += `<b>변경된 행 (${changed.length}건${changed.length > LIMIT ? `, 앞 ${LIMIT}건만 표시` : ""})</b>
<div class="box"><table>${tableHead}`;
  html += changed.length
    ? changed.slice(0, LIMIT).map(r => `<tr class="chg">${cells(r)}</tr>`).join("")
    : `<tr><td colspan="6">변경된 행 없음</td></tr>`;
  html += `</table></div>`;

  if (problems.length) {
    html += `<b>확인 필요 (${problems.length}건)</b>
<div class="box"><table>${tableHead}`;
    html += problems.slice(0, LIMIT).map(r => `<tr class="bad">${cells(r)}</tr>`).join("");
    html += `</table></div>`;
  }

  SpreadsheetApp.getUi().showModalDialog(
    HtmlService.createHtmlOutput(html).setWidth(760).setHeight(560),
    "강수량 보정 결과"
  );
}

// ── 로그 시트 기준으로 팝업 다시 보기 ──
function showLastRainCorrection() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(RAIN_LOG_SHEET_NAME);
  if (!sheet || sheet.getLastRow() < 9) { SpreadsheetApp.getUi().alert("보정 로그가 없습니다."); return; }

  const info = sheet.getRange(2, 2, 5, 1).getDisplayValues().map(r => String(r[0]));
  const logRows = sheet.getRange(9, 1, sheet.getLastRow() - 8, 6).getValues();
  const cnt = (name) => { const m = info[3].match(new RegExp(name + "\\s*(\\d+)")); return m ? +m[1] : 0; };
  const sums = info[4].match(/([\d.]+)\s*→\s*([\d.]+)/);

  showRainCorrectionDialog({
    when: info[0], range: info[2], total: logRows.length,
    cntChanged: cnt("변경"), cntSame: cnt("동일"), cntMissing: cnt("가시리 없음"),
    cntNoVal: cnt("값없음"), cntNoDate: cnt("날짜없음"),
    sumBefore: sums ? +sums[1] : 0, sumAfter: sums ? +sums[2] : 0
  }, logRows);
}

// ── 되돌리기: 로그의 '보정 전' 값을 M열에 복원 ──
function revertRainfallCorrection() {
  const ui = SpreadsheetApp.getUi();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dataSheet = ss.getSheetByName(DATA_SHEET_NAME);
  const logSheet = ss.getSheetByName(RAIN_LOG_SHEET_NAME);
  if (!dataSheet || !logSheet || logSheet.getLastRow() < 9) { ui.alert("되돌릴 보정 로그가 없습니다."); return; }

  const when = logSheet.getRange(2, 2).getDisplayValue();
  const res = ui.alert("보정 되돌리기", `${when} 보정 내용을 취소하고 M열을 원래 값으로 되돌릴까요?`, ui.ButtonSet.YES_NO);
  if (res !== ui.Button.YES) return;

  const rows = logSheet.getRange(9, 1, logSheet.getLastRow() - 8, 4).getValues();
  let restored = 0;
  for (const r of rows) {
    const rowNo = Number(r[0]);
    if (!rowNo) continue;
    dataSheet.getRange(rowNo, DATA_RAIN_COL).setValue(r[2]);
    restored++;
  }
  logSheet.getRange(1, 1).setValue(`강수량 보정 로그 (${Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd HH:mm")} 되돌림)`);
  ui.alert(`되돌리기 완료: ${restored}행 복원`);
}

