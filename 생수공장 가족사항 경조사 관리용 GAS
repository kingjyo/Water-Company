function readConfig_() {
  const v = getSheet_(SH.CFG).getDataRange().getValues();
  const kv = {};
  v.forEach(r => { const k = String(r[0]).trim(); if (k && !(k in kv)) kv[k] = r[1]; });

  // 표 읽기: 제목 행 다음이 머리글, 그다음부터 A열이 빌 때까지 (열 순서 고정)
  const table = title => {
    const i = v.findIndex(r => String(r[0]).trim() === title);
    if (i < 0) return [];
    const out = [];
    for (let j = i + 2; j < v.length && String(v[j][0]).trim() !== ''; j++) out.push(v[j]);
    return out;
  };
  const num = (x, d) => (x === '' || x === null || isNaN(Number(x))) ? d : Number(x);
  const on = x => String(x).trim().toUpperCase() !== 'N';
  const rels = x => splitList_(x).map(normRel_);

  // 창립기념일
  let foundM = 2, foundD = 20;
  const f = kv[K.FOUND];
  if (f instanceof Date) { foundM = f.getMonth() + 1; foundD = f.getDate(); }
  else { const m = String(f || '').match(/(\d{1,2})\D+(\d{1,2})/); if (m) { foundM = +m[1]; foundD = +m[2]; } }

  let emails = splitList_(kv[K.EMAILS]).filter(x => x.indexOf('@') > 0);
  if (!emails.length) emails = [Session.getEffectiveUser().getEmail()];

  const alertDays = splitList_(kv[K.ALERT_DAYS]).map(Number).filter(n => !isNaN(n));

  return {
    foundM: foundM, foundD: foundD,
    emails: emails,
    alertDays: alertDays.length ? alertDays : [60, 30, 14, 7, 3, 1, 0],
    urgentDays: num(kv[K.URGENT_DAYS], 30),
    alertHour: Math.min(23, Math.max(0, num(kv[K.ALERT_HOUR], 8))),
    weekly: on(kv[K.WEEKLY] === undefined ? 'Y' : kv[K.WEEKLY]),
    pastDays: num(kv[K.PAST_DAYS], 365),
    futureDays: num(kv[K.FUTURE_DAYS], 730),
    parentRels: rels(kv[K.PARENT_REL] || '부,모'),
    spouseParentRels: rels(kv[K.SPOUSE_PARENT_REL] || '배우자부,배우자모'),
    relList: splitList_(kv[K.REL_LIST] || '부,모,배우자,자녀,배우자부,배우자모,조부,조모,형제자매,기타'),
    retireAge: num(kv[K.RETIRE_AGE], 60),
    retireAlertDays: splitList_(kv[K.RETIRE_ALERT] || '365,180,90,60,30,7,1,0').map(Number).filter(n => !isNaN(n)),
    retireCap: on(kv[K.RETIRE_CAP] === undefined ? 'Y' : kv[K.RETIRE_CAP]),
    contractMonths: num(kv[K.CONTRACT_MONTHS], 12),
    flightMonths: num(kv[K.FLIGHT_MONTHS], 6),
    flightShow: num(kv[K.FLIGHT_SHOW], 12),
    childOn: on(kv[K.CHILD_ON] === undefined ? 'Y' : kv[K.CHILD_ON]),
    childRels: rels(kv[K.CHILD_REL] || '자녀'),

    // [장기근속포상여행] 근속연수 | 여행일정 | 국내지원(만원) | 해외지원(만원) | 사용기간(개월)
    longService: table(T.LONG).map(r => ({
      years: num(r[0], 0), trip: String(r[1] || ''), dom: num(r[2], ''), abr: num(r[3], ''), months: num(r[4], 12),
    })).filter(t => t.years > 0).sort((a, b) => a.years - b.years),

    // [회갑·칠순] 구분 | 한국나이 | 사용기간(개월) | 대상 관계 | 사용(Y/N)
    bdayItems: table(T.BDAY).map(r => ({
      name: String(r[0]).trim(), age: num(r[1], 0), months: num(r[2], 12), rels: rels(r[3]), on: on(r[4]),
    })).filter(x => x.age > 0),

    // [탈상] 구분 | 기준일(사망일=1일째) | 사용 시작(기준일±일) | 사용 마감(기준일±일) | 대상 관계 | 사용(Y/N)
    talsangItems: table(T.TALSANG).map(r => {
      const b = String(r[1]).trim();
      const y = b.match(/(\d+)\s*년/);
      return {
        name: String(r[0]).trim(),
        years: y ? +y[1] : 0, days: y ? 0 : num(b.replace(/[^\d]/g, ''), 0),
        startOff: num(r[2], -1), endOff: num(r[3], 0), rels: rels(r[4]), on: on(r[5]),
      };
    }).filter(x => x.years || x.days),
  };
}

function readEmployees_(warnings, cfg) {
  cfg = cfg || readConfig_();
  const retireAge = cfg.retireAge;
  const sh = getSheet_(SH.EMP);
  const v = sh.getDataRange().getValues();
  const h = findCols_(v[0], {
    id: '사번', name: '이름', dept: '부서', pos: '직급', hire: '입사일', birth: '생년월일',
    state: '재직상태', contract: '계약종료일',
  });
  const eom = d => new Date(d.getFullYear(), d.getMonth() + 1, 0);
  const out = [];
  for (let i = 1; i < v.length; i++) {
    const r = v[i];
    const id = norm_(r[h.id]);
    if (!id) continue;
    const hire = toDate_(r[h.hire]);
    if (!hire) warnings.push(`직원명부 ${i + 1}행: ${r[h.name]} 입사일이 비었거나 날짜 형식이 아님`);
    const birth = h.birth >= 0 ? toDate_(r[h.birth]) : null;
    const age60 = birth ? addMonths_(birth, retireAge * 12) : null;   // 만 N세 생일
    const retireDate = age60 ? eom(age60) : null;                     // 그달 말일
    const isContract = h.pos >= 0 && String(r[h.pos]).indexOf(CONTRACT_KEY) >= 0;
    const contractManual = h.contract >= 0 ? toDate_(r[h.contract]) : null;
    let contractEnd = null;
    if (isContract) {
      contractEnd = contractManual || (retireDate ? eom(addMonths_(retireDate, cfg.contractMonths)) : null);
      if (!contractEnd) warnings.push(`직원명부 ${i + 1}행: ${r[h.name]} 촉탁인데 생년월일·계약종료일이 없어 계약만료일 계산 불가`);
    }
    out.push({
      row: i + 1, id: id, name: String(r[h.name]).trim(), dept: h.dept >= 0 ? String(r[h.dept]).trim() : '',
      hire: hire, retired: h.state >= 0 && String(r[h.state]).indexOf('퇴사') >= 0,
      birth: birth, age60: age60, retireDate: retireDate,
      isContract: isContract, contractManual: !!contractManual, contractEnd: contractEnd,
      workEnd: isContract ? contractEnd : retireDate,   // 실제로 근무가 끝나는 날
    });
  }
  return out;
}

function readFamilies_(warnings) {
  const sh = getSheet_(SH.FAM);
  const v = sh.getDataRange().getValues();
  const h = findCols_(v[0], { id: '사번', rel: '관계', name: '성명', birth: '생년월일', alive: '생존', death: '사망일', note: '비고' });
  const out = [];
  for (let i = 1; i < v.length; i++) {
    const r = v[i];
    const id = norm_(r[h.id]);
    if (!id) continue;
    const birth = toDate_(r[h.birth]);
    const death = toDate_(r[h.death]);
    if (r[h.birth] !== '' && !birth) warnings.push(`가족사항 ${i + 1}행: 생년월일 '${r[h.birth]}' 날짜 형식 확인`);
    if (r[h.death] !== '' && !death) warnings.push(`가족사항 ${i + 1}행: 사망일 '${r[h.death]}' 날짜 형식 확인`);
    out.push({
      row: i + 1, id: id, rel: normRel_(r[h.rel]), name: String(r[h.name]).trim(),
      birth: birth, death: death, alive: parseAlive_(h.alive >= 0 ? r[h.alive] : '', death),
      note: h.note >= 0 ? String(r[h.note]).trim() : '',
    });
  }
  return out;
}

/** 생존여부 칸 → 생존/사망/미확인. 비어 있으면 사망일 유무로 판단 */
function parseAlive_(v, death) {
  const s = norm_(v);
  if (/사망|별세|고인|작고/.test(s)) return ALIVE.NO;
  if (/미확인|확인|모름|불명|\?/.test(s)) return death ? ALIVE.NO : ALIVE.UNKNOWN;
  if (/생존|생/.test(s)) return ALIVE.YES;
  return death ? ALIVE.NO : ALIVE.YES;
}

/** 사용이력 → 사용 여부 조회용 */
function readUsage_() {
  const sh = getSheet_(SH.USE);
  const v = sh.getDataRange().getValues();
  const h = findCols_(v[0], { done: '처리일', id: '사번', item: '구분', target: '대상', start: '시작' });
  const byKey = {}, talsangByTarget = {};
  for (let i = 1; i < v.length; i++) {
    const r = v[i];
    const id = norm_(r[h.id]);
    const item = normItem_(r[h.item]);
    if (!id || !item) continue;
    const target = norm_(r[h.target]) || '본인';
    const rec = { item: String(r[h.item]).trim(), done: toDate_(r[h.done]), start: toDate_(r[h.start]) };
    byKey[id + '|' + item + '|' + (item.indexOf('장기근속') === 0 ? '본인' : target)] = rec;
    if (item.indexOf('탈상') === 0) talsangByTarget[id + '|' + target] = rec;
  }
  return { byKey: byKey, talsangByTarget: talsangByTarget };
}


