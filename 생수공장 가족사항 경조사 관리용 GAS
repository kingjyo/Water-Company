/** 트리거가 매일 부르는 함수 */
function dailyJob() {
  const res = refreshStatus_();
  const isMonday = res.today.getDay() === 1;
  sendAlerts_(res, isMonday && res.cfg.weekly, false);
}

/** 메뉴: 지금 보내기 (요약 포함, 알림 대상이 없어도 발송) */
function sendAlertsNow() {
  const res = refreshStatus_();
  const n = sendAlerts_(res, true, true);
  SpreadsheetApp.getUi().alert(n === null ? '보낼 내용이 없습니다.' : `알림 메일을 보냈습니다. (오늘 알림 ${n}건)`);
}

/**
 * @return 오늘 알림 건수, 발송 안 했으면 null
 */
function sendAlerts_(res, withSummary, force) {
  const cfg = res.cfg, today = res.today;
  const alerts = [];
  res.events.forEach(ev => {
    if (ev.status === ST.RETIRE) {
      const d = diff_(today, ev.start);
      if (d === 0) alerts.push([`오늘 ${ev.label}`, ev]);
      else if (cfg.retireAlertDays.indexOf(d) >= 0) alerts.push([`${ev.label} ${d}일 전`, ev]);
    } else if (ev.status === ST.SOON) {
      const d = diff_(today, ev.start);
      if (cfg.alertDays.indexOf(d) >= 0) alerts.push([`사용 시작 ${d}일 전`, ev]);
    } else if (ev.status === ST.OPEN || ev.status === ST.URGENT) {
      const d = diff_(today, ev.end);
      const w = ev.endWord || '마감';
      if (sameDay_(today, ev.start)) alerts.push(['오늘부터 사용 가능', ev]);
      else if (ev.noEndAlert) { /* 항공권: 마감 없음 */ }
      else if (d === 0) alerts.push([`⚠ 오늘 ${w}`, ev]);
      else if (cfg.alertDays.indexOf(d) >= 0) alerts.push([`${w} ${d}일 전`, ev]);
    }
  });

  // 주간 요약: 보육비처럼 계속되는 항목은 종료 임박일 때만
  const summary = withSummary
    ? res.events.filter(ev => ev.status === ST.URGENT || (ev.status === ST.OPEN && !ev.ongoing && !ev.noEndAlert) ||
        (ev.status === ST.SOON && diff_(today, ev.start) <= 30) ||
        (ev.status === ST.RETIRE && diff_(today, ev.start) <= 90))
    : [];

  if (!alerts.length && !summary.length && !force) return null;

  const url = SpreadsheetApp.getActive().getUrl();
  let html = `<div style="font-family:'Malgun Gothic',sans-serif;font-size:14px">`;
  html += `<h3 style="margin:0 0 8px">🎁 경조·복지 알림 (${fmt_(today)})</h3>`;
  if (!alerts.length && !summary.length) html += '<p>현재 알릴 항목이 없습니다. (테스트 발송)</p>';
  if (alerts.length) {
    html += `<p><b>오늘 확인할 항목 ${alerts.length}건</b></p>`;
    html += mailTable_(alerts.map(a => [a[0]].concat(evCells_(a[1]))),
      ['알림', '구분', '직원', '대상', '사용 기간', '상태']);
  }
  if (summary.length) {
    html += `<p style="margin-top:16px"><b>현재 사용가능 · 30일 내 시작 예정 (${summary.length}건)</b></p>`;
    html += mailTable_(summary.map(ev => [ev.dday].concat(evCells_(ev))),
      ['D-day', '구분', '직원', '대상', '사용 기간', '상태']);
  }
  html += `<p style="margin-top:16px"><a href="${url}">▶ 스프레드시트 열기</a></p></div>`;

  const subject = alerts.length
    ? `[경조·복지] ${fmt_(today)} 알림 ${alerts.length}건` + (alerts.some(a => /오늘 마감|마감 [1-3]일/.test(a[0])) ? ' ⚠' : '')
    : `[경조·복지] ${fmt_(today)} 주간 요약`;

  MailApp.sendEmail({ to: cfg.emails.join(','), subject: subject, htmlBody: html });
  logAlert_(cfg.emails.join(','), alerts.length, subject,
    alerts.map(a => `${a[0]}: ${a[1].emp.name} ${a[1].label}`).join(' / '));
  return alerts.length;
}

function evCells_(ev) {
  if (ev.kind === '정년퇴직') {
    return [ev.label, `${ev.emp.name}(${ev.emp.dept})`, ev.benefit || '본인',
      `${ev.emp.isContract ? '계약만료' : '퇴직일'} ${fmt_(ev.start)}`, ev.status];
  }
  return [ev.label, `${ev.emp.name}(${ev.emp.dept})`,
    ev.target === '본인' ? '본인' : `${ev.target}(${ev.rel})`,
    ev.endText ? `${fmt_(ev.start)}부터 (마감 없음)` : `${fmt_(ev.start)} ~ ${fmt_(ev.end)}`, ev.status];
}

function mailTable_(rows, head) {
  const td = 'style="border:1px solid #ccc;padding:4px 8px"';
  let h = `<table style="border-collapse:collapse;font-size:13px"><tr>`;
  head.forEach(x => { h += `<th style="border:1px solid #ccc;padding:4px 8px;background:#1f4e78;color:#fff">${x}</th>`; });
  h += '</tr>';
  rows.forEach(r => {
    const bg = /오늘 마감|마감 [1-7]일|🔴/.test(r.join(' ')) ? ' style="background:#fde2e4"' : '';
    h += `<tr${bg}>` + r.map(c => `<td ${td}>${c}</td>`).join('') + '</tr>';
  });
  return h + '</table>';
}

function logAlert_(to, n, subject, detail) {
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(SH.LOG) || buildLogSheet_(ss);
  sh.appendRow([new Date(), to, n, subject, detail]);
}

/** 메뉴: 매일 자동 알림 켜기 */
function installDailyTrigger() {
  removeDailyTrigger_(true);
  const cfg = readConfig_();
