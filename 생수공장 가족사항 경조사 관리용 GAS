function writeCfgTable_(sh, r, title, head, rows, desc) {
  sh.getRange(r, 1).setValue(title).setFontWeight('bold').setFontColor(C_TITLE).setFontSize(11);
  sh.getRange(r, 2).setValue(desc).setFontColor('#666666').setWrap(false);
  sh.getRange(r + 1, 1, 1, head.length).setValues([head]);
  styleHeader_(sh.getRange(r + 1, 1, 1, head.length));
  const body = sh.getRange(r + 2, 1, rows.length, head.length);
  body.setNumberFormat('@').setValues(rows.map(x => x.map(String))).setBackground('#fffbe6')
    .setHorizontalAlignment('center');
  return r + 2 + rows.length + 1;
}

