    '부모 탈상(49재)', '부모 탈상(100일)', '부모 탈상(1주기)',
    '배우자부모 탈상(49재)', '배우자부모 탈상(100일)', '배우자부모 탈상(1주기)',
    '배우자 탈상(49재)', '배우자 탈상(100일)', '배우자 탈상(1주기)',
    '결혼', '출산', '조의', '기타']);
  sh.getRange(2, c, 499, 1).setDataValidation(SpreadsheetApp.newDataValidation()
    .requireValueInList(items, true).setAllowInvalid(true).build());
}

function repairConfig_(ss) {
  const cfg = ss.getSheetByName(SH.CFG);
  if (!cfg) return;
  let colA = cfg.getRange(1, 1, Math.max(1, cfg.getLastRow()), 1).getValues().map(r => String(r[0]).trim());
  const extra = RETIRE_CFG_ROWS.concat(EXTRA_CFG_ROWS_2);
  const add = extra.filter(x => colA.indexOf(x[0]) < 0);
  if (add.length) {
    // 이미 있는 추가 항목 중 마지막 줄 → 없으면 '관계 목록' 줄 아래에 끼워 넣기 (아래 표는 밀려 내려갈 뿐 그대로)
    let at = 0;
    extra.forEach(x => { const i = colA.indexOf(x[0]) + 1; if (i > at) at = i; });
    if (!at) at = colA.indexOf(K.REL_LIST) + 1;
    if (!at) at = colA.indexOf(K.FOUND) + 1;
    if (!at) at = cfg.getLastRow();
    cfg.insertRowsAfter(at, add.length);
    const rng = cfg.getRange(at + 1, 1, add.length, 3);
    cfg.getRange(at + 1, 2, add.length, 1).setNumberFormat('@');
    rng.setValues(add).setFontWeight('normal').setFontColor('#000000').setBackground(null).setHorizontalAlignment('left');
    cfg.getRange(at + 1, 1, add.length, 1).setFontWeight('bold').setBackground('#f3f6fa');
    cfg.getRange(at + 1, 2, add.length, 1).setBackground('#fffbe6');
    cfg.getRange(at + 1, 3, add.length, 1).setFontColor('#666666');
    colA = cfg.getRange(1, 1, cfg.getLastRow(), 1).getValues().map(r => String(r[0]).trim());
  }
  // 설명 문구만 최신으로 (B열 값은 건드리지 않음)
  const fsRow = colA.indexOf(K.FLIGHT_SHOW) + 1;
  if (fsRow) {
    const d = cfg.getRange(fsRow, 3);
    if (String(d.getValues()[0][0]).indexOf('사용 마감 아님') < 0) d.setValue(EXTRA_CFG_ROWS_2[1][2]);
  }

  // 장기근속 사용기간: 처음 만든 기본값(12개월)이면 5년(60개월)으로 한 번만 바꿈
  const props = PropertiesService.getDocumentProperties();
  if (!props.getProperty('mig_longservice_60')) {
    const t = colA.indexOf(T.LONG);
    if (t >= 0) {
      for (let r = t + 3; r <= colA.length && colA[r - 1] !== ''; r++) {
        const cell = cfg.getRange(r, 5);
        if (String(cell.getValues()[0][0]).trim() === '12') cell.setValue('60');
      }
      const descCell = cfg.getRange(t + 1, 2);
      if (String(descCell.getValues()[0][0]).indexOf('1회 지급') >= 0) {
        descCell.setValue('창립기념일에 근속연수 이상이 되면 그날부터 사용기간(60개월=5년) 안에 1회 사용. 행 추가/삭제 가능');
      }
    }
    props.setProperty('mig_longservice_60', '1');
  }

  [[RETIRE_NAME, K.RETIRE_AGE], [CONTRACT_NAME, K.CONTRACT_MONTHS]].forEach(x => {
    const row = colA.indexOf(x[1]) + 1;
    if (!row) return;
    const named = ss.getRangeByName(x[0]);
    if (!named || named.getSheet().getName() !== SH.CFG || named.getRow() !== row) {
      ss.setNamedRange(x[0], cfg.getRange(row, 2));
    }
  });
}

/** 사번 열을 텍스트로 통일 */
function normalizeIds_(sh) {
  const c = headerMap_(sh).findIndex(h => h.indexOf('사번') >= 0) + 1;
  if (!c) return;
  sh.getRange(2, c, Math.max(1, sh.getMaxRows() - 1), 1).setNumberFormat('@');
  const n = sh.getLastRow() - 1;
  if (n < 1) return;
  const rng = sh.getRange(2, c, n, 1);
  const v = rng.getValues();
  let changed = false;
  const out = v.map(r => {
    const x = r[0];
    if (typeof x === 'number') { changed = true; return [String(x)]; }
    if (typeof x === 'string' && x !== x.trim()) { changed = true; return [x.trim()]; }
    return [x];
  });
  if (changed) rng.setValues(out);
}

/** 사번을 입력·붙여넣기 하는 즉시 텍스트로 바꿈 (단순 트리거) */
function onEdit(e) {
  try {
    if (!e || !e.range) return;
    const sh = e.range.getSheet();
    if ([SH.EMP, SH.FAM, SH.USE].indexOf(sh.getName()) < 0 || e.range.getRow() < 2) return;
    const head = headerMap_(sh);
    const c0 = e.range.getColumn(), c1 = c0 + e.range.getNumColumns() - 1;
    // 가족사항: 사망일을 넣으면 생존여부를 '사망'으로
    if (sh.getName() === SH.FAM) {
      const cD = head.findIndex(h => h.indexOf('사망일') >= 0) + 1;
      const cA = head.findIndex(h => h.indexOf('생존') >= 0) + 1;
      if (cD && cA && cD >= c0 && cD <= c1) {
        const n = e.range.getNumRows(), r0 = e.range.getRow();
        const d = sh.getRange(r0, cD, n, 1).getValues();
        const a = sh.getRange(r0, cA, n, 1).getValues();
        let ch = false;
        const out = a.map((x, i) => {
          if (d[i][0] !== '' && x[0] !== ALIVE.NO) { ch = true; return [ALIVE.NO]; }
          return x;
        });
        if (ch) sh.getRange(r0, cA, n, 1).setValues(out);
      }
    }
    const c = head.findIndex(h => h.indexOf('사번') >= 0) + 1;
    if (!c || c < c0 || c > c1) return;
    const rng = sh.getRange(e.range.getRow(), c, e.range.getNumRows(), 1);
    const v = rng.getValues();
    if (!v.some(r => typeof r[0] === 'number')) return;
    rng.setNumberFormat('@').setValues(v.map(r => [typeof r[0] === 'number' ? String(r[0]) : r[0]]));
  } catch (err) { /* 입력 방해하지 않음 */ }
}

/** 직원명부 입력 열·자동 열 준비. {id, name} 열 문자 반환 */
function repairEmployee_(emp) {
  let head = headerMap_(emp);
  const col = key => head.findIndex(h => h.indexOf(key) >= 0) + 1;

  // 계약종료일(촉탁) 입력 열 — 없으면 '퇴사일' 오른쪽에 끼워 넣기
  if (!col('계약종료일')) {
    const after = col('퇴사일') || col('재직상태') || head.length;
    emp.insertColumnAfter(after);
    const c = after + 1;
    emp.getRange(1, c).setValue('계약종료일(촉탁)');
    styleHeader_(emp.getRange(1, c));
    emp.getRange(2, c, 499, 1).setNumberFormat('yyyy-mm-dd').setBackground(null)
      .setFontColor('#000000').setHorizontalAlignment('center');
    dateValidation_(emp.getRange(2, c, 499, 1));
    emp.getRange(1, c).setNote('직급이 "촉탁"인 경우만. 비우면 정년퇴직일 + 촉탁 계약기간(설정)으로 자동 계산. 재계약하면 새 종료일 입력');
    emp.setColumnWidth(c, 110);
    head = headerMap_(emp);
  }

  const cId = col('사번'), cName = head.indexOf('이름') + 1 || col('이름');
  if (!cId || !cName) return null;
  const L = c => colLetter_(c);

  // 자동 열 위치 (없으면 맨 끝에 추가)
  const autoKeys = ['근속기간', '만나이', '정년퇴직일', '퇴직까지'];
  const pos = {};
  let next = head.length + 1;
  autoKeys.forEach(k => { pos[k] = col(k) || next++; });

  const cHire = col('입사일'), cBirth = head.indexOf('생년월일') + 1 || col('생년월일');
  const cPos = col('직급'), cState = col('재직상태'), cCt = col('계약종료일');
  const rg = c => `${L(c)}2:${L(c)}`;

  // 근속기간
  if (cHire) emp.getRange(1, pos['근속기간']).setFormula(
    `={"근속기간(자동)"; ARRAYFORMULA(IF(${rg(cHire)}="", "", IFERROR(DATEDIF(${rg(cHire)}, TODAY(), "Y")&"년 "&DATEDIF(${rg(cHire)}, TODAY(), "YM")&"개월", "")))}`);
  if (cBirth) {
    // 만나이
    emp.getRange(1, pos['만나이']).setFormula(
      `={"만나이(자동)"; ARRAYFORMULA(IF(${rg(cBirth)}="", "", IFERROR(DATEDIF(${rg(cBirth)}, TODAY(), "Y"), "")))}`);
    // 정년퇴직일 = 만 N세 생일이 속한 달 말일
    emp.getRange(1, pos['정년퇴직일']).setFormula(
      `={"정년퇴직일(자동)"; ARRAYFORMULA(IF(${rg(cBirth)}="", "", IFERROR(EOMONTH(${rg(cBirth)}, ${RETIRE_NAME}*12), "")))}`);
    // 퇴직까지
    const N = rg(pos['정년퇴직일']);
    const remain = `DATEDIF(TODAY(), ${N}, "Y")&"년 "&DATEDIF(TODAY(), ${N}, "YM")&"개월 (D-"&(${N}-TODAY())&")"`;
    let body = `IF(${N}<TODAY(), "정년 경과", IF(${N}=TODAY(), "오늘 퇴직", ${remain}))`;
    if (cPos) {
      const CE = cCt ? `IF(${rg(cCt)}<>"", ${rg(cCt)}, EOMONTH(${N}, ${CONTRACT_NAME}))` : `EOMONTH(${N}, ${CONTRACT_NAME})`;
      const ct = `"촉탁 · 계약만료 "&TEXT(${CE}, "yyyy-mm-dd")&IF(${CE}<TODAY(), " (지남)", " (D-"&(${CE}-TODAY())&")")`;
      body = `IF(REGEXMATCH(${rg(cPos)}&"", "${CONTRACT_KEY}"), ${ct}, ${body})`;
    }
    if (cState) body = `IF(${rg(cState)}="퇴사", "퇴사", ${body})`;
    emp.getRange(1, pos['퇴직까지']).setFormula(`={"퇴직까지(자동)"; ARRAYFORMULA(IF(${N}="", "", ${body}))}`);
  }

  // 자동 열 서식
  const widths = { '근속기간': 110, '만나이': 80, '정년퇴직일': 105, '퇴직까지': 210 };
  autoKeys.forEach(k => {
    const c = pos[k];
    emp.getRange(1, c).setBackground('#5b7fa6').setFontColor('#ffffff').setFontWeight('bold')
      .setHorizontalAlignment('center').setVerticalAlignment('middle');
    emp.getRange(2, c, 499, 1).setBackground('#f3f6fa').setFontColor('#555555').setHorizontalAlignment('center');
    if (c >= head.length + 1) emp.setColumnWidth(c, widths[k]);
  });
  emp.getRange(2, pos['정년퇴직일'], 499, 1).setNumberFormat('yyyy-mm-dd');

  // 조건부 서식: 촉탁 = 보라, 1년 이내 퇴직 = 빨강, 정년 경과 = 회색 (이 두 열의 기존 규칙은 지우고 다시)
  const cols = [pos['정년퇴직일'], pos['퇴직까지']];
  const NN = '$' + L(pos['정년퇴직일']) + '2';
  const areas = cols.map(c => emp.getRange(2, c, 499, 1));
  const keep = emp.getConditionalFormatRules().filter(r =>
    !r.getRanges().some(x => cols.indexOf(x.getColumn()) >= 0));
  const isCt = cPos ? `REGEXMATCH($${L(cPos)}2&"", "${CONTRACT_KEY}")` : 'FALSE';
  const rules = [];
  if (cPos) rules.push(SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied(`=${isCt}`)
    .setBackground('#ece3f7').setFontColor('#5b2c83').setRanges(areas).build());
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied(`=AND(ISNUMBER(${NN}), ${NN}>=TODAY(), ${NN}<=EDATE(TODAY(), 12))`)
    .setBackground('#fde2e4').setFontColor('#b00020').setBold(true).setRanges(areas).build());
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied(`=AND(ISNUMBER(${NN}), ${NN}<TODAY())`)
    .setBackground('#e0e0e0').setFontColor('#777777').setRanges(areas).build());
  emp.setConditionalFormatRules(rules.concat(keep));

  return { id: L(cId), name: L(cName) };
}

/** 가족사항·사용이력: 이름(자동) 수식 + 사번 드롭다운 */
function repairLookup_(sh, emp, ec) {
  const head = headerMap_(sh);
  const cId = head.findIndex(h => h.indexOf('사번') >= 0) + 1;
  const cNm = head.findIndex(h => h.indexOf('이름') >= 0 && h.indexOf('자동') >= 0) + 1;
  if (!cId) return;
  const A = colLetter_(cId);
  if (cNm) {
    const label = sh.getName() === SH.FAM ? '직원이름(자동)' : '이름(자동)';
    // TO_TEXT로 양쪽을 글자로 맞춰서 비교 → 숫자/텍스트가 섞여도 찾음
    sh.getRange(1, cNm).setFormula(
      `={"${label}"; ARRAYFORMULA(IF(${A}2:${A}="", "", IFERROR(VLOOKUP(TRIM(TO_TEXT(${A}2:${A})), ` +
      `{TRIM(TO_TEXT('${SH.EMP}'!${ec.id}2:${ec.id})), '${SH.EMP}'!${ec.name}2:${ec.name}}, 2, FALSE), "⚠ 사번 확인")))}`);
  }
  sh.getRange(2, cId, 499, 1).setDataValidation(SpreadsheetApp.newDataValidation()
    .requireValueInRange(emp.getRange(`${ec.id}2:${ec.id}`), true).setAllowInvalid(true)
    .setHelpText('직원명부에 있는 사번을 고르세요').build());
}

/** 만 나이 */
function ageAt_(birth, d) {
  let a = d.getFullYear() - birth.getFullYear();
  if (d.getMonth() < birth.getMonth() || (d.getMonth() === birth.getMonth() && d.getDate() < birth.getDate())) a--;
  return a;
}

function colLetter_(n) {
  let s = '';
  while (n > 0) { const m = (n - 1) % 26; s = String.fromCharCode(65 + m) + s; n = Math.floor((n - 1) / 26); }
  return s;
}

/** a → b 남은 기간을 'n년 m개월' 로 */
function ymText_(a, b) {
  let m = (b.getFullYear() - a.getFullYear()) * 12 + (b.getMonth() - a.getMonth());
  if (b.getDate() < a.getDate()) m--;
  const y = Math.floor(m / 12); m = m % 12;
  return (y ? `${y}년 ` : '') + `${m}개월`;
}

function styleHeader_(rng) {
  rng.setBackground(C_HEAD).setFontColor('#ffffff').setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle').setWrap(true);
}

function dateValidation_(rng) {
  rng.setDataValidation(SpreadsheetApp.newDataValidation().requireDate().setAllowInvalid(true)
    .setHelpText('날짜로 입력하세요. 예) 1956-06-25').build());
}


/* ======================= 7. 공통 도우미 ======================= */

function getSheet_(name) {
  const sh = SpreadsheetApp.getActive().getSheetByName(name);
  if (!sh) throw new Error(`[${name}] 시트가 없습니다. 메뉴 > 초기 양식 만들기를 먼저 실행하세요.`);
  return sh;
}

/** 머리글 행에서 키워드가 들어간 첫 열 위치 (없으면 -1, 필수 열 없으면 오류) */
function findCols_(headRow, spec) {
  const head = headRow.map(x => String(x).replace(/\s/g, ''));
  const out = {};
  Object.keys(spec).forEach(k => {
    out[k] = head.findIndex(h => h.indexOf(spec[k]) >= 0);
  });
  ['id'].forEach(k => {
    if (k in out && out[k] < 0) throw new Error(`머리글에 '${spec[k]}' 열이 없습니다.`);
  });
  return out;
}

function headerMap_(sh) {
  return sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(x => String(x).replace(/\s/g, ''));
}

/** 머리글 키워드 기준으로 다음 빈 행에 기록 (자동 열은 건드리지 않음) */
function appendByHeader_(sh, head, data) {
  const idCol = head.findIndex(h => h.indexOf('사번') >= 0) + 1;
  const colVals = sh.getRange(1, idCol, sh.getMaxRows(), 1).getValues();
  let row = 1;
  colVals.forEach((r, i) => { if (String(r[0]).trim() !== '') row = i + 1; });
  row += 1;
  Object.keys(data).forEach(key => {
    const c = head.findIndex(h => h.indexOf(key) >= 0 && h.indexOf('자동') < 0);
    if (c >= 0) sh.getRange(row, c + 1).setValue(data[key]);
  });
}

/** 공백 제거 문자열 */
function norm_(v) { return String(v === null || v === undefined ? '' : v).replace(/\s/g, ''); }

/** 구분 비교용: 공백·'부모/배우자부모/배우자' 접두어·'포상/여행' 제거, 49제→49재 */
function normItem_(v) {
  return norm_(v).replace(/^(배우자부모|부모|배우자)/, '').replace(/포상|여행/g, '')
    .replace('49제', '49재').replace('탈상(백일)', '탈상(100일)').replace('탈상(1년)', '탈상(1주기)')
    .replace(/^항공권(복지)?.*$/, '항공권');
}

function normRel_(v) {
  const s = norm_(v);
  return REL_ALIAS[s] || s;
}

function splitList_(v) {
  return String(v === null || v === undefined ? '' : v).split(/[,，;\n]+/).map(x => x.trim()).filter(Boolean);
}

function joinNote_() {
  return Array.prototype.slice.call(arguments).filter(Boolean).join(' · ');
}

/** 여러 형태의 날짜 입력 → 자정 기준 Date (실패 시 null) */
function toDate_(v) {
  if (v === '' || v === null || v === undefined) return null;
  if (Object.prototype.toString.call(v) === '[object Date]') {
    return isNaN(v.getTime()) ? null : new Date(v.getFullYear(), v.getMonth(), v.getDate());
  }
  const s = String(v).trim();
  let m = s.match(/^(\d{4})\D+(\d{1,2})\D+(\d{1,2})/);        // 1956-06-25, 1956.6.25, 1956/06/25
  if (!m) m = s.match(/^(\d{4})(\d{2})(\d{2})$/);              // 19560625
  if (!m) return null;
  return d_(+m[1], +m[2], +m[3]);
}

/** 년,월,일 → Date (잘못된 날짜면 null) */
function d_(y, m, d) {
  const dt = new Date(y, m - 1, d);
  return dt.getMonth() === m - 1 ? dt : null;
}

function today_() { const n = new Date(); return new Date(n.getFullYear(), n.getMonth(), n.getDate()); }

function addDays_(d, n) { return new Date(d.getFullYear(), d.getMonth(), d.getDate() + n); }

/** 월 더하기 (2/29 + 12개월 → 2/28 처럼 말일 넘침 방지) */
function addMonths_(d, n) {
  const y = d.getFullYear(), m = d.getMonth() + n;
  const last = new Date(y, m + 1, 0).getDate();
  return new Date(y, m, Math.min(d.getDate(), last));
}

function diff_(a, b) { return Math.round((b - a) / 86400000); }

function sameDay_(a, b) { return diff_(a, b) === 0; }

function pad_(n) { return (n < 10 ? '0' : '') + n; }

function fmt_(d) {
  if (!d) return '';
  return `${d.getFullYear()}-${pad_(d.getMonth() + 1)}-${pad_(d.getDate())}`;
}
