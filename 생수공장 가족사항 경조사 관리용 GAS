/**
 * 매 새로고침마다 실행 (여러 번 실행해도 결과 같음)
 *  - 설정 시트에 정년·촉탁 항목이 없으면 추가 + 이름 범위 연결
 *  - 사번 열을 전부 '텍스트'로 통일 (숫자/텍스트가 섞이면 드롭다운 경고·이름 조회 실패)
 *  - 직원명부: 계약종료일(촉탁) 입력 열, 자동 열(근속기간·만나이·정년퇴직일·퇴직까지) 준비
 *  - 가족사항·사용이력: 이름(자동) 수식과 사번 드롭다운을 현재 직원명부 위치에 맞춰 다시 설정
 */
function repairSheets_() {
  const ss = SpreadsheetApp.getActive();
  repairConfig_(ss);
  const emp = ss.getSheetByName(SH.EMP);
  if (!emp) return;
  normalizeIds_(emp);
  const ec = repairEmployee_(emp);
  if (!ec) return;
  [SH.FAM, SH.USE].forEach(n => {
    const sh = ss.getSheetByName(n);
    if (!sh) return;
    normalizeIds_(sh);
    repairLookup_(sh, emp, ec);
  });
  const fam = ss.getSheetByName(SH.FAM);
  if (fam) repairFamily_(fam);
  const use = ss.getSheetByName(SH.USE);
  if (use) repairUsageItems_(use);
}

/**
 * 가족사항: '생존여부' 열이 없으면 생년월일 오른쪽에 끼워 넣고(기존 데이터는 오른쪽으로 한 칸 이동할 뿐 그대로)
 * 사망일 있으면 '사망', 없으면 '생존'으로 미리 채움. 드롭다운·색은 매번 다시 설정
 */
function repairFamily_(sh) {
  let head = headerMap_(sh);
  let cAlive = head.findIndex(h => h.indexOf('생존') >= 0) + 1;
  if (!cAlive) {
    const cBirth = head.indexOf('생년월일') + 1;
    const cDeath0 = head.findIndex(h => h.indexOf('사망일') >= 0) + 1;
    const after = cBirth || (cDeath0 ? cDeath0 - 1 : head.length);
    sh.insertColumnAfter(after);
    cAlive = after + 1;
    sh.getRange(1, cAlive).setValue('생존여부');
    styleHeader_(sh.getRange(1, cAlive));
    sh.setColumnWidth(cAlive, 80);
    head = headerMap_(sh);
    const cId = head.findIndex(h => h.indexOf('사번') >= 0) + 1;
    const cDeath = head.findIndex(h => h.indexOf('사망일') >= 0) + 1;
    const n = sh.getLastRow() - 1;
    if (n > 0 && cId) {
      const ids = sh.getRange(2, cId, n, 1).getValues();
      const deaths = cDeath ? sh.getRange(2, cDeath, n, 1).getValues() : ids.map(() => ['']);
      sh.getRange(2, cAlive, n, 1).setValues(ids.map((r, i) =>
        [String(r[0]).trim() === '' ? '' : (deaths[i][0] !== '' ? ALIVE.NO : ALIVE.YES)]));
    }
  }
  const body = sh.getRange(2, cAlive, 499, 1);
  body.setNumberFormat('@').setHorizontalAlignment('center').setBackground(null).setFontColor('#000000');
  body.setDataValidation(SpreadsheetApp.newDataValidation()
    .requireValueInList([ALIVE.YES, ALIVE.NO, ALIVE.UNKNOWN], true).setAllowInvalid(true)
    .setHelpText('생존 / 사망 / 미확인. 사망이면 회갑·칠순·보육비는 표시 안 함 (사망일 있으면 탈상만 계산)').build());
  sh.getRange(1, cAlive).setNote('생존 / 사망 / 미확인\n· 사망: 회갑·칠순·보육비 표시 안 함. 사망일을 넣으면 탈상 계산\n· 미확인: 계산은 하되 "확인 필요" 표시\n· 비우면 사망일 유무로 판단');

  // 색: 사망 = 회색, 미확인 = 노랑 (이 열의 기존 규칙만 지우고 다시)
  const nameC = head.findIndex(h => h.indexOf('성명') >= 0) + 1;
  const cols = [cAlive, nameC].filter(Boolean);
  const areas = cols.map(c => sh.getRange(2, c, 499, 1));
  const A = '$' + colLetter_(cAlive) + '2';
  const keep = sh.getConditionalFormatRules().filter(r => !r.getRanges().some(x => cols.indexOf(x.getColumn()) >= 0));
  sh.setConditionalFormatRules([
    SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied(`=${A}="${ALIVE.NO}"`)
      .setBackground('#e6e6e6').setFontColor('#888888').setRanges(areas).build(),
    SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied(`=${A}="${ALIVE.UNKNOWN}"`)
      .setBackground('#fff4c2').setFontColor('#7a5b00').setRanges(areas).build(),
  ].concat(keep));
}

/** 사용이력 '구분' 드롭다운 목록 (항목이 늘어도 자동 반영, 목록 밖 값도 경고만) */
