/** 최초 1회: 시트·서식·예시 데이터 생성 (이미 있는 시트는 건드리지 않음) */
function setupTemplate() {
  const ss = SpreadsheetApp.getActive();
  const ui = SpreadsheetApp.getUi();
  const ok = ui.alert('🛠 초기 양식 만들기',
    '설정 / 직원명부 / 가족사항 / 사용이력 / 대상자현황 / 알림로그 시트를 만들고 예시 데이터를 넣습니다.\n' +
    '이미 같은 이름의 시트가 있으면 그 시트는 건드리지 않습니다.\n\n진행할까요?', ui.ButtonSet.YES_NO);
  if (ok !== ui.Button.YES) return;

  const made = [], skipped = [];
  const steps = [
    [SH.CFG, buildConfigSheet_], [SH.EMP, buildEmployeeSheet_], [SH.FAM, buildFamilySheet_],
    [SH.USE, buildUsageSheet_], [SH.STATUS, buildStatusSheet_], [SH.LOG, buildLogSheet_],
  ];
  steps.forEach(s => {
    if (ss.getSheetByName(s[0])) { skipped.push(s[0]); return; }
    s[1](ss); made.push(s[0]);
  });

  // 기본 빈 시트 정리
  ['시트1', 'Sheet1'].forEach(n => {
    const s = ss.getSheetByName(n);
    if (s && ss.getSheets().length > 1 && s.getLastRow() === 0) ss.deleteSheet(s);
  });

  // 시트 순서
  [SH.STATUS, SH.EMP, SH.FAM, SH.USE, SH.CFG, SH.LOG].forEach((n, i) => {
    const s = ss.getSheetByName(n);
    if (s) { ss.setActiveSheet(s); ss.moveActiveSheet(i + 1); }
  });

  refreshStatus_();
  ss.setActiveSheet(ss.getSheetByName(SH.STATUS));

  let msg = `만든 시트: ${made.join(', ') || '없음'}`;
  if (skipped.length) msg += `\n건너뛴 시트(이미 있음): ${skipped.join(', ')}`;
  const sTz = Session.getScriptTimeZone(), xTz = ss.getSpreadsheetTimeZone();
  if (sTz !== xTz) {
    msg += `\n\n⚠ 시간대가 다릅니다 (스크립트: ${sTz} / 시트: ${xTz}).\n` +
      `날짜가 하루씩 밀릴 수 있으니 Apps Script 프로젝트 설정과 파일 > 설정의 시간대를 모두 서울로 맞추세요.`;
  }
  msg += '\n\n예시 데이터(직원명부·가족사항·사용이력)를 지우고 실제 데이터를 넣은 뒤\n[🎁 경조·복지] > 대상자현황 새로고침 을 누르세요.';
  ui.alert('완료', msg, ui.ButtonSet.OK);
  onOpen();
}

