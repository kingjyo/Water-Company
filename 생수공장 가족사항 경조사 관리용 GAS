/* ======================= 1. 대상자현황 새로고침 ======================= */

/** 메뉴: 대상자현황 새로고침 */
function refreshStatus() {
  const res = refreshStatus_();
  SpreadsheetApp.getActive().toast(
    `대상자 ${res.events.length}건 정리 완료` + (res.warnings.length ? ` · 확인 필요 ${res.warnings.length}건` : ''),
    '🔄 새로고침', 5);
}

/** 계산 + 시트 기록. {events, warnings, cfg, today} 반환 */
function refreshStatus_() {
  repairSheets_();   // 사번 텍스트 통일·자동 수식·정년/촉탁 열을 매번 점검 (예전 시트도 자동 업그레이드)
  const cfg = readConfig_();
  const today = today_();
  const built = buildEvents_(cfg, today);
  writeStatusSheet_(built.events, built.warnings, today);
  return { events: built.events, warnings: built.warnings, cfg: cfg, today: today };
}

/** 모든 대상 항목 계산 */
function buildEvents_(cfg, today) {
  const warnings = [];
  const emps = readEmployees_(warnings, cfg);
  const fams = readFamilies_(warnings);
  const usage = readUsage_();

  const empMap = {};
  emps.forEach(e => { empMap[e.id] = e; });

  let events = [];

  // ── 1) 장기근속포상여행 ──────────────────────────────
  // 창립기념일(예: 2/20)에 근속 N년 이상이 되는 해 → 그날부터 1년간 사용 가능
  emps.forEach(e => {
    if (e.retired || !e.hire) return;
    cfg.longService.forEach(t => {
      const anniv = addMonths_(e.hire, t.years * 12);                 // 근속 N년 되는 날
      let y = anniv.getFullYear();
      if (anniv > new Date(y, cfg.foundM - 1, cfg.foundD)) y++;      // 그해 창립기념일 이후면 다음 해
      const start = new Date(y, cfg.foundM - 1, cfg.foundD);
      const end = addDays_(addMonths_(start, t.months), -1);
      events.push({
        kind: '장기근속', label: `장기근속 ${t.years}년`, emp: e, rel: '본인', target: '본인',
        base: anniv, start: start, end: end,
        benefit: longServiceBenefit_(t),
        note: `근속 ${t.years}년 도달 ${fmt_(anniv)} → ${y}년 창립기념일부터`,
      });
    });
  });

  // ── 1-2) 항공권 복지 ───────────────────────────────
  // 입사일부터 N개월 되는 날부터 사용 가능 (촉탁 제외). 마감 없음 → 일정 기간만 표시
  if (cfg.flightMonths > 0) {
    emps.forEach(e => {
      if (e.retired || !e.hire || e.isContract) return;
      const start = addMonths_(e.hire, cfg.flightMonths);
      events.push({
        kind: '항공권', label: '항공권 복지', emp: e, rel: '본인', target: '본인',
        // end는 '대상자현황에 보여주는 기간'일 뿐 사용 마감이 아님 → 화면에는 '마감 없음'으로 표시
        base: e.hire, start: start, end: addDays_(addMonths_(start, cfg.flightShow), -1),
        endText: '없음 (퇴직 시까지)', benefit: '퇴직 시까지 사용 가능 (사용 마감 없음)', noEndAlert: true, noCap: true,
        note: `입사 ${fmt_(e.hire)} → 근속 ${cfg.flightMonths}개월 되는 날부터 사용 가능 · 현황표에는 ${cfg.flightShow}개월간만 표시(알림용)`,
      });
    });
  }

  // ── 2) 가족 경조 (회갑·칠순 / 탈상 / 영유아 보육비) ──────
  fams.forEach(f => {
    const e = empMap[f.id];
    if (!e) { warnings.push(`가족사항 ${f.row}행: 사번 '${f.id}'이(가) 직원명부에 없습니다.`); return; }
    if (e.retired) return;
    const prefix = relPrefix_(f.rel, cfg);
    const unknownNote = f.alive === ALIVE.UNKNOWN ? '❓ 생존여부 미확인 — 안내할 때 함께 확인' : '';
    if (f.alive === ALIVE.YES && f.death) {
      warnings.push(`가족사항 ${f.row}행: ${f.name} 생존여부는 '생존'인데 사망일이 있음`);
    }

    // 회갑·칠순 : 출생일을 1세로 → 한국나이 N세 되는 해의 생일부터 1년
    cfg.bdayItems.forEach(it => {
      if (!it.on || it.rels.indexOf(f.rel) < 0) return;
      if (!f.birth) {
        if (f.alive !== ALIVE.NO) warnings.push(`가족사항 ${f.row}행: ${f.name}(${f.rel}) 생년월일이 없어 ${it.name} 계산 불가`);
        return;
      }
      const start = addMonths_(f.birth, (it.age - 1) * 12);
      const end = addDays_(addMonths_(start, it.months), -1);
      if (f.alive === ALIVE.NO && (!f.death || f.death < start)) return; // 시작 전 별세(또는 사망일 모름) → 대상 아님
      events.push({
        kind: '회갑칠순', label: prefix + it.name, emp: e, rel: f.rel, target: f.name,
        base: start, start: start, end: end, benefit: '',
        note: joinNote_(unknownNote, `한국나이 ${it.age}세 생일부터 ${it.months}개월`,
          f.death && f.death <= end ? `기간 중 별세(${fmt_(f.death)})` : '', f.note),
      });
    });

    // 영유아 위탁보육비 : 출생일 ~ 만6세가 되어 취학하는 해(출생연도+7) 2월 말일
    if (cfg.childOn && f.birth && f.alive !== ALIVE.NO && cfg.childRels.indexOf(f.rel) >= 0) {
      const endAll = new Date(f.birth.getFullYear() + 7, 2, 0);       // 그해 2월 말일
      const first = addMonths_(f.birth, 12);                           // 첫돌
      const age = ageAt_(f.birth, today);
      events.push({
        kind: '보육', label: '자녀 영유아보육비', emp: e, rel: f.rel, target: f.name,
        base: f.birth, start: f.birth, end: endAll, endWord: '지급종료', ongoing: true,
        benefit: today < first ? '만0세: 직원 직접 지급 가능' : `만0~5세 미취학 지급 (현재 만 ${age}세)`,
        note: joinNote_(unknownNote, `${f.birth.getFullYear() + 7}년 3월 취학 예정 → 2월까지 지급`, f.note),
      });
      events.push({
        kind: '보육', label: '자녀 보육비(만0세 직접지급)', emp: e, rel: f.rel, target: f.name,
        base: f.birth, start: f.birth, end: addDays_(first, -1), endWord: '만0세 종료', ongoing: true,
        benefit: '만0세 구간: 직원에게 직접 지급 가능',
        note: joinNote_(`첫돌 ${fmt_(first)}부터는 일반 보육비 지급 방식`, f.note),
      });
    }

    // 탈상 : 사망일을 1일째로 셈 (사망일을 모르면 계산 안 함)
    if (f.death) {
      cfg.talsangItems.forEach(it => {
        if (!it.on || it.rels.indexOf(f.rel) < 0) return;
        const base = it.years ? addMonths_(f.death, it.years * 12) : addDays_(f.death, it.days - 1);
        events.push({
          kind: '탈상', label: prefix + it.name, emp: e, rel: f.rel, target: f.name,
          base: base, start: addDays_(base, it.startOff), end: addDays_(base, it.endOff), benefit: '',
          note: joinNote_(`사망일 ${fmt_(f.death)}`, f.note),
        });
      });
    }
  });

  // ── 3) 정년퇴직 / 촉탁 계약만료 ─────────────────────
  // 일반: 만 N세 생일이 속한 달의 말일 퇴직
  // 촉탁: 정년 후 계약직 → 계약만료일(직접입력 또는 정년퇴직일 + 계약기간)
  // 그날 이후 복지 기간은 잘라냄(설정)
  if (cfg.retireCap) {
    events = events.filter(ev => !(ev.emp.workEnd && ev.start > ev.emp.workEnd));
    events.forEach(ev => {
      if (ev.noCap) return;
      if (ev.emp.workEnd && ev.end > ev.emp.workEnd) {
        ev.end = ev.emp.workEnd;
        ev.note = joinNote_(ev.emp.isContract ? '⚠ 촉탁 계약만료일까지만 사용 가능' : '⚠ 정년퇴직일까지만 사용 가능', ev.note);
      }
    });
  }
  emps.forEach(e => {
    if (e.retired || !e.workEnd) return;
    events.push(e.isContract ? {
      kind: '정년퇴직', label: '촉탁 계약만료', emp: e, rel: '본인', target: '본인',
      base: e.retireDate || e.workEnd, start: e.workEnd, end: e.workEnd, benefit: '',
      note: e.contractManual
        ? '계약종료일 직접입력'
        : `정년퇴직 ${fmt_(e.retireDate)} 다음 날부터 ${cfg.contractMonths}개월 (자동 계산)`,
    } : {
      kind: '정년퇴직', label: '정년퇴직', emp: e, rel: '본인', target: '본인',
      base: e.age60, start: e.retireDate, end: e.retireDate, benefit: '',
      note: `만 ${cfg.retireAge}세 생일 ${fmt_(e.age60)} → 그달 말일 퇴직`,
    });
  });

  // ── 4) 상태 판정 ──────────────────────────────────
  events.forEach(ev => {
    if (ev.kind === '정년퇴직') {
      const d = diff_(today, ev.start);
      const word = ev.emp.isContract ? '계약만료' : '퇴직';
      if (d >= 0) {
        ev.status = ST.RETIRE;
        ev.dday = d === 0 ? `오늘 ${word}` : `${word} D-${d}`;
        ev.note = joinNote_(d > 0 ? `남은 기간 ${ymText_(today, ev.start)}` : '', ev.note);
      } else if (ev.emp.isContract) {
        ev.status = ST.NA;
        ev.dday = `계약만료 +${-d}일`;
        ev.note = joinNote_('재계약했으면 직원명부 "계약종료일(촉탁)" 수정, 아니면 재직상태 "퇴사"', ev.note);
        warnings.push(`직원명부 ${ev.emp.row}행: ${ev.emp.name} 촉탁 계약만료일(${fmt_(ev.start)}) 지남 → 재계약이면 계약종료일 수정, 아니면 퇴사 처리`);
      } else {
        ev.status = ST.NA;
        ev.dday = `퇴직 +${-d}일`;
        ev.note = joinNote_('촉탁 재고용이면 직급을 "촉탁"으로, 아니면 재직상태 "퇴사"', ev.note);
        warnings.push(`직원명부 ${ev.emp.row}행: ${ev.emp.name} 정년퇴직일(${fmt_(ev.start)}) 지남 → 촉탁이면 직급 "촉탁", 아니면 퇴사 처리`);
      }
      return;
    }
    if (ev.kind === '보육') {
      // 계속 지급되는 기간 → 사용이력과 무관, 종료일만 관리
      if (today < ev.start) { ev.status = ST.SOON; ev.dday = `시작 D-${diff_(today, ev.start)}`; }
      else if (today > ev.end) { ev.status = ST.NA; ev.dday = ev.endWord; }
      else {
        const d = diff_(today, ev.end);
        ev.status = d <= cfg.urgentDays ? ST.URGENT : ST.OPEN;
        ev.dday = d === 0 ? `${ev.endWord} D-DAY` : `${ev.endWord} D-${d}`;
      }
      return;
    }
    const key = ev.emp.id + '|' + normItem_(ev.label) + '|' + (ev.target === '본인' ? '본인' : norm_(ev.target));
    const used = usage.byKey[key];
    if (ev.kind === '항공권' && !used) {
      // 마감 없음: 사용 가능해진 날부터 표시기간 동안 '사용가능'
      if (today < ev.start) { ev.status = ST.SOON; ev.dday = `시작 D-${diff_(today, ev.start)}`; }
      else if (today > ev.end) { ev.status = ST.NA; ev.dday = '-'; }   // 표시기간 지남 → 숨김 대상
      else { ev.status = ST.OPEN; ev.dday = `가능 +${diff_(ev.start, today)}일`; }
      return;
    }
    if (used) {
      ev.status = ST.DONE;
      ev.dday = '사용 ' + fmt_(used.start || used.done);
      ev.usedRec = used;
    } else if (today > ev.end) {
      ev.status = ST.MISSED;
      ev.dday = `만료 +${diff_(ev.end, today)}일`;
    } else if (today < ev.start) {
      ev.status = ST.SOON;
      ev.dday = `시작 D-${diff_(today, ev.start)}`;
    } else {
      const d = diff_(today, ev.end);
      ev.status = d <= cfg.urgentDays ? ST.URGENT : ST.OPEN;
      ev.dday = d === 0 ? '마감 D-DAY' : `마감 D-${d}`;
    }
  });

  // 탈상은 49재·100일·1주기 중 한 번만 사용 → 묶어서 정리
  const groups = {};
  events.filter(ev => ev.kind === '탈상').forEach(ev => {
    const g = ev.emp.id + '|' + norm_(ev.target);
    (groups[g] = groups[g] || []).push(ev);
  });
  Object.keys(groups).forEach(g => {
    const list = groups[g];
    const usedEv = list.find(ev => ev.status === ST.DONE);
    const usedOther = usage.talsangByTarget[g];
    if (usedEv || usedOther) {
      const what = usedEv ? usedEv.label.replace(/^.*?(탈상)/, '$1') : usedOther.item;
      list.forEach(ev => {
        if (ev.status === ST.DONE) return;
        ev.status = ST.NA; ev.dday = '-';
        ev.note = joinNote_(`${what} 사용함`, ev.note);
      });
      return;
    }
    const alive = list.filter(ev => ev.status !== ST.MISSED);
    const expired = list.filter(ev => ev.status === ST.MISSED);
    if (alive.length) {
      // 다음 탈상 시기가 남아 있으면 지나간 것은 '해당없음'
      expired.forEach(ev => { ev.status = ST.NA; ev.note = joinNote_('다음 탈상 시기 남음', ev.note); });
    } else if (expired.length) {
      // 전부 지났으면 마지막(1주기)만 '기한만료'로 남김
      expired.sort((a, b) => b.end - a.end);
      expired.slice(1).forEach(ev => { ev.status = ST.NA; });
    }
  });

  // 정년퇴직 행에 '퇴직 전에 써야 할 복지' 정리
  events.filter(ev => ev.kind === '정년퇴직' && ev.status === ST.RETIRE).forEach(r => {
    const left = [];
    events.forEach(ev => {
      if (ev.emp !== r.emp || ev.kind === '정년퇴직') return;
      if ([ST.OPEN, ST.URGENT, ST.SOON].indexOf(ev.status) < 0) return;
      const name = ev.kind === '탈상' ? ev.label.replace(/\(.*\)$/, '(택1)') : ev.label;
      if (left.indexOf(name) < 0) left.push(name);
    });
    r.benefit = left.length ? `퇴직 전 미사용: ${left.join(', ')}` : '';
  });

  // ── 5) 표시 범위 거르기 + 정렬 ───────────────────────
  const minEnd = addDays_(today, -cfg.pastDays);
  const maxStart = addDays_(today, cfg.futureDays);
  events = events.filter(ev => ev.start <= maxStart && ev.end >= minEnd &&
    !((ev.ongoing || ev.kind === '항공권') && ev.status !== ST.DONE && ev.end < today));  // 보육·항공권은 기간 끝나면 숨김

  // 장기근속은 직원별로 '가장 가까운 1건'만 남김 (사용완료·사용가능은 모두 표시)
  const lsSeen = {};
  events = events.filter(ev => {
    if (ev.kind !== '장기근속' || ev.status !== ST.SOON) return true;
    if (lsSeen[ev.emp.id]) return false;
    lsSeen[ev.emp.id] = true; return true;
  });

  events.sort((a, b) => {
    const s = ST_ORDER.indexOf(a.status) - ST_ORDER.indexOf(b.status);
    if (s) return s;
    if (a.status === ST.SOON || a.status === ST.RETIRE) return a.start - b.start;
    if (a.status === ST.MISSED || a.status === ST.DONE || a.status === ST.NA) return b.end - a.end;
    return a.end - b.end;
  });

  return { events: events, warnings: warnings };
}

function longServiceBenefit_(t) {
  const money = (t.dom !== '' && t.dom === t.abr)
    ? `국내·해외 ${t.dom}만원`
    : `국내 ${t.dom}만원 / 해외 ${t.abr}만원`;
  return `${t.trip} · ${money}`;
}

function relPrefix_(rel, cfg) {
  if (cfg.parentRels.indexOf(rel) >= 0) return '부모 ';
  if (cfg.spouseParentRels.indexOf(rel) >= 0) return '배우자부모 ';
  return rel + ' ';
}


/* ======================= 2. 대상자현황 시트 쓰기 ======================= */

function writeStatusSheet_(events, warnings, today) {
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(SH.STATUS) || buildStatusSheet_(ss);
  const nCol = STATUS_HEADERS.length;

  // 기존 데이터 지우기
  if (sh.getFilter()) sh.getFilter().remove();
  const last = Math.max(sh.getMaxRows(), STATUS_HEADER_ROW + 1);
  sh.getRange(STATUS_HEADER_ROW + 1, 1, last - STATUS_HEADER_ROW, nCol).clear();

  // 2행: 기준일 / 경고
  const now = new Date();
  const info = `기준일 ${fmt_(today)}(${'일월화수목금토'[today.getDay()]}) · 갱신 ${fmt_(now)} ${pad_(now.getHours())}:${pad_(now.getMinutes())}`;
  const c2 = sh.getRange(2, 1);
  c2.setValue(warnings.length ? `${info}   ⚠ 확인 필요 ${warnings.length}건 (이 칸 메모 참고)` : info);
  c2.setNote(warnings.length ? warnings.join('\n') : '');
  c2.setFontColor(warnings.length ? '#b00020' : '#555555');

  // 3행: 요약 칩
  const cnt = s => events.filter(ev => ev.status === s).length;
  const chips = [
    [ST.URGENT, `${ST.URGENT} ${cnt(ST.URGENT)}건`],
    [ST.OPEN, `${ST.OPEN} ${cnt(ST.OPEN)}건`],
    [ST.SOON, `${ST.SOON} ${cnt(ST.SOON)}건`],
    [ST.MISSED, `${ST.MISSED} ${cnt(ST.MISSED)}건`],
    [ST.RETIRE, `${ST.RETIRE} ${cnt(ST.RETIRE)}명`],
  ];
  sh.getRange(3, 1, 1, nCol).clearContent().setBackground(null);
  chips.forEach((c, i) => {
    sh.getRange(3, 1 + i * 2, 1, 2).breakApart().merge()
      .setValue(c[1]).setBackground(ST_COLOR[c[0]]).setFontWeight('bold')
      .setHorizontalAlignment('center');
  });

  // 4행: 머리글
  sh.getRange(STATUS_HEADER_ROW, 1, 1, nCol).setValues([STATUS_HEADERS])
    .setBackground(C_HEAD).setFontColor('#ffffff').setFontWeight('bold').setHorizontalAlignment('center');

  if (!events.length) {
    sh.getRange(STATUS_HEADER_ROW + 1, 1).setValue('표시할 대상이 없습니다.');
    return;
  }

  const rows = events.map(ev => [
    ev.status, ev.dday, ev.label, ev.emp.dept, ev.emp.id, ev.emp.name, ev.rel, ev.target,
    ev.base, ev.start, ev.endText || ev.end, ev.benefit, ev.note || '',
  ]);
  const rng = sh.getRange(STATUS_HEADER_ROW + 1, 1, rows.length, nCol);
  rng.setValues(rows);
  rng.setBackgrounds(events.map(ev => Array(nCol).fill(ST_COLOR[ev.status] || null)));
  rng.setFontColors(events.map(ev => Array(nCol).fill(
    (ev.status === ST.DONE || ev.status === ST.NA) ? '#888888' : '#000000')));
  rng.setVerticalAlignment('middle');
  sh.getRange(STATUS_HEADER_ROW + 1, 9, rows.length, 3).setNumberFormat('yyyy-mm-dd');
  sh.getRange(STATUS_HEADER_ROW + 1, 1, rows.length, 2).setFontWeight('bold');
  sh.getRange(STATUS_HEADER_ROW + 1, 5, rows.length, 1).setNumberFormat('@');
  [1, 2, 5, 7, 9, 10, 11].forEach(c =>
    sh.getRange(STATUS_HEADER_ROW + 1, c, rows.length, 1).setHorizontalAlignment('center'));
  // 마감일 굵게(사용가능/임박)
  events.forEach((ev, i) => {
    if ((ev.status === ST.URGENT || ev.status === ST.OPEN) && !ev.endText) {
      sh.getRange(STATUS_HEADER_ROW + 1 + i, 11).setFontWeight('bold').setFontColor('#b00020');
    }
  });

  sh.getRange(STATUS_HEADER_ROW, 1, rows.length + 1, nCol).createFilter();
}


/* ======================= 3. 사용완료 처리 ======================= */

/** 메뉴: 대상자현황에서 선택한 행을 사용이력에 기록 */
function markSelectedAsUsed() {
  const ss = SpreadsheetApp.getActive();
  const ui = SpreadsheetApp.getUi();
  const sh = ss.getActiveSheet();
  if (sh.getName() !== SH.STATUS) {
    ui.alert(`[${SH.STATUS}] 시트에서 처리할 행을 선택한 뒤 다시 실행하세요.`);
    return;
  }
  const sel = sh.getActiveRange();
  const r0 = Math.max(sel.getRow(), STATUS_HEADER_ROW + 1);
  const r1 = sel.getRow() + sel.getNumRows() - 1;
  if (r1 < r0) { ui.alert('표 안의 행(5행부터)을 선택하세요.'); return; }

  const vals = sh.getRange(r0, 1, r1 - r0 + 1, STATUS_HEADERS.length).getValues()
    .filter(r => r[4] !== '' && r[0] !== ST.DONE);
  if (!vals.length) { ui.alert('처리할 항목이 없습니다. (이미 사용완료이거나 빈 행)'); return; }

  const list = vals.map(r => `· ${r[5]} - ${r[2]} (${r[7]})`).join('\n');
  const resp = ui.prompt('✅ 사용완료 처리',
    `${list}\n\n사용 날짜를 입력하세요.\n예) 2026-10-20   또는   2026-10-20~2026-10-23\n(비워두면 오늘 날짜)`,
    ui.ButtonSet.OK_CANCEL);
  if (resp.getSelectedButton() !== ui.Button.OK) return;

  const txt = resp.getResponseText().trim();
  const today = today_();
  let s = today, e = today;
  if (txt) {
    const parts = txt.split(/\s*[~∼～]\s*/);
    s = toDate_(parts[0]);
    e = parts[1] ? toDate_(parts[1]) : s;
    if (!s || !e) { ui.alert('날짜 형식을 확인하세요. 예) 2026-10-20'); return; }
  }

  const use = ss.getSheetByName(SH.USE);
  const h = headerMap_(use);
  vals.forEach(r => {
    appendByHeader_(use, h, {
      '처리일': today, '사번': String(r[4]), '구분': r[2],
      '대상': r[7], '시작': s, '종료': e, '비고': '대상자현황에서 처리',
    });
  });
  refreshStatus();
}


