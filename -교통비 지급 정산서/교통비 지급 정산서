// ═══════════════════════════════════════════
// ✅ 반영 점검 — 달력(+근무계획) 기준 "있어야 할 행" ↔ 정산서 실제 행 대조
// ═══════════════════════════════════════════

/** 정산서 데이터 행 읽기 (5행 ~ 합계 직전) */
function readSettlementRows_(sheet) {
  const sumRow = findSumRow(sheet);
  const n = sumRow - DATA_START_ROW;
  if (n <= 0) return [];
  const v = sheet.getRange(DATA_START_ROW, 1, n, DIST_COL).getDisplayValues();
  const out = [];
  v.forEach((r, i) => {
    const name = normName_(r[0]);
    if (!name) return;
    const m = String(r[1]).match(/(\d+)\s*월\s*(\d+)\s*일/);
    out.push({
      row: DATA_START_ROW + i,
      nameRaw: String(r[0]).trim(),
      name,
      month: m ? parseInt(m[1], 10) : null,
      day: m ? parseInt(m[2], 10) : null,
      route: String(r[2]).trim(),
      reasonRaw: String(r[4]).trim(),
      reason: normReason_(r[4]),
      km: Number(String(r[DIST_COL - 1]).replace(/[^\d.]/g, '')) || 0
    });
  });
  return out;
}

/**
 * 대조 + 달력 색칠
 * 반환: { text, counts }
 */
function checkCalendar_(month, data, cal) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const statusByCell = {};
  const add = (it, level, text) => {
    const k = it.row + '|' + it.col;
    (statusByCell[k] = statusByCell[k] || []).push({ level, text, it });
  };
  const counts = { ok: 0, warn: 0, miss: 0, pending: cal.pending.length };
  const extra = [];
  const autoMiss = [];

  cal.pending.forEach(p => add(p, 'pending', `🟨 ${p.reason || '(사유 없음)'} — 사유 미정이라 정산에서 뺌 (사유를 적으면 다음 정산 때 들어감)`));

  Object.keys(SHEET_CFG).forEach(key => {
    const cfg = SHEET_CFG[key];
    const specials = cal.items.filter(s => s.sheetKey === key);
    const sheet = ss.getSheetByName(cfg.sheetName);
    if (!sheet) {
      specials.forEach(s => { counts.miss++; add(s, 'miss', `🟥 ${s.reason} — "${cfg.sheetName}" 시트가 없음`); });
      return;
    }
    const expected = buildRows_(key, data, specials).rows;
    const actual = readSettlementRows_(sheet);
    const used = actual.map(() => false);
    const findRow = r => actual.findIndex((a, i) =>
      !used[i] && a.name === normName_(r.name) && a.month === month && a.day === r.day && a.reason === normReason_(r.reason));

    // ① 특이사항 먼저
    expected.filter(r => r.special).forEach(r => {
      const it = r.src;
      const i = findRow(r);
      if (i < 0) {
        counts.miss++;
        add(it, 'miss', `🟥 ${r.reason} — 정산서(${cfg.sheetName})에 없음 → 정산을 다시 실행하세요`);
        return;
      }
      used[i] = true;
      const a = actual[i];
      const diffs = [];
      if (normRoute_(a.route) !== normRoute_(r.route)) diffs.push(`구간 정산서 "${a.route}" / 달력 기준 "${r.route}"`);
      if (Number(a.km) !== Number(r.distance)) diffs.push(`거리 정산서 ${a.km}km / 달력 기준 ${r.distance}km`);
      const same = expected.filter(x => !x.special && x.name === r.name && x.day === r.day);
      if (diffs.length > 0) {
        counts.warn++;
        add(it, 'warn', `🟧 ${r.reason} — 정산서 ${a.row}행에 있으나 값이 다름: ${diffs.join(', ')}\n   → 정산서를 손으로 고쳤다면 다시 돌릴 때 사라집니다. 사유표나 달력 칸("(60km)", "@장소")에 적어 두세요`);
      } else {
        counts.ok++;
        add(it, 'ok', `✅ ${r.reason} — 반영됨 (${cfg.sheetName} ${a.row}행 / ${r.route} / ${r.distance}km)` +
          (same.length > 0 ? `\n   ℹ 같은 날 근무계획 근무("${same[0].reason}")도 따로 1건` : ''));
      }
    });

    // ② 근무계획 자동 행
    let miss = 0;
    expected.filter(r => !r.special).forEach(r => {
      const i = findRow(r);
      if (i < 0) miss++; else used[i] = true;
    });
    if (miss > 0) autoMiss.push(` - ${cfg.sheetName}: 근무계획 기준 자동 행 ${miss}건이 정산서에 없거나 업무내용이 다름 → 정산을 다시 실행하세요`);

    // ③ 어디에도 없는 정산서 행 (손으로 넣은 행)
    actual.forEach((a, i) => {
      if (used[i]) return;
      extra.push(` - ${cfg.sheetName} ${a.row}행: ${a.nameRaw} / ${a.month ? a.month + '월 ' : ''}${a.day || '?'}일 / ${a.reasonRaw}`);
    });
  });

  // 달력 색칠 + 메모
  const stamp = Utilities.formatDate(new Date(), 'Asia/Seoul', 'M/d HH:mm');
  const summary = `마지막 점검 ${stamp} · ✅ ${counts.ok}  🟧 ${counts.warn}  🟥 ${counts.miss}  🟨 ${counts.pending}`;
  paintCalendar_(cal, statusByCell, stamp, summary);

  // 결과 글
  const out = [`📅 ${month}월 특이사항 반영 점검 — ✅ 반영 ${counts.ok} / 🟧 확인 ${counts.warn} / 🟥 누락 ${counts.miss} / 🟨 사유 미정 ${counts.pending}`];
  const detail = [];
  Object.keys(statusByCell).forEach(k => statusByCell[k].forEach(s => {
    if (s.level !== 'ok') detail.push({ day: s.it.day, text: ` - ${s.it.name} ${month}/${s.it.day} ${s.text.split('\n')[0]}` });
  }));
  detail.sort((a, b) => a.day - b.day);
  if (detail.length > 0) {
    detail.slice(0, 15).forEach(d => out.push(d.text));
    if (detail.length > 15) out.push(`   … 외 ${detail.length - 15}건 (달력에서 색 칸에 마우스를 올려 확인)`);
  }
  if (autoMiss.length > 0) out.push('\n⚠ 근무계획 자동 행\n' + autoMiss.join('\n'));
  if (extra.length > 0) {
    out.push(`\n⚠ 달력·근무계획 어디에도 없는 정산서 행 ${extra.length}건 (손으로 넣은 행? 다시 정산하면 지워짐 → 달력에 적어 두세요)`);
    extra.slice(0, 10).forEach(x => out.push(x));
    if (extra.length > 10) out.push(`   … 외 ${extra.length - 10}건`);
  }
  if (cal.problems.length > 0) out.push('\n⚠ 달력에서 무시된 칸\n' + cal.problems.slice(0, 8).join('\n'));
  if (detail.length === 0 && autoMiss.length === 0 && extra.length === 0) out.push('✅ 달력의 특이사항이 모두 정산서에 그대로 들어가 있습니다');
  return { text: out.join('\n'), counts };
}

function paintCalendar_(cal, statusByCell, stamp, summary) {
  const sh = cal.sheet;
  const last = sh.getLastRow();
  if (last < CAL_FIRST_ROW) return;
  const n = last - CAL_FIRST_ROW + 1;
  const rng = sh.getRange(CAL_FIRST_ROW, CAL_DAY_COL, n, 31);
  const notes = rng.getNotes();
  const year = calYear_(cal.month), dim = daysInMonth_(cal.month);
  const ORDER = { ok: 0, pending: 1, warn: 2, miss: 3 };
  const bgs = [];
  for (let i = 0; i < n; i++) {
    const row = [];
    for (let j = 0; j < 31; j++) {
      const st = statusByCell[(CAL_FIRST_ROW + i) + '|' + (CAL_DAY_COL + j)];
      const mine = String(notes[i][j]).indexOf(CAL_NOTE_TAG) === 0;
      if (mine) notes[i][j] = '';
      if (st) {
        const worst = st.reduce((a, b) => (ORDER[b.level] > ORDER[a] ? b.level : a), 'ok');
        row.push(CAL_COLORS[worst]);
        if (!notes[i][j]) notes[i][j] = CAL_NOTE_TAG + ' ' + stamp + '\n' + st.map(x => x.text).join('\n');
      } else {
        row.push(calBaseBg_(year, cal.month, j + 1, dim));
      }
    }
    bgs.push(row);
  }
  rng.setBackgrounds(bgs);
  rng.setNotes(notes);
  sh.getRange(1, CAL_STATUS_COL).setValue(summary);
}

// ═══════════════════════════════════════════
// 실행 후 점검 — 합계행 아래 "개인별 현황" 표
// ═══════════════════════════════════════════
function readPersonTables_(sheet, sumRow) {
  const nRows = Math.min(20, Math.max(0, sheet.getLastRow() - sumRow));
  if (nRows < 1) return [];
  const vals = sheet.getRange(sumRow + 1, 1, nRows, 10).getValues();
  const tables = [];
  let cur = null;
  for (let i = 0; i < nRows; i++) {
    const row = vals[i];
    if (normName_(row[0]) === '성명') { cur = { headerRow: sumRow + 1 + i, items: [] }; tables.push(cur); continue; }
    if (!cur) continue;
    let any = false;
    for (let c = 0; c < 10; c += 2) {
      const nm = normName_(row[c]);
      if (!nm) continue;
      any = true;
      cur.items.push({ name: nm, value: Number(row[c + 1]) || 0 });
    }
    if (!any) cur = null;
  }
  return tables;
}

function checkPersonTables_(sheet, sumRow, rows) {
  const out = [];
  const name = sheet.getName();
  const tables = readPersonTables_(sheet, sumRow);
  if (tables.length === 0) return out;

  const total = Number(sheet.getRange(sumRow, SUM_COL).getValue()) || 0;
  const amountSum = tables[0].items.reduce((a, b) => a + b.value, 0);
  if (Math.round(amountSum) !== Math.round(total)) {
    out.push(` - ${name}: 개인별 현황 금액 합 ${fmt_(amountSum)} ≠ 합계 K${sumRow} ${fmt_(total)} → 개인별 현황 표의 이름·수식 확인`);
  }
  if (tables[1]) {
    const cntSum = tables[1].items.reduce((a, b) => a + b.value, 0);
    if (cntSum !== rows.length) {
      out.push(` - ${name}: 개인별 현황 건수 합 ${cntSum} ≠ 입력 ${rows.length}건 → 교통비 발생 내역 "근무인원"이 틀어짐`);
    }
  }
  const listed = new Set(tables[0].items.map(x => x.name));
  const missing = [];
  rows.forEach(r => { const k = normName_(r.name); if (!listed.has(k) && missing.indexOf(k) < 0) missing.push(k); });
  if (missing.length > 0) {
    out.push(` - ${name}: 개인별 현황 표에 없는 이름 ${missing.join(', ')} → 금액·인원 집계에서 빠짐 (표에 칸 추가 필요)`);
  }
  return out;
}

function fmt_(n) {
  return Math.round(Number(n) || 0).toLocaleString('ko-KR');
}

