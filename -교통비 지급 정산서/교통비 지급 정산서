// ───────────────────────────────────────────
// 근무 유형 표기 정규화
// "P/교" → "P", "야/교" → "야" ... / "교", "교육" 단독 → "" (제외)
// ───────────────────────────────────────────
function normalizeType(raw) {
  let s = String(raw === null || raw === undefined ? '' : raw).trim();
  if (!s) return '';
  s = s.replace(/[／\\,、·ㆍ|]/g, '/');
  s = s.replace(/\s+/g, '');
  const parts = s.split('/').filter(function (p) {
    return p !== '' && !/^교(육)?$/.test(p);
  });
  if (parts.length === 0) return '';
  let base = parts[0];
  if (/^[a-zA-Z]+$/.test(base)) base = base.toUpperCase();
  return base;
}

function normName_(s) {
  return String(s === null || s === undefined ? '' : s).replace(/\s+/g, '');
}
function normReason_(s) { return normName_(s); }
function normRoute_(s) { return normName_(s).replace(/<->|<>|↔|⇔|-/g, '↔'); }

// ───────────────────────────────────────────
// 월 숫자 가져오기 (근무현황표 Z3) — 실패 시 오류 발생
// ───────────────────────────────────────────
function getMonthNumber() {
  const ss = SpreadsheetApp.openById(ATTENDANCE_SS_ID);
  for (const s of ss.getSheets()) {
    if (!s.getName().includes('근무현황표')) continue;
    const val = s.getRange('Z3').getValue();
    let month = null;
    if (val instanceof Date) {
      month = val.getMonth() + 1;
    } else {
      const matched = String(val).match(/(\d+)/);
      if (matched) month = parseInt(matched[1], 10);
    }
    if (month >= 1 && month <= 12) return month;
  }
  throw new Error('근무현황표 스프레드시트의 "근무현황표" 시트 Z3에서 월을 읽지 못했습니다. Z3 셀을 확인해주세요.');
}

/** A열 값이 "계"(합계/소계 포함)인지 */
function isEndMark_(v) {
  return /^(합|소)?계$/.test(String(v === null || v === undefined ? '' : v).replace(/\s+/g, ''));
}

/**
 * 근무계획 → 해당 월 시트 파싱 + 직급 순위 매핑
 * 반환: { records: [...], rankMap: { "김일수": 0, ... }, endRow, endMarkFound }
 */
function parseMonthlyWorkData(month) {
  const ss = SpreadsheetApp.openById(WORK_PLAN_SS_ID);
  const monthName = `${month}월`;
  const monthSheet = ss.getSheetByName(monthName);
  if (!monthSheet) {
    throw new Error(`근무계획 스프레드시트에서 "${monthName}" 시트를 찾을 수 없습니다.`);
  }

  const lastRow = monthSheet.getLastRow();
  if (lastRow < WP_NAME_START_ROW) {
    throw new Error(`"${monthName}" 시트 ${WP_NAME_START_ROW}행 이후에 데이터가 없습니다.`);
  }

  const markCol = monthSheet.getRange(WP_NAME_START_ROW, WP_END_MARK_COL, lastRow - WP_NAME_START_ROW + 1, 1).getValues();
  let numRows = markCol.length;
  let endMarkFound = false;
  for (let i = 0; i < markCol.length; i++) {
    if (isEndMark_(markCol[i][0])) { numRows = i; endMarkFound = true; break; }
  }
  if (numRows === 0) {
    throw new Error(`"${monthName}" 시트 ${WP_NAME_START_ROW}행 A열이 이미 "계"라 읽을 이름이 없습니다.`);
  }

  const dayRow = monthSheet.getRange(WP_HEADER_ROW, WP_DAY_START_COL, 1, WP_DAY_COUNT).getValues()[0];
  const nameCol = monthSheet.getRange(WP_NAME_START_ROW, WP_NAME_COL, numRows, 1).getValues();
  const workGrid = monthSheet.getRange(WP_NAME_START_ROW, WP_DAY_START_COL, numRows, WP_DAY_COUNT).getValues();

  const records = [];
  const rankMap = {};

  for (let r = 0; r < nameCol.length; r++) {
    const name = String(nameCol[r][0]).trim();
    if (!name) continue;
    if (!(name in rankMap)) rankMap[name] = r;

    for (let c = 0; c < dayRow.length; c++) {
      const dayVal = dayRow[c];
      if (!dayVal && dayVal !== 0) continue;
      const day = parseInt(dayVal, 10);
      if (isNaN(day)) continue;

      const rawType = String(workGrid[r][c]).trim();
      if (!rawType) continue;
      const type = normalizeType(rawType);
      if (!type) continue;

      records.push({ name, day, type, rawType, monthName });
    }
  }
  return { records, rankMap, endRow: WP_NAME_START_ROW + numRows - 1, endMarkFound };
}

/**
 * 제품생산 계획 → 해당 월 시트 파싱
 * 반환: { [day]: { C, D, E, F, G, H, I, J, K, L } }
 */
function parsePlanData(month) {
  const ss = SpreadsheetApp.openById(PROD_PLAN_SS_ID);
  const prefix = `${month}월`;

  let planSheet = null;
  for (const s of ss.getSheets()) {
    if (s.getName().startsWith(prefix) && s.getName().includes('제품생산 계획')) {
      planSheet = s;
      break;
    }
  }
  if (!planSheet) {
    throw new Error(`제품생산 계획 스프레드시트에서 "${prefix} 제품생산 계획..." 시트를 찾을 수 없습니다.`);
  }

  const dayCol = planSheet.getRange('A3:A33').getValues();
  const dataGrid = planSheet.getRange('C3:L33').getValues();

  const plan = {};
  for (let r = 0; r < dayCol.length; r++) {
    const day = parseInt(dayCol[r][0], 10);
    if (isNaN(day)) continue;
    plan[day] = {
      C: dataGrid[r][0], D: dataGrid[r][1], E: dataGrid[r][2], F: dataGrid[r][3],
      G: dataGrid[r][4], H: dataGrid[r][5], I: dataGrid[r][6], J: dataGrid[r][7],
      K: dataGrid[r][8], L: dataGrid[r][9]
    };
  }
  return plan;
}

/** 숫자 수치가 입력된 경우만 true */
function hasValue(v) {
  if (v === null || v === undefined) return false;
  const s = String(v).trim();
  if (s === '' || s === '-') return false;
  const num = Number(s.replace(/,/g, ''));
  return !isNaN(num) && num !== 0;
}

// ───────────────────────────────────────────
// "합 계" 행 찾기 ★ 시트 끝까지 검색, 못 찾으면 오류 (추측 금지)
// ───────────────────────────────────────────
function findSumRow(targetSheet) {
  const last = targetSheet.getLastRow();
  if (last >= DATA_START_ROW) {
    const vals = targetSheet.getRange(DATA_START_ROW, 1, last - DATA_START_ROW + 1, SUM_COL).getValues();
    for (let i = 0; i < vals.length; i++) {
      for (let c = 0; c < vals[i].length; c++) {
        if (String(vals[i][c]).replace(/\s+/g, '') === '합계') return DATA_START_ROW + i;
      }
    }
  }
  throw new Error(`"${targetSheet.getName()}" 시트에서 "합 계" 행을 찾지 못했습니다. 합계 행의 A열에 "합 계" 글자가 있는지 확인해주세요.`);
}

/**
 * 합계 행 바로 위에 count개 행 추가 (TEMPLATE_ROW의 서식·병합·수식 복사)
 * 반환: 새 합계 행 번호
 */
function insertDataRows_(sheet, sumRow, count) {
  if (sumRow <= TEMPLATE_ROW) {
    throw new Error(`"${sheet.getName()}" 시트의 합계 행(${sumRow}행)이 너무 위에 있어 행을 추가할 수 없습니다.`);
  }
  sheet.insertRowsAfter(sumRow - 1, count);
  const lastCol = sheet.getMaxColumns();
  sheet.getRange(TEMPLATE_ROW, 1, 1, lastCol).copyTo(sheet.getRange(sumRow, 1, count, lastCol));
  sheet.getRange(sumRow, 1, count, 6).clearContent(); // 복사된 A~F 데이터는 지움
  sheet.setRowHeights(sumRow, count, sheet.getRowHeight(TEMPLATE_ROW));
  sheet.showRows(sumRow, count);
  return sumRow + count;
}

// ───────────────────────────────────────────
// 사유 생성 함수들 (BTL, 제품생산, CIP)
// ───────────────────────────────────────────
function getBTLReason(dayPlan) {
  if (!dayPlan) return 'BTL/CAP 생산';
  const btlPart = [];
  if (hasValue(dayPlan.I)) btlPart.push('1.5L BTL');
  if (hasValue(dayPlan.J)) btlPart.push('0.5L BTL');
  if (hasValue(dayPlan.K)) btlPart.push('0.33L BTL');
  const parts = [];
  if (btlPart.length > 0) parts.push(btlPart.join('/'));
  if (hasValue(dayPlan.L)) parts.push('CAP');
  return parts.length > 0 ? parts.join('/') + ' 생산' : 'BTL/CAP 생산';
}

function getSejeumReason(type, dayPlan) {
  if (type === 'L') return '정비 연장';
  if (!dayPlan) return type === 'B' ? 'BTL 생산' : '제품 생산';

  if (type === 'B') {
    const parts = [];
    if (hasValue(dayPlan.I)) parts.push('1.5L BTL');
    if (hasValue(dayPlan.J)) parts.push('0.5L BTL');
    if (hasValue(dayPlan.K)) parts.push('0.33L BTL');
    return parts.length > 0 ? parts.join('/') + ' 생산' : 'BTL 생산';
  }

  if (type === 'P') {
    if (hasValue(dayPlan.D)) return '1.5L 제품 생산';
    if (hasValue(dayPlan.E)) return '0.5L 제품 생산';
    if (hasValue(dayPlan.F)) return '0.33L 제품 생산';
    if (hasValue(dayPlan.G)) return '0.12L 제품 생산';
    return '제품 생산';
  }
  return '연장 근무';
}

function getCIPReasons(dayPlan, group) {
  if (!group || group.length === 0) return [];
  if (!dayPlan) return Array(group.length).fill('CIP');

  const morning = group.filter(r => r.type === '조');
  const evening = group.filter(r => r.type === '연');
  const reasons = [];

  if (morning.length > 0) {
    if (hasValue(dayPlan.H)) {
      reasons.push('0.19L 생산라인 CIP');
    } else {
      reasons.push(getNextCIP(dayPlan, 'morning'));
    }
    for (let i = 1; i < morning.length; i++) reasons.push(getNextCIP(dayPlan, 'morning'));
  }
  for (let i = 0; i < evening.length; i++) reasons.push(getNextCIP(dayPlan, 'evening'));
  return reasons;
}

function getNextCIP(dayPlan, shiftType) {
  const priorities = shiftType === 'morning'
    ? ['C', 'D', 'E', 'F', 'G']
    : ['D', 'E', 'F', 'C', 'G'];
  for (const col of priorities) {
    if (hasValue(dayPlan[col])) return getCIPReasonName(col);
  }
  return 'CIP';
}

function getCIPReasonName(col) {
  const map = {
    'C': '18.9L 생산라인 CIP',
    'D': '1.5L 생산라인 CIP',
    'E': '0.5L 생산라인 CIP',
    'F': '0.33L 생산라인 CIP',
    'G': '0.12L 생산라인 CIP',
    'H': '0.19L 생산라인 CIP'
  };
  return map[col] || 'CIP';
}

// ───────────────────────────────────────────
// 구간·주행거리 결정 (달력·사유표 > 사람별 > 시트 기본)
// 특이사항 행의 routeSet/kmSet 은 readCalendar_ 에서 달력 칸 > 사유표 순으로 이미 정해 둔 값
// ───────────────────────────────────────────
function resolveTrip_(key, row) {
  let route = ROUTE_TEXT;
  let distance = SHEET_CFG[key].distance;

  const p = PERSON_ROUTE[normName_(row.name)];
  if (p) {
    if (p.route) route = p.route;
    const d = (p.distance !== null && typeof p.distance === 'object') ? p.distance[key] : p.distance;
    if (typeof d === 'number' && d > 0) distance = d;
  }
  if (row.routeSet) route = row.routeSet;
  if (typeof row.kmSet === 'number' && row.kmSet > 0) distance = row.kmSet;
  return { route, distance };
}

// ───────────────────────────────────────────
// 공통 시트 쓰기
// 반환: { count, sumRow, addedRows }
// ───────────────────────────────────────────
function writeToSheet(targetSheet, rows, monthName) {
  let sumRow = findSumRow(targetSheet);
  if (sumRow <= DATA_START_ROW) {
    throw new Error(`"${targetSheet.getName()}" 시트의 합계 행 위치(${sumRow}행)가 올바르지 않습니다.`);
  }

  // 1) 숨겨진 데이터 행 모두 펼치기
  targetSheet.showRows(DATA_START_ROW, sumRow - DATA_START_ROW);

  // 2) 행이 모자라면 자동 확장
  let addedRows = 0;
  if (rows.length > sumRow - DATA_START_ROW) {
    addedRows = rows.length - (sumRow - DATA_START_ROW);
    sumRow = insertDataRows_(targetSheet, sumRow, addedRows);
  }
  const capacity = sumRow - DATA_START_ROW;

  // 3) 5행 ~ 합계 바로 윗행까지 A~F 전부 비우기
  targetSheet.getRange(DATA_START_ROW, 1, capacity, 6).clearContent();
  targetSheet.getRange(DATA_START_ROW, 2, capacity, 1).setNumberFormat(DATE_FORMAT);

  const n = rows.length;
  const sumCell = targetSheet.getRange(sumRow, SUM_COL);

  if (n === 0) {
    sumCell.setValue(0);
    targetSheet.hideRows(DATA_START_ROW, capacity);
    return { count: 0, sumRow: sumRow, addedRows: addedRows };
  }

  // 4) 열 단위 일괄 쓰기 (C:D, E:F 병합 셀 고려해 열별로 기록)
  targetSheet.getRange(DATA_START_ROW, 1, n, 1).setValues(rows.map(r => [r.name]));
  targetSheet.getRange(DATA_START_ROW, 2, n, 1).setValues(rows.map(r => [`${monthName} ${r.day}일`])); // ★ 띄어쓰기
  targetSheet.getRange(DATA_START_ROW, 3, n, 1).setValues(rows.map(r => [r.route || ROUTE_TEXT]));
  targetSheet.getRange(DATA_START_ROW, 5, n, 1).setValues(rows.map(r => [r.reason]));
  targetSheet.getRange(DATA_START_ROW, DIST_COL, n, 1).setValues(rows.map(r => [r.distance]));

  // 5) 합계 수식 (빈 행의 #N/A를 피하려고 마지막 데이터 행까지만 합산)
  const lastDataRow = DATA_START_ROW + n - 1;
  sumCell.setFormula(`=SUM($K$${DATA_START_ROW}:$K$${lastDataRow})`);

  // 6) 데이터 없는 행 숨기기
  if (capacity > n) targetSheet.hideRows(DATA_START_ROW + n, capacity - n);

  return { count: n, sumRow: sumRow, addedRows: addedRows };
}

// ───────────────────────────────────────────
// 공통 데이터 로딩
// ───────────────────────────────────────────
function loadData() {
  const month = getMonthNumber();
  const parsed = parseMonthlyWorkData(month);
  const plan = parsePlanData(month);
  return { month, records: parsed.records, rankMap: parsed.rankMap, plan, endMarkFound: parsed.endMarkFound, endRow: parsed.endRow };
}

function rankOf_(rankMap, name) {
  return (name in rankMap) ? rankMap[name] : 999;
}

// ───────────────────────────────────────────
// 자동 입력 행 생성 (근무계획 기반)
// kind: CIP는 조=0, 연=1 / 나머지는 0 (특이사항은 2)
// ───────────────────────────────────────────
function buildAutoRows_(key, data) {
  const records = data.records, plan = data.plan, rankMap = data.rankMap;
  const byDayRank = (a, b) => {
    if (a.day !== b.day) return a.day - b.day;
    return rankOf_(rankMap, a.name) - rankOf_(rankMap, b.name);
  };

  if (key === 'BTL') {
    return records.filter(r => r.type === '야').sort(byDayRank)
      .map(r => ({ name: r.name, day: r.day, reason: getBTLReason(plan[r.day]), kind: 0, special: false, type: r.type }));
  }

  if (key === 'SEJEUM') {
    return records.filter(r => ['B', 'P', 'L'].includes(r.type)).sort(byDayRank)
      .map(r => ({ name: r.name, day: r.day, reason: getSejeumReason(r.type, plan[r.day]), kind: 0, special: false, type: r.type }));
  }

  // CIP
  const filtered = records
    .filter(r => r.type === '조' || r.type === '연')
    .sort((a, b) => {
      if (a.day !== b.day) return a.day - b.day;
      if (a.type !== b.type) return a.type === '조' ? -1 : 1;
      return rankOf_(rankMap, a.name) - rankOf_(rankMap, b.name);
    });

  const dayGroups = {};
  for (const r of filtered) {
    if (!dayGroups[r.day]) dayGroups[r.day] = [];
    dayGroups[r.day].push(r);
  }

  const rows = [];
  for (const day of Object.keys(dayGroups).map(Number).sort((a, b) => a - b)) {
    const group = dayGroups[day];
    const reasons = getCIPReasons(plan[day], group);
    group.forEach((r, i) => {
      rows.push({ name: r.name, day: r.day, reason: reasons[i], kind: r.type === '조' ? 0 : 1, special: false, type: r.type });
    });
  }
  return rows;
}

// ───────────────────────────────────────────
// 자동 입력 + 특이사항 병합 정렬
// • BTL/제품생산: 날짜 → 직급 → (자동 먼저)
// • 품질 CIP : 날짜 → 조 → 연 → 특이사항 → 직급
// ───────────────────────────────────────────
function mergeAndSort_(key, autoRows, specials, rankMap) {
  const all = autoRows.concat(specials.map(s => ({
    name: s.name, day: s.day, reason: s.reason, kmSet: s.km, routeSet: s.route,
    kind: 2, special: true, src: s
  })));
  const kindFirst = (key === 'CIP');
  all.sort((a, b) => {
    if (a.day !== b.day) return a.day - b.day;
    if (kindFirst && a.kind !== b.kind) return a.kind - b.kind;
    const ra = rankOf_(rankMap, a.name), rb = rankOf_(rankMap, b.name);
    if (ra !== rb) return ra - rb;
    return a.kind - b.kind;
  });
  return all;
}

/** 한 시트에 들어갈 최종 행 (자동 + 특이사항, 구간·거리 결정까지) */
function buildRows_(key, data, specials) {
  const autoRows = buildAutoRows_(key, data);
  const rows = mergeAndSort_(key, autoRows, specials, data.rankMap);
  rows.forEach(r => {
    const t = resolveTrip_(key, r);
    r.route = t.route;
    r.distance = t.distance;
  });
  return { rows, autoCount: autoRows.length };
}

// ───────────────────────────────────────────
// 정산 실행 본체 — mode: 'ALL' | 'BTL' | 'SEJEUM' | 'CIP'
// 반환: 결과 요약 문자열
// ───────────────────────────────────────────
function runFill_(mode, expectedMonth, cal) {
  const data = loadData();
  if (expectedMonth && data.month !== expectedMonth) {
    throw new Error(`기준 월이 ${expectedMonth}월 → ${data.month}월로 바뀌었습니다. 다시 실행해주세요.`);
  }
  if (!cal) cal = readCalendar_(data.month, true);

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const monthName = `${data.month}월`;
  const keys = mode === 'ALL' ? RUN_SHEET_ORDER : [mode];

  const lines = [];
  const checks = [];
  const tripNotes = [];
  const written = []; // { key, sheet, sumRow, rows }

  if (!data.endMarkFound) {
    checks.push(` - 근무계획 "${monthName}" 시트 A열에서 "계" 행을 못 찾아 시트 끝(${data.endRow}행)까지 읽음 → 메뉴 [근무계획 이름 확인]으로 확인`);
  }

  for (const key of keys) {
    const cfg = SHEET_CFG[key];
    const sheet = ss.getSheetByName(cfg.sheetName);
    if (!sheet) {
      if (mode === 'ALL') { lines.push(`• ${cfg.sheetName}: 시트 없음 (건너뜀)`); continue; }
      throw new Error(`"${cfg.sheetName}" 시트를 찾을 수 없습니다.`);
    }

    const specials = cal.items.filter(s => s.sheetKey === key);
    const built = buildRows_(key, data, specials);
    const rows = built.rows;

    rows.forEach(r => {
      if (r.special && (r.route !== ROUTE_TEXT || r.distance !== cfg.distance)) {
        tripNotes.push(` - ${cfg.sheetName} / ${r.name} / ${monthName} ${r.day}일 (${r.reason}) → ${r.route}, ${r.distance}km`);
      }
    });

    const res = writeToSheet(sheet, rows, monthName);
    written.push({ key, sheet, sumRow: res.sumRow, rows });

    let line = `• ${cfg.sheetName}: 총 ${res.count}건 (자동 ${built.autoCount} + 특이사항 ${specials.length}) / 합계 ${res.sumRow}행`;
    if (res.addedRows > 0) line += ` ← 행 부족으로 ${res.addedRows}행 자동 추가`;
    lines.push(line);
  }

  SpreadsheetApp.flush();

  // 실행 후 점검 ①: 개인별 현황 = 합계 ?
  written.forEach(w => checkPersonTables_(w.sheet, w.sumRow, w.rows).forEach(m => checks.push(m)));

  let msg = `${monthName} 교통비 정산 완료\n\n` + lines.join('\n');
  msg += '\n\n' + fuelStatusLine_(data.month);
  if (tripNotes.length > 0) {
    const shown = tripNotes.slice(0, 12);
    msg += '\n\nℹ 기본과 다른 구간·거리로 넣은 특이사항\n' + shown.join('\n') +
      (tripNotes.length > shown.length ? `\n   … 외 ${tripNotes.length - shown.length}건` : '');
  }
  msg += checks.length > 0
    ? '\n\n⚠ 자동 점검에서 확인할 것\n' + checks.join('\n')
    : '\n\n✅ 자동 점검: 개인별 현황 금액·건수가 합계와 일치';

  // 실행 후 점검 ②: 달력 ↔ 정산서 대조 + 달력 색칠
  const chk = checkCalendar_(data.month, data, cal);
  msg += '\n\n' + chk.text;
  return msg;
}

// ═══════════════════════════════════════════
// 📅 특이사항 달력
// ═══════════════════════════════════════════

function calSheetName_(month) { return month + CAL_SHEET_SUFFIX; }

/** 달력의 연도: 지금 날짜 기준 (12월분을 1월에 정산 / 1월 달력을 12월에 미리 만드는 경우 처리) */
function calYear_(month) {
  const now = new Date();
  let y = now.getFullYear();
  const cur = now.getMonth() + 1;
  if (month - cur > 6) y -= 1;
  else if (cur - month > 6) y += 1;
  return y;
}

function daysInMonth_(month) {
  return new Date(calYear_(month), month, 0).getDate();
}

function calBaseBg_(year, month, day, dim) {
  if (day > dim) return CAL_COLORS.off;
  const w = new Date(year, month - 1, day).getDay();
  return (w === 0 || w === 6) ? CAL_COLORS.weekend : CAL_COLORS.none;
}

function sheetNameToKey_() {
  const m = {};
  Object.keys(SHEET_CFG).forEach(k => { m[normName_(SHEET_CFG[k].sheetName)] = k; m[k] = k; });
  return m;
}

/** 특이사항의 시트 → 달력에서 들어갈 구역 */
function calSectionFor_(sheetKey) {
  if (CAL_SECTIONS.indexOf(sheetKey) >= 0) return sheetKey;
  if (sheetKey === 'BTL' && CAL_SECTIONS.indexOf('SEJEUM') >= 0) return 'SEJEUM';
  return null;
}

function colA1_(col) {
  let s = '';
  while (col > 0) { const m = (col - 1) % 26; s = String.fromCharCode(65 + m) + s; col = Math.floor((col - 1) / 26); }
  return s;
}

/** 칸 하나 → 여러 건 (줄바꿈 또는 " + ") */
function splitCalLines_(raw) {
  return String(raw === null || raw === undefined ? '' : raw)
    .split(/\r?\n|\s\+\s/)
    .map(s => s.trim())
    .filter(Boolean);
}

/**
 * 한 건 해석
 *  "자재 구매 (30km)"          → 거리 30
 *  "민속촌 채수 @제주민속촌"    → 구간 "공장 ↔ 제주민속촌"
 *  "BTL: 사유"                 → BTL 생산 시트 (제품생산 구역에 적을 때)
 *  "?" / "농업용수 CIP?"        → 사유 미정 (정산에서 뺌)
 */
function parseCalLine_(line, secKey) {
  let s = String(line).trim();
  let sheetKey = secKey;

  const mb = s.match(/^\[?\s*BTL\s*\]?\s*[:：]\s*/i);
  if (mb) { sheetKey = 'BTL'; s = s.slice(mb[0].length); }

  let km = '';
  const mk = s.match(/[(（]?\s*(\d+(?:\.\d+)?)\s*km\s*[)）]?/i);
  if (mk) {
    km = Number(mk[1]);
    s = (s.slice(0, mk.index) + ' ' + s.slice(mk.index + mk[0].length)).trim();
  }

  let route = '';
  const mr = s.match(/[@＠]\s*(.+)$/);
  if (mr) {
    const place = mr[1].trim();
    if (place) route = place.indexOf('↔') >= 0 ? place : '공장 ↔ ' + place;
    s = s.slice(0, mr.index).trim();
  }

  let pending = false;
  if (/[?？]\s*$/.test(s)) { pending = true; s = s.replace(/[?？]+\s*$/, '').trim(); }
  s = s.replace(/\s+/g, ' ');
  if (!s) pending = true;

  return { sheetKey, reason: s, km, route, pending };
}

/**
 * 달력 읽기
 * 반환: { sheet, month, dim, items: [...], pending: [...], problems: [...], created, imported }
 *   item: { sheetKey, name, day, reason, km, route, inCatalog, row, col, raw }
 */
function readCalendar_(month, createIfMissing) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(calSheetName_(month));
  let created = false, imported = 0;
  if (!sh) {
    if (!createIfMissing) {
      return { sheet: null, month, dim: daysInMonth_(month), items: [], pending: [], problems: [], created: false, imported: 0 };
    }
    const r = createCalendar_(month);
    sh = r.sheet; created = true; imported = r.imported;
  }

  const catalog = readCatalog_();
  const dim = daysInMonth_(month);
  const out = { sheet: sh, month, dim, items: [], pending: [], problems: [], created, imported };
  const lastRow = sh.getLastRow();
  if (lastRow < CAL_FIRST_ROW) return out;

  const vals = sh.getRange(CAL_FIRST_ROW, 1, lastRow - CAL_FIRST_ROW + 1, CAL_DAY_COL + 30).getDisplayValues();
  const keyByName = sheetNameToKey_();
  const probSeen = {};
  const problem = (k, text) => { if (!probSeen[k]) { probSeen[k] = true; out.problems.push(text); } };
  let curSec = '', curName = '';

  vals.forEach((r, i) => {
    const rowNo = CAL_FIRST_ROW + i;
    const secRaw = String(r[CAL_SEC_COL - 1]).trim();
    if (secRaw) { curSec = secRaw; curName = ''; }
    const nameRaw = String(r[CAL_NAME_COL - 1]).trim();
    if (nameRaw) curName = nameRaw;   // 이름 칸은 사람마다 ${CAL_SLOTS}줄 병합 → 아래 줄은 위 이름을 이어 씀
    const name = curName;

    for (let d = 1; d <= 31; d++) {
      const raw = String(r[CAL_DAY_COL + d - 2]).trim();
      if (!raw) continue;
      const col = CAL_DAY_COL + d - 1;
      const cell = colA1_(col) + rowNo;
      if (!name) { problem('noname' + rowNo, ` - ${rowNo}행: 이름(B열)이 비어 있어 이 줄은 무시`); continue; }
      if (d > dim) { problem(cell, ` - ${cell} ${name}: ${month}월에는 ${d}일이 없어 무시`); continue; }
      const secKey = keyByName[normName_(curSec)];
      if (!secKey) { problem('sec' + rowNo, ` - ${rowNo}행 ${name}: 구분 "${curSec}"을(를) 몰라 무시 (품질 CIP / 제품생산)`); continue; }

      splitCalLines_(raw).forEach(line => {
        const p = parseCalLine_(line, secKey);
        const base = { sheetKey: p.sheetKey, name, day: d, row: rowNo, col, raw: line, reason: p.reason };
        if (p.pending) { out.pending.push(base); return; }
        const cat = catalog.map[catKey_(p.sheetKey, p.reason)];
        out.items.push(Object.assign(base, {
          km: p.km !== '' ? p.km : (cat && cat.km !== '' ? cat.km : ''),
          route: p.route || (cat && cat.route) || '',
          inCatalog: !!cat
        }));
      });
    }
  });
  return out;
}

/** 정산 전 확인창에 보여줄 요약 */
function calendarPreview_(cal, mode) {
  const m = cal.month;
  const out = [];
  if (cal.created) {
    out.push(`📅 "${calSheetName_(m)}" 시트가 없어 새로 만들었습니다.` +
      (cal.imported ? ` (예전 입력창 기록 ${cal.imported}건을 옮김)` : ''));
  }
  const cnt = {};
  cal.items.forEach(s => { cnt[s.sheetKey] = (cnt[s.sheetKey] || 0) + 1; });
  const parts = Object.keys(SHEET_CFG).filter(k => cnt[k]).map(k => `${SHEET_CFG[k].sheetName} ${cnt[k]}건`);
  out.push(`📅 ${m}월 특이사항 달력 → 정산에 넣을 것 ${cal.items.length}건` + (parts.length ? ` (${parts.join(' / ')})` : ''));

  if (mode !== 'ALL') {
    const other = cal.items.filter(s => s.sheetKey !== mode).length;
    if (other > 0) out.push(`ℹ 이번 실행은 ${SHEET_CFG[mode].sheetName} 시트만 — 다른 시트 특이사항 ${other}건은 이번엔 쓰지 않음`);
  }
  if (cal.pending.length > 0) {
    out.push(`\n🟨 사유 미정(?) ${cal.pending.length}건 — 정산에서 빠집니다`);
    cal.pending.slice(0, 10).forEach(p => out.push(` - ${p.name} ${m}/${p.day} ${p.reason || '(사유 없음)'}`));
    if (cal.pending.length > 10) out.push(`   … 외 ${cal.pending.length - 10}건`);
  }
  const unknown = {};
  cal.items.filter(s => !s.inCatalog && s.km === '' && !s.route).forEach(s => {
    const k = SHEET_CFG[s.sheetKey].sheetName + ' · ' + s.reason;
    unknown[k] = (unknown[k] || 0) + 1;
  });
  const uk = Object.keys(unknown);
  if (uk.length > 0) {
    out.push('\nℹ 사유표에 없는 사유 → 기본 구간·거리로 계산 (필요하면 사유표에 추가)');
    uk.slice(0, 8).forEach(k => out.push(` - ${k} (${unknown[k]}건)`));
    if (uk.length > 8) out.push(`   … 외 ${uk.length - 8}가지`);
  }
  if (cal.problems.length > 0) {
    out.push('\n⚠ 무시된 칸');
    cal.problems.slice(0, 8).forEach(p => out.push(p));
  }
  return out.join('\n');
}

/** 숨김 '특이사항' 시트(옛 입력창) 기록 읽기 — month 생략 시 전체 */
function readHiddenSpecials_(month) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SPECIAL_SHEET_NAME);
  if (!sh || sh.getLastRow() < 2) return [];
  const keyByName = sheetNameToKey_();
  const limit = Date.now() - SPECIAL_EXPIRE_DAYS * 24 * 60 * 60 * 1000;
  return sh.getRange(2, 1, sh.getLastRow() - 1, 7).getValues()
    .map(r => ({
      month: parseInt(r[0], 10),
      sheetKey: keyByName[normName_(r[1])],
      day: parseInt(r[2], 10),
      name: String(r[3]).trim(),
      reason: String(r[4]).trim().replace(/\s+/g, ' '),
      at: r[5],
      km: parseKm_(r[6])
    }))
    .filter(e => e.sheetKey && e.name && e.reason && e.day >= 1 && e.day <= 31 && !isNaN(e.month))
    .filter(e => month === undefined ||
      (e.month === month && !(e.at instanceof Date && e.at.getTime() < limit)));
}

/** 주행거리 입력값 → 양수면 숫자, 아니면 '' */
function parseKm_(v) {
  const n = Number(String(v === null || v === undefined ? '' : v).replace(/[^\d.]/g, ''));
  return (n > 0) ? n : '';
}

/** 옛 기록 한 건 → 달력 칸 글자 */
function calLineText_(e, secKey, catalog) {
  const prefix = (e.sheetKey !== secKey) ? e.sheetKey + ': ' : '';
  const cat = catalog.map[catKey_(e.sheetKey, e.reason)];
  const expectKm = (cat && cat.km !== '') ? cat.km : SHEET_CFG[e.sheetKey].distance;
  const kmTxt = (e.km !== '' && Number(e.km) !== Number(expectKm)) ? ` (${e.km}km)` : '';
  return prefix + e.reason + kmTxt;
}

/**
 * 달력 시트 새로 만들기
 *  preset 없으면: 코드 이름 목록 + 숨김 '특이사항' 시트(옛 입력창)의 그 달 기록을 옮김
 *  preset 있으면: { sections: [{key, names}], cells: {"키|이름|일": [줄...]}, imported } 그대로 씀 (옛 양식 달력 변환용)
 */
function createCalendar_(month, preset) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const name = calSheetName_(month);
  if (ss.getSheetByName(name)) throw new Error(`"${name}" 시트가 이미 있습니다.`);

  const catalog = readCatalog_(); // 사유표도 없으면 함께 만듦
  const year = calYear_(month);
  const dim = daysInMonth_(month);

  let sections, cells, imported = 0;
  if (preset) {
    sections = preset.sections; cells = preset.cells; imported = preset.imported || 0;
  } else {
    // 구역별 이름 (코드 목록 + 옛 기록에만 있는 이름)
    sections = CAL_SECTIONS.map(key => ({ key, names: SHEET_CFG[key].names.slice() }));
    cells = {};
    readHiddenSpecials_(month).forEach(e => {
      const secKey = calSectionFor_(e.sheetKey);
      const sec = sections.find(s => s.key === secKey);
      if (!sec) return;
      if (sec.names.indexOf(e.name) < 0) sec.names.push(e.name);
    const k = secKey + '|' + e.name + '|' + e.day;
    (cells[k] = cells[k] || []).push(calLineText_(e, secKey, catalog));
    imported++;
    });
  }

  // 시트 생성 — '품질 CIP' 바로 뒤
  const anchor = ss.getSheetByName(SHEET_CFG.CIP.sheetName);
  const sh = ss.insertSheet(name, anchor ? anchor.getIndex() : ss.getNumSheets());
  try {
    layoutCalendar_(sh, { month, year, dim, sections, cells, catalog });
  } catch (e) {
    try { ss.deleteSheet(sh); } catch (e2) {} // 만들다 실패하면 반쯤 만든 시트를 지움 (다음에 깨끗하게 다시 만들도록)
    throw e;
  }
  return { sheet: sh, imported };
}

/** 사람마다 한 줄뿐인 옛 양식 달력인지 (이름 칸이 병합돼 있지 않음) */
function isOldCalLayout_(sh) {
  if (CAL_SLOTS <= 1 || sh.getLastRow() < CAL_FIRST_ROW) return false;
  return !sh.getRange(CAL_FIRST_ROW, CAL_NAME_COL).isPartOfMerge();
}

/** 옛 양식 달력 → 하루 여러 칸 양식으로 다시 만들기 (적어 둔 내용은 그대로 옮김) */
function convertCalendar_(sh, month) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const keyByName = sheetNameToKey_();
  const last = sh.getLastRow();
  const vals = sh.getRange(CAL_FIRST_ROW, 1, last - CAL_FIRST_ROW + 1, CAL_DAY_COL + 30).getDisplayValues();

  const sections = [];
  const cells = {};
  let moved = 0, curSec = null, curName = '';
  vals.forEach(r => {
    const secRaw = String(r[CAL_SEC_COL - 1]).trim();
    if (secRaw) {
      const key = keyByName[normName_(secRaw)];
      curSec = key ? (sections.find(x => x.key === key) || (sections.push({ key, names: [] }), sections[sections.length - 1])) : null;
      curName = '';
    }
    const nameRaw = String(r[CAL_NAME_COL - 1]).trim();
    if (nameRaw) curName = nameRaw;
    if (!curSec || !curName) return;
    if (curSec.names.indexOf(curName) < 0) curSec.names.push(curName);
    for (let d = 1; d <= 31; d++) {
      const lines = splitCalLines_(r[CAL_DAY_COL + d - 2]);
      if (lines.length === 0) continue;
      const k = curSec.key + '|' + curName + '|' + d;
      cells[k] = (cells[k] || []).concat(lines);
      moved += lines.length;
    }
  });
  // 코드 목록에 있는데 옛 달력에 없던 사람도 넣음
  CAL_SECTIONS.forEach(key => {
    let sec = sections.find(x => x.key === key);
    if (!sec) { sec = { key, names: [] }; sections.push(sec); }
    SHEET_CFG[key].names.forEach(n => { if (sec.names.indexOf(n) < 0) sec.names.push(n); });
  });

  const name = sh.getName();
  const backupName = name + ' (옛 양식)';
  const old = ss.getSheetByName(backupName);
  if (old) ss.deleteSheet(old);
  sh.setName(backupName);
  let created;
  try {
    created = createCalendar_(month, { sections, cells, imported: moved });
  } catch (e) {
    sh.setName(name); // 실패하면 원래대로
    throw e;
  }
  ss.deleteSheet(sh);
  return { sheet: created.sheet, moved };
}

/** 달력 시트 꾸미기 (제목·안내·머리글·본문·서식·드롭다운) */
function layoutCalendar_(sh, ctx) {
  const { month, year, dim, sections, cells, catalog } = ctx;
  const totalCols = CAL_COUNT_COL;
  if (sh.getMaxColumns() < totalCols) sh.insertColumnsAfter(sh.getMaxColumns(), totalCols - sh.getMaxColumns());
  else if (sh.getMaxColumns() > totalCols) sh.deleteColumns(totalCols + 1, sh.getMaxColumns() - totalCols);

  const S = CAL_SLOTS;
  const peopleRows = sections.reduce((a, s) => a + s.names.length, 0) * S;
  const lastRow = CAL_FIRST_ROW + peopleRows - 1;
  if (sh.getMaxRows() < lastRow + 5) sh.insertRowsAfter(sh.getMaxRows(), lastRow + 5 - sh.getMaxRows());

  sh.getRange(1, 1, sh.getMaxRows(), totalCols).setFontFamily('Malgun Gothic').setFontSize(9);

  // 제목·안내 ★ 병합은 고정 열(A·B)과 나머지(C~)를 넘나들지 않게 — 넘나들면 열 고정 오류
  sh.getRange(1, 1, 2, CAL_NAME_COL).merge()
    .setValue(`${month}월`).setFontSize(18).setFontWeight('bold')
    .setHorizontalAlignment('center').setVerticalAlignment('middle').setBackground('#e8eaed');
  sh.getRange(1, CAL_DAY_COL, 1, CAL_STATUS_COL - CAL_DAY_COL).merge()
    .setValue(`${year}년 ${month}월 교통비 특이사항 달력`).setFontSize(14).setFontWeight('bold').setVerticalAlignment('middle');
  sh.getRange(1, CAL_STATUS_COL, 1, totalCols - CAL_STATUS_COL + 1).merge()
    .setValue('아직 점검 안 함').setHorizontalAlignment('right').setVerticalAlignment('middle')
    .setFontColor('#5f6368').setFontSize(10);
  sh.getRange(2, CAL_DAY_COL, 1, totalCols - CAL_DAY_COL + 1).merge().setValue(CAL_GUIDE)
    .setWrap(true).setVerticalAlignment('middle').setFontColor('#3c4043').setBackground('#f8f9fa');
  sh.setRowHeight(1, 30);
  sh.setRowHeight(2, 44);

  // 머리글 (날짜·요일)
  const head = ['구분', '이름'];
  const week = ['', ''];
  const WD = '일월화수목금토';
  for (let d = 1; d <= 31; d++) {
    head.push(d <= dim ? d : '');
    week.push(d <= dim ? WD[new Date(year, month - 1, d).getDay()] : '');
  }
  head.push('건수');
  week.push('');
  sh.getRange(CAL_HEADER_ROW, 1, 1, totalCols).setValues([head]);
  sh.getRange(CAL_WEEK_ROW, 1, 1, totalCols).setValues([week]);
  const hdr = sh.getRange(CAL_HEADER_ROW, 1, 2, totalCols);
  hdr.setFontWeight('bold').setHorizontalAlignment('center').setVerticalAlignment('middle').setBackground('#e8eaed');
  sh.getRange(CAL_HEADER_ROW, 1, 2, 1).merge();
  sh.getRange(CAL_HEADER_ROW, 2, 2, 1).merge();
  sh.getRange(CAL_HEADER_ROW, CAL_COUNT_COL, 2, 1).merge();
  for (let d = 1; d <= 31; d++) {
    const c = CAL_DAY_COL + d - 1;
    if (d > dim) { sh.getRange(CAL_HEADER_ROW, c, 2, 1).setBackground(CAL_COLORS.off); continue; }
    const w = new Date(year, month - 1, d).getDay();
    if (w === 0) sh.getRange(CAL_HEADER_ROW, c, 2, 1).setFontColor('#d93025');
    if (w === 6) sh.getRange(CAL_HEADER_ROW, c, 2, 1).setFontColor('#1a73e8');
  }
  sh.getRange(CAL_HEADER_ROW, CAL_DAY_COL, 1, 31).setFontSize(10);

  // 본문
  const body = [];
  const secRanges = [];
  const personStarts = [];
  let r = CAL_FIRST_ROW;
  sections.forEach(sec => {
    if (sec.names.length === 0) return;
    const start = r;
    sec.names.forEach((n, i) => {
      personStarts.push(r);
      for (let slot = 0; slot < S; slot++) {
        const row = [i === 0 && slot === 0 ? SHEET_CFG[sec.key].sheetName : '', slot === 0 ? n : ''];
        for (let d = 1; d <= 31; d++) {
          const lines = cells[sec.key + '|' + n + '|' + d] || [];
          // 한 칸에 한 건씩, 칸 수보다 많으면 마지막 칸에 줄바꿈으로 모음
          row.push(slot < S - 1 ? (lines[slot] || '') : lines.slice(S - 1).join('\n'));
        }
        row.push(slot === 0 ? `=COUNTA(${colA1_(CAL_DAY_COL)}${r}:${colA1_(CAL_DAY_COL + 30)}${r + S - 1})` : '');
        body.push(row);
        r++;
      }
    });
    secRanges.push({ key: sec.key, start, n: sec.names.length * S });
  });

  if (body.length > 0) {
    sh.getRange(CAL_FIRST_ROW, CAL_DAY_COL, body.length, 31).setNumberFormat('@');
    sh.getRange(CAL_FIRST_ROW, 1, body.length, totalCols).setValues(body);

    const all = sh.getRange(CAL_FIRST_ROW, 1, body.length, totalCols);
    all.setVerticalAlignment('middle').setWrap(true)
      .setBorder(true, true, true, true, true, true, '#e0e0e0', SpreadsheetApp.BorderStyle.DOTTED);
    all.setBorder(true, true, true, true, true, null, '#c0c0c0', SpreadsheetApp.BorderStyle.SOLID);
    sh.getRange(CAL_FIRST_ROW, CAL_DAY_COL, body.length, 31).setHorizontalAlignment('center');
    sh.getRange(CAL_FIRST_ROW, CAL_NAME_COL, body.length, 1).setFontWeight('bold').setHorizontalAlignment('center').setFontSize(10);
    sh.getRange(CAL_FIRST_ROW, CAL_COUNT_COL, body.length, 1).setHorizontalAlignment('center').setFontColor('#5f6368');
    sh.setRowHeights(CAL_FIRST_ROW, body.length, 22);

    // 사람 한 명 = ${S}줄 묶음 (이름·건수 병합, 묶음 아래 진한 선)
    personStarts.forEach(p => {
      sh.getRange(p, CAL_NAME_COL, S, 1).merge().setVerticalAlignment('middle');
      sh.getRange(p, CAL_COUNT_COL, S, 1).merge().setVerticalAlignment('middle');
      sh.getRange(p + S - 1, 1, 1, totalCols)
        .setBorder(null, null, true, null, null, null, '#9e9e9e', SpreadsheetApp.BorderStyle.SOLID);
    });

    // 주말·없는 날 바탕색
    const bgs = body.map(() => {
      const row = [];
      for (let d = 1; d <= 31; d++) row.push(calBaseBg_(year, month, d, dim));
      return row;
    });
    sh.getRange(CAL_FIRST_ROW, CAL_DAY_COL, body.length, 31).setBackgrounds(bgs);

    secRanges.forEach(s => {
      sh.getRange(s.start, CAL_SEC_COL, s.n, 2).setBackground(CAL_SECTION_BG[s.key] || '#ffffff');
      sh.getRange(s.start, CAL_SEC_COL, s.n, 1).merge()
        .setFontWeight('bold').setHorizontalAlignment('center').setVerticalAlignment('middle').setFontSize(10);
      sh.getRange(s.start + s.n - 1, 1, 1, totalCols)
        .setBorder(null, null, true, null, null, null, '#5f6368', SpreadsheetApp.BorderStyle.SOLID_MEDIUM);
    });
  }

  sh.setColumnWidth(CAL_SEC_COL, 62);
  sh.setColumnWidth(CAL_NAME_COL, 56);
  sh.setColumnWidths(CAL_DAY_COL, 31, 76);
  sh.setColumnWidth(CAL_COUNT_COL, 38);
  sh.setFrozenRows(CAL_WEEK_ROW);
  sh.setFrozenColumns(CAL_NAME_COL);

  refreshCalValidation_(sh, catalog);
}

/**
 * 달력 칸 하나 점검
 *  • 사유를 사유표 표기로 맞춤 — 띄어쓰기만 다른 경우 ("18.9L 대외분석 의뢰" → 사유표의 "18.9L 대외분석의뢰")
 *  • useRule: 드롭다운을 걸지 여부
 *      - 빈 칸 / 사유 하나만 적은 칸 → 드롭다운 (목록에 없는 사유면 빨간 경고 표시 = 사유표에 없다는 뜻)
 *      - 2건 이상·(30km)·@장소·?·BTL: 처럼 목록과 모양이 다른 칸 → 사유가 모두 사유표에 있으면 드롭다운을 떼어 경고 없앰
 */
function calCellCheck_(raw, secKey, catalog) {
  const src = String(raw === null || raw === undefined ? '' : raw);
  const lines = splitCalLines_(src);
  if (!secKey) return { text: src, changed: false, useRule: false };
  if (lines.length === 0) return { text: src, changed: false, useRule: true };

  let allKnown = true, plain = lines.length === 1, lineChanged = false;
  const out = lines.map(line => {
    const p = parseCalLine_(line, secKey);
    if (p.pending || p.km !== '' || p.route || p.sheetKey !== secKey) plain = false;
    if (p.pending) return line;
    const cat = catalog.map[catKey_(p.sheetKey, p.reason)];
    if (!cat) { allKnown = false; return line; }
    // 사유 부분만 사유표 표기로 (BTL:, @장소, (30km)는 그대로 붙임)
    let t = (p.sheetKey !== secKey ? p.sheetKey + ': ' : '') + cat.reason;
    if (p.route) t += ' @' + (p.route.indexOf('공장 ↔ ') === 0 ? p.route.slice('공장 ↔ '.length) : p.route);
    if (p.km !== '') t += ` (${p.km}km)`;
    if (t !== line) lineChanged = true;
    return t;
  });
  const text = lineChanged ? out.join('\n') : src;
  return { text, changed: lineChanged, useRule: plain || !allKnown };
}

function calRuleFor_(key, catalog, cache) {
  if (!key) return null;
  if (key in cache) return cache[key];
  const list = catalog.bySheet[key] || [];
  cache[key] = list.length === 0 ? null : SpreadsheetApp.newDataValidation()
    .requireValueInList(list.slice(0, 500), true)
    .setAllowInvalid(true)
    .setHelpText('목록에서 고르거나 직접 입력. 2건 이상은 줄바꿈 또는 " + "  /  거리: (30km)  /  목적지: @성읍교  /  미정: ?')
    .build();
  return cache[key];
}

/** 달력 각 행의 구역(시트 키) — A열 병합 칸을 아래로 이어 읽음 */
function calRowKeys_(sh, fromRow, toRow) {
  const keyByName = sheetNameToKey_();
  const secVals = sh.getRange(CAL_FIRST_ROW, CAL_SEC_COL, toRow - CAL_FIRST_ROW + 1, 1).getDisplayValues();
  const keys = [];
  let cur = '';
  secVals.forEach((r, i) => {
    if (String(r[0]).trim()) cur = String(r[0]).trim();
    if (CAL_FIRST_ROW + i >= fromRow) keys.push(keyByName[normName_(cur)] || null);
  });
  return keys;
}

/** 지정 범위(달력 날짜 칸)의 표기 맞춤 + 드롭다운 다시 걸기 */
function refreshCalCells_(sh, r0, c0, nR, nC, catalog) {
  const rng = sh.getRange(r0, c0, nR, nC);
  const vals = rng.getDisplayValues();
  const keys = calRowKeys_(sh, r0, r0 + nR - 1);
  const cache = {};
  let anyChange = false;
  const dvs = vals.map((row, i) => row.map((v, j) => {
    const res = calCellCheck_(v, keys[i], catalog);
    if (res.changed) { vals[i][j] = res.text; anyChange = true; }
    return res.useRule ? calRuleFor_(keys[i], catalog, cache) : null;
  }));
  if (anyChange) rng.setValues(vals);
  rng.setDataValidations(dvs);
}

/** 달력 전체 새로고침 (달력 만들 때·열 때·사유표를 고쳤을 때) */
function refreshCalValidation_(sh, catalog) {
  const last = sh.getLastRow();
  if (last < CAL_FIRST_ROW) return;
  refreshCalCells_(sh, CAL_FIRST_ROW, CAL_DAY_COL, last - CAL_FIRST_ROW + 1, 31, catalog);
}

function isCalSheet_(sh) {
  return new RegExp('^(\\d{1,2})' + CAL_SHEET_SUFFIX + '$').test(sh.getName());
}

// onEdit(단순 트리거)
//  • 달력 칸을 고치면: 점검 색·메모 지움 + 사유 표기를 사유표에 맞춤 + 드롭다운 경고 정리
//  • 사유표를 고치면: 모든 달력의 드롭다운·표기를 새 사유표에 맞춤
function onEdit(e) {
  try {
    if (!e || !e.range) return;
    const sh = e.range.getSheet();

    if (sh.getName() === CATALOG_SHEET_NAME) {
      if (e.range.getLastRow() < CATALOG_FIRST_ROW || e.range.getColumn() > 2) return; // 시트·사유 열만
      const catalog = readCatalog_();
      sh.getParent().getSheets().filter(isCalSheet_).forEach(c => refreshCalValidation_(c, catalog));
      return;
    }

    const m = sh.getName().match(new RegExp('^(\\d{1,2})' + CAL_SHEET_SUFFIX + '$'));
    if (!m) return;
    const r0 = Math.max(e.range.getRow(), CAL_FIRST_ROW);
    const r1 = e.range.getLastRow();
    const c0 = Math.max(e.range.getColumn(), CAL_DAY_COL);
    const c1 = Math.min(e.range.getLastColumn(), CAL_DAY_COL + 30);
    if (r0 > r1 || c0 > c1) return;
    const nR = r1 - r0 + 1, nC = c1 - c0 + 1;
    if (nR * nC > 3000) return;

    const month = parseInt(m[1], 10);
    const year = calYear_(month), dim = daysInMonth_(month);
    const rng = sh.getRange(r0, c0, nR, nC);
    const notes = rng.getNotes();
    const bgs = [];
    for (let i = 0; i < nR; i++) {
      const row = [];
      for (let j = 0; j < nC; j++) {
        row.push(calBaseBg_(year, month, c0 + j - CAL_DAY_COL + 1, dim));
        if (String(notes[i][j]).indexOf(CAL_NOTE_TAG) === 0) notes[i][j] = '';
      }
      bgs.push(row);
    }
    rng.setBackgrounds(bgs);
    rng.setNotes(notes);

    refreshCalCells_(sh, r0, c0, nR, nC, readCatalog_());
  } catch (err) {
    // 단순 트리거 오류는 무시 (입력은 그대로 됨)
  }
}

// ═══════════════════════════════════════════
// 📋 특이사항 사유표 — 사유별 기본 구간·거리 + 달력 드롭다운 목록
// ═══════════════════════════════════════════
function catKey_(key, reason) { return key + '|' + normReason_(reason); }

let _catalogMemo = null;

function readCatalog_() {
  if (_catalogMemo) return _catalogMemo;
  const sh = getOrCreateCatalog_();
  const out = { map: {}, bySheet: {} };
  Object.keys(SHEET_CFG).forEach(k => { out.bySheet[k] = []; });
  const last = sh.getLastRow();
  if (last >= CATALOG_FIRST_ROW) {
    const keyByName = sheetNameToKey_();
    sh.getRange(CATALOG_FIRST_ROW, 1, last - CATALOG_FIRST_ROW + 1, 4).getDisplayValues().forEach(r => {
      const key = keyByName[normName_(r[0])];
      const reason = String(r[1]).trim().replace(/\s+/g, ' ');
      if (!key || !reason) return;
      let route = String(r[2]).trim();
      if (route && route.indexOf('↔') < 0) route = '공장 ↔ ' + route;
      if (!out.map[catKey_(key, reason)]) out.map[catKey_(key, reason)] = { reason, route, km: parseKm_(r[3]) };
      if (out.bySheet[key].indexOf(reason) < 0) out.bySheet[key].push(reason);
    });
  }
  _catalogMemo = out;
  return out;
}

function getOrCreateCatalog_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(CATALOG_SHEET_NAME);
  if (sh) return sh;

  // 초기 목록: 코드의 reasons + 옛 입력창 기록에 나온 사유
  const seeds = [];
  const seen = {};
  const kms = {};
  const addSeed = (key, reason, used) => {
    reason = String(reason).trim().replace(/\s+/g, ' ');
    if (!reason) return;
    const k = catKey_(key, reason);
    if (seen[k]) {
      if (used && !seen[k].used) { seen[k].reason = reason; seen[k].used = true; } // 실제로 쓰던 띄어쓰기 우선
      return;
    }
    seen[k] = { key, reason, used: !!used };
    seeds.push(seen[k]);
  };
  ['CIP', 'SEJEUM', 'BTL'].forEach(key => SHEET_CFG[key].reasons.forEach(r => addSeed(key, r)));
  readHiddenSpecials_().forEach(e => {
    addSeed(e.sheetKey, e.reason, true);
    const k = catKey_(e.sheetKey, e.reason);
    (kms[k] = kms[k] || {})[String(e.km)] = true;
  });

  const rows = seeds.map(s => {
    const k = catKey_(s.key, s.reason);
    let km = '';
    const ks = kms[k] ? Object.keys(kms[k]) : [];
    if (ks.length === 1 && ks[0] !== '' && Number(ks[0]) !== SHEET_CFG[s.key].distance) km = Number(ks[0]);
    let route = '';
    const rule = CATALOG_SEED_ROUTES.find(x => s.reason.indexOf(x.kw) >= 0);
    if (rule) { route = rule.route; if (km === '') km = rule.km; }
    return [SHEET_CFG[s.key].sheetName, s.reason, route, km, ''];
  });
  rows.sort((a, b) => {
    const order = { '품질 CIP': 0, '제품생산': 1, 'BTL 생산': 2 };
    return (order[a[0]] - order[b[0]]);
  });

  sh = ss.insertSheet(CATALOG_SHEET_NAME, ss.getNumSheets());
  sh.getRange(1, 1, 200, 5).setFontFamily('Malgun Gothic').setFontSize(10);
  sh.getRange(1, 1, 1, 5).merge().setValue('특이사항 사유표 — 달력 칸에 적는 사유, 사유별 구간·주행거리')
    .setFontWeight('bold').setFontSize(13);
  sh.getRange(2, 1, 1, 5).merge().setValue(
    '• 구간·거리 칸을 비우면 기본값 (공장 ↔ 제주시 / BTL·제품생산 50km, 품질 CIP 55km / 김은혁은 공장 ↔ 서귀포시)\n' +
    '• 구간은 "제주민속촌"처럼 장소만 써도 됨 → "공장 ↔ 제주민속촌"  • 여기 있는 사유가 달력 드롭다운에 나옴 (행 추가·삭제 자유)\n' +
    '• 달력 칸에 직접 적은 값 "(30km)", "@성읍교"가 이 표보다 우선')
    .setWrap(true).setFontColor('#3c4043').setBackground('#f8f9fa').setVerticalAlignment('middle');
  sh.setRowHeight(2, 58);
  sh.getRange(3, 1, 1, 5).setValues([['시트', '사유', '구간 (비우면 기본)', '주행거리 km (비우면 기본)', '메모']])
    .setFontWeight('bold').setBackground('#e8eaed').setHorizontalAlignment('center');
  if (rows.length > 0) sh.getRange(CATALOG_FIRST_ROW, 1, rows.length, 5).setValues(rows);
  const listRows = Math.max(rows.length + 30, 60);
  sh.getRange(CATALOG_FIRST_ROW, 1, listRows, 1).setDataValidation(
    SpreadsheetApp.newDataValidation()
      .requireValueInList(Object.keys(SHEET_CFG).map(k => SHEET_CFG[k].sheetName), true).build());
  sh.getRange(3, 1, listRows + 1, 5).setBorder(true, true, true, true, true, true, '#c0c0c0', SpreadsheetApp.BorderStyle.SOLID);
  sh.setColumnWidth(1, 80);
  sh.setColumnWidth(2, 260);
  sh.setColumnWidth(3, 170);
  sh.setColumnWidth(4, 150);
  sh.setColumnWidth(5, 220);
  sh.setFrozenRows(3);
  return sh;
}

function openCatalog() {
  getOrCreateCatalog_().activate();
}

