// {V} 자리에 정규화된 용량이 들어감
// stripExtension: true → "연장" 제거(생산 계열) / false → "연장" 유지(정비·청소 계열)
// ※ 순서 중요: 좁은 패턴을 넓은 패턴("생산")보다 먼저
const VOLUME_ACTIVITIES = [
  { re: /^b\s*t\s*l\s*(?:[\/·,]\s*(?:c\s*a\s*p|캡)\s*)?생\s*산/i, canonical: "{V} BTL 생산", stripExtension: true },
  { re: /^병\s*생\s*산/, canonical: "{V} BTL 생산", stripExtension: true },
  { re: /^캔\s*생\s*산/, canonical: "{V} 캔 생산", stripExtension: true },
  { re: /^충\s*[진전]\s*실\s*정\s*비/, canonical: "{V} 충진실 정비", stripExtension: false },
  { re: /^충\s*[진전]\s*실\s*청\s*소/, canonical: "{V} 충진실 청소", stripExtension: false },
  { re: /^충\s*[진전]\s*실\s*세\s*척/, canonical: "{V} 충진실 세척", stripExtension: false },
  { re: /^(?:제\s*품\s*)?생\s*산/, canonical: "{V} 제품 생산", stripExtension: true }
];

// ※ "연장" 포함 패턴을 반드시 먼저 선언
const FLAT_PATTERNS = [
  { re: /c\s*i\s*p\s*작업\s*연장/i, canonical: "CIP 작업 연장" },
  { re: /c\s*i\s*p\s*작업/i, canonical: "CIP 작업" },
  { re: /c\s*i\s*p\s*연장/i, canonical: "CIP 연장" },
  { re: /c\s*i\s*p/i, canonical: "CIP" },

  { re: /설비\s*보전\s*연장/, canonical: "설비 보전 연장" },
  { re: /설비\s*보전/, canonical: "설비 보전" },
  { re: /설비\s*점검\s*연장/, canonical: "설비 점검 연장" },
  { re: /설비\s*점검/, canonical: "설비 점검" },

  { re: /공장\s*청소\s*연장/, canonical: "공장 청소 연장" },
  { re: /공장\s*청소/, canonical: "공장 청소" },

  { re: /재고\s*조사\s*연장/, canonical: "재고 조사 연장" },
  { re: /재고\s*조사/, canonical: "재고 조사" }
];


function normalizeReason(text) {
  if (!text || String(text).trim() === "") return text;

  let work = String(text);

  let suffix = "";
  const paren = work.match(/\(.*?\)\s*$/);
  if (paren) {
    suffix = " " + paren[0].trim();
    work = work.replace(/\(.*?\)\s*$/, "").trim();
  }

  work = work.replace(/(\d),(\d)/g, "$1.$2");
  work = work.replace(/\s+/g, " ").trim();

  const byVolume = matchVolumePattern(work);
  if (byVolume) return byVolume + suffix;

  for (const p of FLAT_PATTERNS) {
    if (p.re.test(work)) return p.canonical + suffix;
  }
  return work + suffix;
}


function matchVolumePattern(text) {
  const m = text.match(/^\s*(\d+(?:\.\d+)?)\s*\.?\s*(?:L|리터)?\s*(.*)$/i);
  if (!m) return null;

  const label = toVolumeLabel(m[1]);
  if (!label) return null;

  const rest = m[2].trim();
  if (!rest) return null;

  for (const act of VOLUME_ACTIVITIES) {
    if (act.re.test(rest)) {
      const leftover = rest.replace(act.re, "").trim();
      let out = act.canonical.replace("{V}", label);
      if (!act.stripExtension && /연장/.test(leftover)) out += " 연장";
      return out;
    }
  }
  return null;
}


function toVolumeLabel(raw) {
  let s = String(raw);
  if (/^0\d+$/.test(s)) s = "0." + s.slice(1); // "033" → "0.33"
  const key = String(parseFloat(s)); // "0.50"→"0.5", "1.0"→"1"
  return VOLUME_LABELS[key] || null;
}


