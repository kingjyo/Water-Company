  const endRow = _findEndRow(sheet);
  _ensureColumnExists(sheet, COL_CATEGORY);
  sheet.getRange(1, COL_CATEGORY).setValue("연장사유 분류");

  const needCheck = _normalizeAndClassify(sheet, endRow);
  _styleCategoryColumn(sheet, endRow);
  _styleHeader(sheet, sheet.getLastColumn(), false);

  SpreadsheetApp.getUi().alert(`✅ 신청사유 정규화 + 분류 완료!\n\n확인필요 항목: ${needCheck}건`);
}


function previewNormalizeReason() {
  const sheet = _getOvertimeSheet();
  if (!sheet) return;

  const endRow = _findEndRow(sheet);
  const values = sheet.getRange(DATA_START_ROW, COL_REASON, endRow - DATA_START_ROW + 1, 1).getValues();

  const needCheck = [];
  values.forEach((row, i) => {
    const before = String(row[0]).trim();
    if (!before) return;
    const after = normalizeReason(before);
    const cat = classifyReason(after);
    Logger.log(`${DATA_START_ROW + i}행: "${before}" → "${after}" [${cat}]`);
    if (cat === CATEGORY_FALLBACK) needCheck.push(`${DATA_START_ROW + i}행: ${after}`);
  });

  Logger.log("─── 확인필요 항목 ───");
  needCheck.forEach(v => Logger.log(v));
}


// ─── 연결 상태 점검 (전송 전 확인용) ─────────────────────────────────────
function checkExternalSources() {
  const lines = [];

  try {
    const month = getTargetMonth();
    lines.push(`✅ 기준 월: ${month}월`);

    try {
      const att = SpreadsheetApp.openById(SS_ID_ATTENDANCE);
      const s = _findSheetByPatterns(att, [`${month}월 근태`, `${month}월근태`],
                                     new RegExp(`^\\s*${month}\\s*월\\s*근태`));
      lines.push(s ? `✅ 근태 시트: "${s.getName()}"` : `❌ "${month}월 근태" 시트 없음`);
    } catch (e) { lines.push(`❌ 근태 정산내역: ${e.message}`); }

    try {
      const plan = SpreadsheetApp.openById(SS_ID_WORK_PLAN);
      const s = _findSheetByPatterns(plan, [`${month}월`],
                                     new RegExp(`(^|[^0-9])${month}\\s*월`));
      lines.push(s ? `✅ 근무계획 시트: "${s.getName()}"` : `❌ "${month}월" 시트 없음`);
      Logger.log(`근무계획 전체 시트: ${plan.getSheets().map(x => x.getName()).join(", ")}`);
    } catch (e) { lines.push(`❌ 근무계획: ${e.message}`); }

  } catch (e) {
    lines.push(`❌ 기준 월 확인 실패: ${e.message}`);
  }

  SpreadsheetApp.getUi().alert("🔗 외부 소스 점검\n\n" + lines.join("\n"));
}


