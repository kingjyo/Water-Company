  if (!sheet) return;

  deleteColumnsByLetters(sheet, OVERTIME_DELETE_COLS);
  sheet.deleteRow(1);
  SpreadsheetApp.flush();

  _ensureColumnExists(sheet, COL_CATEGORY);
  sheet.getRange("A1").setValue("No");
  sheet.getRange("E1").setValue("출근시간");
  sheet.getRange("F1").setValue("퇴근시간");
  sheet.getRange("I1").setValue("결과시간");
  sheet.getRange("J1").setValue("신청사유");
  sheet.getRange(1, COL_CATEGORY).setValue("연장사유 분류");

  // ※ 행 고정 안 함 (다음 달 원본 붙여넣기 시 병합 오류 방지)
  _styleHeader(sheet, sheet.getLastColumn(), false);

  const endRow = _findEndRow(sheet);
  Logger.log(`처리 범위: ${DATA_START_ROW}행 ~ ${endRow}행`);

  _normalizeAndClassify(sheet, endRow);
  _styleCategoryColumn(sheet, endRow);
  _convertResultTimeRange(sheet, endRow);

  SpreadsheetApp.getUi().alert(
    "✅ 처리 완료!\n\n" +
    "• 불필요한 열 삭제\n" +
    "• 헤더 1행으로 정리\n" +
    "• 신청사유 정규화\n" +
    "• 연장사유 분류(K열) 생성\n" +
    "• 결과시간 소수 변환"
  );
}


function _styleCategoryColumn(sheet, endRow) {
  const range = sheet.getRange(1, COL_CATEGORY, endRow, 1);
  range.setBorder(true, true, true, true, true, true, "#000000", SpreadsheetApp.BorderStyle.SOLID);
  range.setHorizontalAlignment("center");
  range.setVerticalAlignment("middle");
  sheet.setColumnWidth(COL_CATEGORY, 110);
}


