// [F] 연장사유 분류
// ═════════════════════════════════════════════════════════════════════════
// ※ 순서 중요: "정비"를 앞에 둬야 복합 표기가 정비로 잡힘
const REASON_CATEGORIES = [
  { keywords: ["정비"], label: "정비" },
  { keywords: ["BTL", "병"], label: "BTL 생산" },
  { keywords: ["제품"], label: "제품 생산" }
];
const CATEGORY_FALLBACK = "확인필요";


function classifyReason(reason) {
  const val = String(reason == null ? "" : reason).trim();
  if (!val) return "";

  const upper = val.toUpperCase();
  for (const cat of REASON_CATEGORIES) {
    if (cat.keywords.some(k => upper.indexOf(k.toUpperCase()) !== -1)) return cat.label;
  }
  return CATEGORY_FALLBACK;
}


function _normalizeAndClassify(sheet, endRow) {
  _ensureColumnExists(sheet, COL_CATEGORY);

  const numRows = endRow - DATA_START_ROW + 1;
  const reasonRange = sheet.getRange(DATA_START_ROW, COL_REASON, numRows, 1);

  const normalized = [];
  const categories = [];

  reasonRange.getValues().forEach(row => {
    const raw = String(row[0]).trim();
    const norm = raw ? normalizeReason(raw) : raw;
    normalized.push([norm]);
    categories.push([classifyReason(norm)]);
  });

  reasonRange.setValues(normalized);
  sheet.getRange(DATA_START_ROW, COL_CATEGORY, numRows, 1).setValues(categories);

  return categories.filter(c => c[0] === CATEGORY_FALLBACK).length;
}


// ═════════════════════════════════════════════════════════════════════════
// [G] 결과시간 → 소수 변환
// ═════════════════════════════════════════════════════════════════════════
function convertTimeToDecimal(val) {
  val = String(val).trim();
  if (/^\d+(\.\d+)?$/.test(val)) return parseFloat(val);

  let hours = 0, minutes = 0;

  const mFull = val.match(/(\d+)\s*시간\s*(\d+)\s*분/);
  if (mFull) {
    hours = parseInt(mFull[1], 10);
    minutes = parseInt(mFull[2], 10);
  } else {
    const mHour = val.match(/(\d+)\s*시간/);
    if (mHour) {
      hours = parseInt(mHour[1], 10);
    } else {
      const mMin = val.match(/^(\d+)\s*분$/);
      if (mMin) minutes = parseInt(mMin[1], 10);
      else return null;
    }
  }
  return Math.round((hours + minutes / 60) * 100) / 100;
}


