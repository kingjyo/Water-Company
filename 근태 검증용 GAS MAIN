// ─── X월 근무현황표 시트 + 기준 월 반환 ──────────────────────────────────
// 시트 이름의 X가 그 시트의 Z3에 연동되므로 이름으로 직접 찾을 수 없어 패턴 탐색
// ※ 이 함수는 Code.gs에만 존재해야 합니다 (검증.gs에서는 삭제)
function _getWorkStatusSheet() {
  const att = SpreadsheetApp.openById(SS_ID_ATTENDANCE);
  const candidates = att.getSheets()
    .filter(s => /(\d{1,2})\s*월\s*근무현황표/.test(s.getName()));

  if (candidates.length === 0) throw new Error("근무현황표 시트를 찾을 수 없습니다");

  // 시트 이름의 월과 Z3 값이 일치하는 것을 우선 채택
  let chosen = null;
  for (const s of candidates) {
    const nameMonth = parseInt(s.getName().match(/(\d{1,2})\s*월/)[1], 10);
    const cellMonth = _toMonthNumber(s.getRange(MONTH_SOURCE_CELL).getValue());
    if (cellMonth && cellMonth === nameMonth) { chosen = s; break; }
  }
  if (!chosen) {
    chosen = candidates[0];
    Logger.log(`[주의] 이름과 ${MONTH_SOURCE_CELL} 값이 일치하는 근무현황표 없음 → "${chosen.getName()}" 사용`);
  }

  const month = _toMonthNumber(chosen.getRange(MONTH_SOURCE_CELL).getValue());
  if (!month) throw new Error(`"${chosen.getName()}"의 ${MONTH_SOURCE_CELL} 값이 유효한 월이 아닙니다`);

  Logger.log(`근무현황표: "${chosen.getName()}" / ${MONTH_SOURCE_CELL} = ${month}`);
  return { sheet: chosen, month: month };
}


function _toMonthNumber(v) {
  if (v instanceof Date) return v.getMonth() + 1;
  const m = String(v == null ? "" : v).match(/(\d{1,2})/);
  if (!m) return null;
  const n = parseInt(m[1], 10);
  return (n >= 1 && n <= 12) ? n : null;
}


function columnLetterToIndex(letter) {
  letter = String(letter).toUpperCase();
  let result = 0;
  for (let i = 0; i < letter.length; i++) result = result * 26 + (letter.charCodeAt(i) - 64);
  return result;
}


function deleteColumnsByLetters(sheet, letters) {
  const idx = letters.map(columnLetterToIndex)
    .filter(i => i <= sheet.getMaxColumns())
    .sort((a, b) => b - a);

  let i = 0;
  while (i < idx.length) {
    const end = idx[i];
    let j = i;
    while (j + 1 < idx.length && idx[j + 1] === idx[j] - 1) j++;
    sheet.deleteColumns(idx[j], end - idx[j] + 1);
    i = j + 1;
  }
  SpreadsheetApp.flush();
}


function unmergeHeaderRows(sheet) {
  const lastCol = sheet.getLastColumn();
  const merges = sheet.getRange(1, 1, 2, lastCol).getMergedRanges();

  merges.forEach(r => {
    const value = r.getCell(1, 1).getValue();
    const startCol = r.getColumn();
    const numCols = r.getNumColumns();
    r.breakApart();
    sheet.getRange(1, startCol, 1, numCols).setValue(value);
  });
  SpreadsheetApp.flush();

  const row1 = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
  const row2 = sheet.getRange(2, 1, 1, lastCol).getValues()[0];
  let changed = false;
  for (let i = 0; i < lastCol; i++) {
    if (String(row1[i]).trim() === "" && String(row2[i]).trim() !== "") {
      row1[i] = row2[i];
      changed = true;
    }
  }
  if (changed) sheet.getRange(1, 1, 1, lastCol).setValues([row1]);
}


function _findColumnByHeader(sheet, keyword, fallbackCol) {
  const lastCol = sheet.getLastColumn();
  if (lastCol < 1) return null;

  const headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
  for (let i = 0; i < headers.length; i++) {
    if (String(headers[i]).replace(/\s+/g, "").indexOf(keyword) !== -1) return i + 1;
  }
  Logger.log(`헤더 "${keyword}" 미발견 → 폴백 열 ${fallbackCol} 사용`);
  return (fallbackCol && fallbackCol <= lastCol) ? fallbackCol : null;
}


function _toDate(v) {
  if (v instanceof Date && !isNaN(v.getTime())) {
    return new Date(v.getFullYear(), v.getMonth(), v.getDate());
  }
  const s = String(v == null ? "" : v).trim();
  if (!s) return null;

  const m = s.match(/(\d{4})\s*[-.\/년]\s*(\d{1,2})\s*[-.\/월]\s*(\d{1,2})/);
  if (m) return new Date(parseInt(m[1], 10), parseInt(m[2], 10) - 1, parseInt(m[3], 10));

  const parsed = new Date(s);
  if (!isNaN(parsed.getTime())) {
    return new Date(parsed.getFullYear(), parsed.getMonth(), parsed.getDate());
  }
  return null;
}


// ─── 헤더 서식 (freeze: 1행 고정 여부) ───────────────────────────────────
function _styleHeader(sheet, lastCol, freeze) {
  const headerRange = sheet.getRange(1, 1, 1, lastCol);
  headerRange.setFontWeight("bold");
  headerRange.setBackground("#d9e1f2");
  headerRange.setHorizontalAlignment("center");
  headerRange.setVerticalAlignment("middle");
  sheet.setFrozenRows(freeze ? 1 : 0);
}


function _ensureColumnExists(sheet, colIndex) {
  const max = sheet.getMaxColumns();
  if (max < colIndex) sheet.insertColumnsAfter(max, colIndex - max);
}


function _ensureRowExists(sheet, rowIndex) {
  const max = sheet.getMaxRows();
  if (max < rowIndex) sheet.insertRowsAfter(max, rowIndex - max);
}


function _getOvertimeSheet() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_OVERTIME);
  if (!sheet) {
    SpreadsheetApp.getUi().alert(`"${SHEET_OVERTIME}" 시트를 찾을 수 없습니다.`);
    return null;
  }
  return sheet;
}


function _findEndRow(sheet) {
  const lastRow = sheet.getLastRow();
  if (lastRow < DATA_START_ROW) return DATA_START_ROW;

  const colA = sheet.getRange(DATA_START_ROW, 1, lastRow - DATA_START_ROW + 1, 1).getValues();
  for (let i = 0; i < colA.length; i++) {
    const v = colA[i][0];
    if (v === "" || v === null || v === undefined) return DATA_START_ROW + i;
  }
  return lastRow;
}


function _convertResultTimeRange(sheet, endRow) {
  const range = sheet.getRange(DATA_START_ROW, COL_RESULT_TIME, endRow - DATA_START_ROW + 1, 1);
  const values = range.getValues();
  let count = 0;

  const converted = values.map(row => {
    const val = String(row[0]).trim();
    if (!val) return [row[0]];
    const c = convertTimeToDecimal(val);
    if (c === null) return [row[0]];
    count++;
    return [c];
  });

  range.setValues(converted);
  range.setNumberFormat("0.00");
  return count;
}


