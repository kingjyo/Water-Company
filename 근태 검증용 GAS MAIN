function cleanLeaveSheet() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_LEAVE);
  if (!sheet) {
    SpreadsheetApp.getUi().alert(`"${SHEET_LEAVE}" 시트를 찾을 수 없습니다.`);
    return;
  }

  const removedRetire = deleteRetiredRows(sheet);
  deleteColumnsByLetters(sheet, LEAVE_DELETE_COLS);
  const removedExpired = deleteExpiredLeaveRows(sheet);
  const sorted = sortLeaveByType(sheet);

  _styleHeader(sheet, sheet.getLastColumn(), true);

  // 마무리: 휴가내역 대조 전송
  const result = transferToComparisonSheet();

  let msg =
    "✅ 휴가관리 시트 정리 완료!\n\n" +
    `• 퇴사자 ${removedRetire}개 행 삭제\n` +
    `• 사용종료일 ${EXPIRE_MONTHS}개월 경과 ${removedExpired}개 행 삭제\n` +
    `• 휴가구분 정렬 완료 (${sorted}개 행)\n` +
    `• 불필요한 ${LEAVE_DELETE_COLS.length}개 열 삭제\n\n` +
    `📤 휴가내역 대조 전송 (기준 월: ${result.month || "?"}월)\n` +
    `• 성공 ${result.ok}개 / 실패 ${result.fail}개 블록`;

  if (result.messages.length > 0) {
    msg += "\n\n⚠️ 확인 필요\n" + result.messages.join("\n");
  }

  SpreadsheetApp.getUi().alert(msg);
}


// ─── 퇴사자 행 삭제 ──────────────────────────────────────────────────────
function deleteRetiredRows(sheet) {
  const lastRow = sheet.getLastRow();
  if (lastRow < LEAVE_DATA_START_ROW) return 0;
  if (sheet.getMaxColumns() < COL_RETIRE_DATE) return 0;

  const numRows = lastRow - LEAVE_DATA_START_ROW + 1;
  const values = sheet.getRange(LEAVE_DATA_START_ROW, COL_RETIRE_DATE, numRows, 1).getValues();

  const targets = [];
  values.forEach((row, i) => {
    const v = row[0];
    if (v !== "" && v !== null && v !== undefined && String(v).trim() !== "") {
      targets.push(LEAVE_DATA_START_ROW + i);
    }
  });

  deleteRowsByIndexes(sheet, targets);
  return targets.length;
}


// ─── 사용종료일 + N개월 경과 행 삭제 ─────────────────────────────────────
function deleteExpiredLeaveRows(sheet) {
  const lastRow = sheet.getLastRow();
  if (lastRow < LEAVE_DATA_START_ROW) return 0;

  const col = _findColumnByHeader(sheet, HEADER_END_DATE, FALLBACK_COL_END_DATE);
  if (!col) return 0;

  const today = new Date();
  const threshold = new Date(today.getFullYear(), today.getMonth() - EXPIRE_MONTHS, today.getDate());
  threshold.setHours(0, 0, 0, 0);

  const numRows = lastRow - LEAVE_DATA_START_ROW + 1;
  const values = sheet.getRange(LEAVE_DATA_START_ROW, col, numRows, 1).getValues();

  const targets = [];
  values.forEach((row, i) => {
    const d = _toDate(row[0]);
    if (d && d < threshold) targets.push(LEAVE_DATA_START_ROW + i);
  });

  deleteRowsByIndexes(sheet, targets);
  Logger.log(`만료 기준일: ${Utilities.formatDate(threshold, Session.getScriptTimeZone(), "yyyy-MM-dd")} / 삭제 ${targets.length}행`);
  return targets.length;
}


// ─── 휴가구분 기준 정렬 (연차 → 월차 → 공휴 → 그 외) ─────────────────────
function sortLeaveByType(sheet) {
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();
  if (lastRow < LEAVE_DATA_START_ROW + 1) return 0;

  const col = _findColumnByHeader(sheet, HEADER_LEAVE_TYPE, FALLBACK_COL_LEAVE_TYPE);
  if (!col) return 0;

  const numRows = lastRow - LEAVE_DATA_START_ROW + 1;
  const range = sheet.getRange(LEAVE_DATA_START_ROW, 1, numRows, lastCol);
  const values = range.getValues();

  // 원래 순서(idx)를 같이 들고 가서 동일 구분 내 순서 유지 (안정 정렬)
  const decorated = values.map((row, idx) => ({
    row: row, idx: idx, rank: _leaveTypeRank(row[col - 1])
  }));
  decorated.sort((a, b) => (a.rank - b.rank) || (a.idx - b.idx));

  range.setValues(decorated.map(d => d.row));
  return numRows;
}


function _leaveTypeRank(value) {
  const v = String(value == null ? "" : value).trim();
  if (!v) return LEAVE_TYPE_ORDER.length + 1;
  for (let i = 0; i < LEAVE_TYPE_ORDER.length; i++) {
    if (v.indexOf(LEAVE_TYPE_ORDER[i]) !== -1) return i;
  }
  return LEAVE_TYPE_ORDER.length;
}


// ═════════════════════════════════════════════════════════════════════════
// [C] 휴가내역 대조 시트로 통합 전송
// ═════════════════════════════════════════════════════════════════════════
function transferToComparisonSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const dst = ss.getSheetByName(SHEET_COMPARE);
  if (!dst) {
    SpreadsheetApp.getUi().alert(`"${SHEET_COMPARE}" 시트를 찾을 수 없습니다.`);
    return { ok: 0, fail: 0, month: null, messages: [] };
  }

  const messages = [];
  let ok = 0, fail = 0;

  // ── 1) 기준 월 확인 ──────────────────────────────────────────────────
  let month = null;
  try {
    month = getTargetMonth();
    Logger.log(`기준 월: ${month}월`);
  } catch (e) {
    messages.push(`• 기준 월 확인 실패: ${e.message}`);
    Logger.log(`기준 월 확인 실패: ${e.message}`);
  }

  // ── 2) 소스 시트 준비 (실패해도 나머지는 계속 진행) ──────────────────
  const sources = {};

  sources.leave = ss.getSheetByName(SHEET_LEAVE);
  if (!sources.leave) messages.push(`• "${SHEET_LEAVE}" 시트 없음`);

  if (month) {
    try {
      const att = SpreadsheetApp.openById(SS_ID_ATTENDANCE);
      sources.attendance = _findSheetByPatterns(att, [
        `${month}월 근태`, `${month}월근태`
      ], new RegExp(`^\\s*${month}\\s*월\\s*근태`));
      if (!sources.attendance) messages.push(`• 근태 정산내역에서 "${month}월 근태" 시트 없음`);
    } catch (e) {
      messages.push(`• 근태 정산내역 열기 실패: ${e.message}`);
    }

    try {
      const plan = SpreadsheetApp.openById(SS_ID_WORK_PLAN);
      sources.workplan = _findSheetByPatterns(plan, [
        `${month}월`
      ], new RegExp(`(^|[^0-9])${month}\\s*월`));
      if (!sources.workplan) messages.push(`• 근무계획에서 "${month}월" 시트 없음`);
    } catch (e) {
      messages.push(`• 근무계획 열기 실패: ${e.message}`);
    }
  }

  // ── 3) 블록별 전송 ───────────────────────────────────────────────────
  const typeCol = sources.leave
    ? _findColumnByHeader(sources.leave, HEADER_LEAVE_TYPE, FALLBACK_COL_LEAVE_TYPE)
    : null;

  TRANSFER_BLOCKS.forEach(b => {
    const src = sources[b.source];
    if (!src) { fail++; return; }

    // 블록 경계 검증 (휴가관리 블록만)
    if (b.expectTypes && typeCol) {
      const types = _readBlock(src, b.srcRow, typeCol, b.numRows, 1);
      let mismatch = 0;
      types.forEach(r => {
        const v = String(r[0]).trim();
        if (!v) return;
        if (!b.expectTypes.some(t => v.indexOf(t) !== -1)) mismatch++;
      });
      if (mismatch > 0) {
        messages.push(`• ${b.label}: 휴가구분 불일치 ${mismatch}행`);
      }
    }

    try {
      const values = _readBlock(src, b.srcRow, b.srcCol, b.numRows, b.numCols);
      _ensureRowExists(dst, b.dstRow + b.numRows - 1);
      _ensureColumnExists(dst, b.dstCol + b.numCols - 1);
      dst.getRange(b.dstRow, b.dstCol, b.numRows, b.numCols).setValues(values);
      ok++;
      Logger.log(`${b.label}: ${b.numRows}×${b.numCols} 전송 완료`);
    } catch (e) {
      fail++;
      messages.push(`• ${b.label} 전송 실패: ${e.message}`);
    }
  });

  return { ok: ok, fail: fail, month: month, messages: messages };
}


