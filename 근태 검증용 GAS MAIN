}


// ─── 시트 탐색: 정확한 이름 → 접두 일치 → 정규식 포함 ────────────────────
function _findSheetByPatterns(spreadsheet, exactNames, fallbackRegex) {
  const sheets = spreadsheet.getSheets();

  for (const name of exactNames) {
    const s = spreadsheet.getSheetByName(name);
    if (s) { Logger.log(`시트 매칭(정확): "${name}"`); return s; }
  }

  for (const name of exactNames) {
    const hit = sheets.find(s => s.getName().trim().indexOf(name) === 0);
    if (hit) { Logger.log(`시트 매칭(접두): "${hit.getName()}"`); return hit; }
  }

  if (fallbackRegex) {
    const hit = sheets.find(s => fallbackRegex.test(s.getName()));
    if (hit) { Logger.log(`시트 매칭(패턴): "${hit.getName()}"`); return hit; }
  }

  Logger.log(`시트 매칭 실패: ${exactNames.join(", ")} / 존재하는 시트: ${sheets.map(s => s.getName()).join(", ")}`);
  return null;
}


// ─── 범위 초과분을 빈 값으로 채워 읽기 ───────────────────────────────────
function _readBlock(sheet, row, col, numRows, numCols) {
  const out = [];
  for (let r = 0; r < numRows; r++) out.push(new Array(numCols).fill(""));

  const readRows = Math.max(0, Math.min(numRows, sheet.getMaxRows() - row + 1));
  const readCols = Math.max(0, Math.min(numCols, sheet.getMaxColumns() - col + 1));
  if (readRows === 0 || readCols === 0) return out;

  const vals = sheet.getRange(row, col, readRows, readCols).getValues();
  for (let r = 0; r < readRows; r++) {
    for (let c = 0; c < readCols; c++) out[r][c] = vals[r][c];
  }
  return out;
}


// ─── 행 삭제 (내림차순 + 연속구간 묶음) ──────────────────────────────────
function deleteRowsByIndexes(sheet, rows) {
  if (!rows || rows.length === 0) return;
  const idx = rows.slice().sort((a, b) => b - a);
  let i = 0;
  while (i < idx.length) {
    const end = idx[i];
    let j = i;
    while (j + 1 < idx.length && idx[j + 1] === idx[j] - 1) j++;
    sheet.deleteRows(idx[j], end - idx[j] + 1);
    i = j + 1;
  }
  SpreadsheetApp.flush();
}


