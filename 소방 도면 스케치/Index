function curveGeometry(a) {
    const w=a.w, h=a.h; return {
        w, h, bw:Math.max(2, Math.min(beltWidth(a), Math.min(w, h)*.45)), cx:-w/2, cy:h/2
    }

    ;
}

function curveEnds(a) {
    const {
        w, h, bw
    }

    =curveGeometry(a); return [localWorld(a, {
        x:-w/2, y:-h/2+bw/2

    }), localWorld(a, {
    x:w/2-bw/2, y:h/2
})];
}

