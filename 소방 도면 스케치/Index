const BELT_FADE= {
    fill:.25, rung:.28, rail:.4, edge:.6
}

;
const beltRail=bw=>Math.min(3, Math.max(.8, bw*.14));
const beltPitch=bw=>Math.max(2.4, Math.min(10, bw*.4));

function drawConveyor(g, a, col, sw, interactive) {
    const len=Math.hypot(a.dx, a.dy); if(len<1)return;
    const bw=beltWidth(a), ux=a.dx/len, uy=a.dy/len, nx=-uy*bw/2, ny=ux*bw/2, thin=Math.max(.5, Math.min(sw*.5, bw*.08)), edge=Math.min(sw, Math.max(.8, bw*.12));

    const outline=`M$ {
        r2(nx)
    }

    $ {
        r2(ny)
    }

    L$ {
        r2(a.dx+nx)
    }

    $ {
        r2(a.dy+ny)
    }

    L$ {
        r2(a.dx-nx)
    }

    $ {
        r2(a.dy-ny)
    }

    L$ {
        r2(-nx)
    }

    $ {
        r2(-ny)
    }

    Z`;

    if(interactive)add(g, 'path', {
        d:outline, fill:'transparent', stroke:'transparent', 'stroke-width':8
