add(g, 'path', {
    d:outline, fill:tint(col, .12), 'fill-opacity':BELT_FADE.fill, stroke:'none'
});
// 양쪽 가이드 레일과 그 사이 체인 판(가로줄)
const k=(bw/2-beltRail(bw))/(bw/2), rx=nx*k, ry=ny*k, n=Math.max(1, Math.round(len/beltPitch(bw))); let d='';

for(let i=1; i<n; i++) {
    const t=len*i/n, x=ux*t, y=uy*t; d+=`M$ {
        r2(x+rx)
    }

    $ {
        r2(y+ry)
    }

    L$ {
        r2(x-rx)
    }

    $ {
        r2(y-ry)
    }

    `;
}

if(d)add(g, 'path', {
    d, fill:'none', stroke:col, 'stroke-width':thin, 'stroke-opacity':BELT_FADE.rung
});

add(g, 'path', {
    d:`M$ {
        r2(rx)
    }

    $ {
        r2(ry)
    }

    L$ {
        r2(a.dx+rx)
    }

    $ {
        r2(a.dy+ry)
    }

    M$ {
        r2(-rx)
    }

    $ {
        r2(-ry)
    }

    L$ {
        r2(a.dx-rx)
    }

    $ {
        r2(a.dy-ry)
    }

