// ── 함께 크기 조절 (v1.0.46) ── 선택한 물체들의 위치·크기·선 굵기·글자 크기를 같은 비율로 바꿉니다(닮은꼴).
let groupAnchor='tl';

function cornersOf(a) {
    if(['wall', 'path', 'conveyor'].includes(a.type))return [localWorld(a, {
        x:0, y:0

    }), localWorld(a, {
    x:a.dx, y:a.dy

})]; const b=geometryBounds(a); return [[b.x, b.y], [b.x+b.w, b.y], [b.x, b.y+b.h], [b.x+b.w, b.y+b.h]].map(([x, y])=>localWorld(a, {
        x, y
    }));
}

function groupBox(items) {
    const ps=items.flatMap(cornersOf), xs=ps.map(p=>p.x), ys=ps.map(p=>p.y); return {
        x0:Math.min(...xs), y0:Math.min(...ys), x1:Math.max(...xs), y1:Math.max(...ys)
    }

    ;
}

function groupPivot(b) {
    const cx=(b.x0+b.x1)/2, cy=(b.y0+b.y1)/2; return {
        tl: {
            x:b.x0, y:b.y0
        }

        , tr: {
            x:b.x1, y:b.y0
        }

        , bl: {
            x:b.x0, y:b.y1
        }

        , br: {
            x:b.x1, y:b.y1
        }

        , center: {
            x:cx, y:cy
        }
    }

    [groupAnchor]|| {
        x:cx, y:cy
    }

    ;
}

function scaleSelection(f) {
    const items=selection(); if(items.length<2|| !(f>0))return; const b=groupBox(items), p=groupPivot(b);

    if(f>1) {
        let max=Infinity; const lim=(edge, piv, bound)=> {
            const d=edge-piv; if(Math.abs(d)<.01)return; const m=(bound-piv)/d; if(m>0)max=Math.min(max, m);
        }

        ; lim(b.x0, p.x, 0); lim(b.x1, p.x, W); lim(b.y0, p.y, 0); lim(b.y1, p.y, H);

        if(max<=1.001) {
            toast('도면 칸 끝에 닿아 더 키울 수 없습니다. 기준을 바꾸거나 먼저 가운데로 옮겨 주세요.'); return;
        }

        if(f>max)f=max;
    }

    const r1=v=>Math.round(v*10)/10, cl=(v, lo, hi)=>Math.max(lo, Math.min(hi, v)); checkpoint();

    items.forEach(a=> {
            const font=isText(a)?textFontSize(a):(a.fontSize !==undefined||String(a.label||'').trim())?labelFontSize(a):null;
            a.x=r1(p.x+(a.x-p.x)*f); a.y=r1(p.y+(a.y-p.y)*f); a.w=Math.max(4, r1(a.w*f)); a.h=Math.max(4, r1(a.h*f)); a.dx=r1(a.dx*f); a.dy=r1(a.dy*f); a.stroke=cl(r1(a.stroke*f), 1, 12);
            if(font !==null)a.fontSize=cl(r1(font*f), 6, 48); if(a.type==='zoneNo')a.nameSize=cl(r1(zoneNameSize(a)*f), 6, 72);
