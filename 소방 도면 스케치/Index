    }
}

const c2=geometricCenter(a); a.x=r1(a.x+c1.x-c2.x); a.y=r1(a.y+c1.y-c2.y);
});
changed(); renderSelection(); renderInspector();
const f=fx !==1?fx:fy, dir=fx !==1?'가로(양옆)':'세로(위아래)';

toast(`$ {
        items.length
    }

    개를 $ {
