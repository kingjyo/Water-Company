function drawConveyorCurve(g, a, col, sw, interactive) {
    const {
        w, h, bw, cx, cy
    }

    =curveGeometry(a), thin=Math.max(.5, Math.min(sw*.5, bw*.08)), edge=Math.min(sw, Math.max(.8, bw*.12)), rail=beltRail(bw);

    const arc=(rx, ry, sweep)=>`A$ {
        r2(rx)
    }

    $ {
        r2(ry)
    }

    0 0 $ {
        sweep
    }

    `;

    const outline=`M$ {
        cx
    }

    $ {
        cy-h
    }

    $ {
        arc(w, h, 1)
    }

    $ {
        cx+w
    }

    $ {
        cy
    }

    L$ {
        r2(cx+w-bw)
    }

    $ {
        cy
    }

    $ {
        arc(w-bw, h-bw, 0)
    }

    $ {
        cx
    }

    $ {
        r2(cy-h+bw)
    }

    Z`;

    if(interactive)add(g, 'path', {
        d:outline, fill:'transparent', stroke:'transparent', 'stroke-width':8
