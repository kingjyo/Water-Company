        const d=edge-piv; if(Math.abs(d)<.01)return; const m=(bound-piv)/d; if(m>0) {
            if(ax==='x')mx=Math.min(mx, m); else my=Math.min(my, m);
        }
    }

    ;
    const full='도면 칸 끝에 닿아 더 늘일 수 없습니다. 「모이는 기준」을 바꾸거나 먼저 줄여서 공간을 만들어 주세요.';

    if(fx>1) {
        lim(b.x0, p.x, 0, 'x'); lim(b.x1, p.x, W, 'x'); if(mx<=1.001) {
            toast(full); return;
        }

        fx=Math.min(fx, mx);
    }

    if(fy>1) {
        lim(b.y0, p.y, 0, 'y'); lim(b.y1, p.y, H, 'y'); if(my<=1.001) {
            toast(full); return;
        }

        fy=Math.min(fy, my);
    }

    const r1=v=>Math.round(v*10)/10, S=q=>({
        x:p.x+(q.x-p.x)*fx, y:p.y+(q.y-p.y)*fy
    }); checkpoint();

items.forEach(a=> {
        if(lineTypes.includes(a.type)||a.type==='conveyor') {
            const s0=S(localWorld(a, {
                    x:0, y:0

                })), s1=S(localWorld(a, {
                x:a.dx, y:a.dy
            })); a.x=r1(s0.x); a.y=r1(s0.y); const l=worldLocal(a, s1); a.dx=r1(l.x); a.dy=r1(l.y); return;
}

const c1=S(geometricCenter(a));

if(['room', 'titleBar'].includes(a.type)) {
    const ang=(((a.angle||0)%180)+180)%180; if(ang<1||ang>179) {
        a.w=Math.max(4, r1(a.w*fx)); a.h=Math.max(4, r1(a.h*fy));
