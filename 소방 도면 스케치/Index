}

// 가로만·세로만 (v1.0.50): 위치는 그 방향으로만 벌리고, 벽·선·컨베이어는 늘이며, 방·제목 띠는 그 방향 길이를 바꾸고, 나머지(아이콘·설비·글자)는 크기 그대로 자리만 옮깁니다.
function stretchSelection(fx, fy) {
    const items=selection(); if(items.length<2|| !(fx>0&&fy>0))return; const b=groupBox(items), p=groupPivot(b);

