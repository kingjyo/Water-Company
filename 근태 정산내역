function debugRowRanges() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const lines = [];

  const safe = (fn) => { try { return fn(); } catch (e) { return '❌ ' + e.message; } };

  // 근무계획 원본
  const statusSheetName = findSheetByPattern(ss, /^\d+월 근무현황표$/);
  if (statusSheetName) {
    const month = Number(ss.getSheetByName(statusSheetName).getRange('Z3').getValue());
    const srcSS = SpreadsheetApp.openById(SOURCE_SS_ID);
    const srcSheet = srcSS.getSheetByName(`${month}월`);
    if (srcSheet) {
      const r = safe(() => getSourceLastDataRow_(srcSheet));
      lines.push(`[근무계획 ${month}월] 인원 행: ${SRC_NAME_START_ROW}~${r} ("계" 행: ${typeof r === 'number' ? r + 1 : '?'})`);
      if (typeof r === 'number') {
        const names = srcSheet.getRange(SRC_NAME_START_ROW, 3, r - SRC_NAME_START_ROW + 1, 1).getValues()
          .map(v => String(v[0]).trim()).filter(v => v);
        lines.push(`  → ${names.length}명: ${names.join(', ')}`);
      }
    } else {
      lines.push(`[근무계획 ${month}월] 시트 없음`);
    }
  }

  // 대상 시트들
  const destPatterns = [/^\d+월 근무현황표$/, /^간식정산$/, /^연장야근정산$/, /^차월 근무계획$/];
  for (const p of destPatterns) {
    const name = findSheetByPattern(ss, p);
    if (!name) { lines.push(`[${p}] 시트 없음`); continue; }
    const sheet = ss.getSheetByName(name);
    const r = safe(() => getDestLastDataRow_(sheet));
    let extra = '';
    if (typeof r === 'number') {
      const names = readWorkerNames(sheet, DEST_NAME_START_ROW, r).map(n => n.name);
      extra = ` → ${names.length}명: ${names.join(', ')}`;
    }
    lines.push(`[${name}] 인원 행: ${DEST_NAME_START_ROW}~${r} ("합계" 행: ${typeof r === 'number' ? r + 1 : '?'})${extra}`);
  }

  // X월 근태
  const attendName = findSheetByPattern(ss, /^\d+월 근태$/);
  if (attendName) {
    const sheet = ss.getSheetByName(attendName);
    const r = safe(() => getAttendSumRow(sheet, ATTEND_START_ROW));
    lines.push(`[${attendName}] 데이터 행: ${ATTEND_START_ROW}~${typeof r === 'number' ? r - 1 : '?'} ("계" 행: ${r})`);
  }

  // 인원정보
  const staff = loadStaffInfo_(ss);
  const staffNames = Object.values(staff).map(s =>
    `${s.name}(${s.start ? ymdToText_(s.start) : '-'}~${s.end ? ymdToText_(s.end) : ''}${s.leaveBase ? ', 월차기준 ' + ymdToText_(s.leaveBase) : ''})`);
  lines.push(`[인원정보] ${staffNames.length}명` + (staffNames.length ? ': ' + staffNames.join(', ') : ''));

  SpreadsheetApp.getUi().alert('🔎 행 범위 인식 결과\n\n' + lines.join('\n'));
}

