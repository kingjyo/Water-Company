const SRC_NAME_START_ROW  = 5;  // 근무계획: 이름/데이터 시작 행
const DEST_NAME_START_ROW = 8;  // 근무현황표·간식정산·연장야근정산·차월 근무계획
const ATTEND_START_ROW    = 7;  // X월 근태

const KEY_TOTAL = ['계', '합계']; // 합계 행 인식 키워드 (공백 제거 후 정확히 일치)

/**
 * startRow부터 마지막 행까지 A열(또는 B열)에서 keys 중 하나와 정확히 일치하는 첫 행 번호 반환.
 * 못 찾으면 -1.
 */
function findTotalRow_(sheet, startRow, keys, checkColB) {
  const lastRow = sheet.getLastRow();
  if (lastRow < startRow) return -1;
  const n = lastRow - startRow + 1;
  const colA = sheet.getRange(startRow, 1, n, 1).getValues();
  const colB = checkColB ? sheet.getRange(startRow, 2, n, 1).getValues() : null;
  const keySet = new Set(keys);
  for (let i = 0; i < n; i++) {
    const kA = String(colA[i][0] == null ? '' : colA[i][0]).replace(/\s/g, '');
    if (keySet.has(kA)) return startRow + i;
    if (colB) {
      const kB = String(colB[i][0] == null ? '' : colB[i][0]).replace(/\s/g, '');
      if (keySet.has(kB)) return startRow + i;
    }
  }
  return -1;
}

/** 근무계획 원본(X월 시트): A열 "계" 행 → 그 직전 행 번호 */
function getSourceLastDataRow_(sheet) {
  const totalRow = findTotalRow_(sheet, SRC_NAME_START_ROW, KEY_TOTAL, false);
  if (totalRow < 0) throw new Error(`[${sheet.getName()}] A열에서 "계" 행을 찾을 수 없습니다. (${SRC_NAME_START_ROW}행 이후)`);
  return totalRow - 1;
}

/** 대상 시트(근무현황표 등): A열/B열 "합계" 행 → 그 직전 행 번호 */
function getDestLastDataRow_(sheet, startRow) {
  const s = startRow || DEST_NAME_START_ROW;
  const totalRow = findTotalRow_(sheet, s, KEY_TOTAL, true);
  if (totalRow < 0) throw new Error(`[${sheet.getName()}] A열/B열에서 "합계" 행을 찾을 수 없습니다. (${s}행 이후)`);
  return totalRow - 1;
}

/** X월 근태 / 연장야근정산 등: "계"/"합계" 행 번호 자체를 반환 */
function getAttendSumRow(sheet, startRow) {
  const s = startRow || ATTEND_START_ROW;
  const totalRow = findTotalRow_(sheet, s, KEY_TOTAL, true);
  if (totalRow < 0) throw new Error(`[${sheet.getName()}] A열/B열에서 "계"/"합계" 행을 찾을 수 없습니다. (${s}행 이후)`);
  return totalRow;
}

/** (하위 호환) 예전 호출부용 — nameMaxRow는 무시하고 합계 행 직전을 반환 */
function getDataLastRow(sheet, nameStartRow, _ignoredMaxRow) {
  return getDestLastDataRow_(sheet, nameStartRow);
}

