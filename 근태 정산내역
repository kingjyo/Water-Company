// 🔄 Z3 셀 변경 시 시트 이름 자동 변경
// =====================================================================

function onEdit(e) {
  const range = e.range;
  const sheet = range.getSheet();
  const ss = e.source;

  if (range.getRow() !== 3 || range.getColumn() !== 26) return;
  if (!/^\d+월 근무현황표$/.test(sheet.getName().trim())) return;

  const newMonth = Number(range.getValue());
  if (!newMonth || isNaN(newMonth) || newMonth < 1 || newMonth > 12) {
    ss.toast(`⚠️ Z3 셀 값이 올바르지 않습니다: "${range.getValue()}" (1~12 사이 숫자 입력)`, '근태관리', 5);
    return;
  }

  const targetPatterns = [
    { pattern: /^\d+월 결과보고$/, newName: `${newMonth}월 결과보고` },
    { pattern: /^\d+월 근태$/, newName: `${newMonth}월 근태` },
    { pattern: /^\d+월 근무현황표$/, newName: `${newMonth}월 근무현황표` },
  ];

  const logs = [];
  for (const target of targetPatterns) {
    const found = findSheetByPattern(ss, target.pattern);
    if (!found) { logs.push(`⚠️ 패턴 시트 없음 — 건너뜀`); continue; }
    if (found.trim() === target.newName) { logs.push(`ℹ️ [${found}] 이미 같은 이름`); continue; }
    ss.getSheetByName(found).setName(target.newName);
    logs.push(`✅ "${found}" → "${target.newName}"`);
  }

  ss.toast(`🔄 ${newMonth}월로 시트 이름 변경 완료\n` + logs.join(' / '), '근태관리', 5);
}

// =====================================================================
// 🚀 올인원 원터치 실행
// =====================================================================

function runAllInOne() {
  const ui = SpreadsheetApp.getUi();
  const destSS = SpreadsheetApp.getActiveSpreadsheet();
  const logs = [];

  try {
    const statusSheetName = findSheetByPattern(destSS, /^\d+월 근무현황표$/);
    if (!statusSheetName) throw new Error('"X월 근무현황표" 시트를 찾을 수 없습니다.');
    const statusSheet = destSS.getSheetByName(statusSheetName);
    const currentMonth = Number(statusSheet.getRange('Z3').getValue());
    const currentYear = Number(statusSheet.getRange('X3').getValue());
    validateMonth(currentMonth, statusSheet.getRange('Z3').getValue());
    if (!currentYear || isNaN(currentYear)) throw new Error(`X3 셀의 년도 값이 올바르지 않습니다: "${statusSheet.getRange('X3').getValue()}"`);

    // "차월 근무계획" 시트 자체의 Z3(월)/X3(년도)를 우선 사용. 없으면 당월+1로 자동 계산.
    const nextSheetName = findSheetByPattern(destSS, /^차월 근무계획$/);
    let nextMonth = (currentMonth % 12) + 1;
    let nextYear = nextMonth === 1 ? currentYear + 1 : currentYear;
    if (nextSheetName) {
      const nextPlanSheet = destSS.getSheetByName(nextSheetName);
      const planMonthRaw = Number(nextPlanSheet.getRange('Z3').getValue());
      if (planMonthRaw && !isNaN(planMonthRaw) && planMonthRaw >= 1 && planMonthRaw <= 12) {
        nextMonth = planMonthRaw;
        const planYearRaw = Number(nextPlanSheet.getRange('X3').getValue());
        nextYear = (planYearRaw && !isNaN(planYearRaw))
          ? planYearRaw
          : (nextMonth < currentMonth ? currentYear + 1 : currentYear);
      }
    }

    const currentDays = getLastDayOfMonth(currentYear, currentMonth);
    const nextDays = getLastDayOfMonth(nextYear, nextMonth);

    logs.push(`📅 ${currentYear}년 ${currentMonth}월 (${currentDays}일까지) / 차월: ${nextYear}년 ${nextMonth}월 (${nextDays}일까지)`);

    // ── 사전 점검. 신규 인원 근무기간 등록 (아무것도 쓰기 전에) ──────
    logs.push('[ 사전 점검 ] 신규 인원 근무기간 등록');
    const regCur = ensureNewMembersRegistered_(destSS, currentYear, currentMonth);
    logs.push(...regCur.logs);
    if (!regCur.ok) throw new Error(`${currentMonth}월 신규 인원의 근무 시작일 등록이 취소되어 작업을 멈췄습니다.\n('인원정보' 시트에 직접 입력한 뒤 다시 실행해도 됩니다)`);
    if (nextSheetName) {
      const regNext = ensureNewMembersRegistered_(destSS, nextYear, nextMonth);
      logs.push(...regNext.logs);
      if (!regNext.ok) throw new Error(`${nextMonth}월(차월) 신규 인원의 근무 시작일 등록이 취소되어 작업을 멈췄습니다.\n('인원정보' 시트에 직접 입력한 뒤 다시 실행해도 됩니다)`);
    }
    const staffMap = loadStaffInfo_(destSS);

    // ── 사전 점검. 시트 구조·수식 (행 추가/삭제로 깨진 곳) ─────────
    logs.push('[ 사전 점검 ] 시트 구조·수식');
    const audit = auditStructure_(destSS);
    if (offerDashFormulaFix_(ui, audit)) logs.push(' 🛠️ 근무(AH) 수식에 "-" 제외 처리 추가');
    const auditErrors = audit.issues.filter(x => x.level === 'error');
    const auditWarnCount = audit.issues.filter(x => x.level === 'warn').length;
    const auditInfoCount = audit.issues.filter(x => x.level === 'info').length;
    if (auditErrors.length) {
      const ans = ui.alert('🩺 구조 점검 — 확인 필요',
        formatAudit_(auditErrors, ['error']) + '\n\n그래도 올인원을 계속 진행할까요?', ui.ButtonSet.YES_NO);
      if (ans !== ui.Button.YES) throw new Error('구조 점검에서 문제가 발견되어 중단했습니다.\n메뉴 [🩺 구조·수식 총점검]으로 자세히 확인하세요.');
      logs.push(` ⚠️ 꼭 확인 ${auditErrors.length}건 있었으나 계속 진행`);
    } else {
      logs.push(' ✅ 꼭 확인할 문제 없음');
    }

    // ── STEP 0. X월 결과보고 전월값 이전 (D28→D25, D29→D26) ─────────
    logs.push('[ STEP 0 ] X월 결과보고 전월값 이전');
    const resultSheetName = findSheetByPattern(destSS, /^\d+월 결과보고$/);
    if (!resultSheetName) {
      logs.push(' ⚠️ "X월 결과보고" 시트 없음 — 건너뜀');
    } else {
      const resultSheet = destSS.getSheetByName(resultSheetName);
      const valD28 = resultSheet.getRange('D28').getValue();
      const valD29 = resultSheet.getRange('D29').getValue();
      resultSheet.getRange('D25').setValue(valD28);
      resultSheet.getRange('D26').setValue(valD29);
      SpreadsheetApp.flush();
      logs.push(` ✅ [${resultSheetName}] D28(${valD28}) → D25, D29(${valD29}) → D26 완료`);
    }

    // ── STEP 1. 당월 근무계획 가져오기 ──────────────────────────────
    logs.push('[ STEP 1 ] 당월 근무계획 가져오기');
    const srcCurrent = loadSourceData(currentMonth);
    const currentTargets = [
      { sheetName: statusSheetName },
      { sheetName: findSheetByPattern(destSS, /^간식정산$/) },
      { sheetName: findSheetByPattern(destSS, /^연장야근정산$/) },
    ];
    for (const target of currentTargets) {
      if (!target.sheetName) { logs.push(' ⚠️ 시트 없음 — 건너뜀'); continue; }
      const sheet = destSS.getSheetByName(target.sheetName);
      const { updated, skipped, log, lastDataRow } = writeToSheet({
        sheet,
        srcNameMap: srcCurrent.srcNameMap,
        srcDateMap: srcCurrent.srcDateMap,
        srcDataGrid: srcCurrent.srcDataGrid,
        srcBgGrid: srcCurrent.srcBgGrid,
        year: currentYear,
        month: currentMonth,
        staffMap,
      });
      logs.push(` ✅ [${target.sheetName}] ${updated}개 입력 (${DEST_NAME_START_ROW}~${lastDataRow}행)` + (skipped > 0 ? ` / ${skipped}명 미매칭` : ''));
      logs.push(...log);
      applyColumnVisibility(sheet, currentDays);
      logs.push(` 📐 [${target.sheetName}] ${currentDays}일 이후 열 숨김 처리`);
    }

    // ── STEP 2. 차월 근무계획 가져오기 ──────────────────────────────
    logs.push('[ STEP 2 ] 차월 근무계획 가져오기');
    if (!nextSheetName) {
      logs.push(' ⚠️ "차월 근무계획" 시트 없음 — 건너뜀');
    } else {
      const srcNext = loadSourceData(nextMonth);
      const { updated, skipped, log, lastDataRow } = writeToSheet({
        sheet: destSS.getSheetByName(nextSheetName),
        srcNameMap: srcNext.srcNameMap,
        srcDateMap: srcNext.srcDateMap,
        srcDataGrid: srcNext.srcDataGrid,
        srcBgGrid: srcNext.srcBgGrid,
        year: nextYear,
        month: nextMonth,
        staffMap,
      });
      logs.push(` ✅ [${nextSheetName}] ${updated}개 입력 (${DEST_NAME_START_ROW}~${lastDataRow}행)` + (skipped > 0 ? ` / ${skipped}명 미매칭` : ''));
      logs.push(...log);
      applyColumnVisibility(destSS.getSheetByName(nextSheetName), nextDays);
      logs.push(` 📐 [${nextSheetName}] ${nextDays}일 이후 열 숨김 처리`);
    }

    // ── STEP 3. 특수문자 외 → 1: 근무현황표(당월) + 차월 근무계획 ──
    logs.push('[ STEP 3 ] 특수문자 외 → 1');
    const step3Targets = [
      { sheetName: statusSheetName, days: currentDays },
      { sheetName: nextSheetName, days: nextDays },
    ];
    for (const t of step3Targets) {
      if (!t.sheetName) { logs.push(' ⚠️ 시트 없음 — 건너뜀'); continue; }
      const sheet = destSS.getSheetByName(t.sheetName);
      if (!sheet) { logs.push(` ⚠️ [${t.sheetName}] 시트 없음 — 건너뜀`); continue; }
      const endCol = colIndexToLetter(2 + t.days);
      const lastRow = getDestLastDataRow_(sheet);
      processFillOne(sheet.getRange(`C${DEST_NAME_START_ROW}:${endCol}${lastRow}`), SPECIAL_CODES, true);
      logs.push(` ✅ [${t.sheetName}] C${DEST_NAME_START_ROW}:${endCol}${lastRow} 완료 (${t.days}일, "-" 유지)`);
    }

    // ── STEP 4. 특수 외 → 1 (당월 일수 기준): 간식정산 ─────────────
    logs.push('[ STEP 4 ] 특수 외 → 1 — 간식정산');
    const snackSheetName = findSheetByPattern(destSS, /^간식정산$/);
    if (!snackSheetName) {
      logs.push(' ⚠️ "간식정산" 시트 없음 — 건너뜀');
    } else {
      const endCol = colIndexToLetter(2 + currentDays);
      const snackSheet = destSS.getSheetByName(snackSheetName);
      const lastRow = getDestLastDataRow_(snackSheet);
      processFillOne(snackSheet.getRange(`C${DEST_NAME_START_ROW}:${endCol}${lastRow}`), SPECIAL_CODES, true);
      logs.push(` ✅ [${snackSheetName}] C${DEST_NAME_START_ROW}:${endCol}${lastRow} 완료 (${currentDays}일)`);
    }

    // ── STEP 5. PBL→연 & 연/야 외 지우기 (당월 일수 기준): 연장야근정산
    logs.push('[ STEP 5 ] PBL→연 & 연/야 외 지우기 — 연장야근정산');
    const overtimeSheetName = findSheetByPattern(destSS, /^연장야근정산$/);
    if (!overtimeSheetName) {
      logs.push(' ⚠️ "연장야근정산" 시트 없음 — 건너뜀');
    } else {
      const overtimeSheet = destSS.getSheetByName(overtimeSheetName);
      const nightText = processPBLtoYeonAndClear(overtimeSheet, currentDays);
      const endCol = colIndexToLetter(2 + currentDays);
      const lastRow = getDestLastDataRow_(overtimeSheet);
      logs.push(` ✅ [${overtimeSheetName}] C${DEST_NAME_START_ROW}:${endCol}${lastRow} 완료 / 야간 문구: ${nightText}`);
    }

    // ── STEP 6. 누계처리: X월 근태 ──────────────────────────────────
    logs.push('[ STEP 6 ] 누계처리 (K→L, M→N, O→P) — X월 근태');
    const attendSheetName = findSheetByPattern(destSS, new RegExp(`^${currentMonth}월 근태$`));
    if (!attendSheetName) {
      logs.push(` ⚠️ "${currentMonth}월 근태" 시트 없음 — 건너뜀`);
    } else {
      const { updatedCount, skippedCount, endRow } = processAccumulate(destSS.getSheetByName(attendSheetName));
      logs.push(` ✅ [${attendSheetName}] ${updatedCount}개 업데이트 / ${skippedCount}개 건너뜀 (${ATTEND_START_ROW}~${endRow}행)`);
    }

    // ── STEP 7. 1년 미만 월차 점검 (휴무 소진내역보다 먼저: F열이 맞아야 부여일수가 맞음)
    logs.push('[ STEP 7 ] 1년 미만 월차 점검 — 근태 F열(년차)');
    logs.push(...checkMonthlyLeave_(destSS, currentYear, currentMonth, true));

    // ── STEP 8. 휴무 소진내역 업데이트 (연차 부여 포함) ─────────────
    logs.push('[ STEP 8 ] 휴무 소진내역 업데이트');
    const leaveSheetName = findSheetByPattern(destSS, /^휴무 소진내역$/);
    if (!leaveSheetName) {
      logs.push(' ⚠️ "휴무 소진내역" 시트 없음 — 건너뜀');
    } else if (!attendSheetName) {
      logs.push(` ⚠️ "${currentMonth}월 근태" 시트 없음 — 건너뜀`);
    } else {
      const r = writeLeaveHistory_(destSS, currentMonth);
      logs.push(` ✅ [${leaveSheetName}] ${currentMonth}월 ${r.row}행 업데이트 완료 (근태 합계행: ${r.sumRow}행)`);
      logs.push(`   연차 부여: 당월 ${fmtOld_(r.oldMonth)} → ${r.monthGrant} / 누계 ${fmtOld_(r.oldCum)} → ${r.totalGrant}` +
        ` (근태 F합계 ${r.totalGrant} − 전월 누계 실시 ${r.prevCumUsed})`);
    }

    logs.push(`[ 참고 ] 🩺 구조 점검: 확인 권장 ${auditWarnCount}건 / 참고 ${auditInfoCount}건 — 메뉴 [🩺 구조·수식 총점검]에서 확인`);

    ui.alert(
      `🚀 올인원 원터치 실행 완료 (${currentYear}년 ${currentMonth}월)\n\n` +
      logs.join('\n')
    );

  } catch (e) {
    ui.alert('❌ 오류 발생\n\n' + e.message + '\n\n--- 진행 로그 ---\n' + logs.join('\n'));
    console.error(e);
  }
}

