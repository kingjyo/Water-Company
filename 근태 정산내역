/**
 * 휴무 소진내역에 당월 값 기록 (올인원 STEP 8 / 메뉴 공용)
 *  • D~H(1~6월) / R~V(7~12월): 공휴부여, 주휴부여, 연차실시, 공휴실시, 주휴실시  ← 근태 합계행 M, O, K, M, O
 *  • C / Q (연차 부여): 당월 = 근태 F합계 − 전월 누계 연차 실시,  누계 = 근태 F합계
 *    → 1년 미만 월차가 생기거나 근속 1년이 돼 연차가 늘어나면 자동 반영 (예전엔 손으로 +1 하던 부분)
 */
function writeLeaveHistory_(destSS, currentMonth) {
  const attendSheetName = findSheetByPattern(destSS, new RegExp(`^${currentMonth}월 근태$`));
  if (!attendSheetName) throw new Error(`"${currentMonth}월 근태" 시트를 찾을 수 없습니다.`);
  const attendSheet = destSS.getSheetByName(attendSheetName);
  const leaveSheetName = findSheetByPattern(destSS, /^휴무 소진내역$/);
  if (!leaveSheetName) throw new Error('"휴무 소진내역" 시트를 찾을 수 없습니다.');
  const leaveSheet = destSS.getSheetByName(leaveSheetName);

  const sumRow = getAttendSumRow(attendSheet, ATTEND_START_ROW);
  const valK = attendSheet.getRange(sumRow, 11).getValue();   // 연차 실시
  const valM = attendSheet.getRange(sumRow, 13).getValue();   // 공휴
  const valO = attendSheet.getRange(sumRow, 15).getValue();   // 주휴
  const valF = attendSheet.getRange(sumRow, ATTEND_COL_ANNUAL).getValue(); // 연차 총 부여(F합계)

  const { row, dataStartCol } = getLeaveHistoryTarget(currentMonth);
  [valM, valO, valK, valM, valO].forEach((v, i) => {
    leaveSheet.getRange(row, dataStartCol + i).setValue(v);
  });

  // 연차 부여
  const grantCol = dataStartCol - 1;                   // C(3) 또는 Q(17)
  let prevCumUsed = 0;
  if (currentMonth > 1) {
    const p = getLeaveHistoryTarget(currentMonth - 1);
    prevCumUsed = Number(leaveSheet.getRange(p.row + 1, p.dataStartCol + 2).getValue()) || 0; // 전월 누계행 F/T
  }
  const totalGrant = Number(valF) || 0;
  const monthGrant = totalGrant - prevCumUsed;
  const grantCell = leaveSheet.getRange(row, grantCol);
  const cumCell = leaveSheet.getRange(row + 1, grantCol);
  const oldMonth = grantCell.getFormula() || grantCell.getValue();
  const oldCum = cumCell.getFormula() || cumCell.getValue();
  grantCell.setValue(monthGrant);
  cumCell.setValue(totalGrant);

  SpreadsheetApp.flush();
  return { row, sumRow, valK, valM, valO, totalGrant, monthGrant, prevCumUsed, oldMonth, oldCum };
}

function fmtOld_(v) {
  return (v === '' || v == null) ? '빈칸' : String(v);
}

