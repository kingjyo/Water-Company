// 공휴일 표 생성 (고정 공휴일 + Google 휴일 캘린더 + 수동 보정)
// ═════════════════════════════════════════════════════════════════════════

/**
 * 반환: { map: { 'M-D': { name, substitute } }, source: 문자열, calendarOk: bool }
 *  - substitute: true 면 "대체공휴일" 일정
 */
function getHolidayMap_(year) {
  const map = {};
  Object.keys(FIXED_HOLIDAYS).forEach(k => { map[k] = { name: FIXED_HOLIDAYS[k], substitute: false }; });

  let calendarOk = false;
  let calendarCount = 0;
  try {
    const cal = CalendarApp.getCalendarById(HOLIDAY_CALENDAR_ID);
    if (cal) {
      const events = cal.getEvents(new Date(year, 0, 1), new Date(year + 1, 0, 1));
      events.forEach(ev => {
        const title = String(ev.getTitle() || '').trim();
        if (!HOLIDAY_CALENDAR_KEYWORDS.some(k => title.indexOf(k) !== -1)) return;
        const isSub = title.indexOf('대체') !== -1;
        const allDay = ev.isAllDayEvent();
        const start = allDay ? ev.getAllDayStartDate() : ev.getStartTime();
        const end = allDay ? ev.getAllDayEndDate() : ev.getEndTime();   // 종료일은 미포함
        for (let cur = new Date(start.getFullYear(), start.getMonth(), start.getDate()); cur < end; cur.setDate(cur.getDate() + 1)) {
          if (cur.getFullYear() !== year) continue;
          const key = (cur.getMonth() + 1) + '-' + cur.getDate();
          if (!map[key] || isSub) map[key] = { name: title, substitute: isSub };
          calendarCount++;
        }
      });
      calendarOk = true;
    }
  } catch (e) {
    Logger.log('휴일 캘린더 읽기 실패: ' + e.message);
  }

  // 수동 보정
  Object.keys(HOLIDAY_OVERRIDES).forEach(k => {
    const m = k.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
    if (!m || Number(m[1]) !== year) return;
    const key = Number(m[2]) + '-' + Number(m[3]);
    const v = HOLIDAY_OVERRIDES[k];
    if (v === null) delete map[key];
    else map[key] = { name: String(v), substitute: String(v).indexOf('대체') !== -1 };
  });

  const source = calendarOk
    ? '고정 공휴일 표 + Google 휴일 캘린더(' + calendarCount + '일) + 수동 보정'
    : '고정 공휴일 표 + 수동 보정 (⚠️ 휴일 캘린더를 읽지 못함 — 설날·추석·대체공휴일 누락 가능)';
  return { map: map, source: source, calendarOk: calendarOk };
}

/**
 * 주말에 걸린 공휴일인데 바로 뒤(1~3일 내)에 대체공휴일이 있으면 true
 * → 그 날은 빨강 처리하지 않고 주말색만 (대체일이 빨강)
 */
function hasSubstituteAfter_(holidayMap, year, month, day) {
  for (let i = 1; i <= 3; i++) {
    const d = new Date(year, month - 1, day + i);
    const info = holidayMap[(d.getMonth() + 1) + '-' + d.getDate()];
    if (info && info.substitute) return true;
  }
  return false;
}

/** 해당 날짜를 빨강(공휴일)으로 칠할지 + 표시 이름 */
function resolveHoliday_(holidayMap, year, month, day) {
  const info = holidayMap[month + '-' + day];
  if (!info) return null;
  const dow = new Date(year, month - 1, day).getDay();
  const isWeekend = (dow === 0 || dow === 6);
  if (isWeekend && !info.substitute && hasSubstituteAfter_(holidayMap, year, month, day)) return null;
  return info;
}

function debugHolidays() {
  const ui = SpreadsheetApp.getUi();
  const year = LEAVE_CHECK_CONFIG.year;
  const h = getHolidayMap_(year);
  const weekdayNames = ['일', '월', '화', '수', '목', '금', '토'];
  const keys = Object.keys(h.map).sort((a, b) => {
    const [am, ad] = a.split('-').map(Number), [bm, bd] = b.split('-').map(Number);
    return (am - bm) || (ad - bd);
  });
  const lines = keys.map(k => {
    const [m, d] = k.split('-').map(Number);
    const dow = weekdayNames[new Date(year, m - 1, d).getDay()];
    const red = resolveHoliday_(h.map, year, m, d);
    return (m < 10 ? ' ' : '') + m + '/' + (d < 10 ? ' ' : '') + d + ' (' + dow + ') ' + h.map[k].name +
      (red ? '' : '  → 대체일 있음, 주말색 유지');
  });
  let msg = '📅 ' + year + '년 공휴일 (' + keys.length + '일)\n출처: ' + h.source + '\n\n' + lines.join('\n');
  if (!h.calendarOk) {
    msg += '\n\n⚠️ Google 캘린더에서 "대한민국의 휴일"을 구독(다른 캘린더 추가 → 관심분야 → 대한민국의 휴일)하면 설날·추석이 자동 반영됩니다. ' +
      '그 전에는 HOLIDAY_OVERRIDES에 직접 넣어 주세요.';
  }
  ui.alert(msg);
}


