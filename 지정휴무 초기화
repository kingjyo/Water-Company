/** 등록 창 초기 데이터 (google.script.run 에서 호출) */
function ltChangeFormData() {
  const ss = ltBook_();
  const cur = getSourceSheet_();
  const blocks = getMonthBlocks_(cur);
  const names = [];
  blocks.forEach(b => b.names.forEach(n => { if (names.indexOf(n) < 0) names.push(n); }));
  const positions = {};
  const log = ss.getSheetByName(LEAVE_CHECK_CONFIG.changeSheetName);
  if (log) {
    try { ltReadLedger_(log).forEach(e => { if (e.position) positions[e.name] = e.position; }); } catch (e) { /* 무시 */ }
  }
  return {
    names: names.map(n => ({ name: n, position: positions[n] || '' })),
    today: Utilities.formatDate(new Date(), LT_TZ, 'yyyy-MM-dd'),
    year: LEAVE_CHECK_CONFIG.year
  };
}

/** 등록 처리 (google.script.run 에서 호출) */
function ltSubmitChange(form) {
  const lock = LockService.getDocumentLock();
  if (!lock.tryLock(15000)) throw new Error('다른 작업이 진행 중입니다. 잠시 후 다시 시도하세요.');
  try {
    const ss = ltBook_();
    const year = LEAVE_CHECK_CONFIG.year;
    const name = String(form.name || '').trim();
    if (!name) throw new Error('성명을 선택하세요.');
    const parse = (v, label) => {
      if (!v) return null;
      const d = ltParseDate_(v, '', year);
      if (d.error) throw new Error(label + ': ' + d.error);
      if (d.y !== year) throw new Error(label + ' 날짜는 ' + year + '년이어야 합니다.');
      return d;
    };
    const from = parse(form.from, '변경 전');
    const to = parse(form.to, '변경 후');
    const req = parse(form.requested, '통보일') || ltToday_();
    if (!from && !to) throw new Error('변경 전·후 날짜 중 하나는 입력하세요.');
    const kind = String(form.kind || '연차');
    const half = /반/.test(kind);
    if (from && to && from.key === to.key && !half) {
      throw new Error('변경 전·후 날짜가 같으면 반차(오전/오후)로 선택하세요. (연차 1을 반차로 쪼개 반쪽을 그 날짜에 남기는 경우)');
    }
    const reqLabel = req.m + '/' + req.d;

    // 1) 현재 시트 반영 (검증 먼저, 실패 시 아무것도 안 씀)
    let applied = '';
    if (form.apply) applied = ltApplyToCurrent_(name, from, to, half, reqLabel);

    // 2) 변경 정보 시트에 한 줄 추가
    const row = ltAppendLedgerRow_(ss, {
      name: name, position: String(form.position || '').trim(), requested: req,
      from: from, to: to, note: [half ? kind : '', String(form.note || '').trim()].filter(Boolean).join(' / ')
    });

    // 3) 추적 현황 갱신
    let refresh = '';
    try {
      const res = ltRefreshTracking_(ss);
      refresh = '\n추적 현황: 불일치 ' + res.counts.diff + '칸, 이력 점검 ' + res.counts.log + '건';
    } catch (e) {
      refresh = '\n(추적 현황 갱신 실패: ' + e.message + ')';
    }
    return '✅ 등록 완료 — 변경 정보 ' + row + '행\n' +
      name + ' ' + (from ? ltFmt_(from.key) : '(추가)') + ' → ' + (to ? ltFmt_(to.key) : '취소') + ' [' + kind + ']' +
      (applied ? '\n' + applied : '\n(현재 미사용연차 시트는 바꾸지 않음)') + refresh;
  } finally {
    lock.releaseLock();
  }
}

/** '현재 미사용연차'에서 연차 칸 이동 (검증 후 기록) */
function ltApplyToCurrent_(name, from, to, half, reqLabel) {
  const cfg = LEAVE_CHECK_CONFIG;
  const sheet = getSourceSheet_();
  const blocks = getMonthBlocks_(sheet);
  const dateRow = findDateHeaderRow_(sheet, blocks);
  const startCol = columnLetterToIndex(cfg.dayColStart);
  const dayMap = leaveDayMap_(sheet.getRange(dateRow, startCol, 1, dayColCount_()).getDisplayValues()[0], 31);
  const key = leaveName_(name);

  const locate = dt => {
    const b = getMonthBlock_(blocks, dt.m);
    if (!b) throw new Error(cfg.sourceSheetName + '에 ' + dt.m + '월 블록이 없습니다.');
    if (dt.d > new Date(cfg.year, dt.m, 0).getDate()) throw new Error(ltFmt_(dt.key) + ' 날짜가 잘못되었습니다.');
    const idx = b.names.map((n, i) => leaveName_(n) === key ? i : -1).filter(i => i >= 0);
    if (!idx.length) throw new Error(dt.m + '월 블록에 ' + name + ' 행이 없습니다.');
    if (idx.length > 1) throw new Error(dt.m + '월 블록에 ' + name + ' 행이 2개 이상입니다.');
    const row = b.rows[idx[0]];
    const col = startCol + dayMap[dt.d];
    const cell = sheet.getRange(row, col);
    if (cell.isPartOfMerge()) throw new Error(ltFmt_(dt.key) + '은(는) 공휴일 칸(병합 셀)이라 연차를 넣거나 뺄 수 없습니다.');
    const value = cell.getDisplayValue();
    const amount = ltAmount_(value);
    if (amount === null) throw new Error(cell.getA1Notation() + ' 칸에 년·반이 같이 있습니다. 먼저 정리하세요.');
    return { cell: cell, value: value, amount: amount, a1: cell.getA1Notation(),
      headerBg: sheet.getRange(b.headerRow, col).getBackground() };
  };

  if (from && to && from.key === to.key) {
    const same = locate(from);
    if (same.amount < 0.5 - 1e-9) throw new Error(ltFmt_(from.key) + '(' + same.a1 + ')에 연차가 없어 반차로 남길 수 없습니다.');
    ltAddNote_(same.cell, '◐ 반차로 나눔 — 이 날짜에 반차 유지 (' + reqLabel + ' 통보)');
    return '현재 미사용연차 반영: ' + same.a1 + ' "' + same.value + '" 그대로 (반차 유지 메모만 추가 — 나머지 반쪽은 다른 날짜로 옮기는 행을 등록하면 "반"이 됩니다)';
  }
  const src = from ? locate(from) : null;
  const dst = to ? locate(to) : null;
  const amount = half ? 0.5 : (src && src.amount > 0 ? src.amount : 1);
  if (src && src.amount + 1e-9 < amount) {
    throw new Error('변경 전 날짜 ' + ltFmt_(from.key) + '(' + src.a1 + ')에 옮길 연차가 없습니다. 현재 값: ' + (src.value || '빈칸') +
      '\n→ 이미 옮겼거나 날짜가 틀렸는지 확인하세요. 시트는 그대로 두고 이력만 남기려면 "현재 시트에도 반영" 체크를 끄세요.');
  }
  if (dst && dst.amount + amount > 1 + 1e-9) {
    throw new Error('변경 후 날짜 ' + ltFmt_(to.key) + '(' + dst.a1 + ')에 이미 "' + dst.value + '"가 있어 넣을 수 없습니다.');
  }
  const msgs = [];
  if (src) {
    const left = src.amount - amount;
    src.cell.setValue(ltValueOf_(left));
    if (left < 1e-9) src.cell.setBackground(src.headerBg);
    ltAddNote_(src.cell, '↪ ' + (to ? ltFmt_(to.key) + '(으)로 변경' : '연차 취소') + ' (' + reqLabel + ' 통보)');
    msgs.push(src.a1 + ': "' + (src.value || '') + '" → "' + ltValueOf_(left) + '"');
  }
  if (dst) {
    const nv = ltValueOf_(dst.amount + amount);
    dst.cell.setValue(nv).setBackground(LT_CHANGED_COLOR);
    ltAddNote_(dst.cell, '↩ ' + (from ? ltFmt_(from.key) + '에서 변경' : '연차 추가') + ' (' + reqLabel + ' 통보)');
    msgs.push(dst.a1 + ': "' + (dst.value || '') + '" → "' + nv + '"');
  }
  return '현재 미사용연차 반영: ' + msgs.join(', ');
}

function ltAddNote_(cell, line) {
  const old = cell.getNote();
  cell.setNote(old ? old + '\n' + line : line);
}

function ltAppendLedgerRow_(ss, rec) {
  const C = CHANGE_LOG_CONFIG;
  const sh = ss.getSheetByName(LEAVE_CHECK_CONFIG.changeSheetName);
  if (!sh) throw new Error('"' + LEAVE_CHECK_CONFIG.changeSheetName + '" 시트가 없습니다.');
  const last = Math.max(sh.getLastRow(), C.headerRow);
  const names = sh.getRange(1, C.col.name, last, 1).getDisplayValues();
  let lastData = C.headerRow;
  for (let r = names.length - 1; r >= C.firstDataRow - 1; r--) {
    if (String(names[r][0]).trim()) { lastData = r + 1; break; }
  }
  const row = lastData + 1;
  if (row > sh.getMaxRows()) sh.insertRowsAfter(sh.getMaxRows(), 10);
  const D = dt => dt ? new Date(dt.y, dt.m - 1, dt.d) : '';
  const rng = sh.getRange(row, C.col.name, 1, C.col.used - C.col.name + 1);
  rng.setValues([[rec.name, rec.position, D(rec.requested), D(rec.from), D(rec.to), rec.note, '']]);
  rng.setHorizontalAlignment('center').setVerticalAlignment('middle')
    .setBorder(true, true, true, true, true, true);
  sh.getRange(row, C.col.requested).setNumberFormat('m"월" d"일"');
  sh.getRange(row, C.col.from, 1, 2).setNumberFormat('yyyy-mm-dd');
  return row;
}

