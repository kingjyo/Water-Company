    '<p style="color:#999;font-size:11px">지정휴무 스프레드시트 자동 알림 (' + LEAVE_CHECK_CONFIG.sourceSheetName + ' ↔ 근무계획)</p></div>';
}

function ltLogAlerts_(r, sent) {
  const ss = ltBook_();
  const name = LEAVE_CHECK_CONFIG.alertLogSheetName;
  let sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    sh.getRange(1, 1, 1, 9).setValues([['실행 시각', '구분', '성명', '일자', '남은 날', '지정휴무', '근무계획', '내용', '메일 수신']])
      .setBackground('#17365d').setFontColor('#ffffff').setFontWeight('bold');
    sh.setFrozenRows(1);
    [130, 60, 70, 80, 60, 70, 150, 360, 260].forEach((w, i) => sh.setColumnWidth(i + 1, w));
  }
  const ts = Utilities.formatDate(new Date(), LT_TZ, 'yyyy-MM-dd HH:mm');
  const rows = [];
  r.items.forEach(x => rows.push([ts, '경고', x.name, ltFmt_(x.key), ltDday_(x.off), x.value, (x.planValue || '빈칸') + (x.planCell ? ' (' + x.planCell + ')' : ''), x.status, sent.join(', ')]));
  r.infos.forEach(x => rows.push([ts, '참고', x.name, ltFmt_(x.key), ltDday_(x.off), '', (x.planValue || '') + (x.planCell ? ' (' + x.planCell + ')' : ''), x.status, sent.join(', ')]));
  if (!rows.length) rows.push([ts, '이상 없음', '', '', '', '', '', '근무계획 미반영 연차 없음', '']);
  sh.getRange(sh.getLastRow() + 1, 1, rows.length, 9).setValues(rows);
}

function enableDailyLeaveAlert() {
  const ui = SpreadsheetApp.getUi();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
