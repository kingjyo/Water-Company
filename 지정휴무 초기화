  try {
    const sheet = getSourceSheet_();
    const blocks = getMonthBlocks_(sheet);
    const year = LEAVE_CHECK_CONFIG.year;
    const weekdayNames = ['일', '월', '화', '수', '목', '금', '토'];
    const SAT_COLOR = '#c6d9f0';
    const SUN_COLOR = '#e5b8b7';
    const NA_COLOR = '#7f7f7f';
    const WHITE = '#ffffff';

    const startColIndex = columnLetterToIndex(LEAVE_CHECK_CONFIG.dayColStart);
    const endColIndex = columnLetterToIndex(LEAVE_CHECK_CONFIG.dayColEnd);

    const holidays = getHolidayMap_(year);
    const usedHolidays = [];

    blocks.forEach(b => {
      const headerRow = b.headerRow;
      const nRows = b.dataCount;                    // 인원 행 수 (6, 7, …)
      const daysInMonth = new Date(year, b.month, 0).getDate();

      // 헤더 + 인원 행 전체 병합 해제 (이전 공휴일 병합 제거)
      sheet.getRange(headerRow, startColIndex, nRows + 1, endColIndex - startColIndex + 1).breakApart();

      for (let colIndex = startColIndex; colIndex <= endColIndex; colIndex++) {
        const day = colIndex - startColIndex + 1;
        const headerCell = sheet.getRange(headerRow, colIndex);
        const belowRange = sheet.getRange(headerRow + 1, colIndex, nRows, 1);

        // 그 달에 없는 날짜(29·30·31) → 회색
        if (day > daysInMonth) {
          headerCell.setBackground(NA_COLOR).setValue('');
          belowRange.setBackground(NA_COLOR);
          continue;
        }

        const date = new Date(year, b.month - 1, day);
        const dayOfWeek = date.getDay();
        const info = resolveHoliday_(holidays.map, year, b.month, day);
        const isRedHoliday = !!info;

        let color;
        if (isRedHoliday || dayOfWeek === 0) color = SUN_COLOR;
        else if (dayOfWeek === 6) color = SAT_COLOR;
        else color = WHITE;

        headerCell.setValue(weekdayNames[dayOfWeek]).setBackground(color);
        belowRange.setBackground(color);

        if (isRedHoliday) {
          belowRange.merge();
          belowRange.setValue(info.name)
            .setHorizontalAlignment('center')
            .setVerticalAlignment('middle');
          usedHolidays.push(b.month + '/' + day + ' ' + info.name);
        }
      }
    });

    let msg = '요일, 주말, 공휴일 색상 설정이 완료되었습니다.\n\n' +
      blocks.map(b => b.month + '월: 헤더 ' + b.headerRow + '행 / 인원 ' + b.dataStartRow + '~' + b.dataEndRow + '행 (' + b.dataCount + '명)').join('\n') +
      '\n\n공휴일 출처: ' + holidays.source +
      '\n반영된 공휴일: ' + (usedHolidays.length ? usedHolidays.join(', ') : '없음');
    if (!holidays.calendarOk) {
      msg += '\n\n⚠️ Google 캘린더에서 "대한민국의 휴일"을 구독하면 설날·추석·대체공휴일이 자동 반영됩니다. ' +
        '"📅 올해 공휴일 확인" 메뉴로 먼저 점검하세요.';
    }
    ui.alert(msg);
  } catch (e) {
    ui.alert('❌ 오류\n\n' + e.message);
  }
}


