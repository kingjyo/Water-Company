function refreshLeaveTracking() {
  const ui = SpreadsheetApp.getUi();
  try {
    const ss = ltBook_();
    const res = ltRefreshTracking_(ss);
    const c = res.counts;
    ss.setActiveSheet(ss.getSheetByName(LEAVE_CHECK_CONFIG.trackingSheetName));
    ui.alert('🔄 추적 현황 갱신 완료\n\n' +
      '변경 이력: ' + res.entries.length + '건\n' +
      '원본+이력 ↔ 현재 불일치: ' + c.diff + '칸' + (c.guess ? ' (미등록 변경 추정 ' + c.guess + '건)' : '') + '\n' +
      '이력 자체 점검: ' + c.log + '건\n' +
      '수식·표 점검: ' + c.formula + '건\n' +
      '주의(주말·공휴일·취소): ' + c.warn + '건\n\n' +
      res.people.map(p => p.name + ' — ' + p.status).join('\n'));
  } catch (e) {
    ui.alert('❌ 오류\n\n' + e.message);
  }
}

/** 분석 + 보고 시트 작성 + 이력 H/I열 갱신 (UI 없음, 트리거에서도 사용) */
function ltRefreshTracking_(ss) {
  const holidays = getHolidayMap_(LEAVE_CHECK_CONFIG.year);
  const res = ltAnalyze_(ss, ltToday_(), holidays.map);
  ltWriteTrackingSheet_(ss, res);
  ltWriteLedgerStatus_(ss, res);
  return res;
}

function ltWriteLedgerStatus_(ss, res) {
  const C = CHANGE_LOG_CONFIG;
  const sh = ss.getSheetByName(LEAVE_CHECK_CONFIG.changeSheetName);
  if (!sh || !res.entries.length) return;
  if (C.autoCheckColumn) {
    const head = sh.getRange(C.headerRow, C.col.check);
    if (!head.getDisplayValue()) {
      sh.getRange(C.headerRow, C.col.used).copyTo(head, SpreadsheetApp.CopyPasteType.PASTE_FORMAT, false);
      head.setValue('자동 점검');
      sh.setColumnWidth(C.col.check, 360);
    }
  }
  res.entries.forEach((e, i) => {
    if (C.autoFillUsed) {
      const st = res.usedStatus[i];
      if (st) sh.getRange(e.sheetRow, C.col.used).setValue(st)
        .setFontColor(st === '예' ? '#7f7f7f' : st === '재변경' ? '#2f5597' : st === '취소' ? '#c00000' : '#000000');
    }
    if (C.autoCheckColumn) {
      const msgs = e.errors.map(m => '❌ ' + m).concat(e.warnings.map(m => '⚠️ ' + m));
      const cell = sh.getRange(e.sheetRow, C.col.check);
      cell.setValue(msgs.length ? msgs.join('\n') : '✓')
        .setBackground(e.errors.length ? '#fce4d6' : e.warnings.length ? '#fff2cc' : '#e2f0d9')
        .setWrap(true).setHorizontalAlignment('left').setVerticalAlignment('middle').setFontSize(9)
        .setBorder(true, true, true, true, false, false);
    }
  });
}

function ltWriteTrackingSheet_(ss, res) {
  const cfg = LEAVE_CHECK_CONFIG;
  const W = 10;
  const marker = 'LEAVE_TRACKING_REPORT_V1';
  let sheet = ss.getSheetByName(cfg.trackingSheetName);
  if (sheet && sheet.getLastRow() > 0 && sheet.getRange('A1').getNote() !== marker) {
    throw new Error('"' + cfg.trackingSheetName + '" 이름의 기존 시트에 다른 데이터가 있습니다. 시트 이름을 바꾼 뒤 다시 실행하세요.');
  }
  if (!sheet) sheet = ss.insertSheet(cfg.trackingSheetName);

  const values = [], bgs = [], bolds = [], colors = [], merges = [];
  const push = (row, bg, bold, color, merge) => {
    const r = row.concat(Array(W - row.length).fill('')).slice(0, W);
    values.push(r);
    bgs.push(Array(W).fill(bg || '#ffffff'));
    bolds.push(Array(W).fill(bold ? 'bold' : 'normal'));
    colors.push(Array(W).fill(color || '#000000'));
    if (merge) merges.push(values.length);
  };
  const tz = LT_TZ;
  const t = res.today;
  push([cfg.year + '년 지정휴무 추적 현황'], '#17365d', true, '#ffffff', true);
  push(['갱신: ' + Utilities.formatDate(new Date(), tz, 'yyyy-MM-dd HH:mm') + '  |  기준일 ' + ltFmt_(t.key) +
    '  |  \'' + cfg.originalSheetName + '\' + 변경 이력 ' + res.entries.length + '건  ↔  \'' + cfg.sourceSheetName + '\''], '#ffffff', false, '#595959', true);
  push(['원본(7월 신청)에 변경 이력을 위에서부터 순서대로 적용한 결과가 현재 시트와 같은지 비교합니다. 다르면 이력 누락 또는 시트 반영 누락입니다.'], '#ffffff', false, '#595959', true);
  push([]);

  // ① 인원별
  push(['① 인원별 연차 개수'], '#ffffff', true, '#17365d', true);
  push(['성명', '직급', '미사용연차', '원본 계획', '현재 계획', '원본+이력', '소진(~어제)', '남은 지정', '변경 건수', '상태'], '#d9e5f3', true);
  res.people.forEach(p => push([p.name, p.position, p.unused, p.origTotal, p.curTotal, p.expTotal, p.used, p.remain, p.changes, p.status],
    p.ok ? '#e2f0d9' : '#fce4d6'));
  push([]);

  // ② 확인 필요
  const rank = { '불일치': 0, '추정': 1, '이력 점검': 2, '수식': 3, '표 점검': 4, '주의': 5 };
  const iss = res.issues.slice().sort((a, b) =>
    (rank[a.type] - rank[b.type]) || String(a.name).localeCompare(String(b.name)) ||
    ((a.date ? ltSerialOfKey_(a.date) : 0) - (b.date ? ltSerialOfKey_(b.date) : 0)));
  push(['② 확인 필요 항목 (' + iss.length + '건)'], '#ffffff', true, '#17365d', true);
  push(['구분', '성명', '일자', '원본+이력', '현재 시트', '위치', '이력 행', '', '', '내용'], '#d9e5f3', true);
  if (!iss.length) push(['✅ 없음', '', '', '', '', '', '', '', '', '원본+이력과 현재 시트가 모두 일치합니다.'], '#e2f0d9');
  iss.forEach(it => push([
    it.type, it.name, it.date ? ltFmt_(it.date) : '',
    it.exp === undefined || it.exp === '' ? '' : ltValueOf_(it.exp) || '빈칸',
    it.cur === undefined || it.cur === '' ? '' : ltValueOf_(it.cur) || '빈칸',
    it.where || '', it.row ? it.row + '행' : '', '', '', it.msg
  ], it.type === '주의' ? '#fff2cc' : it.type === '추정' ? '#ddebf7' : '#fce4d6'));
  push([]);

  // ③ 연차별 흐름
  const chains = res.chains.slice().sort((a, b) =>
    String(a.name).localeCompare(String(b.name)) ||
    ((a.end ? ltSerialOfKey_(a.end) : 99999) - (b.end ? ltSerialOfKey_(b.end) : 99999)));
  push(['③ 연차별 변경 흐름 (' + chains.length + '건, 변경된 것 ' + chains.filter(c => c.path.length > 1 || c.origin !== '원본').length + '건)'], '#ffffff', true, '#17365d', true);
  const flowHeader = values.length + 1;
  push(['성명', '구분', '최초 계획일', '최종 일자', '상태', '변경 횟수', '최근 통보', '출처', '', '변경 경로'], '#d9e5f3', true);
  chains.forEach(c => {
    const st = ltChainStatus_(c, t.serial);
    const steps = c.path.filter(p => p.row);
    const route = (c.origin === '추가' ? '(추가) → ' : '') +
      c.path.filter(p => p.key || p.cancel).map(p => p.cancel ? '취소' : ltFmt_(p.key) + (p.keep ? ' 반차 유지' : '')).join(' → ');
    const last = steps.length ? steps[steps.length - 1] : null;
    const changed = steps.length > 0;
    const bg = st === '취소' ? '#f2f2f2' : /^D-|오늘/.test(st) ? '#fbe5d6' : changed ? '#fff2cc' : '#ffffff';
    const color = st === '소진' ? '#7f7f7f' : '#000000';
    push([c.name, ltValueOf_(c.amount) || c.amount, c.start ? ltFmt_(c.start) : '(추가)', c.end ? ltFmt_(c.end) : '—', st,
      steps.length, last ? (last.requested || '') + ' (' + last.row + '행)' : '',
      c.origin === '원본' ? '원본' : c.origin === '추가' ? '이력: 추가' : '이력: 원본에 없음', '', route + (c.split ? '  (반차로 나눔)' : '')], bg, false, color);
  });

  // 쓰기
  const filter = sheet.getFilter();
  if (filter) filter.remove();
  sheet.getDataRange().breakApart();
  sheet.clear();
  if (sheet.getMaxRows() < values.length + 5) sheet.insertRowsAfter(sheet.getMaxRows(), values.length + 5 - sheet.getMaxRows());
  if (sheet.getMaxColumns() < W) sheet.insertColumnsAfter(sheet.getMaxColumns(), W - sheet.getMaxColumns());
  const rng = sheet.getRange(1, 1, values.length, W);
  rng.setValues(values.map(r => r.map(v => typeof v === 'string' && v.startsWith('=') ? "'" + v : v)))
    .setBackgrounds(bgs).setFontWeights(bolds).setFontColors(colors)
    .setFontFamily('Arial').setFontSize(10).setVerticalAlignment('middle').setWrap(true);
  sheet.getRange(1, 1, values.length, 9).setHorizontalAlignment('center');
  sheet.getRange(1, 10, values.length, 1).setHorizontalAlignment('left');
  merges.forEach(r => sheet.getRange(r, 1, 1, W).merge().setHorizontalAlignment('left'));
  sheet.getRange('A1').setNote(marker).setFontSize(15);
  sheet.setRowHeight(1, 36);
  [80, 70, 100, 100, 90, 80, 120, 110, 30, 520].forEach((w, i) => sheet.setColumnWidth(i + 1, w));
  if (chains.length) sheet.getRange(flowHeader, 1, chains.length + 1, W).createFilter();
  sheet.setHiddenGridlines(true);
  sheet.setFrozenRows(0);
}


