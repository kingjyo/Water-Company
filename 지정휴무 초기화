// [v3] ⏰ 5일 전 경고 — 지정휴무 연차 ↔ 근무계획 '년'/'반'
// ═════════════════════════════════════════════════════════════════════════

/** 근무계획 월 시트 읽기 (캐시) → { error, people:{키:{row, sheetRow}}, dayMap } */
function ltPlanMonth_(planBook, month, cache) {
  if (cache[month]) return cache[month];
  const out = { error: '', people: {}, dayMap: null };
  cache[month] = out;
  try {
    const plan = planBook.getSheetByName(month + '월');
    if (!plan) throw new Error('근무계획에 ' + month + '월 시트가 아직 없습니다');
    const lastRow = plan.getLastRow();
    if (lastRow < 5) throw new Error('근무계획 ' + month + '월에 직원 표가 없습니다');
    const labels = plan.getRange(5, 1, lastRow - 4, 1).getDisplayValues();
    const count = labels.findIndex(r => leaveName_(r[0]) === '계');
    if (count < 0) throw new Error('근무계획 ' + month + '월 A열에서 "계" 행을 찾지 못했습니다');
    const rows = count ? plan.getRange(5, 1, count, 37).getDisplayValues() : [];
    out.dayMap = leaveDayMap_(plan.getRange('G3:AK3').getDisplayValues()[0], new Date(LEAVE_CHECK_CONFIG.year, month, 0).getDate());
    rows.forEach((r, i) => {
      const k = leaveName_(r[2]);
      if (!k) return;
      if (out.people[k]) out.people[k].dup = true;
      else out.people[k] = { row: r, sheetRow: i + 5 };
    });
  } catch (e) {
    out.error = e.message;
  }
  return out;
}

/** 경고 대상 수집 → { today, items:[경고], infos:[참고] } */
function ltCollectAlerts_(today) {
  const cfg = LEAVE_CHECK_CONFIG, A = LEAVE_ALERT_CONFIG;
  const cur = ltReadGrid_(getSourceSheet_());
  const planBook = SpreadsheetApp.openById(cfg.planSpreadsheetId);
  const cache = {};
  const items = [], infos = [];
  for (let off = 0; off <= A.daysBefore; off++) {
    const dt = ltAddDays_(today, off);
    if (dt.y !== cfg.year) continue;
    const pm = ltPlanMonth_(planBook, dt.m, cache);
    Object.keys(cur.people).forEach(k => {
      const person = cur.people[k];
      const cell = person.cells[dt.key];
      const pp = pm.people[k];
      let planVal = '', planCell = '';
      if (pp && pm.dayMap && pm.dayMap[dt.d] !== undefined) {
        const idx = pm.dayMap[dt.d] + 6;
        planVal = pp.row[idx];
        planCell = dt.m + '월!' + leaveColumn_(idx + 1) + pp.sheetRow;
      }
      const base = { name: person.name, key: dt.key, off: off, value: cell ? cell.value : '', planValue: planVal, planCell: planCell,
        where: cell ? cfg.sourceSheetName + '!' + cell.a1 : '' };
      if (cell) {
        const exp = leaveMarkers_(cell.value);
        let status = '';
        if (pm.error) status = '근무계획 확인 불가: ' + pm.error;
        else if (!pp) status = '근무계획 ' + dt.m + '월에 이름이 없습니다';
        else if (pp.dup) status = '근무계획 ' + dt.m + '월에 같은 이름이 2명 이상';
        else {
          const act = leaveMarkers_(planVal);
          if (act === exp) return;
          status = act ? '휴가 종류 불일치 (지정휴무 ' + exp + ' / 근무계획 ' + act + ')' : '근무계획에 "' + exp + '" 없음';
        }
        items.push(Object.assign(base, { status: status }));
      } else if (A.reportPlanOnly && pp && !pp.dup && pm.dayMap) {
        const act = leaveMarkers_(planVal);
        if (act) infos.push(Object.assign(base, { status: '근무계획엔 "' + act + '"인데 지정휴무엔 없음 → 변경 통보·등록 누락?' }));
      }
    });
  }
  return { today: today, items: items, infos: infos };
}

function ltDday_(off) { return off === 0 ? '오늘' : 'D-' + off; }

function previewLeaveAlerts() {
  const ui = SpreadsheetApp.getUi();
  try {
    const r = ltCollectAlerts_(ltToday_());
    const line = x => '• ' + ltDday_(x.off) + ' ' + ltFmt_(x.key) + ' ' + x.name + ' — ' + x.status +
      (x.planCell ? ' [' + x.planCell + ': ' + (x.planValue || '빈칸') + ']' : '');
    let msg = '👀 오늘(' + ltFmt_(r.today.key) + ') ~ ' + LEAVE_ALERT_CONFIG.daysBefore + '일 뒤까지\n\n';
    msg += r.items.length ? '⚠️ 경고 ' + r.items.length + '건\n' + r.items.map(line).join('\n') : '✅ 근무계획 미반영 연차 없음';
    if (r.infos.length) msg += '\n\nℹ️ 참고 ' + r.infos.length + '건\n' + r.infos.map(line).join('\n');
    msg += '\n\n(메일은 보내지 않았습니다)';
    ui.alert(msg);
  } catch (e) {
    ui.alert('❌ 오류\n\n' + e.message);
  }
}

function sendLeaveAlertsNow() {
  const ui = SpreadsheetApp.getUi();
