// ═════════════════════════════════════════════════════════════════════════
// 선택 월 연차·반차 검증 (읽기 전용)
// ═════════════════════════════════════════════════════════════════════════
function validateSelectedLeaveMonths() {
  const ui = SpreadsheetApp.getUi();
  try {
    const source = getSourceSheet_();
    const blocks = getMonthBlocks_(source);
    const available = blocks.map(b => b.month);

    const answer = ui.prompt('선택 월 연차·반차 검증',
      '검증할 월을 입력하세요. 예: 7 또는 7,8,9 또는 전체\n' +
      '지정휴무 탭에 있는 월: ' + available.join(', ') + '월\n초기화하기 전에 검증하세요.',
      ui.ButtonSet.OK_CANCEL);
    if (answer.getSelectedButton() !== ui.Button.OK) return;

    const months = leaveParseMonths_(answer.getResponseText(), available);

    const dateHeaderRow = findDateHeaderRow_(source, blocks);
    const startCol = columnLetterToIndex(LEAVE_CHECK_CONFIG.dayColStart);
    const numDayCols = dayColCount_();
    const sourceHeaders = source.getRange(dateHeaderRow, startCol, 1, numDayCols).getDisplayValues()[0];
    const sourceDays = leaveDayMap_(sourceHeaders, 31);

    const planBook = SpreadsheetApp.openById(LEAVE_CHECK_CONFIG.planSpreadsheetId);

    const results = months.map(month => {
      const block = getMonthBlock_(blocks, month);
      if (!block) return { month, checked: 0, matched: 0, entries: [],
        blocked: '검증 불가: 지정휴무 탭에 ' + month + '월 블록이 없습니다.' };

      // B열(이름) + 날짜 열 전체 (B ~ AG)
      const sourceRows = source.getRange(block.dataStartRow, 2, block.dataCount, numDayCols + 1).getDisplayValues();

      const plan = planBook.getSheetByName(month + '월');
      if (!plan) return { month, checked: 0, matched: 0, entries: [],
        blocked: '검증 불가: 근무계획의 ' + month + '월 시트가 아직 없습니다.' };
      try {
        const lastRow = plan.getLastRow();
        if (lastRow < 5) throw new Error('근무계획에 직원 표와 A열의 계 행이 없습니다.');
        const labels = plan.getRange(5, 1, lastRow - 4, 1).getDisplayValues();
        const count = labels.findIndex(row => leaveName_(row[0]) === '계');
        if (count < 0) throw new Error('A열에서 계 행을 찾지 못해 인원 범위를 확정할 수 없습니다.');
        const planRows = count ? plan.getRange(5, 1, count, 37).getDisplayValues() : [];
        const planHeaders = plan.getRange('G3:AK3').getDisplayValues()[0];
        return leaveCompareMonth_(month, block.dataStartRow, sourceRows, sourceDays, planHeaders, planRows);
      } catch (error) {
        return { month, checked: 0, matched: 0, entries: [], blocked: '검증 불가: ' + error.message };
      }
    });
    leaveShowResults_(results);
  } catch (error) {
    ui.alert('검증을 완료하지 못했습니다', String(error.message || error) +
      '\n\n근무계획 파일 접근 권한과 시트 이름·표 구조를 확인하세요.', ui.ButtonSet.OK);
  }
}

function leaveParseMonths_(input, available) {
  const text = String(input).trim();
  if (text === '전체') return available.slice();
  const parts = text.split(',').map(part => part.trim());
  if (!parts.length || parts.some(part => !/^(?:[1-9]|1[0-2])\s*월?$/.test(part))) {
    throw new Error('월은 1~12 사이 숫자로 입력하세요. 여러 월은 쉼표로 구분하세요. 예: 7,8,9');
  }
  const months = Array.from(new Set(parts.map(part => Number(part.replace(/\s*월$/, ''))))).sort((a, b) => a - b);
  const missing = months.filter(m => available.indexOf(m) === -1);
  if (missing.length) throw new Error('지정휴무 탭에 없는 월입니다: ' + missing.join(', ') + '월 (있는 월: ' + available.join(', ') + '월)');
  return months;
}

function leaveName_(value) {
  return String(value == null ? '' : value).normalize('NFC').replace(/\s+/g, '');
}

function leaveMarkers_(value) {
  const text = String(value == null ? '' : value);
  return ['년', '반'].filter(marker => text.indexOf(marker) >= 0).join('');
}

function leaveDayMap_(headers, days) {
  const result = Object.create(null);
  headers.forEach((header, index) => {
    const text = String(header).trim();
    if (!text) return;
    if (!/^\d+$/.test(text)) throw new Error('날짜 머리글은 숫자여야 합니다: ' + text);
    const day = Number(text);
    if (day < 1 || day > 31) throw new Error('날짜 머리글 범위 오류: ' + text);
    if (result[day] !== undefined) throw new Error('날짜 머리글 중복: ' + day + '일');
    result[day] = index;
  });
  for (let day = 1; day <= days; day++) {
    if (result[day] === undefined) throw new Error('날짜 머리글 누락: ' + day + '일');
  }
  return result;
}

// GAS 서비스에 의존하지 않는 비교 함수: 입력은 getDisplayValues() 형식입니다.
function leaveCompareMonth_(month, startRow, sourceRows, sourceDays, planHeaders, planRows) {
  const days = new Date(LEAVE_CHECK_CONFIG.year, month, 0).getDate();
  const planDays = leaveDayMap_(planHeaders, days);
  const people = Object.create(null);
  const sourceCounts = Object.create(null);
  planRows.forEach((row, index) => {
    const name = leaveName_(row[2]);
    if (name) (people[name] || (people[name] = [])).push({ row, sheetRow: index + 5 });
  });
  sourceRows.forEach(row => {
    const name = leaveName_(row[0]);
    if (name) sourceCounts[name] = (sourceCounts[name] || 0) + 1;
  });
  const result = { month, checked: 0, matched: 0, entries: [], blocked: '' };
  sourceRows.forEach((row, index) => {
    const name = leaveName_(row[0]);
    for (let day = 1; day <= 31; day++) {
      const sourceIndex = sourceDays[day];
      const value = row[sourceIndex + 1];
      const expected = leaveMarkers_(value);
      if (!expected) continue;
      result.checked++;
      const entry = { name: row[0] || '(이름 없음)', day, sourceValue: value,
        sourceCell: leaveColumn_(sourceIndex + 3) + (startRow + index),
        planValue: '', planCell: '', status: '', ok: false };
      const matches = people[name] || [];
      if (day > days) entry.status = '해당 월에 없는 날짜';
      else if (!name) entry.status = '지정휴무 이름 누락';
      else if (sourceCounts[name] > 1) entry.status = '지정휴무 이름 중복: 이름만으로 구분 불가';
      else if (!matches.length) entry.status = '근무계획에 이름 없음';
      else if (matches.length > 1) entry.status = '근무계획 이름 중복: 이름만으로 구분 불가';
      else {
        const matched = matches[0];
        const planIndex = planDays[day] + 6;
        entry.planValue = matched.row[planIndex];
        entry.planCell = leaveColumn_(planIndex + 1) + matched.sheetRow;
        const actual = leaveMarkers_(entry.planValue);
        if (expected.length > 1 || actual.length > 1) entry.status = '년·반 동시 포함: 휴가 종류 확인 필요';
        else if (actual === expected) {
          entry.ok = true;
          entry.status = '일치';
          result.matched++;
        } else entry.status = actual ? '휴가 종류 불일치' : '근무계획에 ' + expected + ' 없음';
      }
      result.entries.push(entry);
    }
  });
  return result;
}

function leaveColumn_(column) {
  let text = '';
  while (column > 0) {
    column--;
    text = String.fromCharCode(65 + column % 26) + text;
    column = Math.floor(column / 26);
  }
  return text;
}

function leaveEscape_(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, char =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
}

function leaveShowResults_(results) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetName = '연차·반차 검증결과';
  const marker = 'LEAVE_VALIDATION_REPORT_V1';
  const lock = LockService.getDocumentLock();
  if (!lock.tryLock(10000)) throw new Error('다른 검증 결과를 저장 중입니다. 잠시 후 다시 실행하세요.');
  try {
    let sheet = ss.getSheetByName(sheetName);
    if (sheet && sheet.getLastRow() > 0 && sheet.getRange('A1').getNote() !== marker) {
      throw new Error(sheetName + ' 이름의 기존 시트에 다른 데이터가 있습니다. 해당 시트 이름을 변경한 뒤 다시 실행하세요.');
    }
    const report = leaveBuildReport_(results);
    const timestamp = Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), 'yyyy-MM-dd HH:mm:ss');
    report.values[1][0] = '검증 시각: ' + timestamp + ' | 선택 월: ' + results.map(r => r.month + '월').join(', ');
    if (!sheet) sheet = ss.insertSheet(sheetName);
    if (sheet.getMaxRows() < report.values.length) {
      sheet.insertRowsAfter(sheet.getMaxRows(), report.values.length - sheet.getMaxRows());
    }
    if (sheet.getMaxColumns() < 9) sheet.insertColumnsAfter(sheet.getMaxColumns(), 9 - sheet.getMaxColumns());
    const filter = sheet.getFilter();
    if (filter) filter.remove();
    sheet.getDataRange().breakApart();
    sheet.clear();
    sheet.getRange('A1').setNote(marker);
    // 원본의 = 시작 문자열을 수식으로 실행하지 않고 표시합니다.
    const safeValues = report.values.map(row => row.map(value =>
      typeof value === 'string' && value.startsWith('=') ? "'" + value : value));
    sheet.getRange(1, 1, safeValues.length, 9).setValues(safeValues)
      .setFontFamily('Arial').setFontSize(10).setVerticalAlignment('middle').setWrap(true);
    [1, 2, 3].forEach(row => sheet.getRange(row, 1, 1, 9).merge());
    sheet.getRange('A1:I1').setBackground('#17365d').setFontColor('#ffffff').setFontSize(16).setFontWeight('bold');
    sheet.setRowHeight(1, 38);
    sheet.setRowHeight(2, 30);
    sheet.setRowHeight(3, 42);
    const summaryHeader = sheet.getRange(5, 1, 1, 9);
    const detailHeader = sheet.getRange(report.detailHeaderRow, 1, 1, 9);
    [summaryHeader, detailHeader].forEach(range => range.setBackground('#d9e5f3').setFontWeight('bold'));
    results.forEach((result, index) => {
      const color = result.blocked || !result.checked ? '#fff2cc' :
        result.checked > result.matched ? '#fce4d6' : '#e2f0d9';
      sheet.getRange(6 + index, 1, 1, 9).setBackground(color);
    });
    if (report.details.length) {
      const colors = report.details.map(row => Array(9).fill(
        row[0] === '일치' ? '#e2f0d9' : row[0] === '확인 필요' ? '#fce4d6' : '#fff2cc'));
      sheet.getRange(report.detailHeaderRow + 1, 1, report.details.length, 9).setBackgrounds(colors);
      sheet.getRange(report.detailHeaderRow, 1, report.details.length + 1, 9).createFilter();
    }
    [100, 65, 100, 100, 150, 125, 150, 150, 330].forEach((width, index) => sheet.setColumnWidth(index + 1, width));
    sheet.setFrozenRows(report.detailHeaderRow);
    sheet.setFrozenColumns(0);
    sheet.setHiddenGridlines(true);
    ss.setActiveSheet(sheet);
    sheet.getRange('A1').activate();
    ss.toast('선택한 월의 결과를 갱신했습니다.', '연차·반차 검증', 5);
  } finally {
    lock.releaseLock();
  }
}

function leaveBuildReport_(results) {
  const pad = row => row.concat(Array(9 - row.length).fill(''));
  const values = [
    pad([LEAVE_CHECK_CONFIG.year + '년 연차·반차 검증결과']),
    pad(['검증 시각']),
    pad(['지정휴무의 년·반 셀 기준 | 재실행 시 선택한 월의 결과로 교체됩니다. | 초기화 전에 검증하세요.']),
    pad([]),
    ['월', '대상', '일치', '확인 필요', '검증 상태', '', '', '', '안내']
  ];
  const details = [];
  results.forEach(result => {
    const status = result.blocked ? '검증 불가' : !result.checked ? '대상 없음' :
      result.checked > result.matched ? '확인 필요' : '일치';
    const message = result.blocked || (!result.checked ? '비교할 년·반 셀이 없습니다. 초기화 후 실행했는지 확인하세요.' : '');
    values.push([result.month + '월', result.blocked ? '—' : result.checked,
      result.blocked ? '—' : result.matched, result.blocked ? '—' : result.checked - result.matched,
      status, '', '', '', message]);
    if (result.blocked || !result.entries.length) {
      details.push([status, result.month, '', '', '', '', '', '', message]);
    } else {
      result.entries.forEach(entry => details.push([
        entry.ok ? '일치' : '확인 필요', result.month, entry.name, result.month + '/' + entry.day,
        entry.sourceValue, LEAVE_CHECK_CONFIG.sourceSheetName + '!' + entry.sourceCell,
        entry.planValue || '(빈칸)', entry.planCell ? result.month + '월!' + entry.planCell : '—', entry.status
      ]));
    }
  });
  const rank = { '확인 필요': 0, '검증 불가': 1, '대상 없음': 2, '일치': 3 };
  details.sort((a, b) => rank[a[0]] - rank[b[0]] || a[1] - b[1]);
  values.push(pad([]));
  const detailHeaderRow = values.length + 1;
  values.push(['결과', '월', '성명', '일자', '지정휴무 값', '지정휴무 위치', '근무계획 값', '근무계획 위치', '상세 사유']);
  values.push(...details);
  return { values, details, detailHeaderRow };
}


// ═════════════════════════════════════════════════════════════════════════
// [v3] 공통 도우미 — 날짜·연차량
// ═════════════════════════════════════════════════════════════════════════

/** 스프레드시트 (트리거 실행 시에도 동작) */
function ltBook_() {
  let ss = null;
  try { ss = SpreadsheetApp.getActiveSpreadsheet(); } catch (e) { ss = null; }
  if (ss) return ss;
  const id = PropertiesService.getScriptProperties().getProperty('LEAVE_BOOK_ID');
  if (!id) throw new Error('스프레드시트를 찾을 수 없습니다. 메뉴에서 "매일 자동 경고 켜기"를 한 번 실행하세요.');
  return SpreadsheetApp.openById(id);
}

/** '년' → 1, '반' → 0.5, 빈칸/기타 → 0, 둘 다 → null */
function ltAmount_(value) {
  const mk = leaveMarkers_(value);
  if (!mk) return 0;
  if (mk === '년') return 1;
  if (mk === '반') return 0.5;
  return null;
}
function ltValueOf_(amount) {
  if (amount >= 1 - 1e-9) return '년';
  if (amount > 1e-9) return '반';
  return '';
}
function ltLabel_(amount) {
  if (!amount) return '없음';
  if (Math.abs(amount - 1) < 1e-9) return '년(1)';
  if (Math.abs(amount - 0.5) < 1e-9) return '반(0.5)';
  return amount + '일';
}

/** 날짜 객체 { y, m, d, key:'M-D', serial } */
function ltMake_(y, m, d) {
  const dt = new Date(Date.UTC(y, m - 1, d));
  if (dt.getUTCFullYear() !== y || dt.getUTCMonth() !== m - 1 || dt.getUTCDate() !== d) {
    return { error: '없는 날짜: ' + y + '-' + m + '-' + d };
  }
  return { y: y, m: m, d: d, key: m + '-' + d, serial: Date.UTC(y, m - 1, d) / 86400000 };
}
function ltFromKey_(key, year) {
  const p = String(key).split('-').map(Number);
  return ltMake_(year || LEAVE_CHECK_CONFIG.year, p[0], p[1]);
}
function ltSerialOfKey_(key) { return ltFromKey_(key).serial; }

/** 시트 값(Date / 'yyyy-mm-dd' / '9/11' / '9월 11일' / 엑셀 일련번호) → 날짜 객체, 빈칸 → null */
function ltParseDate_(raw, disp, year) {
  if (raw === '' || raw == null) {
    if (String(disp == null ? '' : disp).trim() === '') return null;
    raw = disp;
  }
  if (Object.prototype.toString.call(raw) === '[object Date]') {
    if (isNaN(raw.getTime())) return { error: '날짜 형식 오류' };
    return ltMake_(raw.getFullYear(), raw.getMonth() + 1, raw.getDate());
  }
  if (typeof raw === 'number') {
    const dt = new Date(Date.UTC(1899, 11, 30) + Math.round(raw) * 86400000);
    return ltMake_(dt.getUTCFullYear(), dt.getUTCMonth() + 1, dt.getUTCDate());
  }
  const t = String(raw).trim();
  let m = t.match(/^(\d{4})\s*[-./년]\s*(\d{1,2})\s*[-./월]\s*(\d{1,2})/);
  if (m) return ltMake_(Number(m[1]), Number(m[2]), Number(m[3]));
  m = t.match(/^(\d{1,2})\s*[-/.월]\s*(\d{1,2})/);
  if (m) return ltMake_(year, Number(m[1]), Number(m[2]));
  return { error: '날짜를 읽을 수 없음: ' + t };
}

/** 'M-D' → '9/11(금)' */
function ltFmt_(key) {
  if (!key) return '';
  const p = String(key).split('-').map(Number);
  const dow = ['일', '월', '화', '수', '목', '금', '토'][new Date(Date.UTC(LEAVE_CHECK_CONFIG.year, p[0] - 1, p[1])).getUTCDay()];
  return p[0] + '/' + p[1] + '(' + dow + ')';
}

/** 한국시간 오늘 */
function ltToday_() {
  const s = Utilities.formatDate(new Date(), LT_TZ, 'yyyy-M-d').split('-').map(Number);
  return ltMake_(s[0], s[1], s[2]);
}
function ltAddDays_(dt, n) {
  const x = new Date(Date.UTC(dt.y, dt.m - 1, dt.d + n));
  return ltMake_(x.getUTCFullYear(), x.getUTCMonth() + 1, x.getUTCDate());
}

/** 주말·공휴일 이름 (평일이면 '') */
function ltOffDayName_(key, holidayMap) {
  const dt = ltFromKey_(key);
  if (holidayMap) {
    const info = resolveHoliday_(holidayMap, dt.y, dt.m, dt.d);
    if (info) return info.name;
  }
  const dow = new Date(Date.UTC(dt.y, dt.m - 1, dt.d)).getUTCDay();
  if (dow === 0) return '일요일';
  if (dow === 6) return '토요일';
  return '';
}

function ltSortKeys_(keys) {
  return keys.slice().sort((a, b) => ltSerialOfKey_(a) - ltSerialOfKey_(b));
}


// ═════════════════════════════════════════════════════════════════════════
// [v3] 시트 읽기 — 지정휴무 표 / 요약표 / 변경 이력
// ═════════════════════════════════════════════════════════════════════════

/**
 * 지정휴무 표(원본·현재 공용) 읽기
 * 반환: { sheetName, people: { 정규화이름: { name, cells: { 'M-D': { amount, value, a1 } }, rows:{월:행} } },
 *        issues: [ ... ] }
 */
function ltReadGrid_(sheet) {
  const cfg = LEAVE_CHECK_CONFIG;
  const sheetName = sheet.getName();
  const blocks = getMonthBlocks_(sheet);
  const dateRow = findDateHeaderRow_(sheet, blocks);
  const startCol = columnLetterToIndex(cfg.dayColStart);
  const nDays = dayColCount_();
  const dayMap = leaveDayMap_(sheet.getRange(dateRow, startCol, 1, nDays).getDisplayValues()[0], 31);
  const ahCol = startCol + nDays;          // AH 년차, AI 반차, AJ 합계
  const people = {};
  const issues = [];

  blocks.forEach(b => {
    const days = new Date(cfg.year, b.month, 0).getDate();
    const blockVals = sheet.getRange(b.dataStartRow, 2, b.dataCount, nDays + 4).getDisplayValues();   // B ~ AJ
    const blockFx = sheet.getRange(b.dataStartRow, ahCol, b.dataCount, 3).getFormulas();
    b.rows.forEach(row => {
      const vals = blockVals[row - b.dataStartRow];
      const formulas = blockFx[row - b.dataStartRow];
      const key = leaveName_(vals[0]);
      if (!key) return;
      const p = people[key] || (people[key] = { name: String(vals[0]).trim(), cells: {}, rows: {} });
      if (p.rows[b.month]) {
        issues.push({ type: '표 점검', name: p.name, msg: sheetName + ' ' + b.month + '월에 같은 이름이 두 번 있습니다 (' + p.rows[b.month] + '행, ' + row + '행)' });
      }
      p.rows[b.month] = row;
      let sum = 0;
      for (let day = 1; day <= 31; day++) {
        const col = startCol + dayMap[day];
        const v = vals[col - 2];
        const amt = ltAmount_(v);
        const a1 = leaveColumn_(col) + row;
        if (amt === null) {
          issues.push({ type: '표 점검', name: p.name, date: b.month + '-' + day, where: sheetName + '!' + a1,
            msg: '한 칸에 년·반이 같이 있습니다: "' + v + '"' });
          continue;
        }
        if (!amt) continue;
        if (day > days) {
          issues.push({ type: '표 점검', name: p.name, where: sheetName + '!' + a1, msg: b.month + '월에 없는 날짜(' + day + '일)에 연차가 있습니다' });
          continue;
        }
        p.cells[b.month + '-' + day] = { amount: amt, value: v, a1: a1 };
        sum += amt;
      }
      // 합계 수식 점검 (AH/AI/AJ)
      const S = cfg.dayColStart, E = cfg.dayColEnd;
      const ah = leaveColumn_(ahCol), ai = leaveColumn_(ahCol + 1), aj = leaveColumn_(ahCol + 2);
      const expect = [
        '=COUNTIF(' + S + row + ':' + E + row + ',"년")',
        '=COUNTIF(' + S + row + ':' + E + row + ',"반")',
        '=' + ah + row + '+' + ai + row + '/2'
      ];
      const norm = f => String(f || '').replace(/\s+/g, '').replace(/\$/g, '').toUpperCase().replace(/^=\+/, '=');
      [ah, ai, aj].forEach((colName, j) => {
        if (formulas[j] && norm(formulas[j]) !== norm(expect[j])) {
          issues.push({ type: '수식', name: p.name, where: sheetName + '!' + colName + row,
            msg: '합계 수식이 다른 칸을 가리킵니다: ' + formulas[j] + '  → 올바른 수식: ' + expect[j] });
        }
      });
      const ajShown = vals[nDays + 3];
      if (String(ajShown).trim() !== '' && !isNaN(Number(ajShown)) && Math.abs(Number(ajShown) - sum) > 1e-9) {
        issues.push({ type: '수식', name: p.name, where: sheetName + '!' + aj + row,
          msg: '합계 칸 표시값(' + ajShown + ')과 실제 년·반 개수(' + sum + ')가 다릅니다' });
      }
    });
  });
  const dayCols = {};
  for (let day = 1; day <= 31; day++) dayCols[day] = startCol + dayMap[day];
  return { sheetName: sheetName, people: people, issues: issues, blocks: blocks, dayCols: dayCols };
}

/** 상단 요약표에서 '미사용연차' 값 읽기 → { 정규화이름: 숫자 } */
function ltReadSummary_(sheet, blocks) {
  const limit = (blocks && blocks.length ? blocks[0].labelRow : sheet.getLastRow()) - 1;
  if (limit < 2) return {};
  const lastCol = Math.min(sheet.getLastColumn(), 40);
  const vals = sheet.getRange(1, 1, limit, lastCol).getDisplayValues();
  const hr = vals.findIndex(r => leaveName_(r[0]) === '성명');
  if (hr < 0) return {};
  const col = vals[hr].findIndex(v => leaveName_(v) === '미사용연차');
  if (col < 0) return {};
  const out = {};
  for (let r = hr + 1; r < vals.length; r++) {
    const k = leaveName_(vals[r][0]);
    if (!k) break;
    const n = Number(String(vals[r][col]).replace(/,/g, ''));
    if (!isNaN(n)) out[k] = n;
  }
  return out;
}

/** 변경 이력 시트 읽기 (병합된 '변경 전' 칸은 아래 행에도 같은 값으로 간주) */
function ltReadLedger_(sheet) {
  const C = CHANGE_LOG_CONFIG;
  const last = sheet.getLastRow();
  if (last < C.firstDataRow) return [];
  const n = last - C.firstDataRow + 1;
  const width = C.col.used;    // A ~ H
  const rng = sheet.getRange(C.firstDataRow, 1, n, width);
  const values = rng.getValues();
  const disp = rng.getDisplayValues();
  sheet.getRange(C.firstDataRow, C.col.name, n, width - C.col.name + 1).getMergedRanges().forEach(m => {
    const r0 = m.getRow() - C.firstDataRow, c0 = m.getColumn() - 1;
    for (let r = Math.max(r0, 0); r <= Math.min(m.getLastRow() - C.firstDataRow, n - 1); r++) {
      for (let c = c0; c <= Math.min(m.getLastColumn() - 1, width - 1); c++) {
        if (r === r0 && c === c0) continue;
        values[r][c] = values[r0][c0];
        disp[r][c] = disp[r0][c0];
      }
    }
  });
  return ltParseLedgerRows_(values, disp, C.firstDataRow, LEAVE_CHECK_CONFIG.year);
}

/** (GAS 비의존) 이력 행 → 항목 */
function ltParseLedgerRows_(values, disp, firstRow, year) {
  const c = CHANGE_LOG_CONFIG.col;
  const out = [];
  values.forEach((row, i) => {
    const name = String(disp[i][c.name - 1] || '').trim();
    const fromRaw = row[c.from - 1], toRaw = row[c.to - 1];
    const fromDisp = disp[i][c.from - 1], toDisp = disp[i][c.to - 1];
    if (!name && String(fromDisp).trim() === '' && String(toDisp).trim() === '') return;
    const e = {
      sheetRow: firstRow + i,
      name: name,
      key: leaveName_(name),
      position: String(disp[i][c.position - 1] || '').trim(),
      requested: String(disp[i][c.requested - 1] || '').trim(),
      note: String(disp[i][c.note - 1] || '').trim(),
      usedShown: String(disp[i][c.used - 1] || '').trim(),
      from: null, to: null, half: false, cancel: false, errors: [], warnings: []
    };
    if (!name) e.errors.push('이름이 비어 있음');
    e.from = ltParseDate_(fromRaw, fromDisp, year);
    e.to = ltParseDate_(toRaw, toDisp, year);
    [['변경 전', 'from'], ['변경 후', 'to']].forEach(pair => {
      const d = e[pair[1]];
      if (d && d.error) { e.errors.push(pair[0] + ' 날짜: ' + d.error); e[pair[1]] = null; }
      else if (d && d.y !== year) { e.errors.push(pair[0] + ' 날짜가 ' + year + '년이 아님 (' + d.y + ')'); e[pair[1]] = null; }
    });
    e.half = /반/.test(e.note);
    e.cancel = /취소/.test(e.note) || (!!e.from && !e.to && !e.errors.length);
    if (!e.from && !e.to && !e.errors.length) e.errors.push('변경 전·후 날짜가 모두 비어 있음');
    e.sameDay = !!(e.from && e.to && e.from.key === e.to.key);
    // 같은 날짜 = 연차 1을 반차로 쪼개고 반쪽은 원래 날짜에 남기는 경우 (반차일 때만 의미 있음)
    if (e.sameDay && !e.half) e.errors.push('변경 전·후 날짜가 같은데 반차 표시가 없음 (비고에 오전반차/오후반차 기입)');
    out.push(e);
  });
  return out;
}


// ═════════════════════════════════════════════════════════════════════════
// [v3] 핵심 계산 (GAS 비의존) — 원본 + 이력 재생, 현재와 대조
// ═════════════════════════════════════════════════════════════════════════

/**
 * 원본에 이력을 순서대로 적용
 * 반환: { state: { 키: { name, amounts:{'M-D':량}, chains:[...] } }, issues: [...] }
 *  chain = { name, origin:'원본'|'추가'|'이력', start, path:[{key,row,requested}], amount, end, cancelled }
 */
function ltReplay_(origPeople, entries, offDayFn) {
  const state = {};
  const issues = [];
  const ensure = (key, name) => state[key] || (state[key] = { name: name, amounts: {}, chains: [] });

  Object.keys(origPeople).forEach(k => {
    const p = origPeople[k];
    const s = ensure(k, p.name);
    ltSortKeys_(Object.keys(p.cells)).forEach(dk => {
      const a = p.cells[dk].amount;
      s.amounts[dk] = a;
      s.chains.push({ name: p.name, origin: '원본', start: dk, path: [{ key: dk }], amount: a, end: dk, cancelled: false });
    });
  });

  entries.forEach(e => {
    const push = (type, msg, dateKey) => {
      const it = { type: type, name: e.name, date: dateKey || '', row: e.sheetRow, msg: msg };
      issues.push(it);
      (type === '주의' ? e.warnings : e.errors).push(msg);
    };
    if (e.errors.length) {
      e.errors.slice().forEach(m => issues.push({ type: '이력 점검', name: e.name, row: e.sheetRow, msg: m }));
      return;
    }
    if (!state[e.key]) push('이력 점검', '원본 시트에 없는 이름입니다');
    const s = ensure(e.key, e.name);
    const fromKey = e.from ? e.from.key : '';
    const toKey = (e.to && !(/취소/.test(e.note))) ? e.to.key : '';

    let amount;
    let chain = null;
    if (fromKey) {
      const have = s.amounts[fromKey] || 0;
      amount = e.half ? 0.5 : (have > 0 ? have : 1);
      if (have <= 1e-9) push('이력 점검', '변경 전 날짜 ' + ltFmt_(fromKey) + '에 원본·앞선 이력 기준 연차가 없습니다', fromKey);
      else if (have + 1e-9 < amount) push('이력 점검', '변경 전 날짜 ' + ltFmt_(fromKey) + '에 남은 양(' + ltLabel_(have) + ')보다 많이 옮깁니다', fromKey);
      s.amounts[fromKey] = Math.max(0, have - amount);
      if (s.amounts[fromKey] < 1e-9) delete s.amounts[fromKey];

      // 이어지는 연차 흐름 찾기 (먼저 생긴 것부터)
      const idx = s.chains.findIndex(c => !c.cancelled && c.end === fromKey && c.amount > 1e-9);
      if (idx >= 0) {
        const c = s.chains[idx];
        if (c.amount > amount + 1e-9) {       // 연차 1 → 반차로 쪼갬
          c.amount -= amount;
          chain = { name: c.name, origin: c.origin, start: c.start, path: c.path.slice(), amount: amount, end: c.end, cancelled: false, split: true };
          s.chains.push(chain);
        } else {
          chain = c;
        }
      } else {
        chain = { name: e.name, origin: '이력', start: fromKey, path: [{ key: fromKey }], amount: amount, end: fromKey, cancelled: false };
        s.chains.push(chain);
      }
    } else {
      amount = e.half ? 0.5 : 1;
      chain = { name: e.name, origin: '추가', start: '', path: [], amount: amount, end: '', cancelled: false };
      s.chains.push(chain);
    }

    if (toKey) {
      const before = s.amounts[toKey] || 0;
      s.amounts[toKey] = before + amount;
      if (before + amount > 1 + 1e-9) push('이력 점검', '변경 후 날짜 ' + ltFmt_(toKey) + '에 이미 ' + ltLabel_(before) + '이 있어 하루 1일을 넘습니다', toKey);
      const off = (offDayFn && toKey !== fromKey) ? offDayFn(toKey) : '';
      if (off) push('주의', '변경 후 날짜 ' + ltFmt_(toKey) + '이(가) ' + off + '입니다', toKey);
      chain.path.push({ key: toKey, row: e.sheetRow, requested: e.requested, keep: toKey === fromKey });
      chain.end = toKey;
    } else {
      chain.path.push({ key: '', row: e.sheetRow, requested: e.requested, cancel: true });
      chain.cancelled = true;
      chain.end = '';
      push('주의', '연차 취소(' + (fromKey ? ltFmt_(fromKey) : '') + ') — 총 개수가 ' + amount + '일 줄어듭니다', fromKey);
    }
    e.amount = amount;
  });
  return { state: state, issues: issues };
}

/** 원본+이력 결과 ↔ 현재 시트 대조 → 불일치 목록 (+ 미등록 변경 추정) */
function ltCompare_(state, currentPeople, currentSheetName, dayCols) {
  const diffs = [];
  const keys = {};
  Object.keys(state).forEach(k => keys[k] = true);
  Object.keys(currentPeople).forEach(k => keys[k] = true);
  Object.keys(keys).forEach(k => {
    const exp = (state[k] && state[k].amounts) || {};
    const curP = currentPeople[k];
    const cur = (curP && curP.cells) || {};
    const name = (curP && curP.name) || (state[k] && state[k].name) || k;
    const dates = {};
    Object.keys(exp).forEach(d => dates[d] = true);
    Object.keys(cur).forEach(d => dates[d] = true);
    const missing = [], extra = [];
    ltSortKeys_(Object.keys(dates)).forEach(d => {
      const e = exp[d] || 0, c = cur[d] ? cur[d].amount : 0;
      if (Math.abs(e - c) < 1e-9) return;
      const dm = d.split('-').map(Number);
      const row = curP && curP.rows ? curP.rows[dm[0]] : 0;
      const where = cur[d] ? currentSheetName + '!' + cur[d].a1
        : (row && dayCols ? currentSheetName + '!' + leaveColumn_(dayCols[dm[1]]) + row : '');
      const it = { type: '불일치', name: name, date: d, exp: e, cur: c, where: where,
        msg: e > c
          ? '원본+변경이력으로는 ' + ltLabel_(e) + '인데 현재 시트는 ' + ltLabel_(c) + ' → 이력에 없는 변경이 있었거나, 현재 시트 반영이 빠졌습니다'
          : '현재 시트에만 ' + ltLabel_(c) + (e ? ' (예상 ' + ltLabel_(e) + ')' : '') + ' → 변경 정보 시트에 등록 안 된 변경일 수 있습니다' };
      diffs.push(it);
      (e > c ? missing : extra).push({ d: d, amt: Math.abs(e - c) });
    });
    // 미등록 변경 추정: 빠진 날 ↔ 생긴 날을 같은 양끼리 순서대로 짝지음
    const ex = extra.slice();
    missing.forEach(mi => {
      const j = ex.findIndex(x => Math.abs(x.amt - mi.amt) < 1e-9);
      if (j < 0) return;
      const x = ex.splice(j, 1)[0];
      diffs.push({ type: '추정', name: name, date: mi.d, exp: '', cur: '', where: '',
        msg: '미등록 변경 추정: ' + ltFmt_(mi.d) + ' → ' + ltFmt_(x.d) + ' (' + ltLabel_(mi.amt) + ') — 맞다면 변경 정보 시트에 한 줄 추가하세요' });
    });
  });
  return diffs;
}

/** 이력 행별 H열(소진유무) 값 */
function ltLedgerUsedStatus_(entries, todaySerial) {
  return entries.map((e, i) => {
    if (e.errors.length && !e.to && !e.from) return '';
    if (!e.to || /취소/.test(e.note)) return '취소';
    const sibling = x => e.half && x.half && x.from && e.from && x.from.key === e.from.key && x.requested === e.requested;
    const later = entries.slice(i + 1).some(x => x.key === e.key && x.from && x.from.key === e.to.key && !sibling(x));
    if (later) return '재변경';
    return e.to.serial < todaySerial ? '예' : '아니오';
  });
}

/** 연차 흐름 상태 */
function ltChainStatus_(chain, todaySerial) {
  if (chain.cancelled) return '취소';
  if (!chain.end) return '';
  const diff = ltSerialOfKey_(chain.end) - todaySerial;
  if (diff < 0) return '소진';
  if (diff === 0) return '오늘';
  if (diff <= LEAVE_ALERT_CONFIG.daysBefore) return 'D-' + diff;
  return '예정';
}

/**
 * 전체 분석 (시트 읽기 + 계산)
 * 반환: { today, people:[요약], issues:[...], chains:[...], entries, usedStatus }
 */
function ltAnalyze_(ss, today, holidayMap) {
  const cfg = LEAVE_CHECK_CONFIG;
  const sh = n => { const s = ss.getSheetByName(n); if (!s) throw new Error('"' + n + '" 시트를 찾을 수 없습니다.'); return s; };
  const origSheet = sh(cfg.originalSheetName);
  const curSheet = sh(cfg.sourceSheetName);
  const logSheet = sh(cfg.changeSheetName);

  const orig = ltReadGrid_(origSheet);
  const cur = ltReadGrid_(curSheet);
  const summary = ltReadSummary_(curSheet, cur.blocks);
  const origSummary = ltReadSummary_(origSheet, orig.blocks);
  const entries = ltReadLedger_(logSheet);
  const offFn = key => ltOffDayName_(key, holidayMap);
  const rep = ltReplay_(orig.people, entries, offFn);
  const diffs = ltCompare_(rep.state, cur.people, cfg.sourceSheetName, cur.dayCols);
  const todaySerial = today.serial;

  // 인원별 요약
  const order = [];
  const seen = {};
  const add = k => { if (!seen[k]) { seen[k] = true; order.push(k); } };
  Object.keys(cur.people).forEach(add);
  Object.keys(orig.people).forEach(add);
  Object.keys(rep.state).forEach(add);
  const sum = obj => Object.keys(obj || {}).reduce((a, k) => a + (typeof obj[k] === 'number' ? obj[k] : obj[k].amount), 0);
  const positions = {};
  entries.forEach(e => { if (e.position) positions[e.key] = e.position; });

  const allIssues = [].concat(orig.issues, cur.issues, rep.issues, diffs);
  const people = order.map(k => {
    const name = (cur.people[k] && cur.people[k].name) || (orig.people[k] && orig.people[k].name) || rep.state[k].name;
    const origTotal = sum(orig.people[k] && orig.people[k].cells);
    const curCells = (cur.people[k] && cur.people[k].cells) || {};
    const curTotal = sum(curCells);
    const expTotal = sum(rep.state[k] && rep.state[k].amounts);
    let used = 0;
    Object.keys(curCells).forEach(d => { if (ltSerialOfKey_(d) < todaySerial) used += curCells[d].amount; });
    const unused = summary[k] !== undefined ? summary[k] : origSummary[k];
    const changes = entries.filter(e => e.key === k).length;
    const probs = [];
    if (unused !== undefined && Math.abs(origTotal - unused) > 1e-9) probs.push('원본 합계(' + origTotal + ') ≠ 미사용(' + unused + ')');
    if (unused !== undefined && Math.abs(curTotal - unused) > 1e-9) probs.push('현재 합계(' + curTotal + ') ≠ 미사용(' + unused + ')');
    const nDiff = diffs.filter(d => d.type === '불일치' && leaveName_(d.name) === k).length;
    if (nDiff) probs.push('원본+이력 ↔ 현재 불일치 ' + nDiff + '칸');
    const nLog = rep.issues.filter(d => d.type === '이력 점검' && leaveName_(d.name) === k).length;
    if (nLog) probs.push('이력 점검 ' + nLog + '건');
    const nFx = allIssues.filter(d => (d.type === '수식' || d.type === '표 점검') && leaveName_(d.name) === k).length;
    if (nFx) probs.push('수식·표 ' + nFx + '건');
    return {
      key: k, name: name, position: positions[k] || '',
      unused: unused === undefined ? '' : unused,
      origTotal: origTotal, curTotal: curTotal, expTotal: expTotal,
      used: used, remain: curTotal - used, changes: changes,
      status: probs.length ? '⚠️ ' + probs.join(' / ') : '✅ 정상', ok: !probs.length
    };
  });

  // 연차 흐름
  const chains = [];
  order.forEach(k => (rep.state[k] ? rep.state[k].chains : []).forEach(c => {
    if (c.amount < 1e-9 && !c.cancelled) return;
    chains.push(c);
  }));

  return {
    today: today, people: people, issues: allIssues, chains: chains, entries: entries,
    usedStatus: ltLedgerUsedStatus_(entries, todaySerial),
    counts: {
      diff: diffs.filter(d => d.type === '불일치').length,
      guess: diffs.filter(d => d.type === '추정').length,
      log: rep.issues.filter(d => d.type === '이력 점검').length,
      warn: rep.issues.filter(d => d.type === '주의').length,
      formula: allIssues.filter(d => d.type === '수식' || d.type === '표 점검').length
    }
  };
}


