/**
 * A열에서 "N월" 라벨을 찾아 블록 목록을 반환.
 * 각 블록: { month, labelRow, headerRow, dataStartRow, dataEndRow, dataCount, names, rows }
 *  - 블록 범위: 라벨 행 ~ (병합 범위 끝 또는 다음 라벨 직전)
 *  - 인원 행: 그 범위 안에서 B열에 이름이 있는 행 (머리글 라벨 제외)
 *  - 요일 헤더 행: 첫 인원 행 - 1
 */
function getMonthBlocks_(sheet) {
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) throw new Error('"' + sheet.getName() + '" 시트에 데이터가 없습니다.');

  const colA = sheet.getRange(1, 1, lastRow, 1).getDisplayValues();
  const colB = sheet.getRange(1, 2, lastRow, 1).getDisplayValues();

  // A열 병합 범위: 라벨 행 → 병합 끝 행
  const mergeEnd = {};
  sheet.getRange(1, 1, lastRow, 1).getMergedRanges().forEach(r => {
    mergeEnd[r.getRow()] = r.getLastRow();
  });

  // 라벨 행 수집
  const labels = [];
  for (let i = 0; i < lastRow; i++) {
    const m = leaveName_(colA[i][0]).match(/^(\d{1,2})월$/);
    if (m) {
      const month = Number(m[1]);
      if (month >= 1 && month <= 12) labels.push({ month: month, row: i + 1 });
    }
  }
  if (labels.length === 0) throw new Error('"' + sheet.getName() + '" A열에서 "N월" 라벨을 찾지 못했습니다.');

  const blocks = [];
  for (let k = 0; k < labels.length; k++) {
    const top = labels[k].row;
    const nextTop = (k + 1 < labels.length) ? labels[k + 1].row : lastRow + 1;
    // 병합 범위가 있으면 그 끝, 없으면 다음 라벨 직전까지
    const end = Math.min(mergeEnd[top] || (nextTop - 1), nextTop - 1);

    const dataRows = [];
    const names = [];
    for (let r = top; r <= end; r++) {
      const b = leaveName_(colB[r - 1][0]);
      if (!b) continue;
      if (NAME_HEADER_LABELS.indexOf(b) !== -1) continue;
      dataRows.push(r);
      names.push(String(colB[r - 1][0]).trim());
    }
    if (dataRows.length === 0) {
      throw new Error(labels[k].month + '월 블록(' + top + '~' + end + '행)에서 B열 이름을 찾지 못했습니다.');
    }

    blocks.push({
      month: labels[k].month,
      labelRow: top,
      headerRow: dataRows[0] - 1,
      dataStartRow: dataRows[0],
      dataEndRow: dataRows[dataRows.length - 1],
      dataCount: dataRows[dataRows.length - 1] - dataRows[0] + 1,
      names: names,
      rows: dataRows
    });
  }
  return blocks;
}

/** month → 블록 (없으면 null) */
function getMonthBlock_(blocks, month) {
  return blocks.find(b => b.month === month) || null;
}

/**
 * 날짜 머리글 행(1~31) 탐색: 첫 블록 요일 헤더 위쪽에서 C열="1", D열="2" 인 행.
 * 못 찾으면 설정값(fallback) 사용.
 */
function findDateHeaderRow_(sheet, blocks) {
  const limit = blocks[0].headerRow - 1;
  const c = columnLetterToIndex(LEAVE_CHECK_CONFIG.dayColStart);
  if (limit >= 1) {
    const vals = sheet.getRange(1, c, limit, 2).getDisplayValues();
    for (let i = limit - 1; i >= 0; i--) {   // 블록에 가까운 쪽부터
      if (String(vals[i][0]).trim() === '1' && String(vals[i][1]).trim() === '2') return i + 1;
    }
  }
  return LEAVE_CHECK_CONFIG.dateHeaderRowFallback;
}

function getSourceSheet_() {
  const sheet = ltBook_().getSheetByName(LEAVE_CHECK_CONFIG.sourceSheetName);
  if (!sheet) throw new Error('지정휴무 탭을 찾을 수 없습니다: ' + LEAVE_CHECK_CONFIG.sourceSheetName);
  return sheet;
}

function dayColCount_() {
  return columnLetterToIndex(LEAVE_CHECK_CONFIG.dayColEnd) - columnLetterToIndex(LEAVE_CHECK_CONFIG.dayColStart) + 1;
}


// ═════════════════════════════════════════════════════════════════════════
// 년/메모 셀 초기화 (블록별 인원 행만)
// ═════════════════════════════════════════════════════════════════════════
function clearYeonAndNoteCells() {
  const ui = SpreadsheetApp.getUi();
  try {
    const sheet = getSourceSheet_();
    const blocks = getMonthBlocks_(sheet);
    const startCol = columnLetterToIndex(LEAVE_CHECK_CONFIG.dayColStart);
    const numCols = dayColCount_();
    let cleared = 0;

    blocks.forEach(b => {
      const range = sheet.getRange(b.dataStartRow, startCol, b.dataCount, numCols);
      const values = range.getValues();
      const notes = range.getNotes();
      for (let r = 0; r < values.length; r++) {
        for (let c = 0; c < values[r].length; c++) {
          const cellValue = values[r][c];
          const cellNote = notes[r][c];
          const hasYeon = (typeof cellValue === 'string') && cellValue.indexOf('년') !== -1;
          const hasNote = cellNote && cellNote.length > 0;
          if (hasYeon || hasNote) {
            const cell = range.getCell(r + 1, c + 1);
            if (hasYeon) cell.setValue('');
            if (hasNote) cell.clearNote();
            cell.setBackground('#ffffff');
            cleared++;
          }
        }
      }
    });

    ui.alert('완료되었습니다.\n\n' +
      blocks.map(b => b.month + '월: ' + b.dataStartRow + '~' + b.dataEndRow + '행 (' + b.dataCount + '명)').join('\n') +
      '\n\n초기화한 셀: ' + cleared + '개');
  } catch (e) {
    ui.alert('❌ 오류\n\n' + e.message);
  }
}


