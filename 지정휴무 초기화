  ScriptApp.newTrigger('dailyLeaveAlert').timeBased().everyDays(1).atHour(LEAVE_ALERT_CONFIG.triggerHour).inTimezone(LT_TZ).create();
  ui.alert('⏰ 매일 오전 ' + LEAVE_ALERT_CONFIG.triggerHour + '시경 자동 경고를 켰습니다.\n\n' +
    '• 오늘~' + LEAVE_ALERT_CONFIG.daysBefore + '일 뒤 지정휴무 연차가 근무계획에 없으면 메일 발송\n' +
