}

/** 트리거 진입점 */
function dailyLeaveAlert() {
  const today = ltToday_();
  const dow = new Date(Date.UTC(today.y, today.m - 1, today.d)).getUTCDay();
  if (LEAVE_ALERT_CONFIG.skipWeekends && (dow === 0 || dow === 6)) return;
  try { ltRefreshTracking_(ltBook_()); } catch (e) { Logger.log('추적 현황 갱신 실패: ' + e.message); }
  ltRunAlerts_(false);
}

function ltRunAlerts_(manual) {
  const A = LEAVE_ALERT_CONFIG;
  const r = ltCollectAlerts_(ltToday_());
  const sent = [];
  if (r.items.length || r.infos.length) {
    // 개인 메일
    const byName = {};
    r.items.forEach(x => (byName[x.name] || (byName[x.name] = [])).push(x));
    Object.keys(byName).forEach(n => {
      const to = A.teamEmails[n];
      if (!to) return;
      MailApp.sendEmail({
        to: to,
        subject: '[지정휴무] ' + n + '님 연차 ' + byName[n].map(x => ltFmt_(x.key)).join(', ') + ' — 근무계획 미반영',
        htmlBody: ltMailHtml_(n + '님, 아래 날짜는 지정휴무상 연차인데 근무계획에 아직 반영되지 않았습니다.',
          '근무계획 담당자에게 반영을 요청하시거나, 일정을 바꾸셨다면 노사협력팀 통보 후 관리자에게 알려 주세요.', byName[n], [])
      });
      sent.push(n + '(' + to + ')');
    });
    // 관리자 요약
    if (A.adminEmails.length) {
      MailApp.sendEmail({
        to: A.adminEmails.join(','),
        subject: '[지정휴무] ' + ltFmt_(r.today.key) + ' 근무계획 미반영 경고 ' + r.items.length + '건' + (r.infos.length ? ' · 참고 ' + r.infos.length + '건' : ''),
        htmlBody: ltMailHtml_('오늘부터 ' + A.daysBefore + '일 뒤까지 지정휴무 연차 ↔ 근무계획 대조 결과입니다.',
          '개인 메일 발송: ' + (sent.length ? sent.join(', ') : '없음 (teamEmails 미설정)'), r.items, r.infos)
      });
      sent.push('관리자(' + A.adminEmails.join(',') + ')');
    }
  }
  ltLogAlerts_(r, sent);
  return (manual ? '📧 ' : '') + '경고 ' + r.items.length + '건, 참고 ' + r.infos.length + '건\n' +
    (sent.length ? '메일 발송: ' + sent.join(', ') : '보낼 내용이 없어 메일을 보내지 않았습니다.');
}

function ltMailHtml_(intro, outro, items, infos) {
